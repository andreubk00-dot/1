func _open_rest_panel(node):
    if node == null or not is_instance_valid(node):
        return

    var base_id = int(node.get_meta("base_id",-1))
    if base_id < 0 or _base_record_index(base_id) < 0:
        return

    if _rest_danger_nearby():
        _set_survival_feedback("Слишком опасно для отдыха",1.8)
        return

    rest_source_base_id = base_id
    rest_open = true
    inventory_open = true
    is_sprinting = false
    player.velocity = Vector2.ZERO

    if inventory_panel != null:
        inventory_panel.visible = false
    if equipment_panel != null:
        equipment_panel.visible = false
    if container_panel != null:
        container_panel.visible = false
    if craft_panel != null:
        craft_panel.visible = false
    if base_build_panel != null:
        base_build_panel.visible = false

    _refresh_rest_ui()

func _pack_current_bedroll():
    if _rest_source_kind() != "bedroll":
        return false
    var base_id = rest_source_base_id
    var index = _base_record_index(base_id)
    if index < 0:
        return false

    var test_entries = inventory_entries.duplicate(true)
    if _grid_add(test_entries,"bedroll",1,INV_W,INV_H) != 0:
        if rest_status != null:
            rest_status.text = "В рюкзаке нет места 3×1, чтобы свернуть спальник."
        return false

    inventory_entries = test_entries
    if base_object_nodes.has(base_id):
        var node = base_object_nodes[base_id]
        if is_instance_valid(node):
            node.queue_free()
        base_object_nodes.erase(base_id)
    base_objects.remove_at(index)
    _emit_ai_sound(player.global_position,20.0,"workbench",0.12)
    _close_rest_panel()
    _set_survival_feedback("Походный спальник свёрнут",1.6)
    call_deferred("_refresh_inventory_ui")
    return true


func _close_rest_panel():
    rest_open = false
    rest_source_base_id = -1
    inventory_open = false

    if rest_panel != null:
        rest_panel.visible = false

func _refresh_rest_ui():
    if rest_panel == null:
        return

    rest_panel.visible = rest_open
    if not rest_open or rest_status == null:
        return

    var quality = int(_rest_quality() * 100.0)
    var danger_text = "ОПАСНО" if _rest_danger_nearby() else "БЕЗОПАСНО"

    var heat_minutes = int(floor(_rest_heat_minutes_remaining()))
    var heat_text = "Тепла нет — восстановление зависит от погоды"
    if heat_minutes > 0:
        heat_text = "Топливо ~%d ч %02d мин при текущей погоде" % [int(heat_minutes / 60),heat_minutes % 60]
    var source_kind = _rest_source_kind()
    if rest_pack_button != null:
        rest_pack_button.visible = source_kind == "bedroll"
    var source_name = "СПАЛЬНИК" if source_kind == "bedroll" else "РАСКЛАДУШКА"
    rest_status.text = "%s • качество %d%% • %s\n%s\n%s" % [
        source_name,quality,danger_text,heat_text,_rest_requirement_text(8)
    ]



