func _qa_exit_after_selftest():
    # _run_runtime_smoke_tests() has already completed before QA args are handled.
    # Turn its result into a process exit code so CI/local runners can trust it.
    var failed = self_test_failures.size()
    print("QA_SELFTEST_EXIT: failures=",failed)
    get_tree().quit(1 if failed > 0 else 0)

func _qa_capture_screenshot(path,delay_seconds = 1.0):
    # Engine-side screenshot used by art QA. Waiting a short timer gives deferred
    # QA moves, chunk rebuilds, texture upload and one animation update time to settle.
    await get_tree().create_timer(max(0.05,float(delay_seconds))).timeout
    var image = get_viewport().get_texture().get_image()
    var err = image.save_png(path)
    print("QA_CAPTURE: ",path," result=",err)
    get_tree().quit()


