func _weapon_mag_bonus(weapon_id,instance_id = ""):
    var mods = _weapon_mod_state(weapon_id,instance_id)
    var magazine_id = str(mods.get("magazine",""))
    if magazine_id != "" and item_defs.has(magazine_id):
        return int(item_defs[magazine_id].get("mag_bonus",0))
    return 0

func _weapon_mag_capacity(weapon_id,instance_id = ""):
    if not weapon_defs.has(weapon_id):
        return 0
    return int(weapon_defs[weapon_id].get("mag",0)) + _weapon_mag_bonus(weapon_id,instance_id)

func _weapon_base_mag_capacity(weapon_id):
    if not weapon_defs.has(weapon_id):
        return 0
    return int(weapon_defs[weapon_id].get("mag",0))

func _ammo_overflow_for_capacity(weapon_id,new_capacity,instance_id = ""):
    return max(0,_weapon_mag_value(weapon_id,instance_id) - int(new_capacity))

func _rig_reload_multiplier():
    _ensure_equipment_slots()
    var rig_id = str(equipment.get("rig",""))
    if rig_id == "" or not item_defs.has(rig_id):
        return 1.0
    return clamp(float(item_defs[rig_id].get("reload_mult",1.0)),0.65,1.0)

func _rig_pocket_count():
    _ensure_equipment_slots()
    var rig_id = str(equipment.get("rig",""))
    if rig_id == "" or not item_defs.has(rig_id):
        return 0
    return clamp(int(item_defs[rig_id].get("quick_pockets",0)),0,RIG_QUICK_SLOT_COUNT)

func _reload_duration_for_weapon(weapon_id):
    var duration = float(weapon_defs.get(weapon_id,{}).get("reload",0.90))
    return duration * _rig_reload_multiplier()

func _reload_transfer_amount(weapon_id,mag_now,reserve,instance_id = ""):
    if not weapon_defs.has(weapon_id):
        return 0
    var need = max(0,_weapon_mag_capacity(weapon_id,instance_id) - int(mag_now))
    if need <= 0 or reserve <= 0:
        return 0
    if bool(weapon_defs.get(weapon_id,{}).get("shellwise",false)):
        return min(1,min(need,reserve))
    return min(need,reserve)

func _cancel_reload():
    reload_time = 0.0
    reload_anim_duration = 0.0
    reload_weapon_id = ""
    reload_weapon_instance_id = ""
    reload_shellwise = false

func _can_reload_weapon(weapon_id,instance_id = ""):
    var iid = _resolve_weapon_instance(weapon_id,instance_id)
    if not weapon_defs.has(weapon_id) or not _inventory_has_weapon_instance(iid,weapon_id):
        return false
    var weapon = weapon_defs[weapon_id]
    var mag_now = _weapon_mag_value(weapon_id,iid)
    var mag_size = _weapon_mag_capacity(weapon_id,iid)
    var ammo_id = str(weapon.get("ammo",""))
    return mag_now < mag_size and _inventory_count(ammo_id) > 0

func _reload_block_reason(weapon_id,instance_id = ""):
    if inventory_open:
        return "Закройте инвентарь"
    if equipped_melee_id != "":
        return "Выбрано оружие ближнего боя"
    if weapon_cycle_time > 0.0 and weapon_cycle_weapon_id == weapon_id:
        return "Механика оружия ещё в движении"
    if not weapon_defs.has(weapon_id):
        return "Неизвестное оружие"
    var iid = _resolve_weapon_instance(weapon_id,instance_id)
    if not _inventory_has_weapon_instance(iid,weapon_id):
        return "Оружия нет в рюкзаке"
    var weapon = weapon_defs[weapon_id]
    var mag_now = _weapon_mag_value(weapon_id,iid)
    var mag_size = _weapon_mag_capacity(weapon_id,iid)
    var ammo_id = str(weapon.get("ammo",""))
    var reserve = _inventory_count(ammo_id)
    if mag_now >= mag_size:
        return "Магазин полный"
    if reserve <= 0:
        return "Нет патронов: %s" % str(item_defs.get(ammo_id,{}).get("name",ammo_id))
    return ""

func _owned_firearm_except(exclude_id):
    for weapon_id in FIREARM_IDS:
        if weapon_id != exclude_id and _inventory_has_item(weapon_id):
            return weapon_id
    return ""

func _owned_firearm_instance_except(exclude_instance_id):
    _ensure_runtime_item_instance_ids()
    for entry in inventory_entries:
        var weapon_id = str(entry.get("id",""))
        var iid = str(entry.get("instance_id",""))
        if weapon_defs.has(weapon_id) and iid != "" and iid != str(exclude_instance_id):
            return {"weapon_id":weapon_id,"instance_id":iid}
    return {}

func _owned_melee_except(exclude_id):
    for melee_id in ["combat_knife","steel_pipe","fire_axe"]:
        if melee_id != exclude_id and _inventory_has_item(melee_id):
            return melee_id
    return ""

func _prepare_item_for_drop(id,instance_id = ""):
    _ensure_runtime_item_instance_ids()
    _ensure_weapon_runtime_state(false)
    if weapon_defs.has(id):
        var leaving_iid = str(instance_id)
        if leaving_iid == "":
            leaving_iid = _find_inventory_weapon_instance(id)
        # A non-active duplicate can leave without disturbing the gun in hand.
        if leaving_iid != current_weapon_instance_id:
            return true
        var fallback = _owned_firearm_instance_except(leaving_iid)
        if not fallback.is_empty():
            return _switch_weapon(str(fallback.get("weapon_id","")),str(fallback.get("instance_id","")))
        var fallback_melee = _owned_melee_except("")
        if fallback_melee != "":
            _switch_melee(fallback_melee)
            return true
        return false

    # Melee selection is still type-based; retain the existing last-weapon rule.
    if _inventory_count(id) > 1:
        return true
    if id == equipped_melee_id:
        var other_melee = _owned_melee_except(id)
        if other_melee != "":
            _switch_melee(other_melee)
            return true
        var other_firearm = _owned_firearm_instance_except("")
        if not other_firearm.is_empty():
            return _switch_weapon(str(other_firearm.get("weapon_id","")),str(other_firearm.get("instance_id","")))
        return false
    return true

func _start_reload():
    _ensure_weapon_runtime_state(false)
    if reload_time > 0.0:
        return
    var iid = _find_inventory_weapon_instance(current_weapon_id,current_weapon_instance_id)
    var reason = _reload_block_reason(current_weapon_id,iid)
    if reason != "":
        reload_feedback = reason
        reload_feedback_time = 1.8
        return
    reload_feedback = ""
    reload_weapon_id = current_weapon_id
    reload_weapon_instance_id = iid
    reload_shellwise = bool(weapon_defs.get(reload_weapon_id,{}).get("shellwise",false))
    reload_time = _reload_duration_for_weapon(reload_weapon_id)
    reload_anim_duration = reload_time
    _play_weapon_reload_audio(reload_weapon_id)

func _finish_reload():
    var weapon_id = reload_weapon_id
    var iid = reload_weapon_instance_id
    if weapon_id == "" or not weapon_defs.has(weapon_id) or not _inventory_has_weapon_instance(iid,weapon_id):
        _cancel_reload()
        return
    # Switching even to a second copy of the same model cancels this reload.
    if current_weapon_id != weapon_id or current_weapon_instance_id != iid or equipped_melee_id != "":
        _cancel_reload()
        return
    var weapon = weapon_defs[weapon_id]
    var mag_now = _weapon_mag_value(weapon_id,iid)
    var ammo_id = str(weapon.get("ammo",""))
    var reserve = _inventory_count(ammo_id)
    var moved = _reload_transfer_amount(weapon_id,mag_now,reserve,iid)
    if moved <= 0:
        _cancel_reload()
        return
    if not _consume_inventory_item(ammo_id,moved):
        _cancel_reload()
        return
    _set_weapon_mag_value(weapon_id,mag_now + moved,iid)
    reload_feedback = "Перезаряжено: %d/%d" % [_weapon_mag_value(weapon_id,iid),_weapon_mag_capacity(weapon_id,iid)]
    reload_feedback_time = 1.2
    _refresh_inventory_ui()
    if reload_shellwise and _can_reload_weapon(weapon_id,iid):
        reload_time = _reload_duration_for_weapon(weapon_id)
        reload_anim_duration = reload_time
        _play_weapon_reload_audio(weapon_id)
        return
    _cancel_reload()

func _start_bleeding():
    if bleeding:
        return
    bleeding = true
    bleed_damage_taken = 0.0

func _stop_bleeding():
    bleeding = false
    bleed_damage_taken = 0.0



func _quick_bandage():
    if _inventory_count("bandage") > 0:
        if not bleeding and health >= 98.0:
            return

        if _consume_inventory_item("bandage",1):
            _stop_bleeding()
            health = min(100.0,health + 6.0)
            pain = max(0.0,pain - 8.0)
            _stabilize_worst_injury(2.5)
            stamina = min(_survival_stamina_cap(),stamina + 3.0)
            _set_survival_feedback("Бинт: кровотечение остановлено")
            _refresh_inventory_ui()
        return

    if _inventory_count("sterile_bandage") <= 0:
        return

    if _use_sterile_bandage() and _consume_inventory_item("sterile_bandage",1):
        _refresh_inventory_ui()

func _item_uses_instance_id(item_id):
    if not item_defs.has(item_id):
        return false
    return int(item_defs[item_id].get("stack",1)) <= 1

func _allocate_item_instance_id():
    var instance_id = "itm_%08d" % next_item_instance_id
    next_item_instance_id += 1
    return instance_id

func _observe_item_instance_id(instance_id):
    var text = str(instance_id)
    if not text.begins_with("itm_"):
        return
    var number = text.trim_prefix("itm_").to_int()
    if number >= next_item_instance_id:
        next_item_instance_id = number + 1

func _ensure_entries_instance_ids(entries,used_ids):
    for i in range(entries.size()):
        var entry = entries[i]
        var item_id = str(entry.get("id",""))
        if not _item_uses_instance_id(item_id):
            entry.erase("instance_id")
            entries[i] = entry
            continue

        entry["qty"] = 1
        var instance_id = str(entry.get("instance_id",""))
        if instance_id != "":
            _observe_item_instance_id(instance_id)

        if instance_id == "" or used_ids.has(instance_id):
            instance_id = _allocate_item_instance_id()
            entry["instance_id"] = instance_id

        used_ids[instance_id] = true
        entries[i] = entry

func _ensure_runtime_item_instance_ids():
    var used_ids = {}
    _ensure_entries_instance_ids(inventory_entries,used_ids)

    for key in container_states.keys():
        var state = container_states[key]
        var entries = state.get("items",[])
        _ensure_entries_instance_ids(entries,used_ids)
        state["items"] = entries
        container_states[key] = state

    for i in range(dropped_items.size()):
        var record = dropped_items[i]
        var item_id = str(record.get("id",""))
        if not _item_uses_instance_id(item_id):
            record.erase("instance_id")
            dropped_items[i] = record
            continue

        record["qty"] = 1
        var instance_id = str(record.get("instance_id",""))
        if instance_id != "":
            _observe_item_instance_id(instance_id)
        if instance_id == "" or used_ids.has(instance_id):
            instance_id = _allocate_item_instance_id()
            record["instance_id"] = instance_id
        used_ids[instance_id] = true
        dropped_items[i] = record

