func _spawn_chunk_enemies(chunk,coord,count,seed_value,encounter_profile = "standard"):
    var rng = RandomNumberGenerator.new()
    rng.seed = seed_value

    for i in range(count):
        var key = "%d:%d:%d" % [coord.x,coord.y,i]
        # Consume the same RNG sequence even for defeated IDs. A dead predecessor
        # must not change the location or archetype of every surviving enemy.
        var p = _safe_enemy_spawn(rng)
        var enemy_kind = _infected_kind_for_encounter(str(encounter_profile),rng)
        if bool(defeated.get(key,false)):
            continue
        _spawn_enemy(chunk,coord,i,p,enemy_kind)


