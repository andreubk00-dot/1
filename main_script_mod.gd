func _imported_resource_ready(source_path:String) -> bool:
    # A source PNG/WAV can exist while its Godot import product is still missing.
    # Loading it in that state creates a large recursive .ctex/.sample error storm.
    var import_cfg = ConfigFile.new()
    var cfg_err = import_cfg.load(source_path + ".import")
    if cfg_err != OK:
        return false
    var imported_path = str(import_cfg.get_value("remap","path",""))
    if imported_path == "":
        return false
    return FileAccess.file_exists(imported_path)

func _runtime_import_cache_ready() -> bool:
    # Sentinels cover inventory, world, infected animation and audio import paths.
    # Do this before _load_data(): the point is to avoid trying to load missing imports.
    for source_path in [
        "res://inventory_icons_v32.png",
        "res://loot_sprites_v30.png",
        "res://infected_walk_v12.png",
        "res://world_tiles_v10.png",
        "res://audio/weapons/makarov_shot.wav"
    ]:
        if not _imported_resource_ready(source_path):
            return false
    return true

func _show_import_not_ready_screen() -> void:
    # Minimal UI that does not depend on project textures. This is a safe fallback
    # for a project copied without .godot/imported or launched before editor import ends.
    var canvas = CanvasLayer.new()
    canvas.layer = 1000
    add_child(canvas)
    var background = ColorRect.new()
    background.color = Color(0.025,0.028,0.030,1.0)
    background.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
    canvas.add_child(background)
    var label = Label.new()
    label.text = "ИМПОРТ РЕСУРСОВ НЕ ЗАВЕРШЁН\n\nОткройте проект в Godot 4.7.2 и дождитесь 100% Importing Assets.\nПосле завершения импорта запустите игру снова.\n\nSELFTEST не запускался — ошибки ресурсов не размножаются."
    label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
    label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
    label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
    label.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
    label.offset_left = 80.0
    label.offset_top = 80.0
    label.offset_right = -80.0
    label.offset_bottom = -80.0
    background.add_child(label)
    push_warning("OSTATOK startup paused: Godot imported-resource cache is not ready; wait for editor import to finish")
    print("OSTATOK IMPORT GUARD: WAITING FOR GODOT 4.7.2 IMPORT")

