        ]
        return {"scale":0.92,"root_bias":roots[d],"grip_px":grips[d],"source_size":Vector2(16,16)}
    var roots = [
        Vector2(-1.2,0.4), Vector2(-0.8,0.9), Vector2(0.0,1.1), Vector2(0.8,0.9),
        Vector2(1.2,0.4), Vector2(0.8,-0.2), Vector2(0.0,-0.8), Vector2(-0.8,-0.2)
