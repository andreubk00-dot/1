func _input(event):
    if not inventory_open:
        return

    if event is InputEventMouseMotion:
        if inventory_drag_candidate_index >= 0 and Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT):
            if not inventory_drag_active and event.position.distance_to(inventory_drag_press_position) >= 4.0:
                _start_inventory_drag()

            if inventory_drag_active:
                _update_inventory_drag_preview(event.position)

    elif event is InputEventMouseButton:
        if event.button_index == MOUSE_BUTTON_LEFT and not event.pressed:
            if inventory_drag_active:
                _finish_inventory_drag(event.position)
                get_viewport().set_input_as_handled()
            else:
                inventory_drag_candidate_index = -1
                inventory_drag_candidate_source = ""
                inventory_drag_candidate_id = ""



func _developer_tools_available() -> bool:
    var version = str(ProjectSettings.get_setting("application/config/version",""))
    return version.find("-dev") >= 0

func _developer_pois() -> Array:
    var result = []
    for raw in RegionCatalog.POIS:
        var poi = raw.duplicate(true)
        var status = str(poi.get("status",""))
        if status == "existing" or status.begins_with("active"):
            result.append(poi)
    return result

func _developer_poi_entry_position(poi:Dictionary) -> Vector2:
    var anchor:Vector2i = poi.get("coord",Vector2i.ZERO)
    var poi_id = str(poi.get("id",""))
    for raw_off in poi.get("footprint",[Vector2i.ZERO]):
        var off:Vector2i = raw_off
        var cell = PoiCatalog.cell(poi_id,off)
        for access in cell.get("access_points",[]):
            if str(access.get("kind","")) != "entry":
                continue
            var local_pos:Vector2 = access.get("pos",Vector2(CHUNK_SIZE * 0.5,CHUNK_SIZE * 0.5))
            var inward = Vector2(CHUNK_SIZE * 0.5,CHUNK_SIZE * 0.5) - local_pos
            if inward.length() > 0.01:
                local_pos += inward.normalized() * 24.0
            var coord = anchor + off
            return Vector2(coord.x * CHUNK_SIZE,coord.y * CHUNK_SIZE) + local_pos
    return Vector2(anchor.x * CHUNK_SIZE,anchor.y * CHUNK_SIZE) + Vector2(CHUNK_SIZE * 0.5,CHUNK_SIZE * 0.5)

func _developer_teleport_to_poi(poi_id:String) -> bool:
    if not _developer_tools_available() or player == null:
        return false
    var poi = RegionCatalog.poi_by_id(poi_id)
    if poi.is_empty():
        return false
    if _high_risk_floor_active():
        _exit_high_risk_floor(false)
    _cancel_reload()
    player.velocity = Vector2.ZERO
    player.global_position = _developer_poi_entry_position(poi)
    _refresh_chunks(true)
    _close_developer_panel()
    _set_survival_feedback("DEV TELEPORT: %s" % str(poi.get("short_name",poi.get("name",poi_id))),2.4)
    return true

