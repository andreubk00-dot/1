func _entry_description(entry):
    var id = str(entry.get("id",""))
    if not item_defs.has(id):
        return id

    var item = item_defs[id]
    var text = "%s  [%s]\nКоличество: %d   Вес: %.2f кг" % [
        str(item.get("name",id)),
        _item_rarity_label(id),
        int(entry.get("qty",1)),
        _entry_total_weight(entry)
    ]

    if str(item.get("use","")) == "gear":
        text += "   [%s]" % _slot_name(str(item.get("slot","")))

    if str(item.get("category","")) == "weapon":
        var iid = str(entry.get("instance_id",""))
        text += "\nСостояние: %d%% [%s]" % [int(_weapon_condition_value(id,iid)),_weapon_condition_state(id,iid)]
        if weapon_defs.has(id):
            var firearm = weapon_defs[id]
            text += "\nУрон: %d   Магазин: %d/%d   %s" % [
                int(firearm.get("damage",0)),
                _weapon_mag_value(id,iid),
                _weapon_mag_capacity(id,iid),
                _hud_ammo_display_name(str(firearm.get("ammo","")))
            ]
            text += "\nМоды: %s" % _weapon_mod_summary(id,iid)
        text += "\nБыстрый слот: в открытом инвентаре нажмите 1–6."
    elif str(item.get("category","")) == "melee" and melee_defs.has(id):
        var melee = melee_defs[id]
        text += "\nУрон: %d   Выносливость: %d   Дистанция: %d" % [
            int(melee.get("damage",0)),
            int(melee.get("stamina",0)),
            int(melee.get("range",0))
        ]
        text += "\nБыстрый слот: в открытом инвентаре нажмите 1–6."

    if _is_water_container_item(id):
        var iid = str(entry.get("instance_id",""))
        text += "\nВода: %.2f / %.2f л" % [_water_container_fill_l(id,iid),_water_container_capacity_l(id)]
        text += "\nИСП.: пить небольшими порциями. R: перелить 0.5 л из запаса."
    elif id == "repair_kit":
        text += "\nИспользуется у верстака для обслуживания и капремонта оружия."
    elif id == "bedroll":
        text += "\nМожно разложить как переносимое место отдыха и затем свернуть обратно."

    if str(item.get("slot","")) == "rig":
        text += "\nБыстрые карманы: %d. В инвентаре: выбрать расходник и нажать 7/8." % int(item.get("quick_pockets",0))
        text += "\nПерезарядка: %d%% базового времени." % int(round(float(item.get("reload_mult",1.0)) * 100.0))

    return text

