# -------------------------------------------------------------------

func _high_risk_floor_active() -> bool:
    return high_risk_floor_index > 1 and high_risk_floor_poi_id != "" and is_instance_valid(high_risk_floor_root)

func _high_risk_floor_anchor(poi_id:String) -> Vector2i:
    var poi = RegionCatalog.poi_by_id(poi_id)
    return poi.get("coord",Vector2i(999999,999999)) if not poi.is_empty() else Vector2i(999999,999999)

func _high_risk_floor_virtual_origin(poi_id:String,floor_index:int) -> Vector2:
    # Explicit bases keep save positions deterministic across Godot versions.
    var base = Vector2(410000.0,410000.0)
    match str(poi_id):
        "quarantine_center_12":
            base = Vector2(410000.0,410000.0)
        "reserve_arsenal_bastion":
            base = Vector2(430000.0,410000.0)
        "regional_clinical_complex_4":
            base = Vector2(450000.0,410000.0)
        "underground_object_vector":
            base = Vector2(470000.0,410000.0)
        _:
            base = Vector2(490000.0,410000.0)
    return base + Vector2(0.0,float(max(0,floor_index-2)) * 1800.0)

func _high_risk_floor_save_state() -> Dictionary:
    if not _high_risk_floor_active() or player == null:
        return {}
    return {
        "poi_id":high_risk_floor_poi_id,
        "floor":high_risk_floor_index,
        "local_x":player.global_position.x - high_risk_floor_root.global_position.x,
        "local_y":player.global_position.y - high_risk_floor_root.global_position.y,
        "ground_x":high_risk_floor_ground_position.x,
        "ground_y":high_risk_floor_ground_position.y
    }

func _restore_loaded_high_risk_floor_if_needed() -> void:
    if pending_high_risk_floor_restore.is_empty() or player == null:
        return
    var state = pending_high_risk_floor_restore.duplicate(true)
    pending_high_risk_floor_restore.clear()
    var poi_id = str(state.get("poi_id",""))
    var floor_index = int(state.get("floor",1))
    if floor_index <= 1 or not HighRiskFloorCatalog.has_poi(poi_id) or HighRiskFloorCatalog.floor(poi_id,floor_index).is_empty():
        return
    var ground_pos = Vector2(float(state.get("ground_x",player.global_position.x)),float(state.get("ground_y",player.global_position.y)))
    var local_pos = Vector2(float(state.get("local_x",0.0)),float(state.get("local_y",0.0)))
    _enter_high_risk_floor(poi_id,floor_index,ground_pos,local_pos,floor_index)

func _destroy_high_risk_floor() -> void:
    if is_instance_valid(high_risk_floor_root):
        high_risk_floor_root.queue_free()
    high_risk_floor_root = null

func _exit_high_risk_floor(use_ground_position = true) -> void:
    if not _high_risk_floor_active():
        return
    var return_pos = high_risk_floor_ground_position
    _destroy_high_risk_floor()
    high_risk_floor_poi_id = ""
    high_risk_floor_index = 1
    high_risk_floor_anchor_chunk = Vector2i(999999,999999)
    if player != null and use_ground_position:
        player.velocity = Vector2.ZERO
        player.global_position = return_pos
        _refresh_chunks(true)
    high_risk_floor_ground_position = Vector2.ZERO

func _high_risk_floor_spawn_local(poi_id:String,floor_index:int,from_floor:int) -> Vector2:
    var data = HighRiskFloorCatalog.floor(poi_id,floor_index)
    var size:Vector2 = data.get("size",Vector2(980,680))
    if from_floor > floor_index:
        return Vector2(0.0,-size.y*0.31)
    return Vector2(0.0,size.y*0.31)

func _enter_high_risk_floor(poi_id:String,floor_index:int,ground_position = Vector2.ZERO,forced_local_position = Vector2(999999,999999),from_floor = 1) -> bool:
    if player == null or not HighRiskFloorCatalog.has_poi(poi_id):
        return false
    var floor_data = HighRiskFloorCatalog.floor(poi_id,floor_index)
    if floor_data.is_empty():
        return false
    var was_active = _high_risk_floor_active()
    if not was_active:
        high_risk_floor_ground_position = ground_position if ground_position != Vector2.ZERO else player.global_position
    elif ground_position != Vector2.ZERO:
        high_risk_floor_ground_position = ground_position
    _destroy_high_risk_floor()

    high_risk_floor_poi_id = poi_id
    high_risk_floor_index = floor_index
    high_risk_floor_anchor_chunk = _high_risk_floor_anchor(poi_id)
    high_risk_floor_root = Node2D.new()
    high_risk_floor_root.name = "HighRiskFloor_%s_%d" % [poi_id,floor_index]
    high_risk_floor_root.position = _high_risk_floor_virtual_origin(poi_id,floor_index)
    high_risk_floor_root.z_index = -20
    high_risk_floor_root.z_as_relative = false
    high_risk_floor_root.y_sort_enabled = true
    high_risk_floor_root.set_meta("high_risk_floor",true)
    high_risk_floor_root.set_meta("poi_id",poi_id)
    high_risk_floor_root.set_meta("floor_index",floor_index)
    add_child(high_risk_floor_root)
    _build_high_risk_floor(high_risk_floor_root,poi_id,floor_index,floor_data)

    var local_pos = forced_local_position
    if abs(local_pos.x) > 900000.0 or abs(local_pos.y) > 900000.0:
        local_pos = _high_risk_floor_spawn_local(poi_id,floor_index,int(from_floor))
    player.velocity = Vector2.ZERO
    player.global_position = high_risk_floor_root.global_position + local_pos
    var poi = RegionCatalog.poi_by_id(poi_id)
    current_poi_id = poi_id
    current_zone_id = str(RegionCatalog.chunk_profile(high_risk_floor_anchor_chunk).get("zone",current_zone_id))
    current_district_id = str(poi.get("district",current_district_id))
    _set_survival_feedback(str(floor_data.get("label","ВЕРХНИЙ ЭТАЖ")),1.8)
    return true

func _use_high_risk_floor_transition(node) -> void:
    if not is_instance_valid(node) or player == null:
        return
    var poi_id = str(node.get_meta("floor_poi_id",high_risk_floor_poi_id))
    var target_floor = int(node.get_meta("target_floor",1))
    var source_floor = int(node.get_meta("source_floor",1))
    if target_floor <= 1:
        _exit_high_risk_floor(true)
        return
    var ground_pos = high_risk_floor_ground_position
    if source_floor <= 1:
        ground_pos = node.global_position + Vector2(0,34)
    _enter_high_risk_floor(poi_id,target_floor,ground_pos,Vector2(999999,999999),source_floor)

func _create_high_risk_floor_transition(parent,pos:Vector2,poi_id:String,target_floor:int,source_floor:int,label_text:String):
    var node = Node2D.new()
    node.position = pos
    node.z_index = 12
    node.z_as_relative = false
    node.add_to_group("interactable")
    node.add_to_group("high_risk_floor_transitions")
    node.set_meta("interaction_type","floor_transition")
    node.set_meta("floor_poi_id",poi_id)
    node.set_meta("target_floor",target_floor)
    node.set_meta("source_floor",source_floor)
    node.set_meta("display_name",label_text)
    node.set_meta("interaction_radius",74.0)
    parent.add_child(node)
    _rect(Vector2.ZERO,Vector2(76,58),Color(0.10,0.12,0.115,0.92),node)
    _rect(Vector2.ZERO,Vector2(70,52),Color(0.22,0.24,0.22,0.58),node)
    _layout_stair_marks(node,Vector2(-22,15),8)
    _create_world_label(node,Vector2(-34,-22),label_text,6,Color("d8cfad"))
    return node

func _multifloor_prop(root,kind:String,pos:Vector2,scale_value = 0.55,z_value = 3):
    var sprite = _archetype_prop(root,kind,pos,scale_value,z_value)
    var collision_size = _interior_prop_collision_size(kind,scale_value)
    if collision_size != Vector2.ZERO:
        _add_static_rect(root,pos + Vector2(0,collision_size.y*0.10),collision_size)
    return sprite

func _multifloor_outer_walls(root,size:Vector2,wall_color:Color) -> void:
    _rect(Vector2(0,-size.y*0.5),Vector2(size.x+18,18),Color("111614"),root)
    _rect(Vector2(0,size.y*0.5),Vector2(size.x+18,18),Color("111614"),root)
    _rect(Vector2(-size.x*0.5,0),Vector2(18,size.y+18),Color("111614"),root)
    _rect(Vector2(size.x*0.5,0),Vector2(18,size.y+18),Color("111614"),root)
    _rect(Vector2(0,-size.y*0.5+4),Vector2(size.x,8),wall_color,root)
    _rect(Vector2(0,size.y*0.5-4),Vector2(size.x,8),wall_color.darkened(0.10),root)
    _rect(Vector2(-size.x*0.5+4,0),Vector2(8,size.y),wall_color,root)
    _rect(Vector2(size.x*0.5-4,0),Vector2(8,size.y),wall_color.darkened(0.08),root)
    _add_static_rect(root,Vector2(0,-size.y*0.5),Vector2(size.x+18,18))
    _add_static_rect(root,Vector2(0,size.y*0.5),Vector2(size.x+18,18))
    _add_static_rect(root,Vector2(-size.x*0.5,0),Vector2(18,size.y+18))
    _add_static_rect(root,Vector2(size.x*0.5,0),Vector2(18,size.y+18))

func _multifloor_add_room_label(root,pos:Vector2,text:String,color = Color("9fa997")) -> void:
    _create_world_label(root,pos,str(text).to_upper(),6,color)

func _multifloor_add_corridor_lights(root,size:Vector2,theme:String) -> void:
    var color = Color(0.95,0.72,0.42)
    if theme.begins_with("medical"):
        color = Color(0.78,0.88,0.80)
    elif theme.begins_with("quarantine"):
        color = Color(0.72,0.86,0.70)
    elif theme.begins_with("vector"):
        color = Color(0.55,0.72,0.66)
    for x in range(int(-size.x*0.36),int(size.x*0.37),170):
        _add_detail_light(root,Vector2(float(x),0),color,0.22,0.72)
    for y in [-size.y*0.27,size.y*0.27]:
        _add_detail_light(root,Vector2(0,y),color,0.18,0.62)

func _decorate_multifloor_surface(root,size:Vector2,theme:String,layout:String) -> void:
    # Layered floor language: rooms, circulation and stains remain legible even
    # when the camera is pulled back for a large high-risk interior.
    var corridor = Color(0.30,0.31,0.28,0.22)
    var room_tint = Color(0.40,0.42,0.38,0.10)
    var accent = Color(0.74,0.68,0.40,0.28)
    if theme.begins_with("medical"):
        corridor = Color(0.58,0.68,0.64,0.13)
        room_tint = Color(0.72,0.78,0.72,0.08)
        accent = Color(0.72,0.18,0.16,0.28)
    elif theme.begins_with("quarantine"):
        corridor = Color(0.42,0.55,0.47,0.16)
        room_tint = Color(0.52,0.62,0.54,0.08)
        accent = Color(0.78,0.61,0.18,0.30)
    elif theme.begins_with("military"):
        corridor = Color(0.31,0.34,0.27,0.22)
        room_tint = Color(0.38,0.40,0.31,0.10)
        accent = Color(0.82,0.64,0.18,0.30)
    elif theme.begins_with("vector"):
        corridor = Color(0.22,0.31,0.29,0.28)
        room_tint = Color(0.26,0.36,0.33,0.12)
        accent = Color(0.70,0.54,0.16,0.30)

    var c1 = _rect(Vector2.ZERO,Vector2(size.x*0.16,size.y*0.90),corridor,root)
    c1.z_index = -1
    var c2 = _rect(Vector2.ZERO,Vector2(size.x*0.88,size.y*0.12),corridor,root)
    c2.z_index = -1
    for sx in [-1.0,1.0]:
        for sy in [-1.0,1.0]:
            var zone = _rect(Vector2(sx*size.x*0.31,sy*size.y*0.27),Vector2(size.x*0.30,size.y*0.30),room_tint,root)
            zone.z_index = -1

    # Direction / safety markings are deliberately sparse; they break up broad
    # floor planes without turning the interior into a bright arcade.
    for y in range(int(-size.y*0.30),int(size.y*0.31),72):
        var mark = _rect(Vector2(0,float(y)),Vector2(size.x*0.10,3),accent,root)
        mark.z_index = 0
    for x in range(int(-size.x*0.34),int(size.x*0.35),96):
        var edge_mark = _rect(Vector2(float(x),size.y*0.42),Vector2(42,3),accent.darkened(0.10),root)
        edge_mark.z_index = 0

    # Existing pixel-art decal atlas keeps damage/grime consistent with the rest
    # of OSTATOK instead of importing a second visual language.
    var seed = abs(int(hash(str(layout) + ":surface"))) + 1
    var rng = RandomNumberGenerator.new()
    rng.seed = seed
    var decal_kinds = ["floor_papers","blood_smear","newspapers_wide","scattered_bottles","rubble"]
    for i in range(18):
        var side = -1.0 if i % 2 == 0 else 1.0
        var px = side * rng.randf_range(size.x*0.24,size.x*0.43)
        var py = rng.randf_range(-size.y*0.38,size.y*0.36)
        var kind = str(decal_kinds[i % decal_kinds.size()])
        var sp = _world_prop_sprite(kind,root,Vector2(px,py),0,rng.randf_range(0.36,0.54))
        if is_instance_valid(sp):
            sp.rotation = rng.randf_range(-0.35,0.35)

func _multifloor_add_fixture_rows(root,size:Vector2,theme:String) -> void:
    # Dense but navigable edge fixtures make the large floor area feel occupied.
    if theme.begins_with("medical") or theme.begins_with("quarantine"):
        for x in [-size.x*0.42,-size.x*0.34,size.x*0.34,size.x*0.42]:
            for y in [-size.y*0.34,-size.y*0.18,size.y*0.18,size.y*0.34]:
                _multifloor_prop(root,"medical_shelf",Vector2(x,y),0.48)
    elif theme.begins_with("military"):
        for x in [-size.x*0.43,size.x*0.43]:
            for y in [-size.y*0.32,-size.y*0.16,0.0,size.y*0.16,size.y*0.32]:
                _multifloor_prop(root,"locker",Vector2(x,y),0.50)
    elif theme.begins_with("vector"):
        for x in [-size.x*0.43,size.x*0.43]:
            for y in [-size.y*0.30,-size.y*0.10,size.y*0.10,size.y*0.30]:
                _multifloor_prop(root,"filing_cabinet",Vector2(x,y),0.46)

func _multifloor_room_box(root,center:Vector2,room_size:Vector2,label_text:String,theme:String,door_side = "south") -> void:
    # Authored room pod with a real doorway. Large floors should read as buildings,
    # not as empty tiled rectangles with a few props scattered over them.
    var fill = Color(0.31,0.33,0.31,0.24)
    var wall = Color("303733")
    if theme.begins_with("medical"):
        fill = Color(0.56,0.64,0.60,0.16)
        wall = Color("53615b")
    elif theme.begins_with("quarantine"):
        fill = Color(0.42,0.53,0.46,0.18)
        wall = Color("4e5d53")
    elif theme.begins_with("military"):
        fill = Color(0.34,0.36,0.28,0.22)
        wall = Color("555b4c")
    elif theme.begins_with("vector"):
        fill = Color(0.24,0.34,0.31,0.24)
        wall = Color("46534f")
    var floor_patch = _rect(center,room_size,fill,root)
    floor_patch.z_index = -1
    var half = room_size * 0.5
    var gap = 48.0
    var thickness = 8.0
    # Three complete sides + one side split for a readable doorway.
    if door_side != "north":
        _rect(center + Vector2(0,-half.y),Vector2(room_size.x,thickness),wall,root)
        _add_static_rect(root,center + Vector2(0,-half.y),Vector2(room_size.x,thickness))
    else:
        _multifloor_partition_h(root,center.x,center.y-half.y,room_size.x,gap)
    if door_side != "south":
        _rect(center + Vector2(0,half.y),Vector2(room_size.x,thickness),wall,root)
        _add_static_rect(root,center + Vector2(0,half.y),Vector2(room_size.x,thickness))
    else:
        _multifloor_partition_h(root,center.x,center.y+half.y,room_size.x,gap)
    if door_side != "west":
        _rect(center + Vector2(-half.x,0),Vector2(thickness,room_size.y),wall,root)
        _add_static_rect(root,center + Vector2(-half.x,0),Vector2(thickness,room_size.y))
    else:
        _multifloor_partition_v(root,center.x-half.x,center.y,room_size.y,gap)
    if door_side != "east":
        _rect(center + Vector2(half.x,0),Vector2(thickness,room_size.y),wall,root)
        _add_static_rect(root,center + Vector2(half.x,0),Vector2(thickness,room_size.y))
    else:
        _multifloor_partition_v(root,center.x+half.x,center.y,room_size.y,gap)
    _multifloor_add_room_label(root,center + Vector2(-half.x+18,-half.y+20),label_text)

func _multifloor_add_corner_rooms(root,size:Vector2,theme:String,labels:Array) -> void:
    var room_size = Vector2(size.x*0.25,size.y*0.25)
    var centers = [
        Vector2(-size.x*0.31,-size.y*0.27),Vector2(size.x*0.31,-size.y*0.27),
        Vector2(-size.x*0.31,size.y*0.27),Vector2(size.x*0.31,size.y*0.27)
    ]
    var doors = ["south","south","north","north"]
    for i in range(4):
        _multifloor_room_box(root,centers[i],room_size,str(labels[i]),theme,str(doors[i]))

func _multifloor_partition_h(root,center_x:float,y:float,width:float,gap = 34.0) -> void:
    var half = max(20.0,width*0.5)
    var left_len = max(0.0,half-gap*0.5)
    if left_len > 4.0:
        var a = center_x-half+left_len*0.5
        _rect(Vector2(a,y),Vector2(left_len,7),Color("272d2a"),root)
        _add_static_rect(root,Vector2(a,y),Vector2(left_len,7))
        var b = center_x+half-left_len*0.5
        _rect(Vector2(b,y),Vector2(left_len,7),Color("272d2a"),root)
        _add_static_rect(root,Vector2(b,y),Vector2(left_len,7))

func _multifloor_partition_v(root,x:float,center_y:float,height:float,gap = 34.0) -> void:
    var half = max(20.0,height*0.5)
    var seg_len = max(0.0,half-gap*0.5)
    if seg_len > 4.0:
        var a = center_y-half+seg_len*0.5
        _rect(Vector2(x,a),Vector2(7,seg_len),Color("272d2a"),root)
        _add_static_rect(root,Vector2(x,a),Vector2(7,seg_len))
        var b = center_y+half-seg_len*0.5
        _rect(Vector2(x,b),Vector2(7,seg_len),Color("272d2a"),root)
        _add_static_rect(root,Vector2(x,b),Vector2(7,seg_len))

