    var parsed = SaveStore.read_save(load_path)
    if parsed.is_empty():
        return
    set_meta("loaded_save",true)
    var loaded_save_version = int(parsed.get("save_version",0))
    pending_high_risk_floor_restore = parsed.get("high_risk_floor",{})
    if typeof(pending_high_risk_floor_restore) != TYPE_DICTIONARY:
        pending_high_risk_floor_restore = {}

    if parsed.has("player_x") and parsed.has("player_y"):
        set_meta("loaded_player_position",Vector2(
            float(parsed["player_x"]),
            float(parsed["player_y"])
        ))

    health = float(parsed.get("health",100.0))
