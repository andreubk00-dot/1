func _high_risk_floor_enemy_positions(size:Vector2,count:int) -> Array:
    var candidates = [
        Vector2(-size.x*0.38,-size.y*0.30),Vector2(-size.x*0.18,-size.y*0.32),Vector2(size.x*0.18,-size.y*0.32),Vector2(size.x*0.38,-size.y*0.30),
        Vector2(-size.x*0.42,-size.y*0.05),Vector2(-size.x*0.17,-size.y*0.08),Vector2(size.x*0.17,-size.y*0.08),Vector2(size.x*0.42,-size.y*0.05),
        Vector2(-size.x*0.40,size.y*0.18),Vector2(-size.x*0.16,size.y*0.16),Vector2(size.x*0.16,size.y*0.16),Vector2(size.x*0.40,size.y*0.18),
        Vector2(-size.x*0.28,size.y*0.32),Vector2(size.x*0.28,size.y*0.32),Vector2(0,-size.y*0.18),Vector2(0,size.y*0.18)
    ]
    return candidates.slice(0,min(count,candidates.size()))

func _spawn_high_risk_floor_drops(root,poi_id:String,floor_index:int,anchor:Vector2i) -> void:
    for record in dropped_items:
        if str(record.get("floor_poi_id","")) != poi_id or int(record.get("floor_index",0)) != floor_index:
            continue
        var pos = Vector2(float(record.get("x",0.0)),float(record.get("y",0.0)))
        _spawn_world_item(root,anchor,str(record.get("id","")),int(record.get("qty",1)),pos-root.global_position,"",int(record.get("drop_id",-1)),str(record.get("instance_id","")))

func _build_high_risk_floor(root,poi_id:String,floor_index:int,data:Dictionary) -> void:
    var size:Vector2 = data.get("size",Vector2(1000,700))
    var theme = str(data.get("theme","medical"))
    var label = str(data.get("label","ВЕРХНИЙ ЭТАЖ"))
    var wall_color = Color("59635d")
    var backdrop = Color(0.018,0.022,0.021,1.0)
    if theme.begins_with("military"):
        wall_color = Color("555b4c")
        backdrop = Color(0.018,0.021,0.018,1.0)
    elif theme.begins_with("quarantine"):
        wall_color = Color("56645b")
        backdrop = Color(0.018,0.024,0.021,1.0)
    elif theme.begins_with("vector"):
        wall_color = Color("46534f")
        backdrop = Color(0.012,0.017,0.016,1.0)

    _rect(Vector2.ZERO,size+Vector2(220,180),backdrop,root).z_index = -10
    _rect(Vector2.ZERO,size,Color(0.15,0.17,0.16,1.0),root).z_index = -5
    var floor_material_key = "БОЛЬНИЦА"
    if theme.begins_with("military"):
        floor_material_key = "ВОЕННЫЙ СКЛАД"
    elif theme.begins_with("vector"):
        floor_material_key = "ЭНЕРГОБЛОК"
    _interior_floor_sprite(root,floor_material_key,size)
    _decorate_multifloor_surface(root,size,theme,str(data.get("layout","")))
    _multifloor_outer_walls(root,size,wall_color)
    _create_world_label(root,Vector2(-size.x*0.5+30,-size.y*0.5+30),label,11,Color("d8d0b2"))
    _create_world_label(root,Vector2(-size.x*0.5+30,-size.y*0.5+50),"HIGH-RISK • %s" % str(RegionCatalog.poi_by_id(poi_id).get("short_name",poi_id)),6,Color("879287"))

    match str(data.get("layout","")):
        "clinical_wards": _build_multifloor_clinical_wards(root,size)
        "clinical_surgery": _build_multifloor_clinical_surgery(root,size)
        "quarantine_isolation": _build_multifloor_quarantine_isolation(root,size)
        "quarantine_labs": _build_multifloor_quarantine_labs(root,size)
        "bastion_mezzanine": _build_multifloor_bastion_mezzanine(root,size)
        "bastion_command": _build_multifloor_bastion_command(root,size)
        "vector_engineering": _build_multifloor_vector_engineering(root,size)
        "vector_deep_core": _build_multifloor_vector_core(root,size)

    _multifloor_add_fixture_rows(root,size,theme)
    _multifloor_add_corridor_lights(root,size,theme)
    var down_label = "СПУСК • 1 ЭТАЖ" if floor_index == 2 else ("СПУСК • %d ЭТАЖ" % (floor_index-1))
    if poi_id == "underground_object_vector":
        down_label = "ПОДЪЁМ К ВЫХОДУ" if floor_index == 2 else "ПОДЪЁМ • ГЛУБИНА -%d" % (floor_index-1)
    _create_high_risk_floor_transition(root,Vector2(0,size.y*0.40),poi_id,floor_index-1,floor_index,down_label)
    if floor_index < HighRiskFloorCatalog.max_floor(poi_id):
        var up_label = "ЛЕСТНИЦА • %d ЭТАЖ" % (floor_index+1)
        if poi_id == "underground_object_vector":
            up_label = "СПУСК • ГЛУБИНА -%d" % (floor_index+1)
        _create_high_risk_floor_transition(root,Vector2(0,-size.y*0.40),poi_id,floor_index+1,floor_index,up_label)

    var anchor = _high_risk_floor_anchor(poi_id)
    for container in data.get("containers",[]):
        var cid = "mf_%s_f%d_%s" % [poi_id,floor_index,str(container.get("id","cache"))]
        _create_container(root,anchor,container.get("pos",Vector2.ZERO),cid,str(container.get("loot","residential")),str(container.get("name","Запасы")))

    var count = int(data.get("enemy_count",0))
    var profile = str(data.get("enemy_profile","high_interior"))
    var rng = RandomNumberGenerator.new()
    rng.seed = abs(int(hash("%s:%d" % [poi_id,floor_index]))) + 1
    var enemy_positions = _high_risk_floor_enemy_positions(size,count)
    for i in range(enemy_positions.size()):
        var spawn_id = 2000 + floor_index*100 + i
        var key = "%d:%d:%d" % [anchor.x,anchor.y,spawn_id]
        var kind = _infected_kind_for_encounter(profile,rng)
        if not bool(defeated.get(key,false)):
            _spawn_enemy(root,anchor,spawn_id,enemy_positions[i],kind)
    _spawn_high_risk_floor_drops(root,poi_id,floor_index,anchor)

func _hr_visual_override(specs:Array,index:int,pos:Vector2,size:Vector2,sign_text = "",archetype_text = "") -> void:
    if index < 0 or index >= specs.size():
        return
    specs[index]["pos"] = pos
    specs[index]["size"] = size
    if str(sign_text) != "":
        specs[index]["sign"] = str(sign_text)
    if str(archetype_text) != "":
        specs[index]["archetype"] = str(archetype_text)

