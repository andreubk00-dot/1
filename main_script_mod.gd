func _decorate_street_furniture(chunk,coord):
    # 1.15 encounter scenes intentionally replace generic verge clutter so their
    # silhouettes remain readable and nothing spawns through event props.
    if chunk != null and chunk.has_meta("world_event_id"):
        chunk.set_meta("street_furniture_count",0)
        return
    if chunk != null and chunk.has_meta("faction_settlement"):
        chunk.set_meta("street_furniture_count",0)
        return
    # 0.87: visual-only street dressing on the free verges beside the vertical
    # sidewalks (x 258..272 / 496..510 are never used by building plots).
    # No collision, and every slot keeps clear of doors and buildings.
    var district_id = str(_chunk_profile(coord).get("district_id",""))
    var rng = RandomNumberGenerator.new()
    rng.seed = int(abs(coord.x*91813 + coord.y*27361 + 5099)) + 1
    var kinds = ["bench","el_cabinets","planter","notice_board","bus_stop","bollards","dumpster"]
    if district_id.find("industrial") >= 0 or district_id == "rail_corridor":
        kinds = ["el_cabinets","tires","dumpster","bollards"]
    elif district_id.find("rural") >= 0 or district_id.find("dacha") >= 0 or district_id.find("woodland") >= 0:
        kinds = ["bench","tires","notice_board","planter"]
    elif district_id.find("military") >= 0:
        kinds = ["el_cabinets","bollards","dumpster"]
    var slots = [
        Vector2(264,72),Vector2(264,196),Vector2(264,588),Vector2(264,700),
        Vector2(504,88),Vector2(504,204),Vector2(504,576),Vector2(504,690)
    ]
    var wanted = rng.randi_range(2,4)
    var placed = 0
    var used = {}
    for attempt in range(12):
        if placed >= wanted:
            break
        var slot_index = rng.randi_range(0,slots.size() - 1)
        if used.has(slot_index):
            continue
        used[slot_index] = true
        var slot = slots[slot_index]
        if _tree_blocks_door_swing(chunk,slot) or _tree_overlaps_building(chunk,slot):
            continue
        _street_furniture_sprite(kinds[rng.randi_range(0,kinds.size() - 1)],chunk,slot,5)
        placed += 1
    chunk.set_meta("street_furniture_count",placed)
    _scatter_vegetation(chunk,coord,district_id)

