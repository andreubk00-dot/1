    if bool(defeated.get(key,false)):
        return null
    return _spawn_enemy(chunk,coord,spawn_id,pos,kind)

func _build_world_event(chunk,coord:Vector2i,profile:Dictionary,event:Dictionary) -> bool:
    if event.is_empty() or _chunk_has_player_base(coord):
        return false
    var center = _world_event_anchor(chunk,event,coord)
    if center.x < -9000.0:
        return false
    var event_id = str(event.get("id",""))
    var zone = str(profile.get("zone","residential"))
    var risk = int(profile.get("risk",2))
    var size:Vector2 = event.get("footprint",Vector2(140,96))
    var root = Node2D.new()
    root.name = "WorldEvent_%s" % event_id
    root.position = center
    root.z_index = 5
    root.z_as_relative = false
    root.set_meta("world_event_root",true)
    root.set_meta("world_event_id",event_id)
    root.set_meta("world_event_label",str(event.get("label",event_id)))
    root.set_meta("world_event_footprint",size)
    if bool(event.get("supply_event",false)):
        root.set_meta("supply_event",true)
        root.set_meta("supply_event_id",str(event.get("dynamic_event_id","")))
        root.set_meta("faction_id",str(event.get("faction","")))
        root.set_meta("supply_event_stage",str(event.get("stage","distress")))
    root.add_to_group("world_events")
    chunk.add_child(root)
    chunk.set_meta("world_event_id",event_id)
    chunk.set_meta("world_event_label",str(event.get("label",event_id)))

    match event_id:
        "supply_convoy":
            _build_supply_convoy_scene(root,coord,event)
        "abandoned_camp":
            _event_prop(root,"campfire",Vector2(-18,4),0.72,4)
            _event_prop(root,"old_mattress",Vector2(30,18),0.52,3)
            _event_prop(root,"gas_can",Vector2(50,-12),0.45,4)
            _event_prop(root,"rain_collector",Vector2(-54,-8),0.54,4)
            _event_prop(root,"wooden_debris",Vector2(6,34),0.42,2)
        "failed_evacuation":
            _event_prop(root,"stretcher",Vector2(-30,5),0.58,4)
            _event_prop(root,"med_supply_stack",Vector2(33,-8),0.50,4)
            _event_prop(root,"blood_smear",Vector2(8,22),0.62,1)
            _event_prop(root,"traffic_cone",Vector2(58,22),0.48,4)
            _event_prop(root,"road_barrier",Vector2(-60,-20),0.54,4)
        "repair_breakdown":
            _event_prop(root,"generator",Vector2(-28,2),0.58,4)
            _event_prop(root,"tool_case",Vector2(32,12),0.54,4)
            _event_prop(root,"gas_can",Vector2(54,-14),0.46,4)
            _event_prop(root,"cardboard_boxes",Vector2(12,-28),0.44,3)
            _event_prop(root,"traffic_cone",Vector2(-58,24),0.46,4)
        "looted_convoy":
            _event_prop(root,"ammo_crate",Vector2(44,18),0.54,4)
            _event_prop(root,"sandbags",Vector2(-42,20),0.62,4)
            _event_prop(root,"blood_pool_large",Vector2(8,18),0.56,1)
            _event_prop(root,"road_barrier",Vector2(-62,-24),0.58,4)
            var truck = _poi_set_piece(root,"army_truck",Vector2(22,-12),Vector2(104,26),5,EncounterCatalog._hash(coord,83) % 2 == 0)
            if is_instance_valid(truck):
                truck.set_meta("event_piece",true)
        "feeding_site":
            _event_prop(root,"blood_pool_large",Vector2(0,12),0.70,1)
            _event_prop(root,"tipped_chair",Vector2(-34,-8),0.50,3)
            _event_prop(root,"scattered_bottles",Vector2(38,16),0.48,2)
            _event_prop(root,"newspapers_wide",Vector2(10,-24),0.46,2)

    var loot_profile = EncounterCatalog.loot_profile(event,zone)
    if loot_profile != "" and _loot_profile_risk(loot_profile) <= risk:
        _create_container(chunk,coord,center + Vector2(0,28),"event_%s_cache" % event_id,loot_profile,str(event.get("label","Запасы")))

    var enemy_count = int(event.get("enemy_count",0))
    var enemy_offsets = [Vector2(-82,-52),Vector2(86,-42),Vector2(-74,62),Vector2(78,62),Vector2(0,-76),Vector2(-104,8)]
    var dynamic_id = str(event.get("dynamic_event_id",""))
    var spawn_base = 1100 + (EncounterCatalog._hash(coord,101) % 200) * 10
    if bool(event.get("supply_event",false)):
        spawn_base = 4000 + (absi(dynamic_id.hash()) % 50000) * 10
    for i in range(enemy_count):
        var kind = "normal"
        if bool(event.get("supply_event",false)):
            var severity = int(event.get("severity",1))
            if severity >= 2 and i == enemy_count - 1:
                kind = "runner"
        elif risk >= 4 and i == enemy_count - 1 and event_id in ["looted_convoy","feeding_site"]:
            kind = "runner"
        var enemy = _spawn_world_event_enemy(chunk,coord,spawn_base + i,center + enemy_offsets[i % enemy_offsets.size()],kind)
        if is_instance_valid(enemy) and bool(event.get("supply_event",false)):
            enemy.set_meta("supply_event_id",dynamic_id)
    return true

func _build_procedural_chunk(chunk,coord):
    var rng = RandomNumberGenerator.new()
    rng.seed = int(abs(coord.x*73856093 + coord.y*19349663 + 5517)) + 1

    var profile = _chunk_profile(coord)
    var zone = str(profile.get("zone","residential"))
    var is_legacy = bool(profile.get("legacy",false))
    var preserve_082_layout = bool(legacy_building_layout_chunks.get(_zone_chunk_key(coord),false))
    var poi = profile.get("poi",{})
    var poi_kind = str(poi.get("kind",""))
    var poi_id = str(profile.get("poi_id",""))
    var authored_poi = false
    var authored_cell = {}

    # 0.85 major POIs are authored compounds spanning several chunks.  Base chunks
    # from older saves deliberately bypass this path so player-built furniture never
    # ends up inside moved walls.
    if not is_legacy and not preserve_082_layout and PoiCatalog.has_compound(poi_id):
        authored_cell = PoiCatalog.cell(poi_id,poi.get("cell_offset",Vector2i.ZERO))
        authored_poi = _build_major_poi_chunk(chunk,coord,profile)

    if not authored_poi:
        var colors = [
            Color("4c4942"),
            Color("564b43"),
            Color("414943"),
            Color("514d45")
        ]
        var slots = _building_slots_for_chunk(coord,profile,preserve_082_layout)

        # Old explored chunks retain the exact legacy density. New territory reads
        # density from its macro-district profile. Non-authored POI cells remain a
        # little denser so their approach still reads as important.
        var build_chance = _zone_build_chance(zone) if is_legacy else float(profile.get("density",_zone_build_chance(zone)))
        if not poi.is_empty() and not is_legacy:
            build_chance = max(build_chance,0.92)

        for i in range(slots.size()):
            var legacy_container_key = "%d:%d:container:cache_%d" % [coord.x,coord.y,i]
            var should_build = rng.randf() <= build_chance

            # If this chunk was visited in an older save, preserve every building
            # whose container state already exists.
            if container_states.has(legacy_container_key):
                should_build = true

            if not should_build:
                continue

            var size = Vector2.ZERO
            var sign_text = ""
            var wall_color = Color("4c4942")
            var loot_table = "residential"
            var archetype_id = "legacy"
            var archetype_data = {}

            if is_legacy:
                # Exact legacy ranges/order protect already-explored saves.
                size = Vector2(
                    rng.randi_range(145,210),
                    rng.randi_range(105,150)
                )
                sign_text = _zone_building_name(zone,i)
                wall_color = colors[rng.randi_range(0,colors.size()-1)]
                loot_table = _zone_loot_table(zone,i)
            else:
                var building_set = str(profile.get("building_set","mixed_residential"))
                archetype_data = BuildingCatalog.archetype(building_set,i,poi_kind)
                archetype_id = str(archetype_data.get("id","utility_house"))
                var min_size = archetype_data.get("size_min",Vector2(145,105))
                var max_size = archetype_data.get("size_max",Vector2(210,150))
                if preserve_082_layout:
                    var legacy_size = BuildingCatalog.legacy_082_size(archetype_id)
                    min_size = legacy_size[0]
                    max_size = legacy_size[1]
                    size = Vector2(
                        rng.randi_range(int(min_size.x),int(min(float(max_size.x),210.0))),
                        rng.randi_range(int(min_size.y),int(min(float(max_size.y),150.0)))
                    )
                else:
                    size = Vector2(
                        rng.randi_range(int(min_size.x),int(min(float(max_size.x),246.0))),
                        rng.randi_range(int(min_size.y),int(min(float(max_size.y),184.0)))
                    )
                sign_text = str(archetype_data.get("sign","ДОМ"))
                wall_color = archetype_data.get("color",colors[rng.randi_range(0,colors.size()-1)])
                loot_table = str(archetype_data.get("loot",_zone_loot_table(zone,i)))

            var center = slots[i].get("pos",_legacy_building_anchors()[i])
            if not is_legacy and not preserve_082_layout:
                var slot_scale = slots[i].get("scale",Vector2.ONE)
                size = _fit_procedural_building_size(Vector2(size.x * slot_scale.x,size.y * slot_scale.y))
                center = _fit_procedural_building_center(center,size)

            var id = "building_%d" % i

            var building_node = _create_building(
                chunk,
                coord,
                id,
                center,
                size,
                sign_text,
                wall_color,
                true,
                archetype_id if (not is_legacy and not preserve_082_layout) else "",
                archetype_data
            )

            var container_offset = Vector2(0,5)
            if not is_legacy and not preserve_082_layout:
                container_offset = archetype_data.get("container_offset",Vector2(0,5))
            _create_container(
                chunk,
                coord,
                center + container_offset,
                "cache_%d" % i,
                loot_table,
                "%s • %s" % [sign_text,_district_display_name(str(profile.get("district_id","")))]
            )

            # Metadata is intentionally attached without changing save keys. Future
            # room/base/NPC systems can query archetype semantics from the building node.
            if not is_legacy and is_instance_valid(building_node):
                building_node.set_meta("world_archetype",archetype_id)
                building_node.set_meta("layout_profile","legacy_082" if preserve_082_layout else str(archetype_data.get("layout","utility")))
                building_node.set_meta("facade_profile",str(archetype_data.get("facade","utility")))
                building_node.set_meta("yard_profile",str(archetype_data.get("yard","")))
                var gameplay_profile = BuildingCatalog.gameplay_profile(archetype_id)
                building_node.set_meta("location_tags",gameplay_profile.get("tags",[]))
                building_node.set_meta("utility_hooks",gameplay_profile.get("utility_hooks",[]))
                building_node.set_meta("shelter_score",int(gameplay_profile.get("shelter_score",1)))
                building_node.set_meta("district_id",str(profile.get("district_id","")))
                building_node.set_meta("poi_id",str(profile.get("poi_id","")))
                building_node.set_meta("loot_profile",loot_table)

        if zone == "industrial":
            _create_workbench(chunk,Vector2(165,590))
            _create_barrel(chunk,Vector2(225,548))
            _create_barrel(chunk,Vector2(625,246))
            _create_fence(chunk,Vector2(118,268),110)

        elif zone == "military":
            _create_fence(chunk,Vector2(160,270),150)
            _create_fence(chunk,Vector2(548,516),140)
            _create_barrel(chunk,Vector2(210,250))
            _create_barrel(chunk,Vector2(618,535))
            _create_world_label(
                chunk,
                Vector2(450,278),
                "ОГРАНИЧЕННАЯ ЗОНА",
                7,
                Color("a66a55")
            )

        elif zone == "woodland":
            _create_world_label(
                chunk,
                Vector2(40,40),
                "ЛЕСОПОЛОСА",
                7,
                Color("879575")
            )

        elif zone == "rural":
            _create_fence(chunk,Vector2(118,278),92)

        elif zone == "commercial":
            _create_lamp(chunk,Vector2(275,304))
            _create_lamp(chunk,Vector2(520,493))

        if not is_legacy:
            _decorate_region_identity(chunk,coord,profile)

    var car_colors = [
        Color("46535a"),
        Color("654039"),
        Color("555247"),
        Color("3e4c45")
    ]

    var car_count = _zone_car_count(zone,rng)
    var tree_count = _zone_tree_count(zone,rng)
    var enemy_count = _zone_enemy_count(zone,rng)
    if not is_legacy:
        car_count = max(0,int(round(float(car_count) * float(profile.get("car_mult",1.0)))))
        tree_count = max(0,int(round(float(tree_count) * float(profile.get("tree_mult",1.0)))))
        enemy_count = max(1,int(round(float(enemy_count) * float(profile.get("enemy_mult",1.0)))))
    if authored_poi:
        car_count = max(0,int(round(float(car_count) * float(authored_cell.get("car_mult",1.0)))))
        tree_count = max(0,int(round(float(tree_count) * float(authored_cell.get("tree_mult",1.0)))))
        enemy_count = max(0,int(round(float(enemy_count) * float(authored_cell.get("enemy_mult",1.0)))))
        if authored_cell.has("enemy_count"):
            enemy_count = max(0,int(authored_cell.get("enemy_count",enemy_count)))

    var world_event = {}
    if not authored_poi and not is_legacy and not preserve_082_layout and not _chunk_has_player_base(coord):
        world_event = SupplyEventSystem.runtime_event_for_chunk(faction_state,coord,world_day)
        if world_event.is_empty():
            world_event = EncounterCatalog.event_for(coord,zone,int(profile.get("risk",2)),poi_id)
        if not world_event.is_empty():
            if not _build_world_event(chunk,coord,profile,world_event):
                world_event = {}

    for i in range(car_count):
        var car_pos = Vector2(-9999,-9999)
        # Cars used to be placed by raw random coordinates. In dense authored POIs
        # that could stack two vehicles or park one through a building/set piece.
        # Keep the same road/yard band, but accept only a physically clear footprint.
        for attempt in range(12):
            var candidate = Vector2(rng.randi_range(130,650),rng.randi_range(315,455))
            if _car_spot_free(chunk,candidate):
                car_pos = candidate
                break
        if car_pos.x < -9000.0:
            continue
        _create_car(
            chunk,
            car_pos,
            car_colors[rng.randi_range(0,car_colors.size()-1)],
            rng.randf_range(-0.15,0.15)
        )

    for i in range(tree_count):
        var tree_pos = _safe_tree_position(chunk,rng)
        if tree_pos.x > -9000.0:
            _create_tree(
                chunk,
                tree_pos,
                rng.randf_range(0.75,1.18)
            )

    if not authored_poi and world_event.is_empty():
        _decorate_zone_street_art(chunk,zone,coord)
    if world_event.is_empty() and not bool(authored_cell.get("safe_settlement",false)):
        _spawn_zone_ground_loot(chunk,coord,zone,rng)
    _spawn_chunk_enemies(
        chunk,
        coord,
        enemy_count,
        int(rng.seed) + 701,
        str(authored_cell.get("enemy_profile","standard")) if authored_poi else "standard"
    )

func _decorate_region_identity(chunk,coord,profile):
    # 0.82 deliberately uses small physical signs/landmarks instead of a map UI.
    # They make contiguous districts readable while keeping the world diegetic.
    var district_name = str(profile.get("name",""))
    var poi = profile.get("poi",{})
    if not poi.is_empty():
        _create_world_label(chunk,Vector2(300,272),str(poi.get("short_name",poi.get("name","ОБЪЕКТ"))),8,Color("c4b77f"))
        var kind = str(poi.get("kind",""))
        if kind == "garage_coop":
            _world_prop_sprite("road_barrier",chunk,Vector2(358,296),4,0.62)
            _world_prop_sprite("gas_can",chunk,Vector2(394,310),3,0.48)
        elif kind == "factory_complex" or kind == "rail_depot":
            _world_prop_sprite("road_sign",chunk,Vector2(355,292),4,0.64)
            _world_prop_sprite("generator",chunk,Vector2(405,314),4,0.52)
        elif kind == "dacha_coop":
            _world_prop_sprite("wooden_debris",chunk,Vector2(360,302),2,0.46)
        elif kind == "military_checkpoint" or kind == "arsenal_dungeon":
            _world_prop_sprite("sandbags",chunk,Vector2(350,292),5,0.72)
            _world_prop_sprite("road_barrier",chunk,Vector2(410,300),4,0.62)
        elif kind == "quarantine_dungeon":
            _world_prop_sprite("road_barrier",chunk,Vector2(358,296),4,0.62)
            _world_prop_sprite("traffic_cone",chunk,Vector2(410,304),4,0.50)
        elif kind == "medical_endgame_dungeon":
            _world_prop_sprite("stretcher",chunk,Vector2(356,300),4,0.54)
            _world_prop_sprite("wheelchair",chunk,Vector2(408,306),4,0.48)
        elif kind == "underground_endgame_dungeon":
            _world_prop_sprite("generator_prop",chunk,Vector2(356,300),4,0.54)
            _world_prop_sprite("road_barrier",chunk,Vector2(410,304),4,0.54)
        return

    # Sparse district markers only on deterministic boundary-like chunks.
    if (abs(coord.x * 31 + coord.y * 17) % 5) == 0:
        _create_world_label(chunk,Vector2(42,286),district_name,6,Color("8f9686"))



func _layout_wall_h(root,y,width,gap_x = 0.0,gap = 28.0):
    var half_w = max(20.0,float(width) * 0.5)
    var left_edge = -half_w
    var right_edge = half_w
    var gap_left = clamp(float(gap_x) - float(gap) * 0.5,left_edge + 8.0,right_edge - 8.0)
    var gap_right = clamp(float(gap_x) + float(gap) * 0.5,left_edge + 8.0,right_edge - 8.0)
    var left_len = max(0.0,gap_left - left_edge)
    var right_len = max(0.0,right_edge - gap_right)
    if left_len > 4.0:
        var left_pos = left_edge + left_len * 0.5
        _rect(Vector2(left_pos,y),Vector2(left_len,8),Color("242927"),root)
        _rect(Vector2(left_pos,y-2),Vector2(max(2.0,left_len-3.0),2),Color(0.36,0.37,0.33,0.55),root)
        _add_static_rect(root,Vector2(left_pos,y),Vector2(left_len,8))
    if right_len > 4.0:
        var right_pos = gap_right + right_len * 0.5
        _rect(Vector2(right_pos,y),Vector2(right_len,8),Color("242927"),root)
        _rect(Vector2(right_pos,y-2),Vector2(max(2.0,right_len-3.0),2),Color(0.36,0.37,0.33,0.55),root)
        _add_static_rect(root,Vector2(right_pos,y),Vector2(right_len,8))

func _layout_wall_v(root,x,height,gap_y = 0.0,gap = 28.0):
    var half_h = max(20.0,float(height) * 0.5)
    var top_edge = -half_h
    var bottom_edge = half_h
    var gap_top = clamp(float(gap_y) - float(gap) * 0.5,top_edge + 8.0,bottom_edge - 8.0)
    var gap_bottom = clamp(float(gap_y) + float(gap) * 0.5,top_edge + 8.0,bottom_edge - 8.0)
    var top_len = max(0.0,gap_top - top_edge)
    var bottom_len = max(0.0,bottom_edge - gap_bottom)
    if top_len > 4.0:
        var top_pos = top_edge + top_len * 0.5
        _rect(Vector2(x,top_pos),Vector2(8,top_len),Color("242927"),root)
        _rect(Vector2(x-2,top_pos),Vector2(2,max(2.0,top_len-3.0)),Color(0.36,0.37,0.33,0.55),root)
        _add_static_rect(root,Vector2(x,top_pos),Vector2(8,top_len))
    if bottom_len > 4.0:
        var bottom_pos = gap_bottom + bottom_len * 0.5
        _rect(Vector2(x,bottom_pos),Vector2(8,bottom_len),Color("242927"),root)
        _rect(Vector2(x-2,bottom_pos),Vector2(2,max(2.0,bottom_len-3.0)),Color(0.36,0.37,0.33,0.55),root)
        _add_static_rect(root,Vector2(x,bottom_pos),Vector2(8,bottom_len))

func _layout_stair_marks(root,origin,count = 5):
    for i in range(int(count)):
        _rect(origin + Vector2(i*5,-i*3),Vector2(22,3),Color(0.32,0.33,0.30,0.58),root)

func _archetype_prop(root,kind,pos,scale_value = 0.62,z_value = 3):
    var sprite = _world_prop_sprite(kind,root,pos,z_value,scale_value)
    # Archetype interiors use the same depth rules as the older authored interiors.
    # Without this group, large beds/cabinets could render flat over the player and
    # the 0.84 clinic pass also removed the last legacy props the QA relied on.
    if is_instance_valid(sprite) and _interior_prop_uses_depth(kind):
        sprite.z_as_relative = false
        sprite.z_index = 19
        sprite.add_to_group("interior_depth_props")
        var prop_region = _world_prop_region(kind)
        sprite.set_meta("depth_foot_offset",max(4.0,prop_region.size.y * scale_value * 0.30))
    return sprite

func _decorate_archetype_interior(building,archetype_id,data,size,building_id):
    if building == null:
        return
    var layout = str(data.get("layout",archetype_id))
    var inner_w = max(86.0,size.x - 30.0)
    var inner_h = max(66.0,size.y - 34.0)
    var back_y = -size.y * 0.28
    var front_y = size.y * 0.22

    match layout:
        "panel_block":
            _layout_wall_v(building,-size.x*0.20,inner_h,8.0,28.0)
            _layout_wall_v(building,size.x*0.20,inner_h,8.0,28.0)
            _layout_wall_h(building,-size.y*0.10,inner_w,0.0,30.0)
            _archetype_prop(building,"old_fridge",Vector2(-size.x*0.31,back_y),0.55)
            _archetype_prop(building,"cabinet",Vector2(size.x*0.31,back_y),0.55)
            _archetype_prop(building,"old_mattress",Vector2(-size.x*0.31,front_y-10),0.47)
            _layout_stair_marks(building,Vector2(-12,-size.y*0.28),6)
        "panel_entry":
