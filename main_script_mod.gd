# 0.94: inventory is read from actual home stashes, never generated by this screen.
func _home_supply_bounds():
    if not _has_home():
        return Rect2()
    for rec in roof_records:
        if str(rec.get("building_key","")) == str(expedition_journal["home"]["key"]):
            var rect = rec.get("rect",Rect2())
            expedition_journal["home"]["bounds"] = [rect.position.x,rect.position.y,rect.size.x,rect.size.y]
            return rect
    var bounds = expedition_journal["home"].get("bounds",[])
    if typeof(bounds) == TYPE_ARRAY and bounds.size() == 4:
        return Rect2(float(bounds[0]),float(bounds[1]),float(bounds[2]),float(bounds[3]))
    return Rect2()

func _home_stash_reachable(rec):
    if player == null or not _at_home():
        return false
    var pos = Vector2(float(rec.get("x",0.0)),float(rec.get("y",0.0)))
    if player.global_position.distance_to(pos) > 72.0:
        return false
    var ray = PhysicsRayQueryParameters2D.create(player.global_position,pos)
    ray.collision_mask = LAYER_WORLD
    ray.exclude = [player.get_rid()]
    return get_world_2d().direct_space_state.intersect_ray(ray).is_empty()

func _home_stashes(reachable_only = false):
    var result = []
    var rect = _home_supply_bounds()
    if not rect.has_area():
        return result
    var seen = {}
    for rec in base_objects:
        if str(rec.get("kind","")) != "stash":
            continue
        var pos = Vector2(float(rec.get("x",0.0)),float(rec.get("y",0.0)))
        if not rect.has_point(pos):
            continue
        var key = "base_stash_%d" % int(rec.get("id",-1))
        if seen.has(key) or not container_states.has(key):
            continue
        seen[key] = true
        if reachable_only and not _home_stash_reachable(rec):
            continue
        result.append(key)
    return result

func _home_stock_entries(reachable_only = false):
    var entries = []
    for key in _home_stashes(reachable_only):
        for entry in container_states[key].get("items",[]):
            entries.append(entry)
    return entries

func _home_supply_groups():
    var ammo_id = ""
    var capacity = 0
    if _inventory_has_item(current_weapon_id) and weapon_defs.has(current_weapon_id):
        ammo_id = str(weapon_defs[current_weapon_id].get("ammo",""))
        capacity = _weapon_mag_capacity(current_weapon_id,current_weapon_instance_id)
    var groups = SupplyPlan.groups(int(expedition_journal.get("supply_preset",0)),ammo_id,capacity)
    if ammo_id != "":
        groups[-1]["loaded"] = _weapon_mag_value(current_weapon_id,current_weapon_instance_id)
        groups[-1]["name"] = "%s • %s" % [str(item_defs[current_weapon_id].get("name",current_weapon_id)),_hud_ammo_display_name(ammo_id)]
    return groups

func _home_defense_side(pos,rect):
    if not rect.has_area():
        return ""
    var distances = {
        "север":abs(pos.y - rect.position.y),
        "юг":abs(pos.y - rect.end.y),
        "запад":abs(pos.x - rect.position.x),
        "восток":abs(pos.x - rect.end.x)
    }
    var best = "север"
    var best_distance = INF
    for side in distances:
        if float(distances[side]) < best_distance:
            best_distance = float(distances[side])
            best = str(side)
    return best

func _home_defense_element_state(condition,maximum,reinforced = false):
    var safe_max = max(1.0,float(maximum))
    var percent = clamp(float(condition) / safe_max * 100.0,0.0,100.0)
    if float(condition) <= 0.01:
        return "ПРОЛОМ"
    if percent < 35.0:
        return "КРИТИЧНО"
    if percent < 70.0:
        return "ПОВРЕЖДЕНО"
    if percent < 99.5:
        return "ОСЛАБЛЕНО"
    if reinforced:
        return "УКРЕПЛЕНО"
    return "ЦЕЛО"

func _home_defense_color(percent):
    var value = clamp(float(percent),0.0,100.0)
    if value <= 0.01:
        return Color(0.72,0.25,0.22)
    if value < 35.0:
        return Color(0.82,0.34,0.25)
    if value < 70.0:
        return Color(0.84,0.57,0.27)
    if value < 99.5:
        return Color(0.72,0.68,0.38)
    return Color(0.54,0.70,0.52)

func _home_defense_records():
    var result = []
    if not _has_home():
        return result
    var home_key = str(expedition_journal["home"].get("key",""))
    var key_parts = home_key.split(":")
    if key_parts.size() < 3:
        return result
    var coord = _home_chunk()
    var building_id = str(key_parts[2])
    var prefix = "%d:%d:" % [coord.x,coord.y]

    var door_key = prefix + "door:" + building_id
    if shelter_breach_states.has(door_key):
        var door_rec = shelter_breach_states.get(door_key,{})
        if typeof(door_rec) == TYPE_DICTIONARY:
            var door_condition = clamp(float(door_rec.get("condition",DOOR_MAX_CONDITION)),0.0,DOOR_MAX_CONDITION)
            var door_percent = door_condition / DOOR_MAX_CONDITION * 100.0
            result.append({
                "key":door_key,"kind":"door","name":"Входная дверь • южный фасад",
                "condition":door_condition,"maximum":DOOR_MAX_CONDITION,"percent":door_percent,
                "reinforced":false,"state":_home_defense_element_state(door_condition,DOOR_MAX_CONDITION),
                "sort":"0:0000"
            })

    var window_rows = []
    var window_prefix = prefix + "window:" + building_id + ":"
    for raw_key in shelter_breach_states.keys():
        var key = str(raw_key)
        if not key.begins_with(window_prefix):
            continue
        var window_rec = shelter_breach_states.get(key,{})
        if typeof(window_rec) != TYPE_DICTIONARY:
            continue
        var reinforced = bool(window_rec.get("reinforced",false))
        var maximum = _window_condition_max(window_rec)
        var condition = clamp(float(window_rec.get("condition",maximum)),0.0,maximum)
        var percent = condition / max(1.0,maximum) * 100.0
        var parts = key.split(":")
        var slot = int(parts[4]) if parts.size() > 4 else window_rows.size()
        window_rows.append({
            "key":key,"kind":"window","name":"Окно %d • южный фасад" % (slot + 1),
            "condition":condition,"maximum":maximum,"percent":percent,"reinforced":reinforced,
            "state":_home_defense_element_state(condition,maximum,reinforced),
            "sort":"1:%04d" % slot
        })
    window_rows.sort_custom(func(a,b): return str(a.get("sort","")) < str(b.get("sort","")))
    result.append_array(window_rows)

    var rect = _home_supply_bounds()
    var barricade_rows = []
    if rect.has_area():
        for base_rec in base_objects:
            if str(base_rec.get("kind","")) != "barricade":
                continue
            var pos = Vector2(float(base_rec.get("x",0.0)),float(base_rec.get("y",0.0)))
            if not rect.has_point(pos):
                continue
            var base_id = int(base_rec.get("id",-1))
            var condition = clamp(float(base_rec.get("condition",BARRICADE_MAX_CONDITION)),0.0,BARRICADE_MAX_CONDITION)
            var percent = condition / BARRICADE_MAX_CONDITION * 100.0
            barricade_rows.append({
                "key":"base:%d" % base_id,"kind":"barricade","base_id":base_id,
                "side":_home_defense_side(pos,rect),
                "condition":condition,"maximum":BARRICADE_MAX_CONDITION,"percent":percent,
                "reinforced":false,"state":_home_defense_element_state(condition,BARRICADE_MAX_CONDITION),
                "sort":"2:%08d" % max(0,base_id)
            })
    barricade_rows.sort_custom(func(a,b): return str(a.get("sort","")) < str(b.get("sort","")))
    for i in range(barricade_rows.size()):
        barricade_rows[i]["name"] = "Баррикада %d • %s" % [i + 1,str(barricade_rows[i].get("side",""))]
    result.append_array(barricade_rows)
    return result

func _home_defense_state(records = null):
    if not _has_home():
        return "ДОМ НЕ ЗАКРЕПЛЁН"
    var rows = _home_defense_records() if records == null else records
    if rows.is_empty():
        return "НЕТ ДАННЫХ"
    var weakest = 100.0
    var breaches = 0
    for rec in rows:
        var percent = clamp(float(rec.get("percent",100.0)),0.0,100.0)
        weakest = min(weakest,percent)
        if float(rec.get("condition",1.0)) <= 0.01:
            breaches += 1
    if breaches > 0:
        return "КРИТИЧЕСКОЕ • ЕСТЬ ПРОЛОМ"
    if weakest < 35.0:
        return "КРИТИЧЕСКОЕ"
    if weakest < 70.0:
        return "ТЯЖЁЛЫЕ ПОВРЕЖДЕНИЯ"
    if weakest < 99.5:
        return "ЕСТЬ ПОВРЕЖДЕНИЯ"
    return "СТАБИЛЬНО"

func _home_defense_add_row(rec):
    if home_defense_rows == null:
        return
    var row = Panel.new()
    row.custom_minimum_size = Vector2(548,20)
    row.mouse_filter = Control.MOUSE_FILTER_IGNORE
    var style = StyleBoxFlat.new()
    style.bg_color = Color(0.055,0.064,0.061,0.88)
    style.border_color = Color(0.14,0.16,0.145,0.72)
    style.border_width_bottom = 1
    style.anti_aliasing = false
    row.add_theme_stylebox_override("panel",style)
    home_defense_rows.add_child(row)

    var name_label = _hud_make_label(row,Vector2(6,4),Vector2(168,12),str(rec.get("name","Элемент")),7,Color(0.80,0.82,0.75))
    _hud_set_fitted_text(name_label,name_label.text,7,5)
    var percent = clamp(float(rec.get("percent",100.0)),0.0,100.0)
    var color = _home_defense_color(percent)
    var bar = _hud_make_bar(row,Vector2(178,6),Vector2(226,8),color,14)
    _hud_set_bar_value(bar,percent)
    var hp_text = "%d/%d" % [int(round(float(rec.get("condition",0.0)))),int(round(float(rec.get("maximum",100.0))))]
    var hp_label = _hud_make_label(row,Vector2(411,4),Vector2(61,12),hp_text,6,Color(0.88,0.86,0.76),HORIZONTAL_ALIGNMENT_RIGHT)
    var state_label = _hud_make_label(row,Vector2(477,4),Vector2(67,12),str(rec.get("state","")),6,color,HORIZONTAL_ALIGNMENT_RIGHT)
    _hud_set_fitted_text(state_label,state_label.text,6,5)
    # Labels were sized before their small-font theme existed, retaining the
    # default font's taller minimum. Fit AFTER styling to center within the row.
    for label in [name_label,hp_label,state_label]:
        label.size.y = 12.0
        label.position.y = (20.0 - label.size.y) * 0.5

func _refresh_home_defense_ui():
    if home_defense_rows == null or home_right_heading == null:
        return
    for child in home_defense_rows.get_children():
        child.free()
    var records = _home_defense_records()
    var state = _home_defense_state(records)
    var assault_state = _shelter_assault_state_text()
    var heading = "СОСТОЯНИЕ: " + state
    if assault_state != "":
        heading += " • " + assault_state
    _hud_set_fitted_text(home_right_heading,heading,7,5)
    var weakest = 100.0
    if records.is_empty():
        weakest = 45.0 if _has_home() else 0.0
    else:
        for rec in records:
            weakest = min(weakest,float(rec.get("percent",100.0)))
    home_right_heading.add_theme_color_override("font_color",_home_defense_color(weakest))
    if records.is_empty():
        var empty_label = Label.new()
        empty_label.custom_minimum_size = Vector2(540,42)
        empty_label.text = "Нет данных о точках обороны. Посетите закреплённое убежище, чтобы зарегистрировать двери и окна."
        empty_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
        empty_label.add_theme_font_size_override("font_size",8)
        empty_label.add_theme_color_override("font_color",Color(0.70,0.72,0.66))
        home_defense_rows.add_child(empty_label)
        return
    for rec in records:
        _home_defense_add_row(rec)

func _home_infrastructure_text():
    var rect = _home_supply_bounds()
    if not rect.has_area():
        return "Нет данных о здании. Посетите закреплённый дом."
    var counts = {}
    var active_heat = 0
    var longest_heat = 0.0
    var raw_water = 0.0
    var damaged_barricades = 0
    var broken_barricades = 0
    var home_doors = 0
    var damaged_doors = 0
    var breached_doors = 0
    var home_windows = 0
    var reinforced_windows = 0
    var damaged_windows = 0
    var broken_windows = 0
    for rec in base_objects:
        var kind = str(rec.get("kind",""))
        var pos = Vector2(float(rec.get("x",0.0)),float(rec.get("y",0.0)))
        var belongs = rect.has_point(pos)
        if not belongs and kind in ["campfire","rain_collector"]:
            belongs = rect.grow(64.0).has_point(pos) and not _position_is_sheltered(pos)
        if not belongs:
            continue
        counts[kind] = int(counts.get(kind,0)) + 1
        if kind == "barricade":
            var barrier_condition = clamp(float(rec.get("condition",BARRICADE_MAX_CONDITION)),0.0,BARRICADE_MAX_CONDITION)
            if barrier_condition <= 0.01:
                broken_barricades += 1
            elif barrier_condition < BARRICADE_MAX_CONDITION - 0.1:
                damaged_barricades += 1
        if kind == "rain_collector":
            raw_water += clamp(float(rec.get("stored_water",0.0)),0.0,_rain_collector_capacity())
        if kind in ["heater","campfire"] and bool(rec.get("on",false)) and float(rec.get("fuel",0.0)) > 0.0:
            active_heat += 1
            longest_heat = max(longest_heat,float(rec["fuel"]) / _base_fuel_rate(kind,pos) * day_speed)
    var benches = 0
    for node in get_tree().get_nodes_in_group("interactable"):
        if not is_instance_valid(node) or not rect.grow(24.0).has_point(node.global_position):
            continue
        var interaction_type = str(node.get_meta("interaction_type",""))
        if interaction_type == "workbench":
            benches += 1
        elif interaction_type == "door":
            home_doors += 1
            var door_condition = clamp(float(node.get_meta("door_condition",DOOR_MAX_CONDITION)),0.0,DOOR_MAX_CONDITION)
            if door_condition <= 0.01:
                breached_doors += 1
            elif door_condition < DOOR_MAX_CONDITION - 0.1:
                damaged_doors += 1
        elif interaction_type == "shelter_window":
            home_windows += 1
            var window_condition = float(node.get_meta("window_condition",WINDOW_MAX_CONDITION))
            if bool(node.get_meta("window_reinforced",false)):
                reinforced_windows += 1
            if window_condition <= 0.01:
                broken_windows += 1
            else:
                var key = str(node.get_meta("breach_key",""))
                var window_rec = shelter_breach_states.get(key,{})
                var window_max = _window_condition_max(window_rec if typeof(window_rec) == TYPE_DICTIONARY else {})
                if window_condition < window_max - 0.1:
                    damaged_windows += 1
    var lines = ["Состояние обороны: %s" % _home_defense_state(),
        "Ящики: %d • раскладушки: %d" % [int(counts.get("stash",0)),int(counts.get("cot",0))],
        "Лампы: %d • источники тепла: %d" % [int(counts.get("lamp",0)),int(counts.get("heater",0))+int(counts.get("campfire",0))],
        "Баррикады: %d • повреждено %d • сломано %d" % [int(counts.get("barricade",0)),damaged_barricades,broken_barricades],
        "Двери: %d • повреждено %d • выбито %d" % [home_doors,damaged_doors,breached_doors],
        "Окна: %d • укреплено %d • повреждено %d • проломлено %d" % [home_windows,reinforced_windows,damaged_windows,broken_windows],
        "Горят: %d • самый долгий ~%d мин" % [active_heat,int(longest_heat)],
        "Дождесборники рядом: %d • сырая вода: %.1f" % [int(counts.get("rain_collector",0)),raw_water]]
    if loaded_chunks.has(_home_chunk()) or _at_home():
        lines.append("Верстаки в здании: %d" % benches)
    else:
        lines.append("Верстак: проверьте при посещении дома.")
    if int(counts.get("stash",0)) == 0:
        lines.append("Нужен ящик: B → ЯЩИК.")
    if int(counts.get("cot",0)) == 0:
        lines.append("Для сна установите раскладушку.")
    if breached_doors > 0 or broken_windows > 0:
        lines.append("Есть открытый пролом: выбитая дверь или окно больше не держит заражённых.")
    elif damaged_doors > 0 or damaged_windows > 0:
        lines.append("У убежища есть ослабленные точки входа — проверьте их до следующей вылазки.")
    if broken_barricades > 0:
        lines.append("Сломанные баррикады больше не держат проход: подойдите и нажмите E для ремонта.")
    elif damaged_barricades > 0:
        lines.append("Есть повреждённые баррикады — их можно усилить металлоломом.")
    lines.append("Сырая вода требует очистки. Тепло зависит от расстояния; срок топлива — по текущей погоде.")
    return "\n".join(lines)

