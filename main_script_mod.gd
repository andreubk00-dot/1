func _world_to_chunk(pos):
    return Vector2i(
        int(floor(pos.x / float(CHUNK_SIZE))),
        int(floor(pos.y / float(CHUNK_SIZE)))
    )


func _legacy_chunk_zone(coord):
    # Exact 0.27–0.81 zone algorithm, retained only for already explored chunks
    # when an older save is migrated.
    if coord == Vector2i(0,0):
        return "central"

    var value = abs(
        coord.x * 92821
        + coord.y * 68917
        + coord.x * coord.y * 97
        + 1337
    )
    var pick = value % 100

    if pick < 28:
        return "residential"
    if pick < 45:
        return "commercial"
    if pick < 62:
        return "industrial"
    if pick < 78:
        return "woodland"
    if pick < 91:
        return "rural"
    return "military"

func _chunk_zone(coord):
    var key = _zone_chunk_key(coord)
    if legacy_chunk_zones.has(key):
        return str(legacy_chunk_zones[key])
    return RegionCatalog.zone_for_chunk(coord)

func _chunk_profile(coord):
    var profile = RegionCatalog.chunk_profile(coord)
    var key = _zone_chunk_key(coord)
    if legacy_chunk_zones.has(key) and coord != Vector2i(0,0):
        var legacy_zone = str(legacy_chunk_zones[key])
        profile["zone"] = legacy_zone
        profile["district_id"] = "legacy_%s" % legacy_zone
        profile["name"] = _zone_display_name(legacy_zone)
        profile["density"] = _zone_build_chance(legacy_zone)
        profile["enemy_mult"] = 1.0
        profile["tree_mult"] = 1.0
        profile["car_mult"] = 1.0
        profile["building_set"] = "mixed_residential"
        profile["poi"] = {}
        profile["poi_id"] = ""
        profile["legacy"] = true
    else:
        profile["legacy"] = false
    return profile

func _district_display_name(district_id):
    if str(district_id).begins_with("legacy_"):
        return _zone_display_name(str(district_id).trim_prefix("legacy_"))
    return str(RegionCatalog.district_profile(str(district_id)).get("name",_zone_display_name(current_zone_id)))

func _current_location_label():
    if _high_risk_floor_active():
        var floor_data = HighRiskFloorCatalog.floor(high_risk_floor_poi_id,high_risk_floor_index)
        var poi = RegionCatalog.poi_by_id(high_risk_floor_poi_id)
        var floor_label = str(floor_data.get("label","ЭТАЖ %d" % high_risk_floor_index))
        var divider = floor_label.find(" • ")
        if divider > 0:
            floor_label = floor_label.substr(0,divider)
        return "%s • %s" % [str(poi.get("short_name",poi.get("name",high_risk_floor_poi_id))),floor_label]
    if current_poi_id != "":
        var poi = RegionCatalog.poi_for_chunk(current_chunk)
        if not poi.is_empty():
            return str(poi.get("short_name",poi.get("name",_district_display_name(current_district_id))))
    return _district_display_name(current_district_id)

func _chunk_coord_from_key(key):
    var parts = str(key).split(":")
    if parts.size() < 2:
        return Vector2i(999999,999999)
    return Vector2i(int(parts[0]),int(parts[1]))

func _zone_display_name(zone):
    if zone == "central":
        return "ЦЕНТР"
    if zone == "residential":
        return "ЖИЛОЙ РАЙОН"
    if zone == "commercial":
        return "ТОРГОВЫЙ РАЙОН"
    if zone == "industrial":
        return "ПРОМЗОНА"
    if zone == "woodland":
        return "ЛЕСОПОЛОСА"
    if zone == "rural":
        return "ДАЧИ"
    if zone == "military":
        return "ВОЕННЫЙ ПЕРИМЕТР"
    return "НЕИЗВЕСТНО"

