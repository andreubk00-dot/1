    )

func _container_grid_size(state):
    if typeof(state) != TYPE_DICTIONARY:
        return Vector2i(CONTAINER_W,CONTAINER_H)
    return Vector2i(
        clamp(int(state.get("grid_w",CONTAINER_W)),CONTAINER_W,QA_ALL_ITEMS_CONTAINER_W),
        clamp(int(state.get("grid_h",CONTAINER_H)),CONTAINER_H,QA_ALL_ITEMS_CONTAINER_H)
    )

func _migrate_qa_all_items_containers():
    # Test catalogue containers are versionless QA fixtures, not gameplay loot.
    # Old saves can carry a truncated catalogue snapshot, so normalize it on load.
    for key in container_states.keys():
        var state = container_states[key]
        if typeof(state) != TYPE_DICTIONARY or str(state.get("loot_table","")) != "all_items_test":
            continue
        state["grid_w"] = QA_ALL_ITEMS_CONTAINER_W
        state["grid_h"] = QA_ALL_ITEMS_CONTAINER_H
        var ids = {}
        for entry in state.get("items",[]):
            ids[str(entry.get("id",""))] = true
        var complete = ids.size() == item_defs.size()
        if complete:
            for item_id in item_defs.keys():
                if not ids.has(str(item_id)):
                    complete = false
                    break
        if not complete:
            state["items"] = _generate_loot(str(key),"all_items_test",QA_ALL_ITEMS_CONTAINER_W,QA_ALL_ITEMS_CONTAINER_H)
        container_states[key] = state

func _active_container_grid_size():
    if active_container_key == "" or not container_states.has(active_container_key):
        return Vector2i(CONTAINER_W,CONTAINER_H)
    return _container_grid_size(container_states[active_container_key])

