func _hud_survival_objective():
    if bleeding:
        return {"title":"ОСТАНОВИТЬ КРОВЬ","sub":"Нужна повязка или бинт"}
    if wound_infection >= 30.0 or wound_contamination >= 45.0:
        return {"title":"ОБРАБОТАТЬ РАНУ","sub":"Рана требует лечения"}
    if body_temperature < 35.7:
        return {"title":"СОГРЕТЬСЯ","sub":"Укрытие, сухая одежда, огонь"}
    if fatigue >= 78.0:
        return {"title":"ОТДОХНУТЬ","sub":"Сильная усталость"}
    if thirst < 32.0:
        return {"title":"ЖАЖДА","sub":"Нужна питьевая вода"}
    if hunger < 32.0:
        return {"title":"ГОЛОД","sub":"Нужна еда"}
    if _inventory_weight() > _carry_limit() * 0.94:
        return {"title":"РАЗГРУЗИТЬ РЮКЗАК","sub":"Вернуться к убежищу"}
    if expedition_active:
        if expedition_target_reached or bool(expedition_journal.get("returning",false)):
            return {"title":"ВЕРНУТЬСЯ С ВЫЛАЗКИ","sub":_home_navigation_text()}
        var target_distance = _expedition_sector_distance(current_chunk,expedition_target_chunk)
        return {"title":"ИДТИ: %s" % expedition_target_name,"sub":"До цели: %d сект. • M — карта" % target_distance}
    if home_navigation_active:
        return {"title":"ВЕРНУТЬСЯ ДОМОЙ","sub":_home_navigation_text()}
    if _at_home():
        return {"title":"ВЫ ДОМА","sub":"M → Дом / журнал: восстановление"}
    return {"title":"ПОДГОТОВИТЬ ВЫЛАЗКУ","sub":"M — карта региона и планирование"}

func _expedition_sector_distance(from_coord:Vector2i,to_coord:Vector2i) -> int:
    return max(abs(to_coord.x - from_coord.x),abs(to_coord.y - from_coord.y))

func _expedition_estimated_minutes(from_coord:Vector2i,to_coord:Vector2i) -> int:
    # Cardinal chunk crossing at walking speed is ~12 real seconds. With the
    # current day clock (4 game minutes / real second), one sector is ~48 min.
    var delta = Vector2(to_coord - from_coord)
    return int(ceil(delta.length() * 48.0))

func _expedition_time_text(minutes:int) -> String:
    if minutes < 60:
        return "~%d мин" % max(1,minutes)
    var hours = int(minutes / 60)
    var mins = minutes % 60
    return "~%d ч %02d мин" % [hours,mins]

func _expedition_route_chunks(from_coord:Vector2i,to_coord:Vector2i) -> Array:
    var route = []
    var cursor = from_coord
    var guard = 0
    while cursor != to_coord and guard < 128:
        var dx = to_coord.x - cursor.x
        var dy = to_coord.y - cursor.y
        if dx != 0:
            cursor.x += 1 if dx > 0 else -1
        if dy != 0:
            cursor.y += 1 if dy > 0 else -1
        route.append(cursor)
        guard += 1
    return route

func _region_map_cell_tooltip(coord:Vector2i) -> String:
    if _has_home() and coord == _home_chunk():
        return "ДОМ: %s • сектор %d:%d" % [str(expedition_journal["home"]["name"]),coord.x,coord.y]
    var supply_event = SupplyEventSystem.active_event(faction_state,world_day)
    if not supply_event.is_empty() and SupplyEventSystem.active_coord(faction_state,world_day) == coord:
        return "%s • сектор %d:%d
%s" % [SupplyEventSystem.marker_label(faction_state,world_day),coord.x,coord.y,SupplyEventSystem.detail_text(faction_state,world_day)]
    var discovered = discovered_chunks.has(_zone_chunk_key(coord))
    if not discovered:
        return "Сектор %d:%d — не исследован" % [coord.x,coord.y]
    var poi = RegionCatalog.poi_for_chunk(coord)
    if not poi.is_empty() and discovered_pois.has(str(poi.get("id",""))):
        var risk = int(poi.get("risk",_chunk_profile(coord).get("risk",1)))
        return "%s • сектор %d:%d\nОПАСНОСТЬ %d/5" % [str(poi.get("name","ОБЪЕКТ")),coord.x,coord.y,risk]
    return "%s • сектор %d:%d" % [_district_display_name(str(_chunk_profile(coord).get("district_id",""))),coord.x,coord.y]

func _expedition_name_for_chunk(coord:Vector2i) -> String:
    if SupplyEventSystem.active_coord(faction_state,world_day) == coord:
        return SupplyEventSystem.marker_label(faction_state,world_day)
    var key = _zone_chunk_key(coord)
    if discovered_chunks.has(key):
        var poi = RegionCatalog.poi_for_chunk(coord)
        var poi_id = str(poi.get("id",""))
        if poi_id != "" and discovered_pois.has(poi_id):
            return str(poi.get("short_name",poi.get("name","ОБЪЕКТ")))
        return _district_display_name(str(_chunk_profile(coord).get("district_id","old_center")))
    return "НЕИЗВЕСТНЫЙ СЕКТОР %d:%d" % [coord.x,coord.y]

func _expedition_readiness() -> Dictionary:
    # 1.17.2: readiness is factual and target-independent. There is deliberately
    # no aggregate score, tier, recommended POI or acquisition hint here.
    _ensure_runtime_item_instance_ids()
    _ensure_water_container_runtime_state()
    var water_liters = _total_clean_water_l()
    var drink_liters = water_liters + float(_inventory_count("herbal_tea")) * 0.45
    var water_count = int(floor(drink_liters / WATER_PORTION_L + 0.0001))
    var food_count = _inventory_count("canned_meat") + _inventory_count("hot_meal") + _inventory_count("emergency_ration")
    var medical_count = _inventory_count("bandage") + _inventory_count("sterile_bandage") + _inventory_count("trauma_kit")
    var defense_ok = false
    for id in ["combat_knife","steel_pipe","fire_axe"]:
        defense_ok = defense_ok or _inventory_has_item(id)
    var weapon_lines = []
    var firearm_ready = false
    for entry in inventory_entries:
        var id = str(entry.get("id",""))
        if not weapon_defs.has(id):
            continue
        var iid = str(entry.get("instance_id",""))
        var ammo_id = str(weapon_defs[id].get("ammo",""))
        var magazine = _weapon_mag_value(id,iid)
        var reserve = _inventory_count(ammo_id)
        var condition = _weapon_condition_value(id,iid)
        var usable = magazine + reserve > 0 and condition >= 30.0
        defense_ok = defense_ok or usable
        firearm_ready = firearm_ready or (condition >= 60.0 and magazine + reserve > 0)
        weapon_lines.append("%s: %d%% • заряжено %d / запас %d" % [str(item_defs[id].get("name",id)),int(condition),magazine,reserve])

    var condition_ok = not bleeding and thirst >= 45.0 and hunger >= 45.0 and fatigue <= 65.0 and body_temperature >= 35.5 and body_temperature <= 38.2 and wound_infection < 30.0
    var clothing_ok = wetness < 35.0 and _clothing_warmth() >= 3.0
    var carry_limit = max(0.1,_carry_limit())
    var current_weight = _inventory_weight()
    var free_weight = max(0.0,carry_limit - current_weight)
    var weight_ok = current_weight < carry_limit * 0.90
    var head_armor = _armor_value_for_zone("head")
    var torso_armor = _armor_value_for_zone("torso")
    var move_mult = _equipment_move_multiplier()

    var lines = []
    lines.append("%s Питьё: %.1f л" % ["[есть]" if drink_liters > 0.01 else "[нет]",drink_liters])
    lines.append("%s Готовая еда: %d" % ["[есть]" if food_count > 0 else "[нет]",food_count])
    lines.append("%s Перевязка: %d" % ["[есть]" if medical_count > 0 else "[нет]",medical_count])
    lines.append("%s Оружие / БК" % ("[готово]" if defense_ok and (firearm_ready or weapon_lines.is_empty()) else "[проверь]"))
    lines.append("Одежда: %s" % ("сухая / тёплая" if clothing_ok else "требует внимания"))
    lines.append("Защита: голова %d%% • корпус %d%%" % [int(head_armor * 100.0),int(torso_armor * 100.0)])
    lines.append("Мобильность с экипировкой: %d%%" % int(move_mult * 100.0))
    lines.append("Свободный вес: %.1f кг из %.1f кг" % [free_weight,carry_limit])
    lines.append("Физическое состояние: %s" % ("стабильное" if condition_ok else "требует внимания"))

    return {
        "text":"\n".join(lines),
        "weapons":"\n".join(weapon_lines),
        "facts":{
            "water":water_count,
            "water_liters":drink_liters,
            "food":food_count,
            "medical":medical_count,
            "defense_ready":defense_ok,
            "firearm_ready":firearm_ready,
            "clothing_ok":clothing_ok,
            "condition_ok":condition_ok,
            "weight_ok":weight_ok,
            "free_weight":free_weight,
            "head_armor":head_armor,
            "torso_armor":torso_armor,
            "move_mult":move_mult
        }
    }

