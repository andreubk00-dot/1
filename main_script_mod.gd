func _decorate_interior_floor_details(building,size,building_id):
    if building == null:
        return
    var seed_value = abs(hash(str(building_id))) + int(size.x * 13.0 + size.y * 7.0)
    var rng = RandomNumberGenerator.new()
    rng.seed = seed_value
    # Keep the center aisle readable. Flat floor detail belongs around room edges,
    # not under every gameplay object.
    var candidates = [
        Vector2(-size.x*0.34,size.y*0.24),
        Vector2(size.x*0.34,size.y*0.24),
        Vector2(-size.x*0.30,-size.y*0.02),
        Vector2(size.x*0.30,size.y*0.02),
        Vector2(-size.x*0.13,size.y*0.31),
        Vector2(size.x*0.12,size.y*0.31)
    ]
    var count = 3 if size.x < 190.0 else (6 if size.x >= 250.0 else 4)
    for i in range(count):
        var p = candidates[(i + int(abs(hash(str(building_id)))) ) % candidates.size()]
        p += Vector2(rng.randf_range(-8.0,8.0),rng.randf_range(-5.0,5.0))
        var index = rng.randi_range(0,7)
        var rot = 0.0 if index in [2,3,4,6,7] else rng.randf_range(-0.25,0.25)
        _interior_floor_detail_sprite(building,index,p,rot,rng.randf_range(0.55,0.72))

func _decorate_interior_depth_shading(building,size,sign_text,building_id):
    if building == null:
        return
    var root = Node2D.new()
    root.name = "InteriorDepthShading"
    root.z_index = -1
    building.add_child(root)
    var half_w = size.x * 0.5
    var half_h = size.y * 0.5
    # Layered wall falloff: hard contact darkness right under the wall, then a
    # wider faint band. This adds depth without smooth, non-pixel-art gradients.
    _rect(Vector2(0,-half_h+18),Vector2(size.x-22,8),Color(0.02,0.025,0.024,0.20),root)
    _rect(Vector2(0,-half_h+26),Vector2(size.x-30,8),Color(0.02,0.025,0.024,0.10),root)
    _rect(Vector2(-half_w+17,0),Vector2(8,size.y-30),Color(0.02,0.025,0.024,0.16),root)
    _rect(Vector2(half_w-17,0),Vector2(8,size.y-30),Color(0.02,0.025,0.024,0.16),root)
    # Darker corners keep the circulation aisle brighter and visually separate
    # room zones. Ellipses are intentionally low alpha and sit below decals.
    _ellipse(Vector2(-half_w+30,-half_h+34),30,22,Color(0.01,0.012,0.012,0.09),root)
    _ellipse(Vector2(half_w-30,-half_h+34),30,22,Color(0.01,0.012,0.012,0.09),root)
    var s = str(sign_text).to_upper()
    if s.find("АПТЕК") >= 0:
        # Muted warm pools under practical fixtures; PointLight2D supplies the
        # actual illumination, these shapes give the floor a material response.
        _ellipse(Vector2(size.x*0.22,-size.y*0.07),42,24,Color(0.33,0.20,0.08,0.055),root)
        _ellipse(Vector2(-size.x*0.18,-size.y*0.19),34,20,Color(0.27,0.20,0.10,0.035),root)

