func _movement_acceleration_for(current_velocity,desired_velocity,running):
    if desired_velocity.length() <= 0.01:
        return PLAYER_BRAKE

    var accel = PLAYER_SPRINT_ACCEL if running else PLAYER_WALK_ACCEL

    if current_velocity.length() > 1.0:
        var alignment = current_velocity.normalized().dot(
            desired_velocity.normalized()
        )

        # Reversing or making a hard turn needs stronger planted-foot force.
        if alignment < 0.30:
            accel = PLAYER_TURN_ACCEL

    return accel

func _movement_velocity_step(current_velocity,desired_velocity,delta,running):
    var step_delta = max(0.0,float(delta))
    var accel = _movement_acceleration_for(
        current_velocity,
        desired_velocity,
        running
    )

    var result = current_velocity.move_toward(
        desired_velocity,
        accel * step_delta
    )

    if desired_velocity.length() <= 0.01 and result.length() < 0.10:
        return Vector2.ZERO

    return result

func _process(delta):
    if player == null:
        return

    fire_cooldown = max(0.0, fire_cooldown - delta)
    infected_spit_slow_time = max(0.0,infected_spit_slow_time - delta)
    if infected_spit_slow_time <= 0.0:
        infected_spit_slow_mult = 1.0
    melee_cooldown = max(0.0,melee_cooldown - delta)
    melee_swing_time = max(0.0,melee_swing_time - delta)
    shove_cooldown = max(0.0,shove_cooldown - delta)
    weapon_recoil_time = max(0.0,weapon_recoil_time - delta)
    modern_survivor_hit_time = max(0.0,modern_survivor_hit_time - delta)
    reload_feedback_time = max(0.0,reload_feedback_time - delta)
    if reload_feedback_time <= 0.0:
        reload_feedback = ""
    last_player_noise_time = max(0.0,last_player_noise_time - delta)
    if last_player_noise_time <= 0.0:
        last_player_noise_kind = "quiet"
        last_player_noise_radius = 0.0
    autosave_time += delta

    if weapon_cycle_time > 0.0:
        var cycle_before = weapon_cycle_time
        weapon_cycle_time = max(0.0,weapon_cycle_time - delta)
        if weapon_cycle_audio_pending and cycle_before > weapon_cycle_duration and weapon_cycle_time <= weapon_cycle_duration:
            _play_weapon_cycle_audio(weapon_cycle_profile)
            weapon_cycle_audio_pending = false
        if weapon_cycle_time <= 0.0:
            _cancel_weapon_cycle()

    if reload_time > 0.0:
        reload_time = max(0.0,reload_time - delta)
        if reload_time <= 0.0:
            _finish_reload()

    _validate_equipment()

    var frame_start_position = player.global_position
    var frame_start_velocity = player.velocity

    if inventory_open or trader_open or contract_open or region_map_open or developer_panel_open:
        move_direction = Vector2.ZERO
        is_sprinting = false
        player.velocity = Vector2.ZERO
    else:
        move_direction = Input.get_vector("move_left","move_right","move_up","move_down")
        if qa_visual_mode and qa_forced_move_direction.length() > 0.01:
            move_direction = qa_forced_move_direction.normalized()
        is_sprinting = (
            move_direction.length() > 0.05
            and (Input.is_action_pressed("sprint") or (qa_visual_mode and qa_force_sprint))
            and stamina > 1.0
            and hunger > 0.0
            and thirst > 0.0
            and _injury_can_sprint()
            and _fatigue_can_sprint()
        )

        var desired_velocity = move_direction * _current_move_speed()
        player.velocity = _movement_velocity_step(
            player.velocity,
            desired_velocity,
            delta,
            is_sprinting
        )
        player.move_and_slide()

    # Small inertial body lag on starts, stops and hard direction changes.
    # It is visual-only and deliberately capped below one logical pixel.
    var velocity_delta = player.velocity - frame_start_velocity
    var impulse_target = -velocity_delta / max(1.0,MOVE_SPEED) * 0.42
    if inventory_open or trader_open or contract_open or region_map_open or developer_panel_open:
        impulse_target = Vector2.ZERO
    visual_motion_impulse = visual_motion_impulse.lerp(
        impulse_target.limit_length(0.42),
        min(1.0,delta * (10.0 if velocity_delta.length() > 1.0 else 6.0))
    )

    var actual_displacement = player.global_position - frame_start_position
    var instant_visual_speed = actual_displacement.length() / max(delta,0.001)

    var visual_speed_lerp = min(
        1.0,
        delta * (
            15.0
            if instant_visual_speed < visual_move_speed
            else 10.0
        )
    )
    visual_move_speed = lerp(
        visual_move_speed,
        instant_visual_speed,
        visual_speed_lerp
    )

    if actual_displacement.length() > 0.05:
        visual_move_direction = actual_displacement.normalized()

    var visual_movement_active = visual_move_speed > 2.0
    movement_anim_blend = move_toward(
        movement_anim_blend,
        1.0 if visual_movement_active else 0.0,
        delta * (
            7.5
            if visual_movement_active
            else 6.5
        )
    )

    if visual_movement_active and actual_displacement.length() > 0.001:
        # Distance-driven gait prevents foot sliding:
        # blocked/slowed movement automatically slows the animation.
        walk_phase = fposmod(
            walk_phase + _gait_phase_delta_for_distance(
                actual_displacement.length(),
                is_sprinting
            ),
            TAU
        )
    elif movement_anim_blend > 0.02:
        # Settle the final foot onto the nearest contact phase rather than
        # snapping from a stride directly to the idle sprite.
        var settle_target = 0.0 if cos(walk_phase) >= 0.0 else PI
        walk_phase = lerp_angle(
            walk_phase,
            settle_target,
            min(1.0,delta * 10.0)
        )

    if qa_visual_mode and qa_forced_gait_phase >= 0.0:
        walk_phase = qa_forced_gait_phase
        movement_anim_blend = 1.0
        visual_move_speed = max(visual_move_speed,MOVE_SPEED)

    _update_survival(delta)
    _update_injuries(delta)
    _update_medical(delta)
    _update_nutrition(delta)
    _developer_apply_invulnerability()
    _update_infected_death_hazards(delta)

    if health <= 0.0:
        _respawn_player()

    var mouse_pos = get_global_mouse_position()
    if qa_visual_mode and qa_locked_aim.length() > 0.01:
        aim_direction = qa_locked_aim
    elif not inventory_open and not trader_open and not contract_open and not region_map_open and not developer_panel_open and player.global_position.distance_to(mouse_pos) > 2.0:
        aim_direction = (mouse_pos - player.global_position).normalized()

    _update_player_visuals(delta)
    _update_world_items(delta)
    _update_enemies(delta)
    _update_shelter_assault(delta)
    _update_doors(delta)
    _update_interior_prop_depth()
    _update_detail_lights(delta)
    _update_roofs(delta)
    _update_day_night(delta)
    _update_weather(delta)
    _update_exterior_atmosphere(delta)
    _update_base_system(delta)

    if not _high_risk_floor_active():
        var now_chunk = _world_to_chunk(player.global_position)
        if now_chunk != current_chunk:
            _refresh_chunks(false)
        # Check entry into the actual home, even without crossing a chunk boundary.
        _update_expedition_progress()

    if not inventory_open and not trader_open and not contract_open:
        var w = weapon_defs.get(current_weapon_id, {})
        if not region_map_open and not developer_panel_open and equipped_melee_id == "" and bool(w.get("automatic", false)) and Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT):
            _fire_weapon()

    if tracer_time > 0.0:
        tracer_time -= delta
        if tracer_time <= 0.0 and tracer != null:
            tracer.visible = false

    if muzzle_time > 0.0:
        muzzle_time -= delta
        if muzzle_time <= 0.0 and muzzle_flash != null:
            muzzle_flash.visible = false

    if autosave_time >= 10.0:
        autosave_time = 0.0
        _save_state()

    if rest_open:
        _refresh_rest_ui()
    if region_map_open:
        home_journal_refresh_time -= delta
        if home_journal_refresh_time <= 0.0:
            home_journal_refresh_time = 0.5
            _refresh_region_map_ui()

    _update_hud()
    _update_interaction_prompt()
    _update_hover_position()


func _quick_slot_valid_item(id):
    if not item_defs.has(id):
        return false
    var category = str(item_defs[id].get("category",""))
    return category == "weapon" or category == "melee"

func _sanitize_quick_slot_ids(raw):
    var defaults = ["makarov","shotgun","akm","combat_knife","steel_pipe","fire_axe"]
    if typeof(raw) != TYPE_ARRAY:
        return defaults.duplicate()

    var result = []
    var used = {}
    for i in range(6):
        var id = str(raw[i]) if i < raw.size() else ""
        if not _quick_slot_valid_item(id) or used.has(id):
            id = str(defaults[i])
            if used.has(id):
                id = ""
                for fallback_id in defaults:
                    if not used.has(fallback_id):
                        id = str(fallback_id)
                        break
        result.append(id)
        used[id] = true
    return result

func _quick_slot_item(slot):
    quick_slot_ids = _sanitize_quick_slot_ids(quick_slot_ids)
    var index = int(slot) - 1
    if index < 0 or index >= quick_slot_ids.size():
        return ""
    return str(quick_slot_ids[index])

func _refresh_hud_quick_slot_binding(index):
    if index < 0 or index >= hud_quick_slots.size() or index >= quick_slot_ids.size():
        return
    var slot = hud_quick_slots[index]
    var id = str(quick_slot_ids[index])
    slot["id"] = id
    var icon = slot.get("icon",null)
    if icon != null:
        _hud_apply_quick_slot_icon(icon,id)
    var button = slot.get("button",null)
    if button != null:
        button.tooltip_text = "%d — %s\nИнвентарь: выберите оружие и нажмите %d, чтобы заменить слот." % [
            index + 1,
            str(item_defs.get(id,{}).get("name",id)),
            index + 1
        ]
    hud_quick_slots[index] = slot

func _assign_quick_slot(slot,item_id):
    var index = int(slot) - 1
    var id = str(item_id)
    if index < 0 or index >= 6 or not _quick_slot_valid_item(id):
        return false

    quick_slot_ids = _sanitize_quick_slot_ids(quick_slot_ids)
    var previous_index = quick_slot_ids.find(id)
    if previous_index == index:
        return true

    var displaced = str(quick_slot_ids[index])
    quick_slot_ids[index] = id
    if previous_index >= 0:
        quick_slot_ids[previous_index] = displaced

    _refresh_hud_quick_slot_binding(index)
    if previous_index >= 0:
        _refresh_hud_quick_slot_binding(previous_index)
    if hud_world_root != null:
        _update_hud()
    return true

func _inventory_item_action_mode():
    if not inventory_open:
        return false
    if crafting_open or rest_open or base_build_open or mod_panel_open or region_map_open:
        return false
    return true

func _handle_reload_action():
    if _inventory_item_action_mode():
        return _refill_selected_water_container()
    if inventory_open:
        return false
    _start_reload()
    return true

func _select_quick_slot(slot):
    var slot_index = int(slot)
    if slot_index < 1 or slot_index > 6:
        return false

    # Number keys bind only in the actual backpack/container view. Modal screens
    # also set inventory_open, but must not mutate loadout through stale selection.
    if inventory_open and not _inventory_item_action_mode():
        return false
    if _inventory_item_action_mode():
        if selected_inventory_index < 0 or selected_inventory_index >= inventory_entries.size():
            return false
        var selected_id = str(inventory_entries[selected_inventory_index].get("id",""))
        if not _quick_slot_valid_item(selected_id):
            return false
        if _assign_quick_slot(slot_index,selected_id):
            if inv_details != null:
                inv_details.text = "%s → быстрый слот %d" % [str(item_defs[selected_id].get("name",selected_id)),slot_index]
            call_deferred("_refresh_inventory_ui")
            return true
        return false

    var id = _quick_slot_item(slot_index)
    if id != "" and _inventory_has_item(id):
        var category = str(item_defs[id].get("category",""))
        if category == "weapon":
            _switch_weapon(id)
            return true
        if category == "melee":
            _switch_melee(id)
            return true

    _set_survival_feedback("Предмет быстрого слота отсутствует в инвентаре",1.4)
    return false

func _rig_quick_valid_item(id):
    return item_defs.has(id) and bool(item_defs[id].get("rig_quick",false))

func _sanitize_rig_quick_ids(raw):
    var out = ["",""]
    if typeof(raw) == TYPE_ARRAY:
        for i in range(min(RIG_QUICK_SLOT_COUNT,raw.size())):
            var id = str(raw[i])
            if _rig_quick_valid_item(id) and not out.has(id):
                out[i] = id
    return out

func _assign_rig_quick_slot(slot,item_id):
    var index = int(slot) - 1
    if index < 0 or index >= RIG_QUICK_SLOT_COUNT or int(slot) > _rig_pocket_count():
        _set_survival_feedback("Эта разгрузка не имеет такого быстрого кармана",1.5)
        return false
    var id = str(item_id)
    if not _rig_quick_valid_item(id):
        _set_survival_feedback("В быстрый карман помещаются только компактные расходники",1.6)
        return false
    rig_quick_ids = _sanitize_rig_quick_ids(rig_quick_ids)
    var previous_index = rig_quick_ids.find(id)
    var displaced = str(rig_quick_ids[index])
    rig_quick_ids[index] = id
    if previous_index >= 0 and previous_index != index:
        rig_quick_ids[previous_index] = displaced
    _set_survival_feedback("%s → карман %d" % [str(item_defs[id].get("name",id)),int(slot) + 6],1.4)
    return true

func _use_rig_quick_slot(slot):
    var pocket = int(slot)
    if pocket < 1 or pocket > _rig_pocket_count():
        _set_survival_feedback("Нет доступного быстрого кармана разгрузки",1.4)
        return false

    if inventory_open and not _inventory_item_action_mode():
        return false
    if _inventory_item_action_mode():
        if selected_inventory_index < 0 or selected_inventory_index >= inventory_entries.size():
            _set_survival_feedback("Сначала выберите компактный расходник",1.4)
            return false
        var selected_id = str(inventory_entries[selected_inventory_index].get("id",""))
        if _assign_rig_quick_slot(pocket,selected_id):
            call_deferred("_refresh_inventory_ui")
            return true
        return false

    rig_quick_ids = _sanitize_rig_quick_ids(rig_quick_ids)
    var id = str(rig_quick_ids[pocket - 1])
    if id == "" or not _rig_quick_valid_item(id):
        _set_survival_feedback("Быстрый карман пуст",1.3)
        return false
    for i in range(inventory_entries.size()):
        if str(inventory_entries[i].get("id","")) == id:
            selected_inventory_index = i
            _use_selected_inventory()
            return true
    _set_survival_feedback("В кармане назначен предмет, которого нет в рюкзаке",1.6)
    return false

func _event_matches_digit(event,key_code):
    if not (event is InputEventKey):
        return false
    return event.physical_keycode == key_code or event.keycode == key_code


func _unhandled_input(event):
    if _developer_tools_available() and event.is_action_pressed("developer_panel"):
        _toggle_developer_panel()
        get_viewport().set_input_as_handled()
        return

    if developer_panel_open:
        if event is InputEventKey and event.pressed and not event.echo and (event.physical_keycode == KEY_ESCAPE or event.keycode == KEY_ESCAPE):
            _close_developer_panel()
        get_viewport().set_input_as_handled()
        return

    if contract_open:
        if event is InputEventKey and event.pressed and not event.echo and event.physical_keycode in [KEY_ESCAPE,KEY_TAB,KEY_I]:
            _close_contract_board()
        get_viewport().set_input_as_handled()
        return

    if trader_open:
        if event is InputEventKey and event.pressed and not event.echo and event.physical_keycode in [KEY_ESCAPE,KEY_TAB,KEY_I]:
            _close_trader()
        get_viewport().set_input_as_handled()
        return

    if event.is_action_pressed("region_map"):
        _toggle_region_map()
        return

    if region_map_open:
        if event is InputEventKey and event.pressed and not event.echo and event.physical_keycode == KEY_ESCAPE:
            _close_region_map()
        return

    if event.is_action_pressed("reload"):
        _handle_reload_action()
        return

    if event.is_action_pressed("quick_slot_1"):
        _select_quick_slot(1)
        return
    if event.is_action_pressed("quick_slot_2"):
        _select_quick_slot(2)
        return
    if event.is_action_pressed("quick_slot_3"):
        _select_quick_slot(3)
        return
    if event.is_action_pressed("quick_slot_4"):
        _select_quick_slot(4)
        return
    if event.is_action_pressed("quick_slot_5"):
        _select_quick_slot(5)
        return
    if event.is_action_pressed("quick_slot_6"):
        _select_quick_slot(6)
        return
    if event.is_action_pressed("rig_quick_1"):
        _use_rig_quick_slot(1)
        return
    if event.is_action_pressed("rig_quick_2"):
        _use_rig_quick_slot(2)
        return

    if event is InputEventMouseButton:
        if event.button_index == MOUSE_BUTTON_LEFT and event.pressed and not inventory_open and not trader_open and not contract_open:
            _primary_attack()

    elif event is InputEventKey:
        if event.pressed and not event.echo:
            # Logical-key fallback fixes layouts where physical digit codes
            # differ from KEY_1..KEY_6.
            if _event_matches_digit(event,KEY_1):
                _select_quick_slot(1)
                return
            if _event_matches_digit(event,KEY_2):
                _select_quick_slot(2)
                return
            if _event_matches_digit(event,KEY_3):
                _select_quick_slot(3)
                return
            if _event_matches_digit(event,KEY_4):
                _select_quick_slot(4)
                return
            if _event_matches_digit(event,KEY_5):
                _select_quick_slot(5)
                return
            if _event_matches_digit(event,KEY_6):
                _select_quick_slot(6)
                return
            if _event_matches_digit(event,KEY_7):
                _use_rig_quick_slot(1)
                return
            if _event_matches_digit(event,KEY_8):
                _use_rig_quick_slot(2)
                return

            match event.physical_keycode:
                KEY_R:
                    _handle_reload_action()
                KEY_E:
                    if not inventory_open and not trader_open and not contract_open:
                        _interact()
                KEY_TAB, KEY_I:
                    if trader_open:
                        _close_trader()
                    elif mod_panel_open:
                        _close_weapon_mod_panel()
                    elif rest_open:
                        _close_rest_panel()
                    elif crafting_open:
                        _close_crafting()
                    elif base_build_open:
                        _close_base_build()
                    else:
                        _toggle_inventory()
                KEY_ESCAPE:
                    if trader_open:
                        _close_trader()
                    elif mod_panel_open:
                        _close_weapon_mod_panel()
                    elif rest_open:
                        _close_rest_panel()
                    elif crafting_open:
                        _close_crafting()
                    elif base_build_open:
                        _close_base_build()
                    elif inventory_open:
                        _close_inventory()
                KEY_B:
                    if base_build_open:
                        _close_base_build()
                    elif not inventory_open and not trader_open and not contract_open:
                        _open_base_build()
                KEY_X:
                    if base_build_open:
                        _dismantle_nearest_base_object()
                KEY_H:
                    _quick_bandage()
                KEY_F:
                    _toggle_flashlight()
                KEY_T:
                    var debug_advanced_minutes = world_minutes + 60.0
                    if debug_advanced_minutes >= 1440.0:
                        world_day += 1
                        FactionEconomy.daily_tick(faction_state)
                        var supply_result = SupplyEventSystem.daily_tick(faction_state,world_day,_supply_event_blocked_chunks())
                        _apply_supply_event_day_result(supply_result)
                        TradingMarket.restock_all(faction_state,world_day)
                        ContractSystem.refresh_offers(faction_state,world_day,false)
                    world_minutes = fmod(debug_advanced_minutes,1440.0)
                KEY_V:
                    if not inventory_open and not trader_open and not contract_open:
                        _perform_shove()
                KEY_Q:
                    if inventory_open and not crafting_open:
                        _drop_selected_inventory()
                KEY_F5:
                    _save_state()

func _load_data():
    item_defs = _fallback_items()
    weapon_defs = _fallback_weapons()
    melee_defs = _fallback_melee()
    loot_tables = _fallback_loot()
    recipe_defs = _fallback_recipes()
    _apply_item_access_metadata()


func _apply_item_access_metadata():
    for raw_id in item_defs.keys():
        var item_id = str(raw_id)
        var rarity = str(ITEM_RARITY.get(item_id,"common"))
        if not RARITY_INFO.has(rarity):
            rarity = "common"
        item_defs[item_id]["rarity"] = rarity
        item_defs[item_id]["min_loot_risk"] = int(ITEM_MIN_LOOT_RISK.get(item_id,RARITY_INFO[rarity].get("min_risk",1)))

func _item_rarity_key(item_id:String) -> String:
    if not item_defs.has(item_id):
        return "common"
    return str(item_defs[item_id].get("rarity","common"))

func _item_rarity_label(item_id:String) -> String:
    var key = _item_rarity_key(item_id)
    return str(RARITY_INFO.get(key,RARITY_INFO["common"]).get("label","РАСПРОСТРАНЁННОЕ"))

func _item_rarity_color(item_id:String) -> Color:
    var key = _item_rarity_key(item_id)
    return Color(str(RARITY_INFO.get(key,RARITY_INFO["common"]).get("color","#b8bbb1")))

func _item_min_loot_risk(item_id:String) -> int:
    if not item_defs.has(item_id):
        return 1
    return int(item_defs[item_id].get("min_loot_risk",1))

func _loot_profile_risk(profile:String) -> int:
    return int(LOOT_PROFILE_RISK.get(profile,0))

