func _movement_cardinal_from_vector(direction,current_cardinal):
    var side = int(current_cardinal)
    if side != 2 and side != 3:
        side = 2

    if direction.length() < 0.10:
        return side

    # Only horizontal animation exists now.
    # Pure/mostly vertical movement preserves the previous left/right side.
    if direction.x > 0.16:
        return 2
    if direction.x < -0.16:
        return 3
    return side


func _directional_leg_row(cardinal,running,moving):
    var is_left = int(cardinal) == 3
    if not moving:
        return 5 if is_left else 4
    if running:
        return 3 if is_left else 2
    return 1 if is_left else 0



func _update_directional_legs(pose_offset,pose_scale,moving):
    # 0.60 cohesive character: legs are baked into the full-body atlas so pelvis,
    # coat hem and stride cannot drift apart. Keep this node hidden for save/test
    # compatibility; a later animation pass can add relative strafe variants.
    if pv_legs != null:
        pv_legs.visible = false


func _update_player_visuals(delta):
    visual_aim_dir8 = _direction8_hysteresis(aim_direction,visual_aim_dir8)
    player_visual.scale = Vector2(PLAYER_VISUAL_SCALE,PLAYER_VISUAL_SCALE)

    var use_modern_survivor = pv_modern_survivor_sprite != null
    _set_modern_survivor_visible(use_modern_survivor)

    var local_aim = aim_direction
    var local_motion = visual_move_direction

    var blend = clamp(movement_anim_blend,0.0,1.0)
    var phase = fposmod(walk_phase,TAU)
    var step = sin(phase)
    var double_step = sin(phase * 2.0)
    var foot_contact = pow(abs(cos(phase)),8.0)
    var sprint_scale = 1.08 if is_sprinting else 1.0

    # 0.60 anatomical locomotion polish. The cycle is still driven by real travelled distance,
    # but the whole silhouette now reacts to speed, foot plant and lateral loading.
    # These offsets move body + hands + held item together, so detail never breaks
    # into the old floating-layer look.
    var speed_ratio = clamp(visual_move_speed / max(1.0,MOVE_SPEED),0.0,1.55)
    var locomotion_strength = lerp(0.86,1.08,clamp(speed_ratio,0.0,1.0))
    if is_sprinting:
        locomotion_strength *= 1.12

    # 0.60: most gait motion now lives inside the baked anatomical frame. The
    # root only absorbs impact and forward momentum; large whole-sprite bob made
    # the old character look like a paper puppet.
    var body_bob = (
        -pow(abs(cos(phase)),6.0) * 0.045
        + double_step * 0.010
    ) * blend * locomotion_strength

    var motion_side = Vector2(-local_motion.y,local_motion.x) if local_motion.length() > 0.05 else Vector2.RIGHT
    var side_shift = step * (0.050 if is_sprinting else 0.028) * blend * locomotion_strength
    var planted_shift = motion_side * side_shift

    var idle_t = Time.get_ticks_msec() * 0.001
    var idle_breath = sin(idle_t * 1.72) * 0.14 * (1.0-blend)
    var idle_weight = sin(idle_t * 0.58) * 0.16 * (1.0-blend)
    var idle_micro = sin(idle_t * 0.29 + 0.7) * 0.05 * (1.0-blend)

    # Start/stop inertia is intentionally smaller than before. Forward lean is
    # driven by actual travel speed so acceleration reads as weight transfer,
    # not the sprite sliding inside its collision body.
    var forward_mass = local_motion * blend * (0.25 if is_sprinting else 0.085) * clamp(speed_ratio,0.0,1.25)
    var impact_drop = Vector2(0,foot_contact * 0.012 * blend * locomotion_strength)
    var pose_offset = Vector2(idle_weight + idle_micro,idle_breath - 1.0)
    pose_offset += planted_shift + forward_mass + impact_drop + visual_motion_impulse * 0.72 + Vector2(0,body_bob)
    pose_offset.x = round(pose_offset.x * 2.0) * 0.5
    pose_offset.y = round(pose_offset.y * 2.0) * 0.5

    pv_shadow.position = Vector2(
        -1 + side_shift * 0.04,
        14 + body_bob * 0.03
    )
    pv_shadow.scale = Vector2(
        1.0 - abs(step) * 0.008 * blend,
        1.0 + abs(step) * 0.004 * blend
    )

    var weapon_id = equipped_melee_id if equipped_melee_id != "" else current_weapon_id
    var row = _pose_visual_row(local_aim)
    _set_pose_frame(weapon_id,row)

    pv_pose_back.position = pose_offset
    pv_pose_front.position = pose_offset

    # Tiny whole-body roll communicates strafe/load transfer while preserving the
    # baked silhouette. The weapon receives part of the same roll below.
    var aim_side = Vector2(-local_aim.y,local_aim.x) if local_aim.length() > 0.05 else Vector2.DOWN
    var lateral_load = local_motion.dot(aim_side) if local_motion.length() > 0.05 else 0.0
    var body_roll = lateral_load * (0.013 if is_sprinting else 0.007) * blend
    body_roll += -step * 0.0025 * blend * locomotion_strength
    body_roll += sin(idle_t * 0.54) * 0.0025 * (1.0-blend)
    pv_pose_back.rotation = body_roll
    pv_pose_front.rotation = body_roll
    pv_pose_back.scale = Vector2(0.5,0.5)
    pv_pose_front.scale = Vector2(0.5,0.5)

    if use_modern_survivor:
        _update_modern_survivor(weapon_id,local_aim,local_motion,pose_offset,body_roll)

    _update_directional_legs(
        pose_offset,
        Vector2.ONE,
        visual_move_speed > 2.0
    )

    # 0.60 uses baked pixel-art arms. Legacy runtime IK nodes stay alive for
    # compatibility/self-tests but are always hidden so no procedural sticks can
    # leak through the cohesive sprite silhouette.
    _set_melee_arm_visible(false)
    _set_ranged_arm_visible(false)
    pv_arm_back_root.visible = false
    pv_arm_front_root.visible = false

    # Keep the weapon driven by the same runtime body anchor for every character path,
    # including the imported survivor firearm overlay. 0.69/0.70 skipped this call for
    # ranged modern-survivor weapons, which left the gun root stale and caused the gun to
    # appear to float beside the body instead of staying locked into the hands.
    _update_pose_weapon(weapon_id,row,pose_offset,_visual_weapon_angle(aim_direction) + body_roll * 0.35)

    pv_pose_back.z_index = 0
    # When aiming away from the camera, the held weapon belongs behind the
    # head/upper torso. Keeping it at the normal middle Z made the barrel draw
    # straight through the survivor's face in the north-facing pose.
    if use_modern_survivor:
        pv_weapon_root.z_index = 1 if aim_direction.y < -0.55 else 3
    else:
        pv_weapon_root.z_index = -1 if aim_direction.y < -0.55 else 2
    pv_pose_front.z_index = 4

    if camera != null:
        var desired = aim_direction * 34.0 + Vector2(
            0,
            -11 + body_bob * 0.12
        )
        camera.position = camera.position.lerp(
            desired,
            min(1.0,delta * 6.0 + 0.2)
        )

func _melee_model_texture(id):
    if melee_model_atlas == null:
        melee_model_atlas = load("res://melee_models_v18.png")
    if melee_model_atlas == null:
        return null
    var row = 0
    if id == "steel_pipe":
        row = 1
    elif id == "fire_axe":
        row = 2
    var tex = AtlasTexture.new()
    tex.atlas = melee_model_atlas
    tex.region = Rect2(0,row * 32,96,32)
    return tex

func _weapon_model_texture(id):
    if weapon_model_atlas == null:
        weapon_model_atlas = load("res://weapon_models_v21.png")
    if weapon_model_atlas == null or not weapon_defs.has(id):
        return null
    var row = int(weapon_defs[id].get("model_row",0))
    var tex = AtlasTexture.new()
    tex.atlas = weapon_model_atlas
    tex.region = Rect2(0,row * 48,144,48)
    return tex

func _weapon_module_texture(id):
    if weapon_module_atlas == null:
        weapon_module_atlas = load("res://weapon_modules_v6.png")

    if weapon_module_atlas == null:
        return null

    var cell = Vector2i(-1,-1)
    match id:
        "makarov_extmag":
            cell = Vector2i(0,0)
        "shotgun_exttube":
            cell = Vector2i(1,0)
        "akm_extmag":
            cell = Vector2i(2,0)
        "muzzle_brake":
            cell = Vector2i(0,1)
        "suppressor":
            cell = Vector2i(1,1)

    if cell.x < 0:
        return null

    var tex = AtlasTexture.new()
    tex.atlas = weapon_module_atlas
    tex.region = Rect2(cell.x * 32,cell.y * 32,32,32)
    return tex

func _update_visible_weapon_mods():
    if pv_weapon_mag_visual == null or pv_weapon_muzzle_visual == null:
        return

    if equipped_melee_id != "":
        pv_weapon_mag_visual.visible = false
        pv_weapon_muzzle_visual.visible = false
        return

    var mods = _weapon_mod_state(current_weapon_id,current_weapon_instance_id)
    var magazine_id = str(mods.get("magazine",""))
    var muzzle_id = str(mods.get("muzzle",""))

    pv_weapon_mag_visual.texture = _weapon_module_texture(magazine_id) if magazine_id != "" else null
    pv_weapon_muzzle_visual.texture = _weapon_module_texture(muzzle_id) if muzzle_id != "" else null
    pv_weapon_mag_visual.visible = pv_weapon_mag_visual.texture != null
    pv_weapon_muzzle_visual.visible = pv_weapon_muzzle_visual.texture != null

    var config = _held_visual_config(current_weapon_id,false)
    var visual_scale = float(config.get("scale",0.20))

    pv_weapon_mag_visual.modulate = Color.WHITE
    pv_weapon_muzzle_visual.modulate = Color.WHITE

    if current_weapon_id == "makarov":
        pv_weapon_mag_visual.position = Vector2(5.8,4.1)
        pv_weapon_mag_visual.scale = Vector2(visual_scale * 1.25,visual_scale * 1.25)
        pv_weapon_muzzle_visual.position = Vector2(18.8,-0.3)
        pv_weapon_muzzle_visual.scale = Vector2(visual_scale * 1.30,visual_scale * 1.30)
    elif current_weapon_id == "shotgun":
        pv_weapon_mag_visual.position = Vector2(12.5,1.8)
        pv_weapon_mag_visual.scale = Vector2(visual_scale * 1.55,visual_scale * 1.55)
        pv_weapon_muzzle_visual.position = Vector2(22.0,-0.3)
        pv_weapon_muzzle_visual.scale = Vector2(visual_scale * 1.25,visual_scale * 1.25)
    else:
        pv_weapon_mag_visual.position = Vector2(5.7,4.6)
        pv_weapon_mag_visual.scale = Vector2(visual_scale * 1.45,visual_scale * 1.45)
        pv_weapon_muzzle_visual.position = Vector2(18.4,-0.3)
        pv_weapon_muzzle_visual.scale = Vector2(visual_scale * 1.25,visual_scale * 1.25)

func _update_weapon_visual():
    if pv_weapon_root == null or pv_weapon_sprite == null:
        return

    pv_weapon_stock.visible = false
    pv_weapon_body.visible = false
    pv_weapon_mag.visible = false
    pv_weapon_barrel.visible = false

    if equipped_melee_id != "" and pv_modern_survivor_sprite != null and pv_modern_survivor_sprite.visible:
        # 0.75: melee is baked into survivor_<knife|pipe|axe>_*.png; no floating overlay.
        pv_weapon_root.visible = false
        pv_weapon_sprite.visible = false
        pv_weapon_mag_visual.visible = false
        pv_weapon_muzzle_visual.visible = false
        if muzzle_flash != null:
            muzzle_flash.visible = false
        if pv_melee_trail != null:
            pv_melee_trail.visible = false
        _set_melee_arm_visible(false)
        _set_ranged_arm_visible(false)
        return

    if equipped_melee_id != "":
        var config = _held_visual_config(equipped_melee_id,true)
        var scale_value = float(config.get("scale",0.24))

        pv_weapon_root.visible = true
        pv_weapon_sprite.texture = _melee_model_texture(equipped_melee_id)
        pv_weapon_sprite.visible = pv_weapon_sprite.texture != null
        pv_weapon_sprite.scale = Vector2(scale_value,scale_value)
        pv_weapon_sprite.position = config.get("sprite_pos",Vector2.ZERO)
        pv_weapon_sprite.rotation = 0.0
        pv_weapon_sprite.flip_h = false
        pv_weapon_sprite.modulate = Color.WHITE
        pv_weapon_mag_visual.visible = false
        pv_weapon_muzzle_visual.visible = false

        if muzzle_flash != null:
            muzzle_flash.visible = false
        # Old procedural trail/arms were visually leaking around the new sprite.
        # Keep them disabled; the authored Attack3/Attack4 body animation carries the swing.
        if pv_melee_trail != null:
            pv_melee_trail.visible = false
        _set_melee_arm_visible(false)
        _set_ranged_arm_visible(false)
        return

    if pv_melee_trail != null:
        pv_melee_trail.visible = false

    if equipped_melee_id == "" and pv_weapon_root != null and pv_modern_survivor_sprite != null and pv_modern_survivor_sprite.visible:
        # Firearms are baked into dedicated survivor sheets for each weapon so they stay
        # welded to the authored hands across all animation frames.
        pv_weapon_root.visible = false
        pv_weapon_sprite.visible = false
        pv_weapon_mag_visual.visible = false
        pv_weapon_muzzle_visual.visible = false
        if muzzle_flash != null:
            muzzle_flash.visible = false
        return

    var config = _held_visual_config(current_weapon_id,false)
    var scale_value = float(config.get("scale",0.22))

    pv_weapon_sprite.texture = _weapon_model_texture(current_weapon_id)
    pv_weapon_sprite.visible = pv_weapon_sprite.texture != null
    pv_weapon_sprite.scale = Vector2(scale_value,scale_value)
    pv_weapon_sprite.position = config.get("sprite_pos",Vector2.ZERO)
    pv_weapon_sprite.rotation = 0.0
    pv_weapon_sprite.flip_h = false

    pv_weapon_sprite.modulate = Color.WHITE

    if muzzle_flash != null:
        muzzle_flash.position = _source_point_to_weapon_local(
            config.get("muzzle_px",Vector2(96,24)),
            config
        )

    _update_visible_weapon_mods()

