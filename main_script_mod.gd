func _weapon_mod_summary(weapon_id,instance_id = ""):
    var mods = _weapon_mod_state(weapon_id,instance_id)
    var names = []
    for slot in ["magazine","muzzle"]:
        var id = str(mods.get(slot,""))
        if id != "" and item_defs.has(id):
            names.append(str(item_defs[id].get("short",id)))

    if names.is_empty():
        return "нет"
    return ", ".join(names)

func _weapon_mod_multiplier(weapon_id,key,instance_id = ""):
    var mult = 1.0
    var mods = _weapon_mod_state(weapon_id,instance_id)
    for slot in ["magazine","muzzle"]:
        var id = str(mods.get(slot,""))
        if id != "" and item_defs.has(id):
            mult *= float(item_defs[id].get(key,1.0))
    return mult

func _install_selected_weapon_mod():
    if selected_inventory_index < 0 or selected_inventory_index >= inventory_entries.size():
        return false

    var id = str(inventory_entries[selected_inventory_index].get("id",""))
    return _install_weapon_mod(current_weapon_id,id,current_weapon_instance_id)

func _purify_one_dirty_water(method):
    if _inventory_count("dirty_water") <= 0:
        return false

    var test_entries = inventory_entries.duplicate(true)
    if not _consume_one_item_from_entries(test_entries,"dirty_water"):
        return false

    var remaining = _grid_add(test_entries,"water",1,INV_W,INV_H)
    if remaining > 0:
        if inv_details != null:
            inv_details.text = "Нужно свободное место для чистой воды."
        return false

    inventory_entries = test_entries

    if method == "fire":
        _set_survival_feedback("Дождевая вода вскипячена у костра",2.0)
    else:
        _set_survival_feedback("Дождевая вода очищена фильтром",2.0)

    return true

func _use_selected_inventory():
    if selected_inventory_index < 0 or selected_inventory_index >= inventory_entries.size():
        return

    var entry = inventory_entries[selected_inventory_index]
    var id = str(entry.get("id",""))
    if not item_defs.has(id):
        return

    var use_type = str(item_defs[id].get("use",""))

    if use_type == "bandage":
        _stop_bleeding()
        health = min(100.0,health + 6.0)
        pain = max(0.0,pain - 8.0)
        _stabilize_worst_injury(2.5)
        stamina = min(_survival_stamina_cap(),stamina + 3.0)
        _consume_entry_at(selected_inventory_index,1)
        _set_survival_feedback("Рана перевязана • боль снижена")

    elif use_type == "sterile_bandage":
        if not _use_sterile_bandage():
            inv_details.text = "Стерильная повязка сейчас не требуется."
            return
        _consume_entry_at(selected_inventory_index,1)

    elif use_type == "trauma_kit":
        var worst_zone = _worst_injury_zone()
        var needs_trauma = bleeding or health < 96.0 or pain > 12.0
        if worst_zone != "":
            needs_trauma = needs_trauma or _body_condition_value(worst_zone) < 94.0
        if not needs_trauma:
            inv_details.text = "Травматологический набор сейчас не требуется."
            return
        _stop_bleeding()
        health = min(100.0,health + 24.0)
        pain = max(0.0,pain - 18.0)
        _stabilize_worst_injury(12.0)
        wound_contamination = max(0.0,wound_contamination - 15.0)
        stamina = min(_survival_stamina_cap(),stamina + 5.0)
        _consume_entry_at(selected_inventory_index,1)
        _set_survival_feedback("Травматологический набор: состояние стабилизировано",2.2)

    elif use_type == "antiseptic":
        if wound_contamination <= 1.0 and wound_infection <= 1.0:
            inv_details.text = "Нет загрязнённой раны для обработки."
            return
        wound_contamination = max(0.0,wound_contamination - 55.0)
        wound_infection = max(0.0,wound_infection - 4.0)
        pain = min(100.0,pain + 1.0)
        _consume_entry_at(selected_inventory_index,1)
        _set_survival_feedback("Рана обработана антисептиком",2.0)

    elif use_type == "painkillers":
        if pain < 8.0 and painkiller_time > 60.0:
            inv_details.text = "Действие обезболивающего ещё продолжается."
            return
        painkiller_time = max(painkiller_time,240.0)
        _consume_entry_at(selected_inventory_index,1)
        _set_survival_feedback("Обезболивающее действует 4 минуты",2.0)

    elif use_type == "antibiotics":
        if wound_infection < 5.0 and wound_contamination < 45.0:
            inv_details.text = "Антибиотики сейчас не требуются."
            return
        antibiotic_time = max(antibiotic_time,900.0)
        wound_infection = max(0.0,wound_infection - 5.0)
        _consume_entry_at(selected_inventory_index,1)
        _set_survival_feedback("Начат курс антибиотика",2.0)

    elif use_type == "emergency_ration":
        hunger = min(100.0,hunger + 58.0)
        thirst = max(0.0,thirst - 4.0)
        stamina = min(_survival_stamina_cap(),stamina + 10.0)
        well_fed_time = max(well_fed_time,180.0)
        _consume_entry_at(selected_inventory_index,1)
        _set_survival_feedback("Аварийный рацион: сытно, но хочется пить",2.0)

    elif use_type == "water":
        thirst = min(100.0,thirst + 42.0)
        stamina = min(_survival_stamina_cap(),stamina + 8.0)
        _consume_entry_at(selected_inventory_index,1)
        _set_survival_feedback("Жажда утолена")

    elif use_type == "water_container":
        if not _drink_selected_water_container():
            return

    elif use_type == "dirty_water":
        var method = ""
        if _inventory_count("water_filter") > 0:
            method = "filter"
        elif _player_near_active_fire():
            method = "fire"

        if method == "":
            inv_details.text = "Дождевая вода требует фильтра или горящего костра."
            return

        if not _purify_one_dirty_water(method):
            return

    elif use_type == "water_filter":
        if _inventory_count("dirty_water") <= 0:
            inv_details.text = "Нет дождевой воды для фильтрации."
            return
        if not _purify_one_dirty_water("filter"):
            return

    elif use_type == "cook_grain":
        if not _cook_inventory_product(
            "grain",
            true,
            "hot_meal",
            "Приготовлена горячая каша"
        ):
            return

    elif use_type == "brew_tea":
        if not _cook_inventory_product(
            "herbs",
            true,
            "herbal_tea",
            "Заварен травяной чай"
        ):
            return

    elif use_type == "hot_meal":
        hunger = min(100.0,hunger + 52.0)
        thirst = min(100.0,thirst + 7.0)
        stamina = min(_survival_stamina_cap(),stamina + 12.0)
        body_temperature = min(40.5,body_temperature + 0.12)
        pain = max(0.0,pain - 2.0)
        well_fed_time = max(well_fed_time,300.0)
        _consume_entry_at(selected_inventory_index,1)
        _set_survival_feedback("Горячая еда: восстановление улучшено на 5 минут",2.0)

    elif use_type == "herbal_tea":
        thirst = min(100.0,thirst + 30.0)
        stamina = min(_survival_stamina_cap(),stamina + 7.0)
        body_temperature = min(40.5,body_temperature + 0.15)
        pain = max(0.0,pain - 3.0)
        warm_drink_time = max(warm_drink_time,240.0)
        _consume_entry_at(selected_inventory_index,1)
        _set_survival_feedback("Горячий чай: +1.5°C к ощущаемому теплу на 4 минуты",2.0)

    elif use_type == "food":
        if _player_near_active_fire():
            hunger = min(100.0,hunger + 46.0)
            thirst = max(0.0,thirst - 1.0)
            stamina = min(_survival_stamina_cap(),stamina + 8.0)
            body_temperature = min(40.5,body_temperature + 0.04)
            _consume_entry_at(selected_inventory_index,1)
            _set_survival_feedback("Еда разогрета у костра",2.0)
        else:
            hunger = min(100.0,hunger + 36.0)
            thirst = max(0.0,thirst - 2.0)
            stamina = min(_survival_stamina_cap(),stamina + 5.0)
            _consume_entry_at(selected_inventory_index,1)
            _set_survival_feedback("Вы поели")

    elif use_type == "weapon":
        _switch_weapon(id,str(inventory_entries[selected_inventory_index].get("instance_id","")))

    elif use_type == "gear":
        _equip_item(id)

    elif use_type == "bedroll":
        if not _deploy_bedroll():
            return

    elif use_type == "melee":
        _switch_melee(id)

    elif use_type == "repair":
        inv_details.text = "Ремкомплект используется у верстака → ОРУЖЕЙНИК."
        return

    elif use_type == "weapon_mod":
        _install_selected_weapon_mod()

    selected_inventory_index = -1
    call_deferred("_refresh_inventory_ui")

func _consume_entry_at(index, amount):
    if index < 0 or index >= inventory_entries.size():
        return
    var qty = int(inventory_entries[index].get("qty",1))
    qty -= amount
    if qty <= 0:
        inventory_entries.remove_at(index)
    else:
        inventory_entries[index]["qty"] = qty


func _take_selected_container():
    if active_container_key == "" or not container_states.has(active_container_key):
        return
    _ensure_weapon_runtime_state(false)

    var state = container_states[active_container_key]
    var entries = state.get("items",[])

    if selected_container_index < 0 or selected_container_index >= entries.size():
        return

    var entry = entries[selected_container_index]
    var id = str(entry.get("id",""))
    var qty = int(entry.get("qty",1))

    var remaining = _grid_add_existing_entry(inventory_entries,entry,INV_W,INV_H)
    var moved = qty - remaining

    if remaining <= 0:
        entries.remove_at(selected_container_index)
        selected_container_index = -1
    else:
        entry["qty"] = remaining
        entries[selected_container_index] = entry

    state["items"] = entries
    container_states[active_container_key] = state
    _target_farm_note_container_change(active_container_key,false)
    _award_container_discovery(active_container_key,moved)
    call_deferred("_refresh_inventory_ui")

func _store_selected_inventory():
    if active_container_key == "" or not container_states.has(active_container_key):
        return
    _ensure_weapon_runtime_state(false)
    if selected_inventory_index < 0 or selected_inventory_index >= inventory_entries.size():
        return

    var state = container_states[active_container_key]
    var entries = state.get("items", [])
    var entry = inventory_entries[selected_inventory_index]
    var id = str(entry.get("id",""))
    var qty = int(entry.get("qty",1))

    var test_entries = entries.duplicate(true)
    var container_grid = _container_grid_size(state)
    if _grid_add_existing_entry(test_entries,entry,container_grid.x,container_grid.y) != 0:
        return

    if not _prepare_item_for_drop(id,str(entry.get("instance_id",""))):
        return
    entries = test_entries
    inventory_entries.remove_at(selected_inventory_index)
    state["items"] = entries
    container_states[active_container_key] = state
    _target_farm_note_container_change(active_container_key,true)

    selected_inventory_index = -1
    call_deferred("_refresh_inventory_ui")



func _drop_selected_inventory():
    if selected_inventory_index < 0 or selected_inventory_index >= inventory_entries.size():
        return
    var entry = inventory_entries[selected_inventory_index]
    var id = str(entry.get("id",""))
    var qty = int(entry.get("qty",1))
    var original_instance_id = str(entry.get("instance_id",""))
    if not _prepare_item_for_drop(id,original_instance_id):
        reload_feedback = "Нельзя выбросить последнее доступное оружие"
        reload_feedback_time = 1.8
        return
    _cancel_reload()
    if selected_inventory_index < 0 or selected_inventory_index >= inventory_entries.size() or str(inventory_entries[selected_inventory_index].get("id","")) != id:
        var found_index = -1
        for i in range(inventory_entries.size()):
            if str(inventory_entries[i].get("id","")) == id and (original_instance_id == "" or str(inventory_entries[i].get("instance_id","")) == original_instance_id):
                found_index = i
                break
        if found_index < 0:
            return
        selected_inventory_index = found_index
    _ensure_runtime_item_instance_ids()
    entry = inventory_entries[selected_inventory_index]
    inventory_entries.remove_at(selected_inventory_index)
    # Dropped items must stay on the player's side of solid geometry. This uses
    # the same forward clamping rule as the firearm muzzle, so walls cannot be
    # used to throw loot into an inaccessible room.
    var drop_pos = _clamped_player_forward_point(aim_direction,34.0,4.0)
    var record = {"drop_id":next_drop_id,"id":id,"qty":qty,"x":drop_pos.x,"y":drop_pos.y}
    if _item_uses_instance_id(id):
        record["instance_id"] = str(entry.get("instance_id",""))
    next_drop_id += 1
    if _high_risk_floor_active():
        record["floor_poi_id"] = high_risk_floor_poi_id
        record["floor_index"] = high_risk_floor_index
    dropped_items.append(record)
    var drop_noise = 50.0 + min(45.0,_entry_total_weight(entry) * 10.0)
    _emit_ai_sound(drop_pos,drop_noise,"drop",1.0)
    if _high_risk_floor_active():
        _spawn_world_item(
            high_risk_floor_root,
            high_risk_floor_anchor_chunk,
            id,
            qty,
            drop_pos - high_risk_floor_root.global_position,
            "",
            int(record["drop_id"]),
            str(record.get("instance_id",""))
        )
    else:
        var coord = _world_to_chunk(drop_pos)
        if loaded_chunks.has(coord):
            _spawn_world_item(loaded_chunks[coord],coord,id,qty,drop_pos - loaded_chunks[coord].global_position,"",int(record["drop_id"]),str(record.get("instance_id","")))
    reload_feedback = "Выброшено: %s" % str(item_defs.get(id,{}).get("name",id))
    reload_feedback_time = 1.4
    selected_inventory_index = -1
    call_deferred("_refresh_inventory_ui")


func _update_interaction_prompt():
    if interaction_label == null:
        return
    if trader_open or contract_open:
        interaction_label.text = ""
        if hud_interaction_panel != null:
            hud_interaction_panel.visible = false
        return
    if qa_hide_interaction_prompt:
        interaction_label.text = ""
        if hud_interaction_panel != null:
            hud_interaction_panel.visible = false
        return

    if inventory_open:
        interaction_label.text = ""
        if hud_interaction_panel != null:
            hud_interaction_panel.visible = false
        return

    var target = _nearest_interactable()
    if target == null:
        interaction_label.text = ""
        if hud_interaction_panel != null:
            hud_interaction_panel.visible = false
        return

    var type = str(target.get_meta("interaction_type",""))
    var name = str(target.get_meta("display_name",""))

    if type == "world_item":
        interaction_label.text = "ПОДОБРАТЬ  •  %s" % name.to_upper()
    elif type == "container":
        interaction_label.text = "ОБЫСКАТЬ  •  %s" % name.to_upper()
    elif type == "floor_transition":
        interaction_label.text = "ПЕРЕЙТИ  •  %s" % name.to_upper()
    elif type == "door":
        var open = bool(target.get_meta("door_open",false))
        var door_condition = clamp(float(target.get_meta("door_condition",DOOR_MAX_CONDITION)),0.0,DOOR_MAX_CONDITION)
        if door_condition <= 0.01:
            interaction_label.text = "ПОЧИНИТЬ  •  ДВЕРЬ ВЫБИТА"
        elif open and _doorway_blocked(target):
            interaction_label.text = "ДВЕРЬ ЗАНЯТА"
        else:
            interaction_label.text = "%s ДВЕРЬ  •  %d%%" % [("ЗАКРЫТЬ" if open else "ОТКРЫТЬ"),int(round(door_condition))]
    elif type == "shelter_window":
        var key = str(target.get_meta("breach_key",""))
        var rec = shelter_breach_states.get(key,{})
        var max_condition = _window_condition_max(rec if typeof(rec) == TYPE_DICTIONARY else {})
        var condition = clamp(float(target.get_meta("window_condition",max_condition)),0.0,max_condition)
        var pct = int(round(condition / max(1.0,max_condition) * 100.0))
        if condition <= 0.01:
            interaction_label.text = "ПОЧИНИТЬ  •  ОКНО ПРОЛОМЛЕНО"
        elif bool(target.get_meta("window_reinforced",false)):
            interaction_label.text = "УКРЕПЛЁННОЕ ОКНО  •  %d%%" % pct
        elif condition < max_condition - 0.1:
            interaction_label.text = "ПОЧИНИТЬ ОКНО  •  %d%%" % pct
        else:
            interaction_label.text = "УКРЕПИТЬ ОКНО  •  100%"
    elif type == "workbench":
        interaction_label.text = "ВЕРСТАК  •  КРАФТ"
    elif type == "trader":
        interaction_label.text = "ТОРГОВАТЬ  •  %s" % name.to_upper()
    elif type == "contract_board":
        interaction_label.text = "КОНТРАКТЫ  •  %s" % name.to_upper()
    elif type == "supply_event_cargo":
        interaction_label.text = "ОБЕЗОПАСИТЬ ГРУЗ  •  %s" % name.to_upper()
    elif type == "faction_npc":
        interaction_label.text = "ГОВОРИТЬ  •  %s" % name.to_upper()
    elif type == "base_heater":
        interaction_label.text = "ОБОГРЕВАТЕЛЬ"
    elif type == "base_campfire":
        interaction_label.text = "КОСТЁР"
    elif type == "base_rain_collector":
        var base_id = int(target.get_meta("base_id",-1))
        var index = _base_record_index(base_id)
        var stored = 0
        if index >= 0:
            stored = int(floor(float(base_objects[index].get("stored_water",0.0))))
        interaction_label.text = "ДОЖДЕСБОРНИК  %d/%d" % [
            stored,
            int(_rain_collector_capacity())
        ]
    elif type == "base_lamp":
        interaction_label.text = "СТАЦИОНАРНАЯ ЛАМПА"
    elif type == "base_cot":
        interaction_label.text = "ОТДЫХ  •  %s" % name
    elif type == "base_barricade":
        var base_id = int(target.get_meta("base_id",-1))
        var index = _base_record_index(base_id)
        var condition = 0.0
        if index >= 0:
            condition = clamp(float(base_objects[index].get("condition",BARRICADE_MAX_CONDITION)),0.0,BARRICADE_MAX_CONDITION)
        if condition <= 0.01:
            interaction_label.text = "ПОЧИНИТЬ  •  БАРРИКАДА СЛОМАНА"
        elif condition < BARRICADE_MAX_CONDITION - 0.1:
            interaction_label.text = "ПОЧИНИТЬ  •  БАРРИКАДА %d%%" % int(round(condition))
        else:
            interaction_label.text = "БАРРИКАДА  •  100%"
    else:
        interaction_label.text = ""


    _hud_set_fitted_text(interaction_label,interaction_label.text,6,5,18,28)
    if hud_interaction_panel != null:
        hud_interaction_panel.visible = interaction_label.text != ""

func _nearest_interactable():
    var best = null
    var best_score = 999999.0

    for node in get_tree().get_nodes_in_group("interactable"):
        if not is_instance_valid(node):
            continue

        var type = str(node.get_meta("interaction_type",""))
        var limit = float(node.get_meta("interaction_radius",62.0))
        var priority = 0.0

        if type == "door":
            limit = max(limit,88.0)
            priority = 22.0
        elif type == "shelter_window":
            limit = max(limit,74.0)
            priority = 12.0
        elif type == "container":
            limit = max(limit,70.0)
            priority = 7.0
        elif type == "workbench":
            limit = max(limit,72.0)
            priority = 8.0
        elif type == "trader":
            limit = max(limit,78.0)
            priority = 16.0
        elif type == "contract_board":
            limit = max(limit,78.0)
            priority = 15.0
        elif type == "supply_event_cargo":
            limit = max(limit,86.0)
            priority = 18.0
        elif type == "faction_npc":
            limit = max(limit,76.0)
            priority = 9.0
        elif type == "base_heater" or type == "base_campfire" or type == "base_rain_collector" or type == "base_lamp" or type == "base_cot" or type == "base_barricade":
            limit = max(limit,72.0)
            priority = 6.0
        elif type == "world_item":
            limit = max(limit,54.0)

        var dist = player.global_position.distance_to(node.global_position)
        if dist > limit:
            continue
        if not _interactable_reachable(node):
            continue

        var score = dist - priority
        if score < best_score:
            best_score = score
            best = node

    return best

func _interactable_reachable(node):
    if not is_instance_valid(player) or not is_instance_valid(node):
        return false
    var start = player.global_position
    var target = node.global_position
    if start.distance_to(target) <= 1.0:
        return true
    var query = PhysicsRayQueryParameters2D.create(start,target)
    query.collision_mask = LAYER_WORLD
    query.exclude = [player.get_rid()]
    var hit = get_world_2d().direct_space_state.intersect_ray(query)
    if hit.is_empty():
        return true
    # Doors/windows/barricades are themselves world colliders. Reaching their
    # own collision body is a valid interaction; a different wall in front is not.
    var hit_breach = _collider_breach_node(hit.get("collider",null))
    return hit_breach == node

func _interact():
    var target = _nearest_interactable()
    if target == null:
        return

    var type = str(target.get_meta("interaction_type",""))
    if type == "world_item":
        _pickup_world_item(target)
    elif type == "container":
        _open_container(str(target.get_meta("container_key","")))
    elif type == "floor_transition":
        _use_high_risk_floor_transition(target)
    elif type == "door":
        _toggle_door(target)
    elif type == "shelter_window":
        _repair_shelter_window(target)
    elif type == "workbench":
        _open_crafting()
    elif type == "trader":
        _open_trader(str(target.get_meta("trader_id","")))
    elif type == "contract_board":
        _open_contract_board(str(target.get_meta("faction_id","")),str(target.get_meta("display_name","")))
    elif type == "supply_event_cargo":
        _resolve_supply_event(target)
    elif type == "faction_npc":
        _talk_faction_npc(target)
    elif type == "base_heater":
        _toggle_base_heater(target)
    elif type == "base_campfire":
        _toggle_base_campfire(target)
    elif type == "base_rain_collector":
        _collect_rainwater(target)
    elif type == "base_lamp":
        _toggle_base_lamp(target)
    elif type == "base_cot":
        _open_rest_panel(target)
    elif type == "base_barricade":
        _repair_base_barricade(target)

func _pickup_world_item(node):
    if not is_instance_valid(node) or node.is_queued_for_deletion():
        return
    var id = str(node.get_meta("item_id",""))
    var qty = int(node.get_meta("qty",1))
    var instance_id = str(node.get_meta("instance_id",""))

    var remaining = qty
    if _item_uses_instance_id(id) and instance_id != "":
        remaining = _grid_add_existing_entry(inventory_entries,{"id":id,"qty":1,"instance_id":instance_id},INV_W,INV_H)
    else:
        remaining = _grid_add(inventory_entries,id,qty,INV_W,INV_H)
    var moved = qty - remaining

    if moved <= 0:
        return

    var pickup_key = str(node.get_meta("pickup_key",""))
    var drop_id = int(node.get_meta("drop_id",-1))
    # Retire a fixed spawn as soon as any units move. Its remainder becomes an
    # ordinary persistent drop, using the existing save format and chunk loader.
    if pickup_key != "":
        picked_world_items[pickup_key] = true
    if remaining > 0:
        var record_index = -1
        for i in range(dropped_items.size()):
            if int(dropped_items[i].get("drop_id",-2)) == drop_id:
                record_index = i
                break
        if record_index >= 0:
            dropped_items[record_index]["qty"] = remaining
        else:
            drop_id = next_drop_id
            next_drop_id += 1
            var record = {"drop_id":drop_id,"id":id,"qty":remaining,
                "x":node.global_position.x,"y":node.global_position.y}
            if instance_id != "":
                record["instance_id"] = instance_id
            dropped_items.append(record)
        node.set_meta("qty",remaining)
        node.set_meta("drop_id",drop_id)
        node.set_meta("pickup_key","")
    else:
        if drop_id >= 0:
            for i in range(dropped_items.size() - 1,-1,-1):
                if int(dropped_items[i].get("drop_id",-2)) == drop_id:
                    dropped_items.remove_at(i)
                    break
        node.queue_free()
    _refresh_inventory_ui()


