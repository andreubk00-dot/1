func _enemy_has_line_of_sight(enemy):
    var query = PhysicsRayQueryParameters2D.create(
        enemy.global_position,
        player.global_position
    )
    query.collision_mask = LAYER_WORLD
    query.exclude = [enemy.get_rid()]
    var hit = get_world_2d().direct_space_state.intersect_ray(query)
    return hit.is_empty()


func _enemy_memory_goal(enemy,state):
    var target = enemy.global_position
    if state == "chase":
        target = enemy.get_meta("last_known_position",target)
    elif state == "investigate":
        target = enemy.get_meta("heard_position",target)
    elif state == "search":
        target = enemy.get_meta("search_anchor",target)
    else:
        return null
    return target if typeof(target) == TYPE_VECTOR2 else null

func _breach_node_active(node):
    if not is_instance_valid(node):
        return false
    if node.has_meta("door_key"):
        return not bool(node.get_meta("door_open",false)) and float(node.get_meta("door_condition",DOOR_MAX_CONDITION)) > 0.01
    if str(node.get_meta("interaction_type","")) == "shelter_window":
        return float(node.get_meta("window_condition",WINDOW_MAX_CONDITION)) > 0.01
    if str(node.get_meta("base_kind","")) == "barricade":
        return float(node.get_meta("barricade_condition",BARRICADE_MAX_CONDITION)) > 0.01
    return false

func _breach_node_strength_ratio(node):
    if not is_instance_valid(node):
        return 1.0
    if node.has_meta("door_key"):
        return clamp(float(node.get_meta("door_condition",DOOR_MAX_CONDITION)) / DOOR_MAX_CONDITION,0.0,1.0)
    if str(node.get_meta("interaction_type","")) == "shelter_window":
        var key = str(node.get_meta("breach_key",""))
        var rec = shelter_breach_states.get(key,{})
        var maximum = _window_condition_max(rec if typeof(rec) == TYPE_DICTIONARY else {})
        return clamp(float(node.get_meta("window_condition",maximum)) / max(1.0,maximum),0.0,1.0)
    if str(node.get_meta("base_kind","")) == "barricade":
        return clamp(float(node.get_meta("barricade_condition",BARRICADE_MAX_CONDITION)) / BARRICADE_MAX_CONDITION,0.0,1.0)
    return 1.0

func _breach_node_open(node):
    if not is_instance_valid(node):
        return false
    if node.has_meta("door_key"):
        return bool(node.get_meta("door_open",false)) or float(node.get_meta("door_condition",DOOR_MAX_CONDITION)) <= 0.01
    if str(node.get_meta("interaction_type","")) == "shelter_window":
        return float(node.get_meta("window_condition",WINDOW_MAX_CONDITION)) <= 0.01
    if str(node.get_meta("base_kind","")) == "barricade":
        return float(node.get_meta("barricade_condition",BARRICADE_MAX_CONDITION)) <= 0.01
    return false

func _register_shelter_assault_hit(node,_enemy = null,_extra_gain = 0.0):
    # Compatibility name retained for older test/tools. A hit now only marks the
    # home as recently attacked; no hidden pressure meter changes combat tempo.
    if not is_instance_valid(node):
        return
    if _defense_point_belongs_home(node):
        shelter_assault_last_event_ms = Time.get_ticks_msec()

func _home_rect_contains_enemy(enemy,known_rect = Rect2()):
    if not is_instance_valid(enemy):
        return false
    var rect = known_rect if known_rect.has_area() else _home_supply_bounds()
    if not rect.has_area():
        return false
    # Small inset avoids counting an infected whose collision center is still
    # sitting directly on the exterior threshold.
    var inner = rect.grow(-4.0)
    if not inner.has_area():
        inner = rect
    return inner.has_point(enemy.global_position)

func _defense_point_belongs_home(node):
    if not is_instance_valid(node):
        return false
    var rect = _home_supply_bounds()
    return rect.has_area() and rect.grow(28.0).has_point(node.global_position)

func _shelter_intruders_block_repair(node):
    if not _defense_point_belongs_home(node):
        return false
    if shelter_intruders_active > 0:
        return true
    var home_rect = _home_supply_bounds()
    for enemy in get_tree().get_nodes_in_group("infected"):
        if _home_rect_contains_enemy(enemy,home_rect):
            return true
    return false

func _shelter_assault_state_text():
    if shelter_intruders_active > 0:
        return "ПРОНИКНОВЕНИЕ"
    if Time.get_ticks_msec() - shelter_assault_last_event_ms < SHELTER_ASSAULT_HIT_GRACE_MS:
        return "ИДЁТ АТАКА"
    return ""

func _update_shelter_assault(_delta):
    # Keep only the information the player actually needs: is somebody inside?
    # Perimeter HP and breach state are already authoritative elsewhere.
    var home_rect = _home_supply_bounds()
    var player_home = is_instance_valid(player) and home_rect.has_area() and home_rect.has_point(player.global_position)
    var intruders = 0
    for enemy in get_tree().get_nodes_in_group("infected"):
        if not is_instance_valid(enemy):
            continue
        var inside = _home_rect_contains_enemy(enemy,home_rect)
        var was_inside = bool(enemy.get_meta("shelter_intruder",false))
        enemy.set_meta("shelter_intruder",inside)
        if not inside:
            continue
        intruders += 1
        if not was_inside and player_home:
            _set_survival_feedback("Заражённый проник в убежище",2.2)
        if player_home:
            var intruder_state = str(enemy.get_meta("ai_state","idle"))
            if intruder_state != "chase" and intruder_state != "search":
                enemy.set_meta("ai_state","search")
            enemy.set_meta("ai_state_time",max(float(enemy.get_meta("ai_state_time",0.0)),5.0))
            enemy.set_meta("search_anchor",player.global_position)
            enemy.set_meta("heard_position",player.global_position)
            enemy.set_meta("suspicion",max(float(enemy.get_meta("suspicion",0.0)),58.0))
    shelter_intruders_active = intruders
    if is_instance_valid(player):
        player.set_meta("shelter_intruders_active",shelter_intruders_active)

func _collider_breach_node(collider):
    if not is_instance_valid(collider):
        return null
    if collider.has_meta("breachable_door"):
        return collider.get_meta("breachable_door")
    if collider.has_meta("breachable_window"):
        return collider.get_meta("breachable_window")
    if collider.has_meta("breachable_barricade"):
        return collider.get_meta("breachable_barricade")
    return null

func _breach_candidate_crowd(candidate,exclude_enemy = null):
    if not is_instance_valid(candidate):
        return 0
    var count = 0
    for other in get_tree().get_nodes_in_group("infected"):
        if not is_instance_valid(other) or other == exclude_enemy:
            continue
        if other.global_position.distance_to(candidate.global_position) <= 34.0:
            count += 1
    return count

func _breach_candidate_lane_bias(enemy,candidate):
    if not is_instance_valid(enemy) or not is_instance_valid(candidate):
        return 0.0
    var sid = int(enemy.get_meta("spawn_id",0))
    var px = int(round(candidate.global_position.x))
    var py = int(round(candidate.global_position.y))
    # Stable per-infected preference prevents a whole pack from choosing the exact
    # same equally-good opening before crowding is visible around it.
    var mixed = abs(sid * 37 + px * 11 + py * 17)
    return float(mixed % 13)

func _open_entry_inside_target(entry,goal):
    if not is_instance_valid(entry) or typeof(goal) != TYPE_VECTOR2:
        return entry.global_position if is_instance_valid(entry) else Vector2.ZERO
    var through = goal - entry.global_position
    if through.length() < 0.01:
        return entry.global_position
    # Do not stop on the breach threshold. Aim a short distance through it so the
    # infected body fully crosses the wall/window collision line and becomes a
    # real shelter intruder instead of hovering on the opening.
    return entry.global_position + through.normalized() * 28.0

func _enemy_preferred_open_entry(enemy,state):
    var goal = _enemy_memory_goal(enemy,state)
    if goal == null:
        return null
    var offset = goal - enemy.global_position
    if offset.length() < 28.0:
        return null
    var direct_query = PhysicsRayQueryParameters2D.create(enemy.global_position,enemy.global_position + offset.limit_length(120.0),LAYER_WORLD)
    direct_query.exclude = [enemy.get_rid()]
    var direct_hit = get_world_2d().direct_space_state.intersect_ray(direct_query)
    if direct_hit.is_empty():
        return null
    var goal_dir = offset.normalized()
    var best = null
    var best_score = 999999.0
    for candidate in get_tree().get_nodes_in_group("shelter_defense_points"):
        if not _breach_node_open(candidate):
            continue
        var to_candidate = candidate.global_position - enemy.global_position
        var dist = to_candidate.length()
        if dist < 10.0 or dist > 230.0:
            continue
        if to_candidate.normalized().dot(goal_dir) < -0.08:
            continue
        if candidate.global_position.distance_to(goal) > offset.length() + 75.0:
            continue
        var query = PhysicsRayQueryParameters2D.create(enemy.global_position,candidate.global_position,LAYER_WORLD)
        query.exclude = [enemy.get_rid()]
        var hit = get_world_2d().direct_space_state.intersect_ray(query)
        if not hit.is_empty():
            var hit_node = _collider_breach_node(hit.get("collider",null))
            if hit_node != candidate:
                continue
        var crowd_penalty = float(_breach_candidate_crowd(candidate,enemy)) * 10.0
        var lane_bias = _breach_candidate_lane_bias(enemy,candidate) * 0.35
        var score = dist + candidate.global_position.distance_to(goal) * 0.10 + crowd_penalty + lane_bias
        if score < best_score:
            best_score = score
            best = candidate
    return best

# If the direct remembered route ends in a solid wall, nearby visible doors/windows/
# barricades become approach points. This is local steering, not a second AI system:
# the existing chase/investigate/search memory remains authoritative.
func _enemy_preferred_breach_point(enemy,state):
    var goal = _enemy_memory_goal(enemy,state)
    if goal == null:
        return null
    var offset = goal - enemy.global_position
    if offset.length() < 40.0:
        return null
    var direct_query = PhysicsRayQueryParameters2D.create(enemy.global_position,enemy.global_position + offset.limit_length(120.0),LAYER_WORLD)
    direct_query.exclude = [enemy.get_rid()]
    var direct_hit = get_world_2d().direct_space_state.intersect_ray(direct_query)
    if direct_hit.is_empty():
        return null
    if is_instance_valid(_collider_breach_node(direct_hit.get("collider",null))):
        return null

    var candidates = []
    candidates.append_array(get_tree().get_nodes_in_group("doors"))
    candidates.append_array(get_tree().get_nodes_in_group("shelter_windows"))
    for base_node in get_tree().get_nodes_in_group("base_objects"):
        if is_instance_valid(base_node) and str(base_node.get_meta("base_kind","")) == "barricade":
            candidates.append(base_node)

    var best = null
    var best_score = 999999.0
    var goal_dir = offset.normalized()
    for candidate in candidates:
        if not _breach_node_active(candidate):
            continue
        var to_candidate = candidate.global_position - enemy.global_position
        var dist = to_candidate.length()
        if dist < 30.0 or dist > 185.0:
            continue
        if to_candidate.normalized().dot(goal_dir) < 0.05:
            continue
        if candidate.global_position.distance_to(goal) > offset.length() + 45.0:
            continue
        var query = PhysicsRayQueryParameters2D.create(enemy.global_position,candidate.global_position,LAYER_WORLD)
        query.exclude = [enemy.get_rid()]
        var hit = get_world_2d().direct_space_state.intersect_ray(query)
        if hit.is_empty():
            continue
        var hit_node = _collider_breach_node(hit.get("collider",null))
        if hit_node != candidate:
            continue
        var crowd_penalty = float(_breach_candidate_crowd(candidate,enemy)) * 19.0
        var lane_bias = _breach_candidate_lane_bias(enemy,candidate)
        var score = dist + candidate.global_position.distance_to(goal) * 0.18 + _breach_node_strength_ratio(candidate) * 22.0 + crowd_penalty + lane_bias
        if score < best_score:
            best_score = score
            best = candidate
    return best

# Attack only the first real breachable obstruction toward a remembered goal.
# No remembered goal means no attacks through walls.
func _enemy_breachable_obstacle(enemy,state):
    var target = _enemy_memory_goal(enemy,state)
    if target == null:
        return null
    var offset = target - enemy.global_position
    if offset.length() < 1.0:
        return null
    var query = PhysicsRayQueryParameters2D.create(enemy.global_position,
        enemy.global_position + offset.limit_length(36.0),LAYER_WORLD)
    var hit = get_world_2d().direct_space_state.intersect_ray(query)
    if hit.is_empty():
        return null
    var collider = hit["collider"]
    if not is_instance_valid(collider):
        return null
    var breach_node = _collider_breach_node(collider)
    if _breach_node_active(breach_node):
        return breach_node
    return null

# Kept as a compatibility wrapper for the 0.95 regression harness.
func _enemy_door_obstacle(enemy,state):
    var obstacle = _enemy_breachable_obstacle(enemy,state)
    if is_instance_valid(obstacle) and obstacle.has_meta("door_key"):
        return obstacle
    return null

func _enemy_strike_door(enemy,door):
    if not is_instance_valid(door) or bool(door.get_meta("door_open",false)):
        return false
    var key = str(door.get_meta("door_key",""))
    var rec = _door_defense_record(door)
    var condition = max(0.0,float(rec.get("condition",DOOR_MAX_CONDITION)) - DOOR_HIT_DAMAGE)
    rec["condition"] = condition
    _set_breach_state_record(key,rec)
    door.set_meta("breach_last_hit_ms",Time.get_ticks_msec())
    door.set_meta("breach_attack_dir",(enemy.global_position - door.global_position).normalized())
    door.set_meta("breach_impact",0.35)
    enemy.set_meta("ai_facing",(door.global_position - enemy.global_position).normalized())
    _refresh_door_defense(door)

    # One source of truth: the door opens when its structural HP reaches zero.
    if condition <= 0.01:
        var local_enemy = door.to_local(enemy.global_position)
        door.set_meta("door_swing",-PI * 0.5 if local_enemy.y >= 0.0 else PI * 0.5)
        door_states[key] = true
        _apply_door_state(door,true,false)
        if player != null and player.global_position.distance_to(door.global_position) <= 260.0:
            _set_survival_feedback("Дверь выбита",2.0)
    _register_shelter_assault_hit(door,enemy)
    _emit_ai_sound(door.global_position,125.0,"door",1.2,enemy)
    return true

func _enemy_strike_window(enemy,window_node):
    if not _breach_node_active(window_node):
        return false
    var key = str(window_node.get_meta("breach_key",""))
    var rec = shelter_breach_states.get(key,{})
    if typeof(rec) != TYPE_DICTIONARY:
        rec = _breach_state_record(key,"window",WINDOW_MAX_CONDITION)
    var condition = max(0.0,float(rec.get("condition",_window_condition_max(rec))) - WINDOW_HIT_DAMAGE)
    rec["condition"] = condition
    _set_breach_state_record(key,rec)
    window_node.set_meta("breach_last_hit_ms",Time.get_ticks_msec())
    window_node.set_meta("breach_attack_dir",(enemy.global_position - window_node.global_position).normalized())
    window_node.set_meta("breach_impact",0.32)
    enemy.set_meta("ai_facing",(window_node.global_position - enemy.global_position).normalized())
    _refresh_shelter_window(window_node)
    _register_shelter_assault_hit(window_node,enemy)
    _emit_ai_sound(window_node.global_position,112.0,"door",1.05,enemy)
    if condition <= 0.01 and player != null and player.global_position.distance_to(window_node.global_position) <= 260.0:
        _set_survival_feedback("Окно проломлено",2.0)
    return true

func _enemy_strike_barricade(enemy,barricade):
    if not is_instance_valid(barricade):
        return false
    var base_id = int(barricade.get_meta("base_id",-1))
    var index = _base_record_index(base_id)
    if index < 0:
        return false
    var rec = base_objects[index]
    if str(rec.get("kind","")) != "barricade":
        return false
    var condition = clamp(float(rec.get("condition",BARRICADE_MAX_CONDITION)),0.0,BARRICADE_MAX_CONDITION)
    if condition <= 0.01:
        return false

    condition = max(0.0,condition - BARRICADE_HIT_DAMAGE)
    rec["condition"] = condition
    base_objects[index] = rec
    barricade.set_meta("breach_impact",0.34)
    barricade.set_meta("breach_last_hit_ms",Time.get_ticks_msec())
    barricade.set_meta("breach_attack_dir",(enemy.global_position - barricade.global_position).normalized())
    enemy.set_meta("ai_facing",(barricade.global_position - enemy.global_position).normalized())
    _refresh_base_object_node(base_id)
    _register_shelter_assault_hit(barricade,enemy)
    _emit_ai_sound(barricade.global_position,118.0,"door",1.15,enemy)
    if condition <= 0.01 and player != null and player.global_position.distance_to(barricade.global_position) <= 260.0:
        _set_survival_feedback("Баррикада проломлена",2.2)
    return true

func _enemy_can_hit_player(enemy):
    return enemy.global_position.distance_to(player.global_position) < 25.0 and _enemy_has_line_of_sight(enemy)


func _enemy_detects_player(enemy,dist):
    if developer_no_aggro:
        return false
    var radius = _enemy_vision_radius(enemy)
    if dist > radius:
        return false

    if not _enemy_has_line_of_sight(enemy):
        return false

    if dist <= 42.0:
        return true

    # During pursuit/search infected scan more aggressively.
    var state = str(enemy.get_meta("ai_state","idle"))
    if state == "chase" or state == "search":
        return true

    # Flashlight can give the player away even from outside the normal cone.
    if _player_has_active_flashlight():
        return true

    var facing = enemy.get_meta("ai_facing",Vector2.RIGHT)
    if typeof(facing) != TYPE_VECTOR2 or facing.length() <= 0.01:
        facing = Vector2.RIGHT
    else:
        facing = facing.normalized()

    var to_player = player.global_position - enemy.global_position
    if to_player.length() <= 0.01:
        return true
    to_player = to_player.normalized()

    # Wide peripheral cone; the player can still approach from behind.
    return facing.dot(to_player) >= -0.25


func _enemy_move_speed(enemy,multiplier = 1.0) -> float:
    if not is_instance_valid(enemy):
        return ENEMY_SPEED * float(multiplier)
    return ENEMY_SPEED * clamp(float(enemy.get_meta("speed_mult",1.0)),0.65,1.30) * float(multiplier)


func _update_enemies(delta):
    var enemies = get_tree().get_nodes_in_group("infected")

    for enemy in enemies:
        if not is_instance_valid(enemy) or enemy.is_queued_for_deletion() or bool(enemy.get_meta("spawn_pending",false)):
            continue

        if developer_no_aggro:
            _developer_force_enemy_passive(enemy)
            continue

        var dist = enemy.global_position.distance_to(player.global_position)
        var attack_cd = max(0.0,float(enemy.get_meta("attack_cd",0.0)) - delta)
        var attack_anim = max(0.0,float(enemy.get_meta("attack_anim",0.0)) - delta)
        var stagger = max(0.0,float(enemy.get_meta("stagger",0.0)) - delta)
        var knockback = enemy.get_meta("knockback_velocity",Vector2.ZERO)
        if typeof(knockback) != TYPE_VECTOR2:
            knockback = Vector2.ZERO

        var previous_visual_position = enemy.global_position
        var walk = float(enemy.get_meta("walk",0.0))
        var idle_visual_time = float(enemy.get_meta("idle_visual_time",0.0)) + delta
        var state = str(enemy.get_meta("ai_state","idle"))
        if not _ai_state_valid(state):
            state = "idle"

        var state_time = max(0.0,float(enemy.get_meta("ai_state_time",0.0)) - delta)
        var suspicion = max(0.0,float(enemy.get_meta("suspicion",0.0)) - delta * 2.6)
        var lost_sight = max(0.0,float(enemy.get_meta("lost_sight_time",0.0)))
        var sense_cd = max(0.0,float(enemy.get_meta("sense_cd",0.0)) - delta)
        var sees_player = bool(enemy.get_meta("can_see_player",false))

        # Staggered vision checks reduce raycast load while keeping reaction responsive.
        if sense_cd <= 0.0:
            sees_player = _enemy_detects_player(enemy,dist)
            enemy.set_meta("can_see_player",sees_player)

            var sid = int(enemy.get_meta("spawn_id",0))
            sense_cd = 0.16 + float(sid % 5) * 0.018

            if sees_player:
                enemy.set_meta("last_known_position",player.global_position)

                var vision_radius = max(1.0,_enemy_vision_radius(enemy))
                var visual_strength = 1.0 - clamp(dist / vision_radius,0.0,1.0)
                suspicion = min(100.0,suspicion + 18.0 + visual_strength * 34.0)

                if state == "chase" or suspicion >= 42.0 or dist < 55.0:
                    state = "chase"
                    state_time = 4.0
                    lost_sight = 0.0
                elif state != "chase":
                    state = "suspicious"
                    state_time = max(state_time,1.10)

        if state == "chase":
            if sees_player:
                lost_sight = 0.0
                enemy.set_meta("last_known_position",player.global_position)
            else:
                lost_sight += delta

            if lost_sight >= 2.2:
                state = "search"
                state_time = 6.5
                lost_sight = 0.0
                enemy.set_meta(
                    "search_anchor",
                    enemy.get_meta("last_known_position",enemy.global_position)
                )
                enemy.set_meta("search_phase",0)

        if (stagger > 0.0 or knockback.length() > 1.0) and (_infected_is_calling(enemy) or _infected_is_spitting(enemy)):
            _infected_interrupt_special(enemy)
        var special_action_lock = _infected_update_special_action(enemy,state,sees_player,dist,delta)

        var blocked_obstacle = null
        var open_entry = null
        var breach_approach = null
        if stagger <= 0.0 and knockback.length() <= 1.0:
            var already_inside_home = _home_rect_contains_enemy(enemy)
            if not already_inside_home:
                blocked_obstacle = _enemy_breachable_obstacle(enemy,state)
                if not is_instance_valid(blocked_obstacle):
                    # Once a passage exists, use it before spending time on another
                    # intact barrier. If no open entry is practical, fall back to the
                    # established weak-point selection.
                    open_entry = _enemy_preferred_open_entry(enemy,state)
                    if not is_instance_valid(open_entry):
                        breach_approach = _enemy_preferred_breach_point(enemy,state)
        if is_instance_valid(blocked_obstacle):
            # Keep the remembered goal while working through the actual obstruction.
            state_time = max(state_time,1.5)
            lost_sight = min(lost_sight,1.0)
            if attack_cd <= 0.0:
                var struck = false
                if blocked_obstacle.has_meta("door_key"):
                    struck = _enemy_strike_door(enemy,blocked_obstacle)
                elif str(blocked_obstacle.get_meta("interaction_type","")) == "shelter_window":
                    struck = _enemy_strike_window(enemy,blocked_obstacle)
                elif str(blocked_obstacle.get_meta("base_kind","")) == "barricade":
                    struck = _enemy_strike_barricade(enemy,blocked_obstacle)
                if struck:
                    attack_cd = 1.20
                    attack_anim = 0.26

        # Knockback/stagger overrides locomotion, but state/memory continue updating.
        if knockback.length() > 1.0:
            enemy.velocity = knockback
            enemy.move_and_slide()
            knockback = knockback.move_toward(Vector2.ZERO,520.0 * delta)

        elif stagger > 0.0:
            enemy.velocity = Vector2.ZERO

        elif special_action_lock:
            # Special windups plant the infected in place and remain interruptible by damage/stopping power.
            enemy.velocity = Vector2.ZERO
            var special_face_target = player.global_position
            if _infected_is_spitting(enemy):
                special_face_target = enemy.get_meta("spit_target",player.global_position)
            var special_face = special_face_target - enemy.global_position
            if special_face.length() > 0.01:
                enemy.set_meta("ai_facing",special_face.normalized())

        elif is_instance_valid(open_entry):
            # A breached/open point is a route, not another attack target.
            state_time = max(state_time,1.8)
            lost_sight = min(lost_sight,1.0)
            var remembered_goal = _enemy_memory_goal(enemy,state)
            var entry_target = _open_entry_inside_target(open_entry,remembered_goal)
            _enemy_move_toward(enemy,entry_target,_enemy_move_speed(enemy),enemies)
            enemy.set_meta("assault_entry_key",str(open_entry.get_meta("breach_key",open_entry.get_meta("door_key",""))))
            enemy.set_meta("assault_entry_target",entry_target)

        elif is_instance_valid(breach_approach):
            # Local steering toward an actual entry point prevents infected from
            # endlessly leaning on a blank wall when a visible weak point is nearby.
            state_time = max(state_time,1.6)
            _enemy_move_toward(enemy,breach_approach.global_position,_enemy_move_speed(enemy,0.88),enemies)

        elif state == "chase":
            var chase_target = enemy.get_meta("last_known_position",player.global_position)
            if sees_player:
                chase_target = player.global_position
            _enemy_move_toward(enemy,chase_target,_enemy_move_speed(enemy),enemies)

        elif state == "suspicious":
            enemy.velocity = Vector2.ZERO

            var look_target = enemy.get_meta("heard_position",player.global_position)
            if typeof(look_target) == TYPE_VECTOR2:
                var face = look_target - enemy.global_position
                if face.length() > 0.01:
                    enemy.set_meta("ai_facing",face.normalized())

            if state_time <= 0.0:
                if suspicion > 5.0:
                    state = "investigate"
                    state_time = 5.0
                else:
                    state = "idle"

        elif state == "investigate":
            var investigate_target = enemy.get_meta("heard_position",enemy.global_position)
            if typeof(investigate_target) != TYPE_VECTOR2:
                investigate_target = enemy.global_position

            _enemy_move_toward(enemy,investigate_target,_enemy_move_speed(enemy,0.80),enemies)

            if enemy.global_position.distance_to(investigate_target) <= 10.0 or state_time <= 0.0:
                state = "search"
                state_time = 5.5
                enemy.set_meta("search_anchor",investigate_target)
                enemy.set_meta("search_phase",0)

        elif state == "search":
            var search_target = _enemy_search_target(enemy)
            _enemy_move_toward(enemy,search_target,_enemy_move_speed(enemy,0.67),enemies)

            if enemy.global_position.distance_to(search_target) <= 10.0:
                enemy.set_meta("search_phase",int(enemy.get_meta("search_phase",0)) + 1)

            if state_time <= 0.0:
                state = "return"
                state_time = 8.0
                suspicion = min(suspicion,12.0)

        elif state == "return":
            var home = enemy.get_meta("home_position",enemy.global_position)
            if typeof(home) != TYPE_VECTOR2:
                home = enemy.global_position

            _enemy_move_toward(enemy,home,_enemy_move_speed(enemy,0.70),enemies)

            if enemy.global_position.distance_to(home) <= 12.0 or state_time <= 0.0:
                state = "idle"
                state_time = 0.0
                suspicion = 0.0
                enemy.velocity = Vector2.ZERO

        else:
            # Idle infected slowly scan their surroundings rather than pathfinding.
            enemy.velocity = Vector2.ZERO
            var sid_idle = int(enemy.get_meta("spawn_id",0))
            var idle_angle = idle_visual_time * 0.10 + float(sid_idle % 7)
            enemy.set_meta("ai_facing",Vector2(cos(idle_angle),sin(idle_angle)))

        # Advance gait from actual travelled distance, not wall-clock time. This
        # prevents infected from moonwalking when blocked by walls or each other.
        var moved_visual_distance = previous_visual_position.distance_to(enemy.global_position)
        if moved_visual_distance > 0.02:
            walk = fposmod(walk + (moved_visual_distance / 34.0) * TAU,TAU)

        var visual = enemy.get_meta("visual_node",null)
        if is_instance_valid(visual):
            var moving_visual = enemy.velocity.length() > 1.0
            var facing_visual = enemy.velocity.normalized() if moving_visual else enemy.get_meta("ai_facing",Vector2.RIGHT)
            if typeof(facing_visual) != TYPE_VECTOR2 or facing_visual.length() < 0.05:
                facing_visual = Vector2.RIGHT
            var visual_dir = _direction8_from_vector(facing_visual,int(enemy.get_meta("infected_visual_dir",0)))
            enemy.set_meta("infected_visual_dir",visual_dir)

            var attack_offset = Vector2.ZERO
            if attack_anim > 0.0:
                var attack_progress = 1.0 - attack_anim / 0.26
                # The 0.77 attack sheet already contains the body lunge; only a tiny
                # root impulse is kept so collision and shadow do not visibly detach.
                attack_offset = facing_visual.normalized() * sin(clamp(attack_progress,0.0,1.0) * PI) * 0.8
            var idle_sway = 0.0 if moving_visual else sin(idle_visual_time * 1.35 + float(int(enemy.get_meta("spawn_id",0)) % 11)) * 0.18
            visual.position = attack_offset + Vector2(idle_sway,sin(walk) * (0.32 if moving_visual else 0.0))
            var call_telegraph = _infected_is_calling(enemy)
            var spit_telegraph = _infected_is_spitting(enemy)
            var special_telegraph = call_telegraph or spit_telegraph
            var special_pulse = 1.0 + (0.045 + sin(idle_visual_time * 15.0) * 0.018 if special_telegraph else 0.0)
            visual.scale = Vector2.ONE * special_pulse
            var infected_shadow = enemy.get_meta("infected_shadow",null)
            if is_instance_valid(infected_shadow):
                infected_shadow.scale = Vector2(1.0 - abs(sin(walk)) * 0.025 if moving_visual else 1.0,1.0 + abs(sin(walk)) * 0.010 if moving_visual else 1.0)

            var infected_sprite = enemy.get_meta("infected_sprite",null)
            if is_instance_valid(infected_sprite):
                if _infected_is_calling(enemy):
                    infected_sprite.modulate = Color(1.0,0.68,0.54,1.0)
                elif _infected_is_spitting(enemy):
                    infected_sprite.modulate = Color(0.64,1.0,0.48,1.0)
                elif str(enemy.get_meta("special_role","")) == "carrier":
                    infected_sprite.modulate = Color(0.82,0.94,0.58,1.0)
                else:
                    infected_sprite.modulate = Color.WHITE
                var infected_variant = int(enemy.get_meta("infected_variant",0))
                var row8 = infected_variant * 8 + visual_dir
                var frame = 0
                var qa_attack_frame = int(enemy.get_meta("qa_attack_frame",-1))
                if qa_attack_frame >= 0:
                    if infected_sprite.texture == null or infected_sprite.texture.resource_path != "res://infected_attack_v12.png":
                        infected_sprite.texture = load("res://infected_attack_v12.png")
                    frame = clamp(qa_attack_frame,0,INFECTED_ATTACK_FRAMES - 1)
                elif attack_anim > 0.0:
                    if infected_sprite.texture == null or infected_sprite.texture.resource_path != "res://infected_attack_v12.png":
                        infected_sprite.texture = load("res://infected_attack_v12.png")
                    var attack_progress = clamp(1.0 - attack_anim / 0.26,0.0,1.0)
                    frame = min(INFECTED_ATTACK_FRAMES - 1,int(floor(attack_progress * INFECTED_ATTACK_FRAMES)))
                else:
                    if infected_sprite.texture == null or infected_sprite.texture.resource_path != "res://infected_walk_v12.png":
                        infected_sprite.texture = load("res://infected_walk_v12.png")
                    if moving_visual:
                        frame = int(floor(fposmod(walk,TAU) / TAU * float(INFECTED_WALK_FRAMES))) % INFECTED_WALK_FRAMES
                infected_sprite.region_rect = Rect2(frame * INFECTED_CELL,row8 * INFECTED_CELL,INFECTED_CELL,INFECTED_CELL)

            if stagger > 0.0:
                visual.rotation = sin(stagger * 22.0) * 0.055
            else:
                visual.rotation = 0.0

        dist = enemy.global_position.distance_to(player.global_position)
        if (
            state == "chase"
            and dist < 25.0
            and attack_cd <= 0.0
            and stagger <= 0.0
            and knockback.length() <= 1.0
            and _enemy_can_hit_player(enemy)
        ):
            attack_cd = max(0.58,float(enemy.get_meta("attack_interval",0.9)))
            attack_anim = 0.26
            _apply_enemy_hit(float(enemy.get_meta("attack_damage",8.0)))

        enemy.set_meta("ai_state",state)
        enemy.set_meta("attack_anim",attack_anim)
        enemy.set_meta("ai_state_time",state_time)
        enemy.set_meta("suspicion",suspicion)
        enemy.set_meta("lost_sight_time",lost_sight)
        enemy.set_meta("sense_cd",sense_cd)
        enemy.set_meta("alert",state_time if state != "idle" else 0.0)
        enemy.set_meta("attack_cd",attack_cd)
        enemy.set_meta("stagger",stagger)
        enemy.set_meta("knockback_velocity",knockback)
        enemy.set_meta("walk",walk)
        enemy.set_meta("idle_visual_time",idle_visual_time)

func _safe_enemy_spawn(rng):
    if rng.randf() < 0.5:
        return Vector2(
            rng.randi_range(55, CHUNK_SIZE - 55),
            rng.randi_range(326, 434)
        )
    return Vector2(
        rng.randi_range(303, 407),
        rng.randi_range(55, CHUNK_SIZE - 55)
    )


func _consume_one_item_from_entries(entries,id):
    for i in range(entries.size() - 1,-1,-1):
        if str(entries[i].get("id","")) != id:
            continue
        var qty = int(entries[i].get("qty",1))
        qty -= 1
        if qty <= 0:
            entries.remove_at(i)
        else:
            entries[i]["qty"] = qty
        return true
    return false

func _eq_name(slot):
    var id = str(equipment.get(slot,""))
    if id == "":
        return "-"
    if item_defs.has(id):
        return str(item_defs[id].get("short",id))
    return id


func _slot_name(slot):
    match slot:
        "head":
            return "ГОЛОВА"
        "body":
            return "БРОНЯ"
        "outerwear":
            return "ВЕРХНЯЯ ОДЕЖДА"
        "rig":
            return "РАЗГРУЗКА"
        "backpack":
            return "РЮКЗАК"
        "utility":
            return "УТИЛИТА"
    return slot.to_upper()


func _ensure_equipment_slots(migrate_legacy = true):
    if typeof(equipment) != TYPE_DICTIONARY:
        equipment = {}
    for slot_id in EQUIPMENT_SLOT_IDS:
        if not equipment.has(slot_id):
            equipment[slot_id] = ""

    if not migrate_legacy:
        return

    # 1.19 migration: jackets used to occupy the armor/body slot. Move any
    # correctly registered gear into its canonical slot when that slot is free.
    for slot_id in EQUIPMENT_SLOT_IDS:
        var equipped_id = str(equipment.get(slot_id,""))
        if equipped_id == "" or not item_defs.has(equipped_id):
            continue
        var expected_slot = str(item_defs[equipped_id].get("slot",""))
        if expected_slot == "" or expected_slot == slot_id or not equipment.has(expected_slot):
            continue
        if str(equipment.get(expected_slot,"")) == "":
            equipment[expected_slot] = equipped_id
            equipment[slot_id] = ""


func _equip_item(id):
    _ensure_equipment_slots()
    if not item_defs.has(id):
        return
    var item = item_defs[id]
    if str(item.get("use","")) != "gear":
        return

    var slot = str(item.get("slot",""))
    if not equipment.has(slot):
        return

    var test_entries = inventory_entries.duplicate(true)
    if not _consume_one_item_from_entries(test_entries,id):
        return

    var old_id = str(equipment.get(slot,""))
    if old_id != "":
        if _grid_add(test_entries, old_id, 1, INV_W, INV_H) != 0:
            return

    inventory_entries = test_entries
    equipment[slot] = id
    if slot == "utility" and id != "flashlight":
        flashlight_on = false


func _clear_equipment_item(id):
    for slot in equipment.keys():
        if str(equipment[slot]) == id:
            equipment[slot] = ""
            if slot == "utility":
                flashlight_on = false


func _validate_equipment():
    _ensure_equipment_slots()
    for slot in EQUIPMENT_SLOT_IDS:
        var id = str(equipment.get(slot,""))
        if id == "":
            continue
        if not item_defs.has(id) or str(item_defs[id].get("use","")) != "gear":
            equipment[slot] = ""
            if slot == "utility":
                flashlight_on = false
            continue
        var expected_slot = str(item_defs[id].get("slot",""))
        if expected_slot != slot:
            # Corrupt/noncanonical state: keep the item by returning it to the
            # backpack when possible, instead of silently deleting it.
            if _grid_add(inventory_entries,id,1,INV_W,INV_H) == 0:
                equipment[slot] = ""
            continue

    if equipped_melee_id != "" and not _inventory_has_item(equipped_melee_id):
        equipped_melee_id = ""
        _update_weapon_visual()


# Character skill levels were removed in 1.17.2.
# Progression is defined by carried equipment, supplies, physical condition and player knowledge.

func _carry_limit():
    var limit = 8.0
    var id = str(equipment.get("backpack",""))
    if id != "" and item_defs.has(id):
        limit += float(item_defs[id].get("carry_bonus",0.0))
    return limit

func _survival_stamina_cap():
    var cap = 100.0

    if hunger < 25.0:
        cap = min(cap,85.0)
    if hunger < 10.0:
        cap = min(cap,70.0)

    if thirst < 25.0:
        cap = min(cap,75.0)
    if thirst < 10.0:
        cap = min(cap,55.0)

    if health < 30.0:
        cap = min(cap,80.0)

    cap = min(cap,_temperature_stamina_cap())
    cap = min(cap,_injury_stamina_cap())
    cap = min(cap,_fatigue_stamina_cap())
    return cap


func _fatigue_stamina_cap():
    var cap = 100.0
    if fatigue > 35.0:
        cap = min(cap,94.0)
    if fatigue > 55.0:
        cap = min(cap,82.0)
    if fatigue > 72.0:
        cap = min(cap,68.0)
    if fatigue > 88.0:
        cap = min(cap,50.0)
    return cap

func _fatigue_stamina_regen_multiplier():
    var mult = 1.0
    if fatigue > 35.0:
        mult *= 0.92
    if fatigue > 55.0:
        mult *= 0.82
    if fatigue > 72.0:
        mult *= 0.68
    if fatigue > 88.0:
        mult *= 0.52
    return max(0.40,mult)

func _fatigue_speed_multiplier():
    var mult = 1.0
    if fatigue > 60.0:
        mult *= 0.96
    if fatigue > 75.0:
        mult *= 0.91
    if fatigue > 90.0:
        mult *= 0.84
    return max(0.70,mult)

func _fatigue_can_sprint():
    return fatigue < 92.0

func _survival_strain_index():
    # One normalized measure used by fatigue and exertion. It intentionally
    # combines systems instead of treating each HUD bar as an isolated penalty.
    var nutrition_stress = clamp((35.0 - hunger) / 35.0,0.0,1.0)
    var hydration_stress = clamp((35.0 - thirst) / 35.0,0.0,1.0)
    var wet_stress = clamp((wetness - 35.0) / 65.0,0.0,1.0)
    var pain_stress = clamp(_effective_pain() / 100.0,0.0,1.0)
    var infection_stress = clamp(wound_infection / 100.0,0.0,1.0)
    var injury_stress = clamp((100.0 - min(
        _body_condition_value("torso"),
        _body_condition_value("legs")
    )) / 100.0,0.0,1.0)
    var thermal_stress = clamp(max(thermal_cold_stress,thermal_heat_stress) / 1.25,0.0,1.0)
    var bleed_stress = 0.55 if bleeding else 0.0
    return clamp(
        nutrition_stress * 0.16
        + hydration_stress * 0.22
        + wet_stress * 0.10
        + pain_stress * 0.14
        + infection_stress * 0.14
        + injury_stress * 0.10
        + thermal_stress * 0.22
        + bleed_stress,
        0.0,1.75
    )

func _survival_exertion_multiplier():
    var mult = 1.0 + _survival_strain_index() * 0.48
    if wetness > 70.0:
        mult += 0.10
    if fatigue > 55.0:
        mult += (fatigue - 55.0) / 45.0 * 0.24
    return clamp(mult,1.0,2.15)

func _metabolic_heat_efficiency():
    # Low calories make it harder to generate heat; dehydration and exhaustion
    # also reduce the benefit from activity. This closes the rain/cold/food loop.
    var eff = 1.0
    if hunger < 35.0:
        eff *= lerp(0.72,1.0,hunger / 35.0)
    if thirst < 25.0:
        eff *= lerp(0.86,1.0,thirst / 25.0)
    if fatigue > 70.0:
        eff *= lerp(0.82,1.0,(100.0 - fatigue) / 30.0)
    return clamp(eff,0.55,1.0)

func _update_fatigue(delta,moving_now):
    var strain = _survival_strain_index()
    var gain = strain * 0.006

    if moving_now:
        gain += 0.0035
        if is_sprinting:
            gain += 0.021
    elif not bleeding and wound_infection < 70.0:
        var recovery = 0.0030
        if is_sheltered:
            recovery += 0.0035
        if thermal_effective_temperature >= 10.0 and thermal_effective_temperature <= 24.0:
            recovery += 0.0020
        if wetness < 25.0:
            recovery += 0.0015
        if hunger < 30.0 or thirst < 30.0:
            recovery *= 0.45
        fatigue -= delta * recovery

    fatigue = clamp(fatigue + delta * gain,0.0,100.0)

func _nutrition_stamina_multiplier():
    return 1.15 if well_fed_time > 0.0 else 1.0

func _warm_drink_heat_bonus():
    return 1.5 if warm_drink_time > 0.0 else 0.0

func _update_nutrition(delta):
    well_fed_time = max(0.0,well_fed_time - delta)
    warm_drink_time = max(0.0,warm_drink_time - delta)

func _cook_inventory_product(input_id,water_required,output_id,feedback):
    if not _player_near_active_fire():
        if inv_details != null:
            inv_details.text = "Нужен горящий костёр."
        return false

    if _inventory_count(input_id) <= 0:
        return false

    if water_required and _inventory_count("water") <= 0:
        if inv_details != null:
            inv_details.text = "Для готовки нужна чистая вода."
        return false

    var test_entries = inventory_entries.duplicate(true)
    if not _consume_one_item_from_entries(test_entries,input_id):
        return false
    if water_required and not _consume_one_item_from_entries(test_entries,"water"):
        return false

    var remaining = _grid_add(test_entries,output_id,1,INV_W,INV_H)
    if remaining > 0:
        if inv_details != null:
            inv_details.text = "Нужно свободное место для готового блюда."
        return false

    inventory_entries = test_entries
    _set_survival_feedback(feedback,2.0)
    return true

func _survival_stamina_regen_rate():
    var rate = 2.8

    if hunger < 35.0:
        rate *= 0.72
    if hunger < 15.0:
        rate *= 0.60

    if thirst < 35.0:
        rate *= 0.62
    if thirst < 15.0:
        rate *= 0.52

    if health < 35.0:
        rate *= 0.72
    if bleeding:
        rate *= 0.55

    rate *= _thermal_stamina_regen_multiplier()
    rate *= _injury_stamina_regen_multiplier()
    rate *= _fatigue_stamina_regen_multiplier()
    rate *= _nutrition_stamina_multiplier()
    return max(0.15,rate)

func _survival_speed_multiplier():
    var mult = 1.0

    if hunger < 15.0:
        mult *= 0.90
    if hunger < 5.0:
        mult *= 0.90

    if thirst < 15.0:
        mult *= 0.84
    if thirst < 5.0:
        mult *= 0.88

    if health < 30.0:
        mult *= 0.90

    mult *= _thermal_speed_multiplier()
    mult *= _fatigue_speed_multiplier()
    return max(0.50,mult)

func _survival_damage_per_second():
    var damage = 0.0
    if hunger <= 0.0:
        damage += 0.20
    if thirst <= 0.0:
        damage += 0.38
    damage += _thermal_damage_per_second()
    return damage

func _survival_status_text():
    var warnings = []

    if bleeding:
        warnings.append("КРОВОТЕЧЕНИЕ")
    if thirst <= 0.0:
        warnings.append("ОБЕЗВОЖИВАНИЕ")
    elif thirst < 15.0:
        warnings.append("СИЛЬНАЯ ЖАЖДА")

    if hunger <= 0.0:
        warnings.append("ИСТОЩЕНИЕ")
    elif hunger < 15.0:
        warnings.append("СИЛЬНЫЙ ГОЛОД")

    var thermal_text = _thermal_state_text()
    if thermal_text != "ТЕРМОКОМФОРТ":
        warnings.append(thermal_text)

    if wetness > 70.0:
        warnings.append("ПРОМОК")
    elif wetness > 35.0:
        warnings.append("МОКРО")

    var effective_pain = _effective_pain()
    if effective_pain > 70.0:
        warnings.append("СИЛЬНАЯ БОЛЬ")
    elif effective_pain > 35.0:
        warnings.append("БОЛЬ")

    if wound_infection >= 70.0:
        warnings.append("СИЛЬНАЯ ИНФЕКЦИЯ РАНЫ")
    elif wound_infection >= 25.0:
        warnings.append("ИНФЕКЦИЯ РАНЫ")
    elif wound_contamination >= 45.0:
        warnings.append("ЗАГРЯЗНЁННАЯ РАНА")

    if stamina < 15.0:
        warnings.append("ВЫДОХСЯ")
    if is_sprinting:
        warnings.append("БЕГ")

    if well_fed_time > 0.0:
        warnings.append("СЫТ")
    if warm_drink_time > 0.0:
        warnings.append("ГОРЯЧИЙ НАПИТОК")

    if warnings.is_empty():
        if is_sheltered:
            return "СОСТОЯНИЕ: В ТЕПЛЕ"
        return "СОСТОЯНИЕ: СТАБИЛЬНО"
    return "СОСТОЯНИЕ: " + " • ".join(warnings)

func _set_survival_feedback(text_value,duration = 1.8):
    survival_feedback = str(text_value)
    survival_feedback_time = max(0.1,float(duration))

func _update_survival(delta):
    var activity_hunger_mult = 1.0
    var activity_thirst_mult = 1.0

    if is_sprinting and move_direction.length() > 0.05:
        activity_hunger_mult = 1.65
        activity_thirst_mult = 2.10

    activity_hunger_mult *= _thermal_hunger_multiplier()
    activity_thirst_mult *= _thermal_thirst_multiplier()

    # Fever/infection raises fluid demand even in cool weather.
    if wound_infection >= 50.0:
        activity_thirst_mult *= 1.0 + min(0.40,(wound_infection - 50.0) / 50.0 * 0.40)

    hunger = max(0.0,hunger - delta * 0.018 * activity_hunger_mult)
    thirst = max(0.0,thirst - delta * 0.028 * activity_thirst_mult)

    if bleeding:
        var remaining_bleed_damage = max(0.0,MAX_BLEED_DAMAGE - bleed_damage_taken)
        if remaining_bleed_damage > 0.0 and health > 1.0:
            var bleed_tick = min(delta * 0.85,remaining_bleed_damage)
            bleed_tick = min(bleed_tick,max(0.0,health - 1.0))
            health = max(1.0,health - bleed_tick)
            bleed_damage_taken += bleed_tick
        if bleed_damage_taken >= MAX_BLEED_DAMAGE or health <= 1.0:
            bleeding = false

    var deprivation_damage = _survival_damage_per_second()
    if deprivation_damage > 0.0:
        health = max(0.0,health - deprivation_damage * delta)

    var moving_now = player != null and player.velocity.length() > 1.5
    var exertion_mult = _survival_exertion_multiplier()
    if moving_now:
        if is_sprinting:
            stamina = max(0.0,stamina - delta * 7.5 * exertion_mult)
        else:
            stamina = max(0.0,stamina - delta * 0.12 * exertion_mult)
    else:
        stamina += delta * _survival_stamina_regen_rate()

    _update_fatigue(delta,moving_now)
    stamina = clamp(stamina,0.0,_survival_stamina_cap())

    if not bleeding and health < 100.0 and hunger >= 70.0 and thirst >= 70.0:
        var recovery_rate = 0.045
        if is_sheltered:
            recovery_rate = 0.105
        if body_temperature < 35.0:
            recovery_rate *= 0.35
        if fatigue > 70.0:
            recovery_rate *= 0.65
        if wound_infection >= 35.0:
            recovery_rate *= 0.55
        health = min(100.0,health + delta * recovery_rate)

    # Shelter improves general condition even before full health regeneration:
    # stamina recovers better there through _cold_stamina_regen_multiplier().

    sprint_noise_time = max(0.0,sprint_noise_time - delta)
    if moving_now and sprint_noise_time <= 0.0:
        if is_sprinting:
            _emit_ai_sound(player.global_position,138.0,"sprint",1.0)
            sprint_noise_time = 0.48
        else:
            _emit_ai_sound(player.global_position,52.0,"walk",1.0)
            sprint_noise_time = 0.80

    survival_feedback_time = max(0.0,survival_feedback_time - delta)
    if survival_feedback_time <= 0.0:
        survival_feedback = ""

func _current_move_speed():
    var limit = max(1.0,_carry_limit())
    var ratio = _inventory_weight() / limit
    var speed = MOVE_SPEED

    if ratio > 1.0:
        speed *= max(0.55,1.0 - (ratio - 1.0) * 0.42)

    speed *= _survival_speed_multiplier()
    speed *= _injury_move_multiplier()
    speed *= _equipment_move_multiplier()
    if infected_spit_slow_time > 0.0:
        speed *= clamp(infected_spit_slow_mult,0.65,1.0)

    if is_sprinting and stamina > 0.5 and hunger > 0.0 and thirst > 0.0:
        speed *= SPRINT_SPEED_MULT

    return speed

func _layered_protection_value(slot_ids,field,fallback_field = ""):
    # Independent thin layers combine with diminishing returns. This keeps an
    # outer jacket useful over armor without turning two weak layers into 100%.
    var remaining = 1.0
    for slot_id in slot_ids:
        var id = str(equipment.get(slot_id,""))
        if id == "" or not item_defs.has(id):
            continue
        var item = item_defs[id]
        var value = float(item.get(field,item.get(fallback_field,0.0) if fallback_field != "" else 0.0))
        value = clamp(value,0.0,0.70)
        remaining *= 1.0 - value
    return clamp(1.0 - remaining,0.0,0.70)

func _armor_value():
    # Legacy summary helper used by HUD/tests. Actual combat protection is zoned.
    var torso = _armor_value_for_zone("torso")
    var head = _armor_value_for_zone("head")
    return clamp(torso + head * 0.35,0.0,0.60)

func _armor_value_for_zone(zone):
    var key = str(zone)
    if key == "head":
        return _layered_protection_value(["head"],"armor_head","armor")

    var field = "armor_torso"
    if key == "arms":
        field = "armor_arms"
    elif key == "legs":
        field = "armor_legs"
    return _layered_protection_value(["body","outerwear"],field,"armor" if key == "torso" else "")

func _bleed_resistance():
    var remaining = 1.0
    for slot in ["head","body","outerwear"]:
        var id = str(equipment.get(slot,""))
        if id != "" and item_defs.has(id):
            remaining *= 1.0 - clamp(float(item_defs[id].get("bleed_resist",0.0)),0.0,0.75)
    return clamp(1.0 - remaining,0.0,0.75)

func _bleed_resistance_for_zone(zone):
    if str(zone) == "head":
        var head_id = str(equipment.get("head",""))
        if head_id != "" and item_defs.has(head_id):
            return clamp(float(item_defs[head_id].get("bleed_resist",0.0)),0.0,0.75)
        return 0.0

    var remaining = 1.0
    for slot in ["body","outerwear"]:
        var id = str(equipment.get(slot,""))
        if id == "" or not item_defs.has(id):
            continue
        var value = float(item_defs[id].get("bleed_resist",0.0))
        if str(zone) == "arms":
            value *= 0.35
        elif str(zone) == "legs":
            value *= 0.12
        remaining *= 1.0 - clamp(value,0.0,0.75)
    return clamp(1.0 - remaining,0.0,0.75)

func _equipment_move_multiplier():
    var mult = 1.0
    for slot in EQUIPMENT_SLOT_IDS:
        var id = str(equipment.get(slot,""))
        if id != "" and item_defs.has(id):
            mult *= clamp(float(item_defs[id].get("move_mult",1.0)),0.80,1.0)
    return clamp(mult,0.80,1.0)

func _damage_after_armor(base_damage,zone):
    return max(0.0,float(base_damage)) * (1.0 - _armor_value_for_zone(zone))


func _body_zone_name(zone):
    if zone == "head":
        return "ГОЛОВА"
    if zone == "torso":
        return "КОРПУС"
    if zone == "arms":
        return "РУКИ"
    if zone == "legs":
        return "НОГИ"
    return "ТЕЛО"

func _roll_injury_zone():
    var roll = randf()

    if roll < 0.14:
        return "head"
    if roll < 0.56:
        return "torso"
    if roll < 0.78:
        return "arms"
    return "legs"

func _injury_zone_trauma_mult(zone):
    if zone == "head":
        return 1.20
    if zone == "torso":
        return 1.00
    if zone == "arms":
        return 0.80
    if zone == "legs":
        return 0.85
    return 1.0

func _injury_zone_bleed_mult(zone):
    if zone == "head":
        return 0.88
    if zone == "torso":
        return 1.15
    if zone == "arms":
        return 0.95
    if zone == "legs":
        return 1.00
    return 1.0

func _sanitize_body_condition():
    if typeof(body_condition) != TYPE_DICTIONARY:
        body_condition = {}

    for zone in ["head","torso","arms","legs"]:
        if not body_condition.has(zone):
            body_condition[zone] = 100.0
        body_condition[zone] = clamp(float(body_condition[zone]),0.0,100.0)

    pain = clamp(float(pain),0.0,100.0)

func _body_condition_value(zone):
    if not body_condition.has(zone):
        return 100.0
    return clamp(float(body_condition.get(zone,100.0)),0.0,100.0)

func _worst_injury_zone():
    var worst_zone = ""
    var worst_value = 101.0

    for zone in ["head","torso","arms","legs"]:
        var value = _body_condition_value(zone)
        if value < worst_value:
            worst_value = value
            worst_zone = zone

    return worst_zone

func _body_injury_summary():
    var zone = _worst_injury_zone()
    if zone == "":
        return "ТРАВМЫ: НЕТ"

    var value = _body_condition_value(zone)
    if value >= 92.0:
        return "ТРАВМЫ: НЕТ"

    return "ТРАВМЫ: %s %d%%" % [_body_zone_name(zone),int(value)]


func _effective_pain():
    var suppression = 32.0 if painkiller_time > 0.0 else 0.0
    return max(0.0,pain - suppression)

func _contaminate_wound(trauma,open_wound):
    var amount = max(0.0,float(trauma)) * (0.62 if open_wound else 0.18)
    if open_wound:
        amount += 5.0
    if wetness > 65.0:
        amount *= 1.22
    wound_contamination = clamp(wound_contamination + amount,0.0,100.0)

func _medical_stamina_multiplier():
    if wound_infection >= 85.0:
        return 0.62
    if wound_infection >= 60.0:
        return 0.76
    if wound_infection >= 30.0:
        return 0.90
    return 1.0

func _update_medical(delta):
    medical_tick_accumulator += delta
    if medical_tick_accumulator < 0.25:
        return

    var step = medical_tick_accumulator
    medical_tick_accumulator = 0.0

    painkiller_time = max(0.0,painkiller_time - step)
    antibiotic_time = max(0.0,antibiotic_time - step)

    # An open wound slowly becomes dirtier, especially while soaked.
    if bleeding:
        var open_wound_rate = 0.010
        if wetness > 60.0:
            open_wound_rate *= 1.75
        wound_contamination += step * open_wound_rate
    else:
        var clean_rate = 0.004
        if is_sheltered:
            clean_rate *= 1.70
        wound_contamination -= step * clean_rate

    # Contamination turns into a wound infection gradually rather than instantly.
    if antibiotic_time > 0.0:
        wound_contamination -= step * 0.020
        wound_infection -= step * 0.045
    elif wound_contamination > 30.0:
        var exposure = clamp((wound_contamination - 30.0) / 70.0,0.0,1.0)
        var infection_rate = 0.028 * exposure
        if bleeding:
            infection_rate *= 1.25
        if wetness > 60.0:
            infection_rate *= 1.18
        if body_temperature < 35.0:
            infection_rate *= 1.12
        wound_infection += step * infection_rate
    elif wound_contamination < 15.0 and wound_infection < 35.0 and not bleeding:
        wound_infection -= step * 0.0025

    wound_contamination = clamp(wound_contamination,0.0,100.0)
    wound_infection = clamp(wound_infection,0.0,100.0)

    # Infection becomes systemically dangerous only at high values.
    if wound_infection >= 85.0:
        health = max(0.0,health - step * 0.018)
        pain = min(100.0,pain + step * 0.004)
        body_temperature = min(40.5,body_temperature + step * 0.0010)
    elif wound_infection >= 65.0:
        health = max(0.0,health - step * 0.007)
        pain = min(100.0,pain + step * 0.002)
        body_temperature = min(40.5,body_temperature + step * 0.0004)

func _use_sterile_bandage():
    if not bleeding and health >= 99.0 and wound_contamination <= 1.0:
        return false

    _stop_bleeding()
    health = min(100.0,health + 4.0)
    pain = max(0.0,pain - 5.0)
    _stabilize_worst_injury(3.0)
    wound_contamination = max(0.0,wound_contamination - 18.0)
    stamina = min(_survival_stamina_cap(),stamina + 2.0)
    _set_survival_feedback("Стерильная повязка: рана закрыта и очищена",2.0)
    return true

func _injury_move_multiplier():
    var p = _effective_pain()
    var mult = 1.0
    var legs = _body_condition_value("legs")

    if legs < 60.0:
        mult *= 0.92
    if legs < 30.0:
        mult *= 0.78
    if legs < 15.0:
        mult *= 0.80

    if p > 50.0:
        mult *= 0.94
    if p > 80.0:
        mult *= 0.86

    if wound_infection >= 70.0:
        mult *= 0.92
    if wound_infection >= 90.0:
        mult *= 0.88

    return max(0.45,mult)

func _injury_aim_spread_multiplier():
    var p = _effective_pain()
    var mult = 1.0
    var arms = _body_condition_value("arms")
    var head = _body_condition_value("head")

    if arms < 60.0:
        mult *= 1.12
    if arms < 30.0:
        mult *= 1.28

    if head < 40.0:
        mult *= 1.12

    if p > 45.0:
        mult *= 1.10
    if p > 75.0:
        mult *= 1.15

    return mult

func _injury_stamina_cap():
    var p = _effective_pain()
    var cap = 100.0
    var torso = _body_condition_value("torso")
    var legs = _body_condition_value("legs")
    var head = _body_condition_value("head")

    if torso < 60.0:
        cap = min(cap,90.0)
    if torso < 30.0:
        cap = min(cap,70.0)

    if legs < 60.0:
        cap = min(cap,85.0)
    if legs < 30.0:
        cap = min(cap,62.0)

    if head < 50.0:
        cap = min(cap,88.0)
    if head < 25.0:
        cap = min(cap,68.0)

    if p > 50.0:
        cap = min(cap,85.0)
    if p > 80.0:
        cap = min(cap,70.0)

    if wound_infection >= 60.0:
        cap = min(cap,82.0)
    if wound_infection >= 85.0:
        cap = min(cap,65.0)

    return cap

func _injury_stamina_regen_multiplier():
    var p = _effective_pain()
    var mult = 1.0

    if p > 35.0:
        mult *= 0.85
    if p > 70.0:
        mult *= 0.68

    if _body_condition_value("torso") < 50.0:
        mult *= 0.82

    mult *= _medical_stamina_multiplier()
    return max(0.35,mult)

func _injury_can_sprint():
    var p = _effective_pain()
    if _body_condition_value("legs") < 24.0:
        return false
    if p > 88.0:
        return false
    if wound_infection >= 92.0:
        return false
    return true

func _apply_body_injury(zone,trauma):
    if not body_condition.has(zone):
        return

    var amount = max(0.0,float(trauma))
    body_condition[zone] = max(0.0,_body_condition_value(zone) - amount)
    pain = min(100.0,pain + amount * 0.80)
    last_injury_zone = zone

func _stabilize_worst_injury(amount):
    var zone = _worst_injury_zone()
    if zone == "":
        return

    var value = _body_condition_value(zone)
    if value >= 100.0:
        return

    body_condition[zone] = min(100.0,value + max(0.0,float(amount)))

func _update_injuries(delta):
    _sanitize_body_condition()

    var pain_decay = 0.045

    if is_sheltered:
        pain_decay *= 1.65
    if hunger >= 65.0 and thirst >= 65.0:
        pain_decay *= 1.25
    if body_temperature < 35.0:
        pain_decay *= 0.55

    pain = max(0.0,pain - delta * pain_decay)

    # Body-part recovery is intentionally slow. Shelter, food and hydration
    # create a meaningful recovery loop without instantly erasing combat damage.
    if is_sheltered and not bleeding and hunger >= 70.0 and thirst >= 70.0 and wound_infection < 70.0:
        var recovery = delta * 0.010
        if body_temperature >= 36.0:
            recovery *= 1.20
        if wound_infection > 30.0:
            recovery *= 0.62

        for zone in ["head","torso","arms","legs"]:
            body_condition[zone] = min(100.0,_body_condition_value(zone) + recovery)

func _apply_enemy_hit(base_damage):
    if qa_visual_mode or developer_invulnerable:
        return
    var zone = _roll_injury_zone()
    var final_damage = _damage_after_armor(base_damage,zone)
    health = max(0.0,health - final_damage)
    modern_survivor_hit_time = modern_survivor_hit_duration

    var trauma = final_damage * _injury_zone_trauma_mult(zone)
    _apply_body_injury(zone,trauma)

    var bleed_chance = 0.32
    bleed_chance *= _injury_zone_bleed_mult(zone)
    bleed_chance *= (1.0 - _bleed_resistance_for_zone(zone))

    var opened_wound = false
    if randf() < bleed_chance:
        _start_bleeding()
        opened_wound = true

    _contaminate_wound(trauma,opened_wound or bleeding)

    _set_survival_feedback(
        "Травма: %s  Боль %d%%" % [_body_zone_name(zone),int(pain)],
        1.35
    )

func _weather_display_name():
    if weather_state == "rain":
        return "ДОЖДЬ"
    if weather_state == "cloudy":
        return "ПАСМУРНО"
    return "ЯСНО"

func _weather_temp_offset():
    if weather_state == "rain":
        return -3.5
    if weather_state == "cloudy":
        return -1.5
    return 0.0


func _ambient_temperature_for_time():
    var hour = world_minutes / 60.0
    var daily = cos((hour - 14.0) / 24.0 * TAU)

    # Late-autumn continental profile:
    # ~13°C daytime, down to ~-3°C at the coldest clear night.
    return 5.0 + daily * 8.0 + _weather_temp_offset()



func _position_is_sheltered(pos):
    if _high_risk_floor_active() and is_instance_valid(high_risk_floor_root):
        var floor_data = HighRiskFloorCatalog.floor(high_risk_floor_poi_id,high_risk_floor_index)
        var floor_size:Vector2 = floor_data.get("size",Vector2(1000,700))
        var floor_rect = Rect2(high_risk_floor_root.global_position - floor_size*0.5,floor_size)
        if floor_rect.grow(22.0).has_point(pos):
            return true
    for rec in roof_records:
        var rect = rec.get("rect",Rect2())
        if rect.has_point(pos):
            return true
    return false

func _player_is_sheltered():
    if player == null:
        return false
    return _position_is_sheltered(player.global_position)

func _clothing_warmth():
    var total = 0.0
    for slot in ["head","body","outerwear","backpack"]:
        var id = str(equipment.get(slot,""))
        if id != "" and item_defs.has(id):
            total += float(item_defs[id].get("warmth",0.0))
    return total

func _rain_protection():
    var protection = 0.0
    for slot in ["head","body","outerwear","backpack"]:
        var id = str(equipment.get(slot,""))
        if id != "" and item_defs.has(id):
            protection += float(item_defs[id].get("rain_protect",0.0))
    return clamp(protection,0.0,0.75)


func _freezing_exposure_active():
    return ambient_temperature <= 0.0 and not is_sheltered


func _shelter_wellbeing_multiplier():
    if not is_sheltered:
        return 1.0

    var bonus = 1.18

    if thermal_effective_temperature >= 8.0 and thermal_effective_temperature <= 24.0:
        bonus += 0.12
    if wetness < 35.0:
        bonus += 0.08
    if body_temperature < 35.5:
        bonus += 0.08

    return clamp(bonus,1.0,1.46)


func _temperature_stamina_cap():
    var cap = 100.0

    if _freezing_exposure_active():
        cap = min(cap,95.0)

    if wetness > 70.0 and thermal_effective_temperature < 8.0:
        cap = min(cap,88.0)

    if body_temperature < 35.5:
        cap = min(cap,90.0)
    if body_temperature < 35.0:
        cap = min(cap,78.0)
    if body_temperature < 34.0:
        cap = min(cap,60.0)
    if body_temperature < 33.0:
        cap = min(cap,42.0)

    if body_temperature > 38.0:
        cap = min(cap,82.0)
    if body_temperature > 39.0:
        cap = min(cap,62.0)

    return cap

func _weather_wind_speed_kmh():
    if weather_state == "rain":
        return 20.0
    if weather_state == "cloudy":
        return 12.0
    return 6.0

func _wind_chill_temperature(temp_c,wind_kmh):
    var t = float(temp_c)
    var v = max(0.0,float(wind_kmh))

    # Standard wind-chill equation. Use actual air temperature outside
    # the range where the equation is meaningful.
    if t > 10.0 or v <= 4.8:
        return t

    var v016 = pow(v,0.16)
    return 13.12 + 0.6215 * t - 11.37 * v016 + 0.3965 * t * v016

func _shelter_air_temperature():
    # Unheated buildings mainly remove wind/rain and retain some heat.
    # Thermal inertia keeps the interior from immediately matching a cold night.
    return max(4.0,ambient_temperature + 7.0)

func _clothing_insulation():
    return clamp(_clothing_warmth() / 6.0,0.0,0.78)

func _effective_clothing_insulation():
    var insulation = _clothing_insulation()

    # Wet clothing loses most of its insulating ability.
    var wet_loss = 1.0 - (wetness / 100.0) * 0.72
    return clamp(insulation * wet_loss,0.0,0.78)

func _activity_heat_bonus():
    if move_direction.length() <= 0.05:
        return 0.0
    var base = 6.0 if is_sprinting else 2.2
    return base * _metabolic_heat_efficiency()

func _calculate_effective_temperature():
    var air_temp = ambient_temperature

    if is_sheltered:
        air_temp = _shelter_air_temperature()
        wind_speed_kmh = 1.5
    else:
        wind_speed_kmh = _weather_wind_speed_kmh()
        air_temp = _wind_chill_temperature(ambient_temperature,wind_speed_kmh)

    var insulation_bonus = _effective_clothing_insulation() * 10.0
    var wet_penalty = (wetness / 100.0) * 5.0
    var activity_bonus = _activity_heat_bonus()

    var base_heat_bonus = _base_heat_bonus_at_player()
    var drink_heat_bonus = _warm_drink_heat_bonus()
    return air_temp + insulation_bonus + activity_bonus + base_heat_bonus + drink_heat_bonus - wet_penalty

func _thermal_speed_multiplier():
    var mult = 1.0

    # 0°C and below begins environmental exposure risk, but a normal core
    # temperature only receives a mild immediate performance penalty.
    if _freezing_exposure_active():
        mult *= 0.98

    if wetness > 70.0 and thermal_effective_temperature < 8.0:
        mult *= 0.94

    if body_temperature < 35.5:
        mult *= 0.94
    if body_temperature < 35.0:
        mult *= 0.90
    if body_temperature < 34.0:
        mult *= 0.82
    if body_temperature < 33.0:
        mult *= 0.78

    if body_temperature > 38.0:
        mult *= 0.94
    if body_temperature > 39.0:
        mult *= 0.86

    return max(0.50,mult)

func _thermal_stamina_regen_multiplier():
    var mult = 1.0

    if _freezing_exposure_active():
        mult *= 0.90

    if wetness > 70.0 and thermal_effective_temperature < 8.0:
        mult *= 0.82

    if body_temperature < 35.5:
        mult *= 0.86
    if body_temperature < 35.0:
        mult *= 0.78
    if body_temperature < 34.0:
        mult *= 0.62
    if body_temperature < 33.0:
        mult *= 0.50

    if body_temperature > 38.0:
        mult *= 0.78
    if body_temperature > 39.0:
        mult *= 0.58

    mult *= _shelter_wellbeing_multiplier()
    return clamp(mult,0.25,1.65)

func _thermal_damage_per_second():
    var damage = 0.0

    # HP damage follows dangerous core temperature, not air alone.
    if body_temperature < 34.0:
        damage += 0.035
    if body_temperature < 33.0:
        damage += 0.090
    if body_temperature < 32.0:
        damage += 0.180

    if body_temperature > 39.0:
        damage += 0.080
    if body_temperature > 40.0:
        damage += 0.200

    return damage

func _thermal_hunger_multiplier():
    var mult = 1.0

    # Cold thermogenesis increases calorie use.
    if thermal_cold_stress > 0.20:
        mult += min(0.55,thermal_cold_stress * 0.38)
    if body_temperature < 35.0:
        mult += 0.18

    return mult

func _thermal_thirst_multiplier():
    var mult = 1.0

    # Heat raises fluid demand.
    if thermal_heat_stress > 0.10:
        mult += min(1.00,thermal_heat_stress * 0.75)
    if body_temperature > 38.0:
        mult += 0.30

    return mult

func _thermal_state_text():
    if body_temperature <= 32.0:
        return "КРИТИЧЕСКОЕ ПЕРЕОХЛАЖДЕНИЕ"
    if body_temperature < 34.0:
        return "СИЛЬНОЕ ПЕРЕОХЛАЖДЕНИЕ"
    if body_temperature < 35.0:
        return "ПЕРЕОХЛАЖДЕНИЕ"
    if _freezing_exposure_active():
        return "РИСК ПЕРЕОХЛАЖДЕНИЯ"

    if body_temperature >= 40.0:
        return "КРИТИЧЕСКИЙ ПЕРЕГРЕВ"
    if body_temperature > 39.0:
        return "СИЛЬНЫЙ ПЕРЕГРЕВ"
    if body_temperature > 38.0:
        return "ПЕРЕГРЕВ"

    if thermal_effective_temperature < 5.0:
        return "ХОЛОДНО"
    if thermal_effective_temperature > 28.0:
        return "ЖАРКО"

    return "ТЕРМОКОМФОРТ"

func _thermal_tick(step):
    is_sheltered = _player_is_sheltered()
    ambient_temperature = _ambient_temperature_for_time()

    if weather_state == "rain" and not is_sheltered:
        # Fast soaking remains; rain protection delays saturation.
        var soak_rate = 0.92 * (1.0 - _rain_protection())
        if is_sprinting:
            soak_rate *= 1.12
        wetness = min(100.0,wetness + soak_rate * step)
    else:
        var dry_rate = 0.055

        if is_sheltered:
            var shelter_air = _shelter_air_temperature()
            dry_rate = 0.24 + max(0.0,shelter_air - 4.0) * 0.012
            if weather_state != "rain":
                dry_rate += 0.08
        elif weather_state == "clear":
            dry_rate = 0.085
        elif weather_state == "cloudy":
            dry_rate = 0.045

        wetness = max(0.0,wetness - dry_rate * step)

    var nearby_base_heat = _base_heat_bonus_at_player()
    if nearby_base_heat > 0.0:
        wetness = max(0.0,wetness - step * (0.18 + nearby_base_heat * 0.018))

    thermal_effective_temperature = _calculate_effective_temperature()

    # Exertion in warm conditions creates clothing moisture. This matters later
    # if the player stops, night falls or the weather turns cold.
    if move_direction.length() > 0.05 and thermal_effective_temperature > 24.0:
        var sweat_factor = clamp((thermal_effective_temperature - 24.0) / 12.0,0.0,1.0)
        var sweat_rate = 0.035 if not is_sprinting else 0.095
        wetness = min(100.0,wetness + step * sweat_rate * sweat_factor)

    # Gameplay thermoneutral boundary for the current clothing abstraction.
    thermal_cold_stress = clamp((12.0 - thermal_effective_temperature) / 20.0,0.0,1.50)
    thermal_heat_stress = clamp((thermal_effective_temperature - 28.0) / 12.0,0.0,1.25)

    if thermal_cold_stress > 0.0:
        var cooling_rate = 0.0010 + 0.0045 * thermal_cold_stress

        if wetness > 50.0:
            cooling_rate += 0.0015 * (wetness / 100.0)

        # User gameplay rule: 0°C and lower starts hypothermia exposure.
        if _freezing_exposure_active():
            cooling_rate += 0.0013
            cooling_rate += min(0.0015,abs(ambient_temperature) * 0.00015)

        # Starvation weakens thermogenesis; a hungry wet survivor cools faster.
        if hunger < 25.0:
            cooling_rate += (25.0 - hunger) / 25.0 * 0.0012
        if fatigue > 75.0:
            cooling_rate += (fatigue - 75.0) / 25.0 * 0.00045

        body_temperature -= step * cooling_rate
    elif thermal_heat_stress > 0.0:
        var heating_rate = 0.0010 + 0.0038 * thermal_heat_stress
        # Dehydration makes heat accumulation harder to control.
        if thirst < 25.0:
            heating_rate *= 1.0 + (25.0 - thirst) / 25.0 * 0.45
        body_temperature += step * heating_rate
    else:
        var normalization = 0.0035
        if is_sheltered:
            normalization = 0.0080
        body_temperature = move_toward(body_temperature,36.8,step * normalization)

    # Dry shelter restores core temperature faster without acting as a heater.
    if is_sheltered and wetness < 35.0 and thermal_effective_temperature >= 8.0:
        body_temperature = move_toward(body_temperature,36.8,step * 0.0060)

    body_temperature = clamp(body_temperature,30.5,40.5)

func _cold_speed_multiplier():
    return _thermal_speed_multiplier()


func _cold_stamina_regen_multiplier():
    return _thermal_stamina_regen_multiplier()


func _cold_damage_per_second():
    return _thermal_damage_per_second()

func _weather_next_state():
    weather_cycle_index += 1

    var phase = weather_cycle_index % 6
    if phase == 2 or phase == 3:
        weather_state = "rain"
        weather_timer = 95.0
    elif phase == 1 or phase == 4:
        weather_state = "cloudy"
        weather_timer = 80.0
    else:
        weather_state = "clear"
        weather_timer = 105.0

func _create_weather_visuals():
    weather_visual_root = Node2D.new()
    weather_visual_root.name = "WeatherVisuals"
    weather_visual_root.z_as_relative = false
    weather_visual_root.z_index = 90
    player.add_child(weather_visual_root)

    rain_lines.clear()

    for i in range(28):
        var line = Line2D.new()
        line.width = 1.0
        line.default_color = Color(0.64,0.74,0.80,0.40)
        line.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
        line.add_point(Vector2.ZERO)
        line.add_point(Vector2(-3,8))
        line.position = Vector2(
            -175.0 + float((i * 37) % 350),
            -110.0 + float((i * 53) % 225)
        )
        line.visible = false
        line.set_meta("rain_speed",150.0 + float((i * 17) % 55))
        weather_visual_root.add_child(line)
        rain_lines.append(line)

    fog_bands.clear()
    for i in range(5):
        var fog = Polygon2D.new()
        var y = -104.0 + float(i) * 52.0
        var w = 390.0 + float((i * 29) % 70)
        var h = 28.0 + float((i * 11) % 18)
        fog.polygon = PackedVector2Array([
            Vector2(-w*0.5,-h*0.5),Vector2(w*0.5,-h*0.42),
            Vector2(w*0.46,h*0.5),Vector2(-w*0.48,h*0.42)
        ])
        fog.color = Color(0.46,0.52,0.52,0.0)
        fog.position = Vector2(float((i*71)%90)-45.0,y)
        fog.z_index = -2
        fog.set_meta("fog_speed",3.0 + float(i) * 0.7)
        fog.set_meta("fog_phase",float(i) * 1.37)
        weather_visual_root.add_child(fog)
        fog_bands.append(fog)

    rain_splashes.clear()
    for i in range(12):
        var splash = Line2D.new()
        splash.width = 1.0
        splash.default_color = Color(0.62,0.72,0.76,0.0)
        splash.add_point(Vector2(-4,0))
        splash.add_point(Vector2(0,-1))
        splash.add_point(Vector2(4,0))
        splash.position = Vector2(-150.0 + float((i*53)%300),-80.0 + float((i*41)%170))
        splash.visible = false
        splash.set_meta("phase",float(i) * 0.61)
        weather_visual_root.add_child(splash)
        rain_splashes.append(splash)

func _update_weather_visuals(delta):
    var indoors = _high_risk_floor_active()
    var raining = weather_state == "rain" and not indoors

    for i in range(rain_lines.size()):
        var line = rain_lines[i]
        if not is_instance_valid(line):
            continue

        line.visible = raining
        if not raining:
            continue

        var speed = float(line.get_meta("rain_speed",165.0))
        line.position += Vector2(-22.0, speed) * delta

        if line.position.y > 120.0:
            line.position.y = -120.0
            line.position.x = -175.0 + float((i * 61 + weather_cycle_index * 23) % 350)

        if line.position.x < -190.0:
            line.position.x = 185.0

    var t = Time.get_ticks_msec() * 0.001
    var fog_target = 0.0
    if indoors:
        fog_target = 0.0
    elif weather_state == "cloudy":
        fog_target = 0.055
    elif weather_state == "rain":
        fog_target = 0.095
    var hour = world_minutes / 60.0
    if hour >= 20.0 or hour < 6.0:
        fog_target *= 1.35
    for fog in fog_bands:
        if not is_instance_valid(fog):
            continue
        var c = fog.color
        c.a = lerpf(c.a,fog_target,min(1.0,delta*2.0 + 0.06))
        fog.color = c
        var speed = float(fog.get_meta("fog_speed",4.0))
        var phase = float(fog.get_meta("fog_phase",0.0))
        fog.position.x += speed * delta
        fog.position.y += sin(t * 0.18 + phase) * 0.05
        if fog.position.x > 240.0:
            fog.position.x = -240.0

    for i in range(rain_splashes.size()):
        var splash = rain_splashes[i]
        if not is_instance_valid(splash):
            continue
        splash.visible = raining
        if not raining:
            continue
        var phase = float(splash.get_meta("phase",0.0))
        var pulse = max(0.0,sin(t*7.5 + phase))
        splash.modulate.a = pulse * 0.42
        if pulse < 0.08:
            splash.position.x = -160.0 + float((i*67 + weather_cycle_index*31) % 320)
            splash.position.y = -90.0 + float((i*43 + weather_cycle_index*19) % 180)



func _update_weather(delta):
    weather_timer -= delta
    if weather_timer <= 0.0:
        _weather_next_state()

    thermal_tick_accumulator += delta

    # Thermal/shelter calculations run at 5 Hz instead of every frame.
    if thermal_tick_accumulator >= 0.20:
        var step = thermal_tick_accumulator
        thermal_tick_accumulator = 0.0
        _thermal_tick(step)

    # Rain movement remains frame-smooth.
    _update_weather_visuals(delta)



func _time_night_factor():
    var hour = world_minutes / 60.0
    if hour >= 21.0 or hour < 5.0:
        return 1.0
    if hour >= 18.0:
        return clamp((hour - 18.0) / 3.0,0.0,1.0)
    if hour < 7.0:
        return clamp((7.0 - hour) / 2.0,0.0,1.0)
    return 0.0

func _update_exterior_atmosphere(delta):
    var night = _time_night_factor()
    var wet_target = 0.0
    if weather_state == "cloudy":
        wet_target = 0.18
    elif weather_state == "rain":
        wet_target = 0.74
    wet_target *= lerpf(0.76,1.0,night)

    for sprite in get_tree().get_nodes_in_group("wet_surface_fx"):
        if not is_instance_valid(sprite):
            continue
        var base_alpha = float(sprite.get_meta("base_alpha",0.42))
        var c = sprite.modulate
        c.a = lerpf(c.a,base_alpha * wet_target,min(1.0,delta*2.6 + 0.08))
        sprite.modulate = c

    var t = Time.get_ticks_msec() * 0.001
    for light in get_tree().get_nodes_in_group("street_lights"):
        if not is_instance_valid(light):
            continue
        var base_energy = float(light.get_meta("night_energy",0.72))
        var broken = bool(light.get_meta("broken",false))
        var weather_boost = 1.10 if weather_state == "rain" else (1.04 if weather_state == "cloudy" else 1.0)
        var energy = base_energy * night * weather_boost
        if broken and night > 0.05:
            var phase = float(light.get_meta("flicker_phase",0.0))
            var gate = 1.0 if sin(t*5.3 + phase) > -0.72 else 0.18
            energy *= gate * (0.88 + sin(t*13.0 + phase*1.7)*0.08)
        light.energy = max(0.0,energy)
        var pool = light.get_meta("pool") if light.has_meta("pool") else null
        if is_instance_valid(pool):
            var wet_gain = 1.0 if weather_state == "rain" else 0.62
            pool.modulate.a = clamp(energy / max(0.01,base_energy),0.0,1.0) * 0.62 * wet_gain

    for pool in get_tree().get_nodes_in_group("entrance_light_pools"):
        if is_instance_valid(pool):
            pool.modulate.a = night * (0.55 if weather_state == "rain" else 0.38)

    for light in get_tree().get_nodes_in_group("exterior_practical_lights"):
        if not is_instance_valid(light):
            continue
        var base_energy = float(light.get_meta("base_energy",0.24))
        light.energy = base_energy * (0.12 + night * 0.88)

func _base_build_costs(kind):
    if kind == "stash":
        return {"scrap":2,"tape":1}
    if kind == "heater":
        return {"scrap":3,"cloth":2,"tape":1}
    if kind == "campfire":
        return {"scrap":1,"cloth":1}
    if kind == "rain_collector":
        return {"scrap":2,"cloth":2,"tape":1}
    if kind == "lamp":
        return {"flashlight":1,"scrap":1,"tape":1}
    if kind == "cot":
        return {"cloth":4,"tape":1,"scrap":1}
    if kind == "barricade":
        return {"scrap":3,"tape":1}
    return {}

func _base_object_name(kind):
    if kind == "stash":
        return "БАЗОВЫЙ ЯЩИК"
    if kind == "heater":
        return "ОБОГРЕВАТЕЛЬ"
    if kind == "campfire":
        return "КОСТЁР"
    if kind == "rain_collector":
        return "ДОЖДЕСБОРНИК"
    if kind == "lamp":
        return "СТАЦИОНАРНАЯ ЛАМПА"
    if kind == "cot":
        return "РАСКЛАДУШКА"
    if kind == "bedroll":
        return "ПОХОДНЫЙ СПАЛЬНИК"
    if kind == "barricade":
        return "БАРРИКАДА"
    return str(kind).to_upper()

func _base_cost_text(kind):
    var costs = _base_build_costs(kind)
    var lines = []
    var ids = costs.keys()
    ids.sort()

    for item_id in ids:
        var need = int(costs[item_id])
        var have = _inventory_count(str(item_id))
        var item_name = str(item_id)
        if item_defs.has(str(item_id)):
            item_name = str(item_defs[str(item_id)].get("name",item_id))
        lines.append("%s %d/%d" % [item_name,have,need])

    return ", ".join(lines)



func _sanitize_base_objects():
    if typeof(base_objects) != TYPE_ARRAY:
        base_objects = []

    var clean = []
    var max_id = 0

    for raw in base_objects:
        if typeof(raw) != TYPE_DICTIONARY:
            continue

        var kind = str(raw.get("kind",""))
        if (
            kind != "stash"
            and kind != "heater"
            and kind != "campfire"
            and kind != "rain_collector"
            and kind != "lamp"
            and kind != "cot"
            and kind != "bedroll"
            and kind != "barricade"
        ):
            continue

        var rec = raw.duplicate(true)
        rec["id"] = max(1,int(rec.get("id",1)))
        rec["x"] = float(rec.get("x",0.0))
        rec["y"] = float(rec.get("y",0.0))
        rec["rot"] = float(rec.get("rot",0.0))
        rec["on"] = bool(rec.get("on",kind == "heater" or kind == "lamp"))

        var default_fuel = 0.0
        if kind == "heater":
            default_fuel = 180.0
        rec["fuel"] = max(0.0,float(rec.get("fuel",default_fuel)))
        rec["sound_timer"] = max(0.0,float(rec.get("sound_timer",1.5)))
        rec["stored_water"] = clamp(
            float(rec.get("stored_water",0.0)),
            0.0,
            _rain_collector_capacity()
        )
        if kind == "barricade":
            # Old saves had no durability field; they migrate as intact.
            rec["condition"] = clamp(
                float(rec.get("condition",BARRICADE_MAX_CONDITION)),
                0.0,
                BARRICADE_MAX_CONDITION
            )
        elif rec.has("raid_condition"):
            # 1.03.1 cleanup: obsolete interior-raid durability is ignored and
            # removed when old 1.02/1.03 saves are normalized.
            rec.erase("raid_condition")

        max_id = max(max_id,int(rec["id"]))
        clean.append(rec)

    base_objects = clean
    next_base_id = max(int(next_base_id),max_id + 1,1)

func _base_record_index(base_id):
    var id_value = int(base_id)
    for i in range(base_objects.size()):
        if int(base_objects[i].get("id",-1)) == id_value:
            return i
    return -1

func _base_record(base_id):
    var index = _base_record_index(base_id)
    if index < 0:
        return {}
    return base_objects[index]

func _base_build_position(kind):
    var distance = 34.0
    if kind == "lamp":
        distance = 28.0
    elif kind == "campfire":
        distance = 42.0
    elif kind == "rain_collector":
        distance = 40.0
    elif kind == "barricade":
        distance = 46.0
    elif kind == "bedroll":
        distance = 30.0

    var dir = aim_direction
    if dir.length() <= 0.01:
        dir = Vector2.RIGHT

    return player.global_position + dir.normalized() * distance

func _base_build_position_clear(pos,kind = ""):
    if player == null:
        return false

    var query = PhysicsRayQueryParameters2D.create(player.global_position,pos)
    query.collision_mask = LAYER_WORLD
    query.exclude = [player.get_rid()]
    var hit = get_world_2d().direct_space_state.intersect_ray(query)

    if not hit.is_empty():
        return false

    if kind == "barricade" or kind == "bedroll":
        # The center ray cannot see a wall clipping the side of a rotated object.
        var footprint = RectangleShape2D.new()
        footprint.size = Vector2(38,14) if kind == "barricade" else Vector2(52,22)
        var placement = PhysicsShapeQueryParameters2D.new()
        placement.shape = footprint
        placement.transform = Transform2D(aim_direction.angle(),pos)
        placement.collision_mask = LAYER_WORLD
        placement.exclude = [player.get_rid()]
        if not get_world_2d().direct_space_state.intersect_shape(placement,1).is_empty():
            return false

    for rec in base_objects:
        var existing = Vector2(float(rec.get("x",0.0)),float(rec.get("y",0.0)))
        if existing.distance_to(pos) < 26.0:
            return false

    return true

func _base_has_costs(kind):
    var costs = _base_build_costs(kind)
    if costs.is_empty():
        return false

    for item_id in costs.keys():
        if _inventory_count(str(item_id)) < int(costs[item_id]):
            return false

    return true

func _base_consume_costs(kind,entries):
    var costs = _base_build_costs(kind)
    for item_id in costs.keys():
        if not _consume_from_entries(entries,str(item_id),int(costs[item_id])):
            return false
    return true



func _rain_collector_capacity():
    return 8.0

func _rain_collector_fill_rate(state,sheltered):
    if state == "rain" and not sheltered:
        return 0.025
    return 0.0


func _base_build_block_reason(kind):
    if player == null:
        return "Персонаж недоступен."
    var pos = _base_build_position(kind)
    var sheltered = _player_is_sheltered()
    var target_sheltered = _position_is_sheltered(pos)
    if kind == "rain_collector":
        if sheltered or target_sheltered:
            return "Дождесборник нужно ставить снаружи, под открытым небом."
    elif kind != "campfire" and (not sheltered or not target_sheltered):
        return "Персонаж и место установки должны быть внутри укрытия."
    if not _base_has_costs(kind):
        return "Не хватает материалов: %s" % _base_cost_text(kind)
    if not _base_build_position_clear(pos,kind):
        return "Место занято или путь перекрыт."
    return ""

func _base_build_allowed(kind):
    return _base_build_block_reason(kind) == ""


func _make_base_radial_texture():
    var gradient = Gradient.new()
    gradient.offsets = PackedFloat32Array([0.0,0.62,1.0])
    gradient.colors = PackedColorArray([
        Color(1.0,0.84,0.56,1.0),
        Color(1.0,0.55,0.24,0.42),
        Color(1.0,0.40,0.18,0.0)
    ])

    var texture = GradientTexture2D.new()
    texture.gradient = gradient
    texture.width = 128
    texture.height = 128
    texture.fill = GradientTexture2D.FILL_RADIAL
    texture.fill_from = Vector2(0.5,0.5)
    texture.fill_to = Vector2(1.0,0.5)
    return texture

func _create_base_system():
    _sanitize_base_objects()

    if base_root != null and is_instance_valid(base_root):
        base_root.queue_free()

    base_root = Node2D.new()
    base_root.name = "PersistentBaseObjects"
    base_root.z_as_relative = false
    base_root.z_index = 8
    add_child(base_root)

    base_object_nodes.clear()

    for rec in base_objects:
        _spawn_base_object(rec)

func _spawn_base_object(rec):
    if base_root == null:
        return null

    var base_id = int(rec.get("id",-1))
    var kind = str(rec.get("kind",""))
    if base_id < 0:
        return null

    var node = Node2D.new()
    node.name = "Base_%s_%d" % [kind,base_id]
    node.position = Vector2(float(rec.get("x",0.0)),float(rec.get("y",0.0)))
    node.rotation = float(rec.get("rot",0.0))
    node.z_as_relative = false
    node.z_index = 8
    node.set_meta("base_id",base_id)
    node.set_meta("base_kind",kind)
    node.add_to_group("base_objects")
    base_root.add_child(node)

    if kind == "stash":
        var key = "base_stash_%d" % base_id
        if not container_states.has(key):
            container_states[key] = {
                "name":"БАЗОВЫЙ ЯЩИК",
                "loot_table":"",
                "items":[]
            }

        node.add_to_group("interactable")
        node.set_meta("interaction_type","container")
        node.set_meta("container_key",key)
        node.set_meta("display_name","Базовый ящик")
        node.set_meta("interaction_radius",72.0)

