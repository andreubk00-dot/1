    _world_prop_sprite("workbench",node,Vector2(0,-3),0,0.90)

func _target_farm_profile(poi:Dictionary) -> String:
    if typeof(poi) != TYPE_DICTIONARY or poi.is_empty():
        return ""
    return str(poi.get("farm_profile",""))

func _target_farm_refresh_days(poi:Dictionary) -> int:
    var profile = _target_farm_profile(poi)
    if profile == "":
        return 0
    return max(1,int(poi.get("refresh_days",TARGET_FARM_REFRESH_DAYS.get(profile,0))))

func _target_farm_expected_container_keys(poi:Dictionary) -> Array:
    var out = []
    if typeof(poi) != TYPE_DICTIONARY or poi.is_empty():
        return out
    var poi_id = str(poi.get("id",""))
    var farm_profile = _target_farm_profile(poi)
    if poi_id == "" or farm_profile == "" or not PoiCatalog.has_compound(poi_id):
        return out
    var anchor:Vector2i = poi.get("coord",poi.get("anchor",Vector2i(999999,999999)))
    if anchor.x >= 900000:
        return out
    for offset in PoiCatalog.footprint(poi_id):
        var cell = PoiCatalog.cell(poi_id,offset)
        var coord = anchor + offset
        for spec in cell.get("buildings",[]):
            if str(spec.get("loot","")) != farm_profile:
                continue
            var cid = str(spec.get("container_id",""))
            if cid != "":
                out.append("%d:%d:container:%s" % [coord.x,coord.y,cid])
        for loose in cell.get("loose_containers",[]):
            if str(loose.get("loot","")) != farm_profile:
                continue
            var cid = str(loose.get("id",""))
            if cid != "":
                out.append("%d:%d:container:%s" % [coord.x,coord.y,cid])
    return out

func _target_farm_site_state(poi_id:String) -> Dictionary:
    var raw = loot_refresh_sites.get(poi_id,{})
    if typeof(raw) != TYPE_DICTIONARY:
        return {}
    return raw.duplicate(true)

func _target_farm_cancel_schedule(poi_id:String):
    if poi_id == "":
        return
    var state = _target_farm_site_state(poi_id)
    if state.is_empty():
        return
    state["ready_day"] = 0
    state["cleared_day"] = 0
    loot_refresh_sites[poi_id] = state

func _target_farm_schedule_if_cleared(poi_id:String):
    var poi = RegionCatalog.poi_by_id(poi_id)
    if poi.is_empty():
        return
    var keys = _target_farm_expected_container_keys(poi)
    if keys.is_empty():
        return
    for key in keys:
        if not container_states.has(key):
            return
        var state = container_states[key]
        if typeof(state) != TYPE_DICTIONARY or not state.get("items",[]).is_empty():
            return
    var site = _target_farm_site_state(poi_id)
    if int(site.get("ready_day",0)) > 0:
        return
    site["cleared_day"] = world_day
    site["ready_day"] = world_day + _target_farm_refresh_days(poi)
    site["cycle"] = int(site.get("cycle",0))
    loot_refresh_sites[poi_id] = site

func _target_farm_note_container_change(key:String,player_added=false):
    if not container_states.has(key):
        return
    var state = container_states[key]
    if typeof(state) != TYPE_DICTIONARY or not bool(state.get("target_farm",false)):
        return
    var poi_id = str(state.get("poi_id",""))
    if poi_id == "":
        return
    if player_added:
        # Player storage must never be overwritten by a scheduled refill. Depositing
        # anything into a target cache cancels its site timer; a fresh cooldown only
        # starts after the target caches are emptied again.
        _target_farm_cancel_schedule(poi_id)
        return
    if state.get("items",[]).is_empty():
        _target_farm_schedule_if_cleared(poi_id)

func _reset_target_farm_threats(poi:Dictionary):
    if typeof(poi) != TYPE_DICTIONARY or poi.is_empty():
        return
    var anchor:Vector2i = poi.get("coord",poi.get("anchor",Vector2i(999999,999999)))
    if anchor.x >= 900000:
        return
    var prefixes = []
    for offset in poi.get("footprint",[Vector2i.ZERO]):
        var coord = anchor + offset
        prefixes.append("%d:%d:" % [coord.x,coord.y])
    for raw_key in defeated.keys():
        var key = str(raw_key)
        for prefix in prefixes:
            if key.begins_with(prefix):
                defeated.erase(raw_key)
                break

func _target_farm_other_site_chunk_loaded(poi:Dictionary,current_coord:Vector2i) -> bool:
    if typeof(poi) != TYPE_DICTIONARY or poi.is_empty():
        return false
    var anchor:Vector2i = poi.get("coord",poi.get("anchor",Vector2i(999999,999999)))
    if anchor.x >= 900000:
        return false
    for offset in poi.get("footprint",[Vector2i.ZERO]):
        var coord = anchor + offset
        if coord != current_coord and loaded_chunks.has(coord):
            return true
    return false

func _prepare_target_farm_site(poi:Dictionary) -> bool:
    if typeof(poi) != TYPE_DICTIONARY or poi.is_empty():
        return false
    var poi_id = str(poi.get("id",""))
    var farm_profile = _target_farm_profile(poi)
    if poi_id == "" or farm_profile == "":
        return false
    var site = _target_farm_site_state(poi_id)
    var ready_day = int(site.get("ready_day",0))
    if ready_day <= 0 or world_day < ready_day:
        return false
    var keys = _target_farm_expected_container_keys(poi)
    if keys.is_empty():
        return false
    # Never delete player storage. A refill only commits if every target cache is
    # still empty when the player comes back after the cooldown.
    for key in keys:
        if not container_states.has(key):
            return false
        var state = container_states[key]
        if typeof(state) != TYPE_DICTIONARY or not state.get("items",[]).is_empty():
            return false
    var cycle = int(site.get("cycle",0)) + 1
    for key in keys:
        var state = container_states[key]
        var grid = _container_grid_size(state)
        var table_name = str(state.get("loot_table",farm_profile))
        state["items"] = _generate_loot("%s:refresh:%d" % [key,cycle],table_name,grid.x,grid.y)
        state["generated_day"] = world_day
        state["refresh_cycle"] = cycle
        container_states[key] = state
    site["cycle"] = cycle
    site["last_refresh_day"] = world_day
    site["ready_day"] = 0
    site["cleared_day"] = 0
    loot_refresh_sites[poi_id] = site
    # A new target-farm cycle must also restore the location's danger; otherwise a
    # cleared dungeon would become a free vending machine on later visits.
    _reset_target_farm_threats(poi)
    return true

func _create_container(chunk, coord, local_pos, container_id, loot_table, display_name, grid_w=CONTAINER_W, grid_h=CONTAINER_H):
    var key = "%d:%d:container:%s" % [coord.x,coord.y,container_id]
    var target_w = clamp(int(grid_w),CONTAINER_W,QA_ALL_ITEMS_CONTAINER_W)
    var target_h = clamp(int(grid_h),CONTAINER_H,QA_ALL_ITEMS_CONTAINER_H)
    if str(loot_table) == "all_items_test":
        target_w = QA_ALL_ITEMS_CONTAINER_W
        target_h = QA_ALL_ITEMS_CONTAINER_H
    var poi = RegionCatalog.poi_for_chunk(coord)
    var poi_id = str(poi.get("id",""))
    var target_farm = poi_id != "" and _target_farm_profile(poi) == str(loot_table)

    if not container_states.has(key):
        container_states[key] = {
            "name": display_name,
            "loot_table": loot_table,
            "grid_w":target_w,
            "grid_h":target_h,
            "generated_day":world_day,
            "refresh_cycle":0,
            "poi_id":poi_id,
            "target_farm":target_farm,
            "items": _generate_loot(key, loot_table,target_w,target_h)
        }
    elif loot_table == "all_items_test":
        # QA catalogue crates are versionless test fixtures. Existing saves may
        # contain the old 8x8 truncated state, so expand and repack the fixture
        # when it is spawned rather than forcing a save-version migration.
        var qa_state = container_states[key]
        qa_state["name"] = display_name
        qa_state["loot_table"] = loot_table
        qa_state["grid_w"] = target_w
        qa_state["grid_h"] = target_h
        var qa_ids = {}
        for qa_entry in qa_state.get("items",[]):
            qa_ids[str(qa_entry.get("id",""))] = true
        var qa_complete = qa_ids.size() == item_defs.size()
        if qa_complete:
            for qa_item_id in item_defs.keys():
                if not qa_ids.has(str(qa_item_id)):
                    qa_complete = false
                    break
        if not qa_complete:
            qa_state["items"] = _generate_loot(key,loot_table,target_w,target_h)
        container_states[key] = qa_state
    else:
        # Existing saves keep their exact loot. We only attach refresh metadata;
        # old containers are never silently rerolled during migration.
        var state = container_states[key]
        state["name"] = display_name
        state["loot_table"] = loot_table
        state["grid_w"] = int(state.get("grid_w",target_w))
        state["grid_h"] = int(state.get("grid_h",target_h))
        state["poi_id"] = poi_id
        state["target_farm"] = target_farm
        state["generated_day"] = int(state.get("generated_day",world_day))
        state["refresh_cycle"] = int(state.get("refresh_cycle",0))
        container_states[key] = state
        if target_farm and state.get("items",[]).is_empty():
            _target_farm_schedule_if_cleared(poi_id)

    var node = Node2D.new()
    node.position = local_pos
    node.z_index = 8
    node.z_as_relative = false
    node.add_to_group("interactable")
    node.set_meta("interaction_type","container")
    node.set_meta("container_key",key)
    node.set_meta("display_name",display_name)
    chunk.add_child(node)

    _world_prop_sprite("crate",node,Vector2(0,-2),0,0.90)
    return node

func _generate_loot(key, table_name, grid_w=CONTAINER_W, grid_h=CONTAINER_H):
    var entries = []

    # Permanent QA invariant: the special catalogue crate is generated from
    # item_defs itself. Adding a new item therefore adds it to "ТЕСТ: ВСЕ
    # ПРЕДМЕТЫ" automatically; ordinary loot tables stay explicit. If the
    # catalogue ever stops fitting, QA container dimensions must be expanded.
    if str(table_name) == "all_items_test":
        var catalogue_ids = item_defs.keys()
        catalogue_ids.sort()
        for raw_id in catalogue_ids:
            var id = str(raw_id)
            var qty = max(1,int(item_defs[id].get("stack",1)))
            _grid_add(entries,id,qty,int(grid_w),int(grid_h))
        return entries

    var table = loot_tables.get(table_name, [])
    var rng = RandomNumberGenerator.new()
    rng.seed = int(abs(hash(key))) + 1

    for rule in table:
        if rng.randf() <= float(rule.get("chance",1.0)):
            var qty = rng.randi_range(int(rule.get("min",1)), int(rule.get("max",1)))
            _grid_add(entries, str(rule.get("id","")), qty, int(grid_w), int(grid_h))

    return entries





func _sanitize_shelter_breach_states():
    if typeof(shelter_breach_states) != TYPE_DICTIONARY:
        shelter_breach_states = {}
        return
    var clean = {}
    for raw_key in shelter_breach_states.keys():
        var raw = shelter_breach_states[raw_key]
        if typeof(raw) != TYPE_DICTIONARY:
            continue
        var kind = str(raw.get("kind",""))
        if kind != "door" and kind != "window":
            continue
        var reinforced = bool(raw.get("reinforced",false)) if kind == "window" else false
        var maximum = DOOR_MAX_CONDITION if kind == "door" else WINDOW_MAX_CONDITION + (40.0 if reinforced else 0.0)
        clean[str(raw_key)] = {
            "kind":kind,
            "condition":clamp(float(raw.get("condition",maximum)),0.0,maximum),
            "reinforced":reinforced
        }
    shelter_breach_states = clean

func _breach_state_record(key,kind,max_condition):
    var rec = shelter_breach_states.get(str(key),{})
    if typeof(rec) != TYPE_DICTIONARY:
        rec = {}
    else:
        rec = rec.duplicate(true)
    rec["kind"] = str(kind)
    rec["reinforced"] = bool(rec.get("reinforced",false))
    var effective_max = float(max_condition)
    if str(kind) == "window" and bool(rec["reinforced"]):
        effective_max += 40.0
    rec["condition"] = clamp(float(rec.get("condition",effective_max)),0.0,effective_max)
    shelter_breach_states[str(key)] = rec
    return rec

func _set_breach_state_record(key,rec):
    if typeof(rec) != TYPE_DICTIONARY:
        return
    shelter_breach_states[str(key)] = rec.duplicate(true)

# 1.00 keeps 0.99 visual shelter damage save-safe: stage derives only from persistent HP,
# so saves remain backward-compatible and repairs immediately restore appearance.
func _shelter_visual_stage(condition,max_condition):
    var maximum = max(1.0,float(max_condition))
    var value = clamp(float(condition),0.0,maximum)
    if value <= 0.01:
        return 3
    var ratio = value / maximum
    if ratio < 0.40:
        return 2
    if ratio < 0.75:
        return 1
    return 0

func _ensure_shelter_damage_visual(node,kind):
    if not is_instance_valid(node):
        return null
    node.set_meta("visual_damage_kind",str(kind))
    var visual = node.get_node_or_null("ShelterDamageVisual")
    if visual == null:
        visual = ShelterDamageVisual.new()
        visual.name = "ShelterDamageVisual"
        node.add_child(visual)
    return visual

func _sync_shelter_damage_visual(node,kind,condition,max_condition,reinforced = false):
    if not is_instance_valid(node):
        return 0
    var maximum = max(1.0,float(max_condition))
    var value = clamp(float(condition),0.0,maximum)
    var stage = _shelter_visual_stage(value,maximum)
    var previous_stage = int(node.get_meta("visual_damage_stage",stage))
    node.set_meta("visual_damage_kind",str(kind))
    node.set_meta("visual_damage_stage",stage)
    node.set_meta("visual_damage_ratio",value / maximum)
    node.set_meta("visual_reinforced",bool(reinforced))
    if stage > previous_stage:
        node.set_meta("visual_stage_change_from",previous_stage)
        node.set_meta("visual_stage_change_to",stage)
        node.set_meta("visual_stage_change_ms",Time.get_ticks_msec())
        node.set_meta("visual_fx_serial",int(node.get_meta("visual_fx_serial",0)) + 1)
        node.set_meta("breach_impact",max(float(node.get_meta("breach_impact",0.0)),0.22 + float(stage) * 0.045))
    _ensure_shelter_damage_visual(node,kind)
    return stage

func _align_shelter_damage_visual(node,visual_target = null,fallback_offset = Vector2.ZERO):
    if not is_instance_valid(node):
        return
    var overlay = node.get_node_or_null("ShelterDamageVisual")
    if not is_instance_valid(overlay):
        return
    if is_instance_valid(visual_target):
        overlay.position = node.to_local(visual_target.global_position)
    else:
        overlay.position = fallback_offset

func _breach_under_attack(node,grace_ms = 1400):
    if not is_instance_valid(node):
        return false
    var last_hit = int(node.get_meta("breach_last_hit_ms",-1000000))
    if Time.get_ticks_msec() - last_hit >= int(grace_ms):
        return false
    # A recent impact alone is not enough: repair is blocked only while a nearby
    # infected is visibly in its production attack animation. This prevents stale
    # hits from locking interaction and keeps direct regression helpers deterministic.
    for enemy in get_tree().get_nodes_in_group("infected"):
        if not is_instance_valid(enemy):
            continue
        if enemy.global_position.distance_to(node.global_position) > 42.0:
            continue
        if float(enemy.get_meta("attack_anim",0.0)) > 0.02:
            return true
    return false

func _door_defense_record(door):
    if not is_instance_valid(door):
        return {}
    return _breach_state_record(str(door.get_meta("door_key","")),"door",DOOR_MAX_CONDITION)

func _refresh_door_defense(door):
    if not is_instance_valid(door):
        return
    var key = str(door.get_meta("door_key",""))
    if key == "":
        return
    var rec = _door_defense_record(door)
    var condition = clamp(float(rec.get("condition",DOOR_MAX_CONDITION)),0.0,DOOR_MAX_CONDITION)
    door.set_meta("door_condition",condition)
    door.set_meta("door_breached",condition <= 0.01)
    _sync_shelter_damage_visual(door,"door",condition,DOOR_MAX_CONDITION,false)
    var leaf = door.get_meta("front_leaf") if door.has_meta("front_leaf") else null
    if is_instance_valid(leaf):
        # _update_front_leaf owns the open/close shading. Damage adds a restrained
        # dirt/dent tint without introducing another detached sprite.
        var damage_t = 1.0 - condition / DOOR_MAX_CONDITION
        leaf.self_modulate = Color(1.0,1.0 - damage_t*0.20,1.0 - damage_t*0.28,1.0)
        _align_shelter_damage_visual(door,leaf)
    else:
        _align_shelter_damage_visual(door,null,Vector2.ZERO)

func _repair_shelter_door(door):
    if not is_instance_valid(door):
        return false
    if _shelter_intruders_block_repair(door):
        _set_survival_feedback("Сначала очистите убежище от заражённых",2.0)
        return false
    if _breach_under_attack(door):
        _set_survival_feedback("Слишком опасно: дверь сейчас ломают",1.8)
        return false
    var rec = _door_defense_record(door)
    var condition = clamp(float(rec.get("condition",DOOR_MAX_CONDITION)),0.0,DOOR_MAX_CONDITION)
    if condition >= DOOR_MAX_CONDITION - 0.1:
        _set_survival_feedback("Дверь цела",1.4)
        return false
    if _inventory_count("scrap") < 1 or _inventory_count("tape") < 1:
        _set_survival_feedback("Для ремонта двери нужны металлолом и лента",2.0)
        return false
    var test_entries = inventory_entries.duplicate(true)
    if not _consume_from_entries(test_entries,"scrap",1):
        return false
    if not _consume_from_entries(test_entries,"tape",1):
        return false
    inventory_entries = test_entries
    condition = min(DOOR_MAX_CONDITION,condition + DOOR_REPAIR_AMOUNT)
    rec["condition"] = condition
    _set_breach_state_record(str(door.get_meta("door_key","")),rec)
    _refresh_door_defense(door)
    if bool(door.get_meta("door_open",false)) and not _doorway_blocked(door):
        door_states[str(door.get_meta("door_key",""))] = false
        _apply_door_state(door,false,false)
    _emit_ai_sound(door.global_position,82.0,"workbench",0.75)
    _set_survival_feedback("Дверь укреплена: %d%%" % int(round(condition)),1.8)
    call_deferred("_refresh_inventory_ui")
    return true

func _find_breach_window_visual(facade,x):
    if not is_instance_valid(facade):
        return null
    for child in facade.get_children():
        if not is_instance_valid(child) or not child.has_meta("breach_window_x"):
            continue
        if abs(float(child.get_meta("breach_window_x")) - float(x)) < 0.25:
            return child
    return null

func _set_tall_window_state(sprite,style,state):
    if not is_instance_valid(sprite):
        return
    var atlas = load("res://facade_windows_v1.png")
    if atlas == null:
        return
    var tex = AtlasTexture.new()
    tex.atlas = atlas
    tex.region = Rect2(clamp(int(state),0,3) * 48,clamp(int(style),0,6) * 40,48,40)
    sprite.texture = tex
    sprite.set_meta("window_state",clamp(int(state),0,3))

func _window_condition_max(rec):
    return WINDOW_MAX_CONDITION + (40.0 if bool(rec.get("reinforced",false)) else 0.0)

func _refresh_shelter_window(node):
    if not is_instance_valid(node):
        return
    var key = str(node.get_meta("breach_key",""))
    if key == "":
        return
    var rec = shelter_breach_states.get(key,{})
    if typeof(rec) != TYPE_DICTIONARY:
        rec = _breach_state_record(key,"window",WINDOW_MAX_CONDITION)
    var max_condition = _window_condition_max(rec)
    var condition = clamp(float(rec.get("condition",max_condition)),0.0,max_condition)
    rec["condition"] = condition
    _set_breach_state_record(key,rec)
    node.set_meta("window_condition",condition)
    node.set_meta("window_reinforced",bool(rec.get("reinforced",false)))
    _sync_shelter_damage_visual(node,"window",condition,max_condition,bool(rec.get("reinforced",false)))
    var broken = condition <= 0.01
    var body = node.get_meta("window_body",null) if node.has_meta("window_body") else null
    if is_instance_valid(body):
        body.collision_layer = 0 if broken else LAYER_WORLD
    var shape = node.get_meta("window_shape",null) if node.has_meta("window_shape") else null
    if is_instance_valid(shape):
        shape.disabled = broken
    var visual = node.get_meta("window_visual",null) if node.has_meta("window_visual") else null
    if is_instance_valid(visual):
        var style = int(node.get_meta("window_style",0))
        var visual_state = 1 if broken else (2 if bool(rec.get("reinforced",false)) else 0)
        _set_tall_window_state(visual,style,visual_state)
        var t = condition / max(1.0,max_condition)
        visual.self_modulate = Color(0.78,0.70,0.64,1.0).lerp(Color.WHITE,t) if not broken else Color(0.88,0.82,0.76,1.0)
        _align_shelter_damage_visual(node,visual)
    else:
        _align_shelter_damage_visual(node,null,Vector2.ZERO)

func _create_shelter_window(chunk,coord,building_id,slot,local_pos,facade,facade_x,style):
    var key = "%d:%d:window:%s:%d" % [coord.x,coord.y,str(building_id),int(slot)]
    _breach_state_record(key,"window",WINDOW_MAX_CONDITION)
    var node = Node2D.new()
    node.name = "DefenseWindow_%s_%d" % [str(building_id),int(slot)]
    node.position = local_pos
    node.z_as_relative = false
    node.z_index = 36
    node.add_to_group("interactable")
    node.add_to_group("shelter_windows")
    node.add_to_group("shelter_defense_points")
    node.set_meta("interaction_type","shelter_window")
    node.set_meta("display_name","Окно")
    node.set_meta("interaction_radius",74.0)
    node.set_meta("breach_key",key)
    node.set_meta("window_style",int(style))
    node.set_meta("breach_impact",0.0)
    chunk.add_child(node)

    var body = StaticBody2D.new()
    body.collision_layer = LAYER_WORLD
    body.collision_mask = 0
    body.set_meta("breachable_window",node)
    node.add_child(body)
    var shape = CollisionShape2D.new()
    var rect = RectangleShape2D.new()
    rect.size = Vector2(34,10)
    shape.shape = rect
    body.add_child(shape)
    node.set_meta("window_body",body)
    node.set_meta("window_shape",shape)

    var visual = _find_breach_window_visual(facade,facade_x)
    node.set_meta("window_visual",visual)
    if is_instance_valid(visual):
        node.set_meta("window_visual_base",visual.position)
    _refresh_shelter_window(node)
    return node

func _repair_shelter_window(node):
    if not is_instance_valid(node):
        return false
    if _shelter_intruders_block_repair(node):
        _set_survival_feedback("Сначала очистите убежище от заражённых",2.0)
        return false
    if _breach_under_attack(node):
        _set_survival_feedback("Слишком опасно: окно сейчас ломают",1.8)
        return false
    var key = str(node.get_meta("breach_key",""))
    if key == "":
        return false
    var rec = shelter_breach_states.get(key,{})
    if typeof(rec) != TYPE_DICTIONARY:
        rec = _breach_state_record(key,"window",WINDOW_MAX_CONDITION)
    var max_condition = _window_condition_max(rec)
    var condition = clamp(float(rec.get("condition",max_condition)),0.0,max_condition)
    var reinforced = bool(rec.get("reinforced",false))

    # A pristine ordinary window can be proactively boarded. No new material item
    # is invented: scrap + tape represent a scavenged sheet/brace fixed to the frame.
    if not reinforced and condition >= WINDOW_MAX_CONDITION - 0.1:
        if _inventory_count("scrap") < 2 or _inventory_count("tape") < 1:
            _set_survival_feedback("Для укрепления окна нужны 2 металлолома и лента",2.0)
            return false
        var reinforce_entries = inventory_entries.duplicate(true)
        if not _consume_from_entries(reinforce_entries,"scrap",2) or not _consume_from_entries(reinforce_entries,"tape",1):
            return false
        inventory_entries = reinforce_entries
        rec["reinforced"] = true
        rec["condition"] = WINDOW_MAX_CONDITION + 40.0
        _set_breach_state_record(key,rec)
        _refresh_shelter_window(node)
        _emit_ai_sound(node.global_position,86.0,"workbench",0.78)
        _set_survival_feedback("Окно укреплено металлической накладкой",1.9)
        call_deferred("_refresh_inventory_ui")
        return true

    var broken = condition <= 0.01
    var scrap_need = 2 if broken else 1
    if _inventory_count("scrap") < scrap_need or (broken and _inventory_count("tape") < 1):
        _set_survival_feedback("Нужны материалы для ремонта окна",1.8)
        return false
    var test_entries = inventory_entries.duplicate(true)
    if not _consume_from_entries(test_entries,"scrap",scrap_need):
        return false
    if broken and not _consume_from_entries(test_entries,"tape",1):
        return false
    inventory_entries = test_entries
    if broken:
        rec["reinforced"] = true
        condition = WINDOW_REPAIR_AMOUNT + 15.0
    else:
        condition = min(max_condition,condition + WINDOW_REPAIR_AMOUNT)
    rec["condition"] = condition
    _set_breach_state_record(key,rec)
    _refresh_shelter_window(node)
    _emit_ai_sound(node.global_position,80.0,"workbench",0.72)
    _set_survival_feedback("Окно восстановлено: %d%%" % int(round(condition / _window_condition_max(rec) * 100.0)),1.8)
    call_deferred("_refresh_inventory_ui")
    return true

func _create_door(chunk, coord, local_pos, door_id):
    var key = "%d:%d:door:%s" % [coord.x,coord.y,door_id]
    if not door_states.has(key):
        door_states[key] = false
    _breach_state_record(key,"door",DOOR_MAX_CONDITION)

    var node = Node2D.new()
    node.position = local_pos
    node.z_index = 37
    node.z_as_relative = false
    node.add_to_group("interactable")
    node.add_to_group("doors")
    node.add_to_group("shelter_defense_points")
    node.set_meta("interaction_type","door")
    node.set_meta("door_key",key)
    node.set_meta("display_name","Дверь")
    node.set_meta("door_open",false)
    node.set_meta("door_target_angle",0.0)
    node.set_meta("door_swing",-PI * 0.5)
    node.set_meta("interaction_radius",88.0)
    node.set_meta("breach_key",key)
    node.set_meta("breach_impact",0.0)
    chunk.add_child(node)

    var frame = Node2D.new()
    node.add_child(frame)
    # 0.84: true top-down threshold. The previous upright 32x48 door sprite was
    # rotated in the ground plane and therefore looked skewed / detached from walls.
    _rect(Vector2(0,1),Vector2(48,12),Color("202422"),frame)
    _rect(Vector2(0,-2),Vector2(42,5),Color("6b5845"),frame)
    _rect(Vector2(-22,0),Vector2(6,16),Color("252a28"),frame)
    _rect(Vector2(22,0),Vector2(6,16),Color("252a28"),frame)
    _rect(Vector2(0,7),Vector2(44,3),Color(0.08,0.09,0.085,0.62),frame)

    var visual = Node2D.new()
    visual.position = Vector2(-19,0)
    node.add_child(visual)
    var door_sprite = Sprite2D.new()
    door_sprite.texture = load("res://door_topdown_v2.png")
    door_sprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
    door_sprite.position = Vector2(19,0)
    door_sprite.scale = Vector2.ONE
    visual.add_child(door_sprite)
    node.set_meta("door_hinge_offset",Vector2(-19,0))

    var body = StaticBody2D.new()
    body.collision_layer = LAYER_WORLD
    body.collision_mask = 0
    body.set_meta("breachable_door",node)
    node.add_child(body)

    var shape = CollisionShape2D.new()
    var rect = RectangleShape2D.new()
    rect.size = Vector2(38,10)
    shape.shape = rect
    shape.position = Vector2.ZERO
    body.add_child(shape)

    node.set_meta("door_visual",visual)
    node.set_meta("door_frame",frame)
    node.set_meta("door_body",body)
    node.set_meta("door_shape",shape)

    _apply_door_state(node,bool(door_states[key]),true)
    _refresh_door_defense(node)
    if float(node.get_meta("door_condition",DOOR_MAX_CONDITION)) <= 0.01:
        door_states[key] = true
        _apply_door_state(node,true,true)
    return node

func _link_front_door(door_node,facade):
    # 0.90: buildings with a tall facade show the door as a front-facing leaf in
    # the doorway. The old top-down slab keeps running (hidden) so every door
    # rule — interaction, collision, blocking, saves — stays exactly the same.
    if door_node == null or facade == null or not facade.has_meta("door_leaf"):
        return
    var leaf = facade.get_meta("door_leaf")
    if not is_instance_valid(leaf):
        return
    door_node.set_meta("front_leaf",leaf)
    door_node.set_meta("front_door",true)
    var old_visual = door_node.get_meta("door_visual",null)
    if is_instance_valid(old_visual):
        old_visual.visible = false
    var old_frame = door_node.get_meta("door_frame",null) if door_node.has_meta("door_frame") else null
    if is_instance_valid(old_frame):
        old_frame.visible = false
    _update_front_leaf(door_node)
    _refresh_door_defense(door_node)

func _update_front_leaf(door):
    var leaf = door.get_meta("front_leaf") if door.has_meta("front_leaf") else null
    if not is_instance_valid(leaf):
        return
    var visual = door.get_meta("door_visual",null)
    var angle = 0.0
    if is_instance_valid(visual):
        angle = abs(visual.rotation)
    var open_t = clamp(angle / (PI * 0.5),0.0,1.0)
    # swinging inward: the leaf narrows toward the hinge and falls into shadow
    leaf.scale = Vector2(lerpf(1.0,0.14,open_t),1.0)
    leaf.modulate = Color(1,1,1,1).lerp(Color(0.46,0.44,0.42,1),open_t)
    _align_shelter_damage_visual(door,leaf)

func _update_doors(delta):
    for door in get_tree().get_nodes_in_group("doors"):
        if not is_instance_valid(door):
            continue
        var visual = door.get_meta("door_visual",null)
        if not is_instance_valid(visual):
            continue
        var target = float(door.get_meta("door_target_angle",0.0))
        var impact = max(0.0,float(door.get_meta("breach_impact",0.0)) - delta)
        door.set_meta("breach_impact",impact)
        if not bool(door.get_meta("door_open",false)):
            target += sin(impact * 65.0) * impact * 0.3
        visual.rotation = lerp_angle(visual.rotation,target,min(1.0,delta * 12.0))
        if door.has_meta("front_leaf"):
            _update_front_leaf(door)
    for window_node in get_tree().get_nodes_in_group("shelter_windows"):
        if not is_instance_valid(window_node):
            continue
        var impact = max(0.0,float(window_node.get_meta("breach_impact",0.0)) - delta)
        window_node.set_meta("breach_impact",impact)
        var visual = window_node.get_meta("window_visual",null) if window_node.has_meta("window_visual") else null
        var base_pos = window_node.get_meta("window_visual_base",Vector2.ZERO)
        if is_instance_valid(visual) and typeof(base_pos) == TYPE_VECTOR2:
            visual.position = base_pos + Vector2(sin(impact * 68.0) * impact * 4.0,0.0)


func _ensure_shelter_threat_indicator():
    if not is_instance_valid(player):
        return null
    var indicator = player.get_node_or_null("ShelterThreatIndicator")
    if indicator == null:
        indicator = ShelterThreatIndicator.new()
        indicator.name = "ShelterThreatIndicator"
        player.add_child(indicator)
    return indicator

func _doorway_blocked(door):
    # Only the actual threshold blocks closing; the previous large radius
    # made a nearby player unable to operate the door.
    if player != null:
        var lp = door.to_local(player.global_position)
        if abs(lp.x) < 23.0 and abs(lp.y) < 13.0:
            return true

    for enemy in get_tree().get_nodes_in_group("infected"):
        if not is_instance_valid(enemy):
            continue
        var le = door.to_local(enemy.global_position)
        if abs(le.x) < 22.0 and abs(le.y) < 13.0:
            return true

    return false

func _toggle_door(node):
    var key = str(node.get_meta("door_key",""))
    if key == "":
        return

    var is_open = bool(door_states.get(key,false))
    var defense = _door_defense_record(node)
    var condition = clamp(float(defense.get("condition",DOOR_MAX_CONDITION)),0.0,DOOR_MAX_CONDITION)
    if is_open and condition <= 0.01:
        _repair_shelter_door(node)
        return

    if is_open:
        if _doorway_blocked(node):
            return
        door_states[key] = false
        _apply_door_state(node,false,false)
        _emit_ai_sound(node.global_position,105.0,"door",1.15)
    else:
        var local_player = node.to_local(player.global_position)
        var swing = -PI * 0.5 if local_player.y >= 0.0 else PI * 0.5
        node.set_meta("door_swing",swing)
        door_states[key] = true
        _apply_door_state(node,true,false)
        _emit_ai_sound(node.global_position,82.0,"door",0.85)

func _apply_door_state(node, open, snap=false):
    node.set_meta("door_open",open)
    var visual = node.get_meta("door_visual",null)
    var body = node.get_meta("door_body",null)
    var shape = node.get_meta("door_shape",null)
    # door_arc was used by an older door visual. Godot reports a runtime error
    # when get_meta() is called for an absent key, even when a null fallback is
    # supplied, so guard the optional legacy meta explicitly.
    var arc = node.get_meta("door_arc") if node.has_meta("door_arc") else null

    var target = float(node.get_meta("door_swing",-PI * 0.5)) if open else 0.0
    node.set_meta("door_target_angle",target)

    if is_instance_valid(body):
        body.collision_layer = 0 if open else LAYER_WORLD

    if is_instance_valid(shape):
        shape.disabled = open

    if is_instance_valid(arc):
        arc.visible = not open

    if snap and is_instance_valid(visual):
        visual.rotation = target
        if node.has_meta("front_leaf"):
            _update_front_leaf(node)






func _make_world_loot_texture(id):
    if loot_atlas_texture == null:
        loot_atlas_texture = load("res://loot_sprites_v30.png")

    if loot_atlas_texture != null and loot_icon_cells.has(id):
        var cell = loot_icon_cells[id]
        var tex = AtlasTexture.new()
        tex.atlas = loot_atlas_texture
        tex.region = Rect2(cell.x * 40,cell.y * 40,40,40)
        return tex

    return _make_item_icon(id)

func _world_loot_visual_scale(id):
    # 0.74: loot_sprites_v23 is authored at native world pixel size (same art as
    # the inventory icons, rendered small), so it is never resampled on the ground.
    return 1.0



func _world_loot_art_extent(id):
    var tex = _make_world_loot_texture(id)
    if tex == null:
        return 999
    var img = tex.get_image()
    if img == null:
        return 999
    var used = img.get_used_rect()
    return max(used.size.x,used.size.y)

func _spawn_world_item(chunk, coord, id, qty, local_pos, pickup_key, drop_id, instance_id=""):
    if not item_defs.has(id):
        return null

    var item = item_defs[id]
    var node = Node2D.new()
    node.position = local_pos
    node.z_index = 7
    node.z_as_relative = false
    node.add_to_group("interactable")
    node.add_to_group("world_items")
    node.set_meta("interaction_type","world_item")
    node.set_meta("item_id",id)
    node.set_meta("qty",qty)
    node.set_meta("pickup_key",pickup_key)
    node.set_meta("drop_id",drop_id)
    node.set_meta("instance_id",str(instance_id))
    node.set_meta("display_name",str(item.get("name",id)))
    node.set_meta("bob_phase",randf() * TAU)
    chunk.add_child(node)

    var visual_scale = _world_loot_visual_scale(id)

    var shadow = _ellipse(
        Vector2(0,6),
        9.0 if str(item.get("category","")) == "weapon" else 6.0,
        2.6 if str(item.get("category","")) == "weapon" else 2.2,
        Color(0.02,0.02,0.02,0.22),
        node
    )

    var sprite = Sprite2D.new()
    sprite.texture = _make_world_loot_texture(id)
    sprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
    sprite.scale = Vector2(visual_scale,visual_scale)
    sprite.position = Vector2(0,-3)
    node.add_child(sprite)

    var glint = _rect(Vector2(5,-8),Vector2(1.5,1.5),Color(0.95,0.91,0.65,0.58),node)
    glint.z_index = 2

    node.set_meta("item_sprite",sprite)
    node.set_meta("item_shadow",shadow)
    node.set_meta("item_glint",glint)
    node.set_meta("world_visual_scale",visual_scale)
    return node


func _update_world_items(delta):
    for node in get_tree().get_nodes_in_group("world_items"):
        if not is_instance_valid(node):
            continue

        var phase = float(node.get_meta("bob_phase",0.0)) + delta * 2.0
        node.set_meta("bob_phase",phase)

        var sprite = node.get_meta("item_sprite",null)
        var shadow = node.get_meta("item_shadow",null)
        var glint = node.get_meta("item_glint",null)

        var bob = sin(phase) * 0.9

        if is_instance_valid(sprite):
            sprite.position.y = -3.0 + bob
            sprite.rotation = sin(phase * 0.55) * 0.022

        if is_instance_valid(shadow):
            var shadow_scale = 1.0 - max(0.0,bob) * 0.018
            shadow.scale = Vector2(shadow_scale,shadow_scale)

        if is_instance_valid(glint):
            var pulse = 0.28 + (sin(phase * 1.7) + 1.0) * 0.20
            glint.modulate.a = pulse

func _spawn_fixed_item(chunk, coord, local_pos, spawn_id, id, qty):
    var key = "%d:%d:pickup:%s" % [coord.x,coord.y,spawn_id]
    if bool(picked_world_items.get(key,false)):
        return
    _spawn_world_item(chunk,coord,id,qty,local_pos,key,-1)

func _spawn_saved_drops_for_chunk(chunk,coord):
    for record in dropped_items:
        var pos = Vector2(float(record.get("x",0.0)), float(record.get("y",0.0)))
        if _world_to_chunk(pos) == coord:
            _spawn_world_item(
                chunk,
                coord,
                str(record.get("id","")),
                int(record.get("qty",1)),
                pos - chunk.global_position,
                "",
                int(record.get("drop_id",-1)),
                str(record.get("instance_id",""))
            )

