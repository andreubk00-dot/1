func _rebuild_region_map_grid(center):
    region_map_center = center
    if region_map_grid != null:
        region_map_grid.center = center

func _center_map_on_player():
    _rebuild_region_map_grid(current_chunk)
    _refresh_region_map_ui()

func _zoom_region_map(change):
    region_map_grid.set_zoom(region_map_grid.zoom_index + change)

func _sanitize_map_markers(raw):
    var clean = {}
    if typeof(raw) != TYPE_DICTIONARY:
        return clean
    for raw_key in raw:
        var key = str(raw_key)
        var parts = key.split(":")
        if parts.size() != 2 or not parts[0].is_valid_int() or not parts[1].is_valid_int():
            continue
        var coord = Vector2i(int(parts[0]),int(parts[1]))
        if absi(coord.x) > 100000 or absi(coord.y) > 100000:
            continue
        var marker = raw[raw_key]
        if typeof(marker) != TYPE_DICTIONARY or str(marker.get("kind","")) not in MAP_MARKER_KINDS:
            continue
        clean[_zone_chunk_key(coord)] = {"kind":str(marker["kind"]),"label":str(marker.get("label","")).replace("\n"," ").replace("\r"," ").strip_edges().left(32)}
        if clean.size() >= 128:
            break
    return clean

func _save_selected_map_marker():
    if region_map_selected_chunk.x >= 900000:
        return
    var key = _zone_chunk_key(region_map_selected_chunk)
    if not map_markers.has(key) and map_markers.size() >= 128:
        _set_survival_feedback("На карте уже 128 заметок. Удалите ненужную.",2.0)
        return
    map_markers[key] = {"kind":MAP_MARKER_KINDS[map_marker_kind.selected],"label":map_marker_text.text.strip_edges().left(32)}
    _save_state()
    _refresh_region_map_ui()

func _remove_selected_map_marker():
    map_markers.erase(_zone_chunk_key(region_map_selected_chunk))
    map_marker_text.text = ""
    _save_state()
    _refresh_region_map_ui()

func _region_map_snapshot():
    var cells = {}
    var pois = []
    var radius = region_map_grid.visible_radius()
    for y in range(region_map_center.y-radius.y,region_map_center.y+radius.y+1):
        for x in range(region_map_center.x-radius.x,region_map_center.x+radius.x+1):
            var coord = Vector2i(x,y)
            var known = discovered_chunks.has(_zone_chunk_key(coord))
            var record = {"known":known,"tooltip":_region_map_cell_tooltip(coord)}
            if map_markers.has(_zone_chunk_key(coord)):
                var note = map_markers[_zone_chunk_key(coord)]
                record["tooltip"] += "\nМоя метка: " + str(note.get("label",note.get("kind","")))
            if known:
                var profile = _chunk_profile(coord)
                record["zone"] = str(profile.get("zone","residential"))
                record["district"] = str(profile.get("district_id",""))
            cells[coord] = record
            var poi = RegionCatalog.poi_for_chunk(coord)
            if not poi.is_empty() and bool(poi.get("is_anchor",false)) and discovered_pois.has(str(poi.get("id",""))):
                pois.append({"coord":coord,"name":str(poi.get("short_name",poi.get("name","ОБЪЕКТ"))),"symbol":"medical" if str(poi.get("loot","")) == "pharmacy" else "cache"})
    var marks = []
    for key in map_markers:
        var parts = str(key).split(":")
        var marker = map_markers[key].duplicate(true)
        marker["coord"] = Vector2i(int(parts[0]),int(parts[1]))
        marks.append(marker)
    var supply_event = SupplyEventSystem.active_event(faction_state,world_day)
    if not supply_event.is_empty():
        marks.append({"coord":SupplyEventSystem.active_coord(faction_state,world_day),"kind":"danger","label":SupplyEventSystem.marker_label(faction_state,world_day),"system":true})
    var snapshot = {"center":region_map_center,"cells":cells,"pois":pois,"markers":marks,"player":current_chunk}
    if region_map_selected_chunk.x < 900000:
        snapshot["selected"] = region_map_selected_chunk
    if _has_home():
        snapshot["home"] = _home_chunk()
    if expedition_active or home_navigation_active:
        snapshot["target"] = _navigation_target_chunk()
        snapshot["route"] = [current_chunk] + _expedition_route_chunks(current_chunk,_navigation_target_chunk())
    return snapshot

func _pan_region_map(offset):
    _rebuild_region_map_grid(region_map_center + offset)
    _refresh_region_map_ui()

func _load_map_marker_editor(coord):
    if map_marker_text != null:
        map_marker_text.set_meta("sector",coord)
        var marker = map_markers.get(_zone_chunk_key(coord),{})
        map_marker_text.text = str(marker.get("label",""))
        map_marker_kind.select(max(0,MAP_MARKER_KINDS.find(str(marker.get("kind","danger")))))

func _region_map_select_chunk(coord:Vector2i):
    region_map_selected_chunk = coord
    _load_map_marker_editor(coord)
    _refresh_region_map_ui()

func _toggle_region_map():
    if region_map_open:
        _close_region_map()
    else:
        _open_region_map()

func _open_region_map():
    if mod_panel_open:
        _close_weapon_mod_panel()
    if rest_open:
        _close_rest_panel()
    if crafting_open:
        _close_crafting()
    if base_build_open:
        _close_base_build()
    if inventory_open:
        _close_inventory()
    _cancel_reload()
    region_map_open = true
    if _expedition_sector_distance(current_chunk,region_map_center) > REGION_MAP_MAX:
        _rebuild_region_map_grid(current_chunk)
    home_journal_open = false
    if home_journal_panel != null:
        home_journal_panel.visible = false
    if region_map_panel != null:
        region_map_panel.visible = true
    if region_map_selected_chunk.x >= 900000:
        region_map_selected_chunk = expedition_target_chunk if expedition_active else current_chunk
    if region_map_canvas != null:
        region_map_canvas.visible = true
    _refresh_region_map_ui()

func _close_region_map():
    home_journal_open = false
    if home_journal_panel != null:
        home_journal_panel.visible = false
    region_map_open = false
    if region_map_canvas != null:
        region_map_canvas.visible = false

func _refresh_region_map_ui():
    if region_map_panel == null:
        return
    region_map_coord_label.text = "ДЕНЬ %d  %s   СЕКТОР %d:%d" % [world_day,_time_text(),current_chunk.x,current_chunk.y]
    region_map_grid.configure(_region_map_snapshot())

    var selected = region_map_selected_chunk
    if selected.x >= 900000:
        selected = current_chunk
    if map_marker_text != null and (not map_marker_text.has_meta("sector") or map_marker_text.get_meta("sector") != selected):
        _load_map_marker_editor(selected)
    var selected_key = _zone_chunk_key(selected)
    var discovered = discovered_chunks.has(selected_key)
    var profile = _chunk_profile(selected)
    var poi = RegionCatalog.poi_for_chunk(selected)
    var poi_known = not poi.is_empty() and discovered_pois.has(str(poi.get("id","")))
    region_map_location_label.text = _expedition_name_for_chunk(selected)
    var dist = _expedition_sector_distance(current_chunk,selected)
    var eta = _expedition_time_text(_expedition_estimated_minutes(current_chunk,selected))
    var detail_lines = ["Сектор %d:%d  •  %d сект.  •  путь %s" % [selected.x,selected.y,dist,eta]]
    if SupplyEventSystem.active_coord(faction_state,world_day) == selected:
        detail_lines.append("РАДИОСИГНАЛ: " + SupplyEventSystem.marker_label(faction_state,world_day))
        detail_lines.append(SupplyEventSystem.detail_text(faction_state,world_day))
    if discovered:
        detail_lines.append("Район: %s" % _district_display_name(str(profile.get("district_id","old_center"))))
        var map_risk = int(poi.get("risk",profile.get("risk",2))) if poi_known else int(profile.get("risk",2))
        detail_lines.append("Опасность: %d/5" % map_risk)
        if poi_known:
            detail_lines.append(str(poi.get("description","Обнаруженный ориентир.")))
    else:
        detail_lines.append("Статус: НЕ ИССЛЕДОВАН  •  опасность неизвестна")
        detail_lines.append("Можно назначить как разведывательную цель.")
    region_map_detail_label.text = "\n".join(detail_lines)

    # Exploration knowledge belongs to the player: the map does not grade loadouts.
    region_map_readiness_label.text = ""
    region_map_readiness_label.visible = false
    if expedition_active:
        var returning = expedition_target_reached or bool(expedition_journal.get("returning",false))
        var status = "ВОЗВРАЩЕНИЕ\n%s" % _home_navigation_text() if returning else "В ПУТИ\nДо цели: %d сект." % _expedition_sector_distance(current_chunk,expedition_target_chunk)
        region_map_active_label.text = "%s\n%s\n%s" % [expedition_target_name,status,"Старт: день %d, %02d:%02d" % [expedition_started_day,int(expedition_started_minutes/60.0)%24,int(expedition_started_minutes)%60]]
        region_map_cancel_button.disabled = false
    else:
        region_map_active_label.text = "Выберите сектор и назначьте цель.\nДом: %s" % str(expedition_journal["home"].get("name","не закреплён"))
        if not _has_home():
            region_map_active_label.text = "Сначала закрепите здание: Дом / журнал.\nИсследовать мир можно и без плана."
        region_map_cancel_button.disabled = true
    region_map_plan_button.text = "ОБНОВИТЬ ЦЕЛЬ" if expedition_active else "НАЗНАЧИТЬ ЦЕЛЬ"
    region_map_plan_button.disabled = selected == current_chunk or not _has_home() or selected == _home_chunk()
    region_map_plan_button.tooltip_text = "Цель должна быть вне домашнего сектора."
    if home_journal_open:
        _refresh_home_journal_ui()

func _plan_selected_expedition():
    if region_map_selected_chunk.x >= 900000 or region_map_selected_chunk == current_chunk:
        return
    if not _has_home():
        _set_survival_feedback("Войдите в здание и закрепите дом: M → Дом / журнал",3.0)
        return
    if region_map_selected_chunk == _home_chunk():
        return
    if not expedition_active:
        expedition_origin_chunk = _home_chunk()
        expedition_started_day = world_day
        expedition_started_minutes = world_minutes
        expedition_journal["departure"] = _expedition_snapshot()
        expedition_journal["departed"] = not _at_home()
    # Retargeting never resets the supplies baseline, home or departure time.
    expedition_active = true
    expedition_target_chunk = region_map_selected_chunk
    expedition_target_name = _expedition_name_for_chunk(expedition_target_chunk)
    expedition_target_reached = false
    expedition_journal["returning"] = false
    home_navigation_active = false
    _set_survival_feedback("Цель отмечена: %s" % expedition_target_name,2.2)
    _save_state()
    _refresh_region_map_ui()

func _cancel_expedition():
    if expedition_active:
        _finish_expedition("cancelled")

func _update_expedition_progress():
    if not expedition_active:
        if home_navigation_active and _at_home():
            home_navigation_active = false
        return
    if _has_home() and not bool(expedition_journal["departed"]) and not _at_home():
        # Preparation can continue after selecting a destination. Capture the
        # actual pack when crossing the home's boundary, before processing loot.
        expedition_journal["departed"] = true
        expedition_journal["departure"] = _expedition_snapshot()
        expedition_started_day = world_day
        expedition_started_minutes = world_minutes
        _save_state()
    if not expedition_target_reached and current_chunk == expedition_target_chunk:
        expedition_target_reached = true
        expedition_target_name = _expedition_name_for_chunk(current_chunk)
        _set_survival_feedback("Цель достигнута: %s • возвращайтесь домой" % expedition_target_name,2.8)
        _save_state()
        if region_map_open:
            _refresh_region_map_ui()
    if _has_home():
        if bool(expedition_journal["departed"]) and _at_home():
            _finish_expedition("returned")
    elif expedition_target_reached and current_chunk == expedition_origin_chunk:
        # Legacy 0.92 active routes had no home identity. Finish their original
        # route once; new expeditions require a marked building.
        _finish_expedition("returned")

func _finish_expedition(status):
    if not expedition_active:
        return
    expedition_journal["last_report"] = ExpeditionJournal.report(
        status,expedition_target_name,expedition_target_reached,
        expedition_started_day,expedition_started_minutes,world_day,world_minutes,
        expedition_journal["departure"],_expedition_snapshot())
    expedition_active = false
    expedition_target_chunk = Vector2i(999999,999999)
    expedition_target_name = ""
    expedition_origin_chunk = Vector2i(999999,999999)
    expedition_target_reached = false
    expedition_started_day = 0
    expedition_started_minutes = 0.0
    expedition_journal["departure"] = {}
    expedition_journal["departed"] = false
    expedition_journal["returning"] = false
    home_navigation_active = false
    var message = "Вы вернулись домой. Итоги: M → Дом / журнал"
    if status == "cancelled":
        message = "План отменён. Запись сохранена в журнале."
    elif status == "incapacitated":
        message = "Вылазка сорвана. Запись сохранена в журнале."
    _set_survival_feedback(message,4.0)
    _save_state()
    if region_map_open:
        _refresh_region_map_ui()

# 0.93: an address is a persistent building identity, not the entire chunk.
func _shelter_record_at_player():
    if player != null:
        for rec in roof_records:
            if str(rec.get("building_key","")) != "" and rec.get("rect",Rect2()).has_point(player.global_position):
                return rec
    return {}

func _has_home():
    return not expedition_journal["home"].is_empty()

func _home_chunk():
    if not _has_home():
        return Vector2i(999999,999999)
    var coord = expedition_journal["home"]["chunk"]
    return Vector2i(int(coord[0]),int(coord[1]))

func _at_home():
    return _has_home() and str(_shelter_record_at_player().get("building_key","")) == str(expedition_journal["home"]["key"])

func _home_claim_reason():
    if expedition_active:
        return "Завершите или отмените вылазку перед сменой дома."
    if _shelter_record_at_player().is_empty():
        return "Войдите внутрь здания, которое хотите занять."
    if _at_home():
        return "Это ваш дом. Отметка не делает здание безопасным."
    if _rest_danger_nearby():
        return "Рядом заражённые: сначала проверьте здание."
    return "Отмечается текущее здание; припасы и постройки не перемещаются."

func _claim_current_home():
    var rec = _shelter_record_at_player()
    if expedition_active or rec.is_empty() or _at_home() or _rest_danger_nearby():
        _set_survival_feedback(_home_claim_reason(),3.0)
        return false
    var coord = rec.get("chunk_coord",current_chunk)
    var center = rec["rect"].get_center()
    expedition_journal["home"] = ExpeditionJournal.home({
        "key":str(rec["building_key"]),"name":str(rec.get("building_name","Убежище")).replace("\n"," ").left(60),
        "chunk":[coord.x,coord.y],"position":[center.x,center.y],
        "bounds":[rec["rect"].position.x,rec["rect"].position.y,rec["rect"].size.x,rec["rect"].size.y]
    })
    home_navigation_active = false
    _save_state()
    _set_survival_feedback("Убежище закреплено. На карте: Д",3.0)
    _refresh_region_map_ui()
    _refresh_home_journal_ui()
    return true

func _home_navigation_text():
    if not _has_home():
        if expedition_active:
            return "Старый маршрут: %d сект." % _expedition_sector_distance(current_chunk,expedition_origin_chunk)
        return "Дом пока не закреплён"
    if _at_home():
        return "Вы внутри своего убежища"
    var dist = _expedition_sector_distance(current_chunk,_home_chunk())
    if dist > 0:
        return "До дома: %d сект. • M — карта" % dist
    var pos = expedition_journal["home"]["position"]
    var delta = Vector2(float(pos[0]),float(pos[1])) - player.global_position
    var direction = ""
    if abs(delta.y) > abs(delta.x) * 0.45:
        direction += "С" if delta.y < 0.0 else "Ю"
    if abs(delta.x) > abs(delta.y) * 0.45:
        direction += "В" if delta.x > 0.0 else "З"
    return "Дом: %s • войдите в здание" % direction

func _navigation_target_chunk():
    if expedition_active:
        if expedition_target_reached or bool(expedition_journal["returning"]):
            return _home_chunk() if _has_home() else expedition_origin_chunk
        return expedition_target_chunk
    return _home_chunk()

func _navigate_home():
    if not _has_home():
        _set_survival_feedback("Сначала закрепите здание: Дом / журнал",2.5)
        return
    if expedition_active:
        expedition_journal["returning"] = true
        _save_state()
    home_navigation_active = true
    region_map_selected_chunk = _home_chunk()
    _open_region_map()
    _rebuild_region_map_grid(_home_chunk())
    _refresh_region_map_ui()
    _set_survival_feedback(_home_navigation_text(),2.5)

func _load_expedition_journal(parsed):
    expedition_journal = ExpeditionJournal.normalize(parsed.get("expedition_journal",{}))
    if not expedition_active:
        expedition_journal["departure"] = {}
        expedition_journal["departed"] = false
        expedition_journal["returning"] = false
    home_navigation_active = false

func _expedition_snapshot():
    var counts = {}
    for entry in inventory_entries:
        var id = str(entry.get("id",""))
        if item_defs.has(id):
            counts[id] = int(counts.get(id,0)) + int(entry.get("qty",1))
    for id in equipment.values():
        if item_defs.has(str(id)):
            counts[str(id)] = int(counts.get(str(id),0)) + 1
    var conditions = {}
    for entry in inventory_entries:
        var id = str(entry.get("id",""))
        if not weapon_defs.has(id):
            continue
        var iid = str(entry.get("instance_id",""))
        conditions["%s#%s" % [id,iid]] = _weapon_condition_value(id,iid)
        var ammo = str(weapon_defs[id].get("ammo",""))
        counts[ammo] = int(counts.get(ammo,0)) + _weapon_mag_value(id,iid)
        for module_id in _weapon_mod_state(id,iid).values():
            if item_defs.has(str(module_id)):
                counts[str(module_id)] = int(counts.get(str(module_id),0)) + 1
    var vitals = {}
    for key in ExpeditionJournal.VITALS:
        vitals[key] = float(get(key))
    return ExpeditionJournal.snapshot({"items":counts,"vitals":vitals,"body":body_condition,"weapons":conditions,"bleeding":bleeding})

func _recovery_advice():
    var lines = []
    if bleeding:
        lines.append("• Остановите кровотечение бинтом.")
    if wound_contamination >= 30.0:
        lines.append("• Обработайте загрязнённую рану антисептиком.")
    if wound_infection >= 30.0:
        lines.append("• Инфекция: нужны антибиотики, не только сон.")
    if body_temperature < 35.7:
        lines.append("• Согрейтесь у источника тепла.")
    elif body_temperature > 38.2:
        lines.append("• Отойдите от огня; проверьте инфекцию и воду.")
    if wetness >= 35.0:
        lines.append("• Просушите одежду под крышей, лучше у огня.")
    if thirst < 65.0:
        lines.append("• Выпейте чистую воду перед отдыхом.")
    if hunger < 65.0:
        lines.append("• Поешьте; пополните еду на следующий выход.")
    if fatigue >= 55.0:
        lines.append("• Отдохните на раскладушке после лечения.")
    if _worst_injury_zone() != "" and _body_condition_value(_worst_injury_zone()) < 70.0:
        lines.append("• Травма: %s. Восстановитесь перед дальней вылазкой." % _body_zone_name(_worst_injury_zone()).to_lower())
    if _inventory_weight() > _carry_limit() * 0.90:
        lines.append("• Переложите добычу в ящик убежища.")
    for entry in inventory_entries:
        var id = str(entry.get("id",""))
        var iid = str(entry.get("instance_id",""))
        if weapon_defs.has(id) and _weapon_condition_value(id,iid) < 65.0:
            lines.append("• Обслужите %s на верстаке." % str(item_defs[id].get("name",id)))
    if _at_home():
        var heat_minutes = int(_rest_heat_minutes_remaining())
        if heat_minutes < 240:
            lines.append("• Проверьте отопление: рядом топлива менее чем на 4 ч.")
    if _inventory_count("water") == 0 and _inventory_count("dirty_water") > 0:
        lines.append("• Очистите собранную воду фильтром или кипячением.")
    if lines.is_empty():
        lines.append("• Срочных мер нет. Проверьте запасы перед выходом.")
    return "\n".join(lines)

func _report_items_text(counts):
    if counts.is_empty():
        return "—"
    var lines = []
    for id in counts:
        lines.append("%s ×%d" % [str(item_defs.get(id,{}).get("name",id)),int(counts[id])])
    return "\n".join(lines)

func _last_expedition_report_text():
    var report = expedition_journal["last_report"]
    if report.is_empty():
        return "Пока нет завершённого похода.\n\nЗакрепите дом, выберите цель на карте, выйдите и вернитесь внутрь своего здания.\n\nМожно вернуться раньше: кнопка «К дому». Цель останется невыполненной."
    var status = "ВОЗВРАЩЕНИЕ • цель достигнута" if bool(report["reached"]) else "ВОЗВРАЩЕНИЕ • цель не достигнута"
    if report["status"] == "cancelled":
        status = "ПЛАН ОТМЕНЁН"
    elif report["status"] == "incapacitated":
        status = "ПОХОД СОРВАН • потеря сознания"
    var minutes = int(report["elapsed"])
    var lines = [status,str(report["target"]),"В пути: %d ч %02d мин" % [int(minutes/60),minutes%60],
        "Запись: день %d, %02d:%02d" % [int(report["end_day"]),int(float(report["end_minutes"])/60)%24,int(report["end_minutes"])%60]]
    var before = report["before"]
    var after = report["after"]
    if before.is_empty():
        lines.append("\nСтарый маршрут: стартовый запас не записан.")
    else:
        var delta = ExpeditionJournal.item_delta(before,after)
        lines.append("\nПРИРОСТ ЗАПАСА\n" + _report_items_text(delta["gains"]))
        lines.append("\nУБЫЛО / ИЗРАСХОДОВАНО\n" + _report_items_text(delta["losses"]))
        lines.append("\nРазница переносимого запаса, включая надетое и заряженные патроны. Крафт и расход влияют на итог.")
    lines.append("\nСОСТОЯНИЕ ПРИ ЗАВЕРШЕНИИ")
    var names = {"health":"Здоровье","hunger":"Сытость","thirst":"Вода","fatigue":"Усталость","wetness":"Сырость","body_temperature":"Температура тела","pain":"Боль","wound_infection":"Инфекция","wound_contamination":"Загрязнение раны"}
    for key in ExpeditionJournal.VITALS:
        if not after.get("vitals",{}).has(key):
            continue
        var value = float(after["vitals"][key])
        var text_value = "%.1f °C" % value if key == "body_temperature" else "%d%%" % int(value)
        if before.get("vitals",{}).has(key):
            var previous = float(before["vitals"][key])
            text_value = ("%.1f → %.1f °C" % [previous,value]) if key == "body_temperature" else ("%d → %d%%" % [int(previous),int(value)])
        lines.append("%s: %s" % [names[key],text_value])
    lines.append("Кровотечение: %s" % ("есть" if bool(after.get("bleeding",false)) else "нет"))
    for zone in ["head","torso","arms","legs"]:
        if after.get("body",{}).has(zone) and float(after["body"][zone]) < 99.0:
            lines.append("%s: %d%%" % [_body_zone_name(zone),int(after["body"][zone])])
    for weapon_key in after.get("weapons",{}):
        var id = str(weapon_key).split("#")[0]
        lines.append("%s: %d%%" % [str(item_defs.get(id,{}).get("name",id)),int(after["weapons"][weapon_key])])
    return "\n".join(lines)

