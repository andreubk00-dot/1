            if roll < 0.38:
                return "brute"
            if roll < 0.67:
                return "runner"
        "clinical_perimeter":
            if roll < 0.09:
                return "brute"
            if roll < 0.28:
                return "runner"
        "clinical_interior":
            if roll < 0.04:
