func _build_multifloor_clinical_surgery(root,size:Vector2) -> void:
    _multifloor_add_corner_rooms(root,size,"medical_surgical",["ОПЕРАЦИОННАЯ 1","ОПЕРАЦИОННАЯ 2","ЛАБОРАТОРИЯ","РЕАНИМАЦИЯ"])
    _layout_wall_v(root,-size.x*0.24,size.y*0.74,-120,70)
    _layout_wall_v(root,size.x*0.24,size.y*0.74,120,70)
    _layout_wall_h(root,-size.y*0.22,size.x*0.72,-190,70)
    _layout_wall_h(root,size.y*0.22,size.x*0.72,190,70)
    _multifloor_partition_h(root,-size.x*0.36,0,size.x*0.20,38.0)
    _multifloor_partition_h(root,size.x*0.36,0,size.x*0.20,38.0)
    _multifloor_partition_v(root,-size.x*0.38,0,size.y*0.30,36.0)
    _multifloor_partition_v(root,size.x*0.38,0,size.y*0.30,36.0)
