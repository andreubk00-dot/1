func _world_event_rect(root) -> Rect2:
    if not is_instance_valid(root) or not bool(root.get_meta("world_event_root",false)):
        return Rect2()
    var size = root.get_meta("world_event_footprint",Vector2.ZERO)
    if typeof(size) != TYPE_VECTOR2 or size == Vector2.ZERO:
        return Rect2()
    return Rect2(root.position - size * 0.5,size)

func _world_event_intersects(chunk,rect:Rect2) -> bool:
    if chunk == null:
        return true
    for child in chunk.get_children():
        if not is_instance_valid(child):
            continue
        if child.has_meta("world_building"):
            var size = child.get_meta("building_size",Vector2.ZERO)
            if typeof(size) == TYPE_VECTOR2 and size != Vector2.ZERO:
                if rect.intersects(Rect2(child.position - size * 0.5,size).grow(16.0)):
                    return true
        elif bool(child.get_meta("world_car",false)):
            if rect.intersects(Rect2(child.position - Vector2(42,26),Vector2(84,52))):
                return true
        elif bool(child.get_meta("world_tree",false)):
            if rect.grow(18.0).has_point(child.position):
                return true
        elif child.has_meta("poi_piece_kind"):
            if rect.grow(34.0).has_point(child.position):
                return true
        elif bool(child.get_meta("world_fence",false)):
            var fence_length = float(child.get_meta("fence_length",0.0))
            var half = Vector2(fence_length * 0.5,0).rotated(child.rotation)
            var a = child.position - half
            var b = child.position + half
            var fence_rect = Rect2(Vector2(min(a.x,b.x),min(a.y,b.y)),Vector2(abs(a.x-b.x),abs(a.y-b.y))).grow(10.0)
            if rect.intersects(fence_rect):
                return true
        elif bool(child.get_meta("world_barrel",false)) or bool(child.get_meta("world_lamp",false)):
            if rect.grow(22.0).has_point(child.position):
                return true
        elif child.has_meta("interaction_type"):
            if rect.grow(30.0).has_point(child.position):
                return true
    return false

func _world_event_anchor(chunk,event:Dictionary,coord:Vector2i) -> Vector2:
    var size:Vector2 = event.get("footprint",Vector2(140,96))
    var placement = str(event.get("placement","road"))
    var candidates:Array = []
    if placement == "plot":
        candidates = [Vector2(150,188),Vector2(618,188),Vector2(150,590),Vector2(618,590)]
    else:
        candidates = [Vector2(384,338),Vector2(384,430),Vector2(338,384),Vector2(430,384)]
    var offset = EncounterCatalog._hash(coord,47) % candidates.size()
    for step in range(candidates.size()):
        var pos:Vector2 = candidates[(offset + step) % candidates.size()]
        var rect = Rect2(pos - size * 0.5,size)
        if rect.position.x < 24.0 or rect.position.y < 24.0 or rect.end.x > CHUNK_SIZE - 24.0 or rect.end.y > CHUNK_SIZE - 24.0:
            continue
        if placement == "plot" and _point_on_road_or_sidewalk(pos):
            continue
        if not _world_event_intersects(chunk,rect):
            return pos
    return Vector2(-9999,-9999)

func _event_prop(root,kind:String,offset:Vector2,scale_value:float = 0.5,z_value:int = 4):
    return _world_prop_sprite(kind,root,offset,z_value,scale_value)

func _spawn_world_event_enemy(chunk,coord:Vector2i,spawn_id:int,pos:Vector2,kind:String = "normal"):
