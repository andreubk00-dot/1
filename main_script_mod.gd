func _infected_kind_for_encounter(encounter_profile:String,rng) -> String:
    var roll = rng.randf()
    # 1.21 stable encounter balance: qualitative variants remain authored high-risk content.
    # Special roles replace baseline bodies instead of inflating headcount, and no single
    # profile stacks enough specials to turn every room into unavoidable chain pressure.
    match str(encounter_profile):
        "high_perimeter":
            if roll < 0.14:
                return "brute"
            if roll < 0.34:
                return "runner"
