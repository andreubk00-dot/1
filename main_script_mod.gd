func _decorate_facade_wall_texture(facade,sign_text,size,building_id):
    if facade == null:
        return
    var count = max(3,int(ceil((size.x - 8.0) / 32.0)))
    var span_w = float(count) * 32.0
    # 0.87: facade material follows the building class; variants add drainpipes,
    # AC units and damage. Rural houses keep one paint colour for the whole wall.
    var style_index = _exterior_style_index(sign_text)
    var facade_seed = abs(hash(str(building_id) + ":facade"))
    var variant_pattern = [0,0,1,0,2,0,0,3]
    for i in range(count):
        var x = -span_w * 0.5 + 16.0 + float(i) * 32.0
        var variant = int(variant_pattern[(i + facade_seed) % variant_pattern.size()])
        if style_index == 6:
            variant = int(facade_seed % 4)
        _native_arch_sprite(facade,_facade_style_tile_texture(style_index,variant),Vector2(x,-1),0)

    # Windows are independent transparent game sprites with deterministic condition states.
    var seed_value = abs(hash(str(building_id)))
    var window_x = min(size.x * 0.29,max(42.0,size.x*0.5 - 46.0))
    var s = str(sign_text).to_upper()
    for i in range(2):
        var state = int((seed_value + i * 17) % 3)
        if s.find("АПТЕК") >= 0 and i == 0:
            state = 1
        elif s.find("ЖИЛ") >= 0 and i == 1:
            state = 2
        _window_sprite(facade,state,Vector2(-window_x if i == 0 else window_x,-1),2)
        if state == 0 and (seed_value + i) % 4 == 0:
            # 0.87: someone is still here — a warm window, only visible at night.
            _add_detail_light(facade,Vector2(-window_x if i == 0 else window_x,4),Color(1.0,0.70,0.40),0.34,0.42,true)

    _native_arch_sprite(facade,_wall_corner_texture(2),Vector2(-size.x*0.5+7.0,9),3)
    _native_arch_sprite(facade,_wall_corner_texture(3),Vector2(size.x*0.5-7.0,9),3)

    # 0.79 authored facade silhouette: canopy/awning/ledge is part of the architecture,
    # not loose street clutter. This gives each building class a readable front profile.
    if s.find("АПТЕК") >= 0 or s.find("БОЛЬ") >= 0:
        _facade_detail_sprite(facade,0,Vector2(0,-6),5,0.92)
    elif s.find("МАГАЗ") >= 0 or s.find("ПРОДУК") >= 0 or s.find("КАФЕ") >= 0:
        _facade_detail_sprite(facade,1,Vector2(0,-5),5,0.94)
    elif s.find("ЦЕХ") >= 0 or s.find("ГАРАЖ") >= 0 or s.find("СКЛАД") >= 0 or s.find("СЕРВИС") >= 0 or s.find("КПП") >= 0:
        _facade_detail_sprite(facade,2,Vector2(0,-6),5,0.94)
    else:
        _facade_detail_sprite(facade,3,Vector2(0,-4),4,0.86)

    # 0.52.1 facade dressing: restrained service details break up the old flat rectangle
    # without changing collisions or doorway geometry.
    var facade_rng = RandomNumberGenerator.new()
    facade_rng.seed = seed_value + 4409
    _world_prop_sprite("wall_grime",facade,Vector2(size.x*0.18,5),1,0.38)
    _world_prop_sprite("wall_pipe",facade,Vector2(-size.x*0.39,3),3,0.46)
    _world_prop_sprite("electrical_box",facade,Vector2(size.x*0.39,2),4,0.42)
    if seed_value % 2 == 0:
        _world_prop_sprite("hanging_wires",facade,Vector2(size.x*0.12,-5),3,0.34)
    else:
        _world_prop_sprite("wall_poster",facade,Vector2(-size.x*0.12,1),3,0.34)
    if s.find("АПТЕК") >= 0 or s.find("БОЛЬНИЦ") >= 0 or s.find("ЛЕЧЕБН") >= 0:
        _world_prop_sprite("med_sign",facade,Vector2(0,-1),4,0.42)

