func _qa_move_to_high_risk(poi_id:String,floor_index:int,overview = false):
    _qa_prepare_visual_state()
    if player == null:
        return
    var poi = RegionCatalog.poi_by_id(poi_id)
    if poi.is_empty() or not HighRiskFloorCatalog.has_poi(poi_id):
        return
    qa_hide_interaction_prompt = true
    if _high_risk_floor_active():
        _exit_high_risk_floor(false)
    var ground_pos = _developer_poi_entry_position(poi)
    player.global_position = ground_pos
    if floor_index <= 1 and overview:
        var footprint = PoiCatalog.footprint(poi_id)
        if not footprint.is_empty():
            var min_x = 999
            var max_x = -999
            var min_y = 999
            var max_y = -999
            for off in footprint:
                min_x = min(min_x,int(off.x))
                max_x = max(max_x,int(off.x))
                min_y = min(min_y,int(off.y))
                max_y = max(max_y,int(off.y))
            var anchor:Vector2i = poi.get("coord",Vector2i.ZERO)
            player.global_position = Vector2(
                (float(anchor.x) + (float(min_x+max_x)+1.0)*0.5) * CHUNK_SIZE,
                (float(anchor.y) + (float(min_y+max_y)+1.0)*0.5) * CHUNK_SIZE
            )
    _refresh_chunks(true)
    _qa_clear_infected()
    if floor_index > 1:
        if _enter_high_risk_floor(poi_id,floor_index,ground_pos,Vector2(999999,999999),1):
            _qa_clear_infected()
    if overview and camera != null:
        camera.position_smoothing_enabled = false
        camera.position = Vector2.ZERO
        if floor_index > 1:
            var floor_data = HighRiskFloorCatalog.floor(poi_id,floor_index)
            var floor_size:Vector2 = floor_data.get("size",Vector2(1000,700))
            var viewport_size = get_viewport_rect().size
            var zx = viewport_size.x / max(1.0,floor_size.x + 120.0)
            var zy = viewport_size.y / max(1.0,floor_size.y + 120.0)
            var z = clamp(min(zx,zy),0.48,1.05)
            camera.zoom = Vector2(z,z)
        else:
            camera.zoom = Vector2(0.38,0.38)
        for child in get_children():
            if child is CanvasLayer:
                child.visible = false
    if hud_interaction_panel != null:
        hud_interaction_panel.visible = false

func _qa_move_to_world_event(event_id:String):
    _qa_prepare_visual_state()
    if player == null:
        return
    qa_hide_interaction_prompt = true
    var wanted = str(event_id)
    var found_coord = Vector2i(999999,999999)
    for y in range(-40,41):
        if found_coord.x < 900000:
            break
        for x in range(-40,41):
            var coord = Vector2i(x,y)
            var profile = _chunk_profile(coord)
            if str(profile.get("poi_id","")) != "":
                continue
            var event = EncounterCatalog.event_for(coord,str(profile.get("zone","residential")),int(profile.get("risk",2)),"")
            if str(event.get("id","")) == wanted:
                found_coord = coord
                break
    if found_coord.x >= 900000:
        return
    player.global_position = Vector2(found_coord.x * CHUNK_SIZE,found_coord.y * CHUNK_SIZE) + Vector2(CHUNK_SIZE*0.5,CHUNK_SIZE*0.5)
    _refresh_chunks(true)
    var chunk = loaded_chunks.get(found_coord,null)
    if is_instance_valid(chunk):
        for child in chunk.get_children():
            if is_instance_valid(child) and bool(child.get_meta("world_event_root",false)) and str(child.get_meta("world_event_id","")) == wanted:
                player.global_position = child.global_position + Vector2(0,108)
                break
    _qa_clear_infected()
    if hud_interaction_panel != null:
        hud_interaction_panel.visible = false

