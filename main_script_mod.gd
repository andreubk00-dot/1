func _update_ranged_arms(weapon_id,pose_offset):
    if pv_weapon_root == null:
        _set_ranged_arm_visible(false)
        _set_melee_arm_visible(false)
        return

    var is_melee = equipped_melee_id != ""
    var config = _held_visual_config(weapon_id,is_melee)
    var rear_local = _source_point_to_weapon_local(config.get("rear_px",Vector2.ZERO),config)
    var rear_hand = _weapon_grip_to_player(rear_local)
    var aim = Vector2.RIGHT.rotated(pv_weapon_root.rotation)
    var shoulder_axis = Vector2(-aim.y,aim.x)
    var chest = pose_offset + Vector2(0,-7)
    var rear_shoulder = chest + shoulder_axis * 5.0
    var front_shoulder = chest - shoulder_axis * 5.0

    if is_melee:
        _set_ranged_arm_visible(false)
        _set_melee_arm_visible(true)
        var front_px = config.get("front_px",Vector2(-1,-1))
        var front_hand = chest + aim * 3.0 - shoulder_axis * 1.5
        if typeof(front_px) == TYPE_VECTOR2 and front_px.x >= 0.0:
            front_hand = _weapon_grip_to_player(_source_point_to_weapon_local(front_px,config))
        rear_hand = rear_shoulder + (rear_hand-rear_shoulder).limit_length(17.0)
        front_hand = front_shoulder + (front_hand-front_shoulder).limit_length(18.0)
        _set_melee_arm_z(aim.y < -0.18)
        _update_melee_limb(
            pv_melee_back_outline,pv_melee_back_sleeve,
            pv_melee_back_elbow_outline,pv_melee_back_elbow,
            pv_melee_back_hand_outline,pv_melee_back_hand,
            rear_shoulder,rear_hand,1.0,2.2,pv_weapon_root.rotation
        )
        _update_melee_limb(
            pv_melee_front_outline,pv_melee_front_sleeve,
            pv_melee_front_elbow_outline,pv_melee_front_elbow,
            pv_melee_front_hand_outline,pv_melee_front_hand,
            front_shoulder,front_hand,-1.0,2.0,pv_weapon_root.rotation
        )
        return

    _set_melee_arm_visible(false)
    var front_local = _source_point_to_weapon_local(config.get("front_px",config.get("rear_px",Vector2.ZERO)),config)
    var front_hand = _weapon_grip_to_player(front_local)
    var reload_p = _reload_anim_progress()
    if reload_p >= 0.0:
        var reload_arc = sin(reload_p * PI)
        if config.has("reload_px"):
            var reload_local = _source_point_to_weapon_local(config.get("reload_px"),config)
            front_hand = front_hand.lerp(_weapon_grip_to_player(reload_local),0.92 * reload_arc)
        elif weapon_id in ["makarov","tt33"]:
            front_hand = front_hand.lerp(rear_hand + Vector2(0,4),0.80 * reload_arc)

    rear_hand = rear_shoulder + (rear_hand-rear_shoulder).limit_length(16.0)
    front_hand = front_shoulder + (front_hand-front_shoulder).limit_length(19.0)
    _set_ranged_arm_visible(true)
    _set_ranged_arm_z(aim.y < -0.18)
    _update_melee_limb(
        pv_ranged_back_outline,pv_ranged_back_sleeve,
        pv_ranged_back_elbow_outline,pv_ranged_back_elbow,
        pv_ranged_back_hand_outline,pv_ranged_back_hand,
        rear_shoulder,rear_hand,1.0,2.0,pv_weapon_root.rotation
    )
    _update_melee_limb(
        pv_ranged_front_outline,pv_ranged_front_sleeve,
        pv_ranged_front_elbow_outline,pv_ranged_front_elbow,
        pv_ranged_front_hand_outline,pv_ranged_front_hand,
        front_shoulder,front_hand,-1.0,2.1,pv_weapon_root.rotation
    )


func _melee_elbow_point(shoulder,hand,bend_sign,bend_amount):
    var delta = hand - shoulder
    var distance = delta.length()

    if distance <= 0.001:
        return shoulder

    var middle = (shoulder + hand) * 0.5
    var normal = Vector2(-delta.y,delta.x).normalized()

    # A capped bend keeps short arms from looping into circles
    # and long arms from looking rubber-stretched.
    var natural_bend = min(bend_amount,max(0.8,distance * 0.28))
    return middle + normal * bend_sign * natural_bend

func _set_melee_line_points(outline,sleeve,shoulder,elbow,hand):
    var shoulder_px = Vector2(round(shoulder.x * 2.0) * 0.5,round(shoulder.y * 2.0) * 0.5)
    var elbow_px = Vector2(round(elbow.x * 2.0) * 0.5,round(elbow.y * 2.0) * 0.5)
    var hand_px = Vector2(round(hand.x * 2.0) * 0.5,round(hand.y * 2.0) * 0.5)

    if outline != null:
        outline.clear_points()
        outline.add_point(shoulder_px)
        outline.add_point(elbow_px)
        outline.add_point(hand_px)

    if sleeve != null:
        sleeve.clear_points()
        sleeve.add_point(shoulder_px)
        sleeve.add_point(elbow_px)
        sleeve.add_point(hand_px)

func _update_melee_limb(outline,sleeve,elbow_outline,elbow_fill,hand_outline,hand_fill,shoulder,hand,bend_sign,bend_amount,hand_rotation):
    var elbow = _melee_elbow_point(shoulder,hand,bend_sign,bend_amount)
    var elbow_px = Vector2(round(elbow.x * 2.0) * 0.5,round(elbow.y * 2.0) * 0.5)
    var hand_px = Vector2(round(hand.x * 2.0) * 0.5,round(hand.y * 2.0) * 0.5)
    _set_melee_line_points(outline,sleeve,shoulder,elbow_px,hand_px)

    if elbow_outline != null:
        elbow_outline.position = elbow_px
        elbow_outline.rotation = 0.0
    if elbow_fill != null:
        elbow_fill.position = elbow_px
        elbow_fill.rotation = 0.0

    if hand_outline != null:
        hand_outline.position = hand_px
        hand_outline.rotation = hand_rotation
    if hand_fill != null:
        hand_fill.position = hand_px
        hand_fill.rotation = hand_rotation

func _set_melee_arm_z(facing_up):
    # Far arm remains behind the torso. Near arm emerges from the actual
    # visible shoulder and stays readable in every aim direction.
    if pv_melee_back_outline == null:
        return

    pv_melee_back_outline.z_index = -5
    pv_melee_back_sleeve.z_index = -4
    pv_melee_back_elbow_outline.z_index = -4
    pv_melee_back_elbow.z_index = -3
    pv_melee_back_hand_outline.z_index = 1
    pv_melee_back_hand.z_index = 2

    if facing_up:
        pv_melee_front_outline.z_index = 0
        pv_melee_front_sleeve.z_index = 1
        pv_melee_front_elbow_outline.z_index = 1
        pv_melee_front_elbow.z_index = 2
        pv_melee_front_hand_outline.z_index = 4
        pv_melee_front_hand.z_index = 5
    else:
        pv_melee_front_outline.z_index = 1
        pv_melee_front_sleeve.z_index = 2
        pv_melee_front_elbow_outline.z_index = 2
        pv_melee_front_elbow.z_index = 3
        pv_melee_front_hand_outline.z_index = 5
        pv_melee_front_hand.z_index = 6

func _player_part_texture(atlas,region):
    if atlas == null:
