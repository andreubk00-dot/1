func _cancel_weapon_cycle():
    weapon_cycle_time = 0.0
    weapon_cycle_duration = 0.0
    weapon_cycle_audio_pending = false
    weapon_cycle_profile = ""
    weapon_cycle_weapon_id = ""

func _schedule_weapon_cycle(weapon_id,weapon):
    var profile = str(weapon.get("action_cycle",""))
    if profile not in ["pump","bolt"]:
        _cancel_weapon_cycle()
        return
    weapon_cycle_profile = profile
    weapon_cycle_weapon_id = str(weapon_id)
    weapon_cycle_duration = max(0.08,float(weapon.get("cycle_duration",0.40)))
    var delay = max(0.0,float(weapon.get("cycle_delay",0.20)))
    weapon_cycle_time = delay + weapon_cycle_duration
    weapon_cycle_audio_pending = true

func _weapon_cycle_progress():
    if weapon_cycle_time <= 0.0 or weapon_cycle_duration <= 0.001:
        return -1.0
    if weapon_cycle_weapon_id != current_weapon_id or equipped_melee_id != "":
        return -1.0
    if weapon_cycle_time > weapon_cycle_duration:
        return -1.0
    return clamp(1.0 - weapon_cycle_time / weapon_cycle_duration,0.0,1.0)

func _weapon_shot_directions(weapon, base_dir):
    var pellets = max(1,int(weapon.get("pellets",1)))
    var spread = max(0.0,float(weapon.get("spread",0.0)))
    var condition_ratio = _weapon_condition_value(current_weapon_id,current_weapon_instance_id) / 100.0
    spread *= 1.0 + (1.0 - condition_ratio) * 1.35
    spread *= _weapon_mod_multiplier(current_weapon_id,"spread_mult",current_weapon_instance_id)
    spread *= _injury_aim_spread_multiplier()
    var dirs = []

    if pellets == 1:
        dirs.append(base_dir.rotated(randf_range(-spread,spread)))
        return dirs

    # Full cone from -spread to +spread. A small jitter keeps it organic while
    # guaranteeing that pellets actually occupy the whole cone.
    for i in range(pellets):
        var t = 0.5
        if pellets > 1:
            t = float(i) / float(pellets - 1)
        var angle = lerpf(-spread,spread,t)
        var jitter = spread / float(pellets) * 0.30
        angle += randf_range(-jitter,jitter)
        dirs.append(base_dir.rotated(angle))

    return dirs

func _firearm_hit_response(weapon,enemy,direction,landed_hits):
    if not is_instance_valid(enemy):
        return
    var pellets = max(1,int(weapon.get("pellets",1)))
    var hits = clamp(int(landed_hits),1,pellets)
    var coverage = 1.0
    if pellets > 1:
        # A grazing pellet should not stop an infected like a full close-range blast.
        # Around half of the pellets already delivers the authored full shotgun impulse.
        coverage = clamp(float(hits) / max(1.0,float(pellets) * 0.55),0.18,1.0)
    var impact_force = max(0.0,float(weapon.get("impact",0.0))) * coverage
    var stagger_time = max(0.0,float(weapon.get("stagger",0.0))) * coverage
    if impact_force <= 0.0 and stagger_time <= 0.0:
        return
    _apply_enemy_impulse(enemy,direction,impact_force,stagger_time)

func _weapon_stopping_label(weapon):
    var impact = float(weapon.get("impact",0.0))
    var stagger_time = float(weapon.get("stagger",0.0))
    if impact >= 115.0 or stagger_time >= 0.40:
        return "ВЫСОКАЯ"
    if impact >= 65.0 or stagger_time >= 0.20:
        return "СРЕДНЯЯ"
    return "НИЗКАЯ"

