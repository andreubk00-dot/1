func _sanitize_loaded_entries(entries):
    for i in range(entries.size() - 1,-1,-1):
        var id = str(entries[i].get("id",""))
        if not item_defs.has(id):
            entries.remove_at(i)

func _sanitize_loaded_state(migrate_legacy_weapon_state = false):
    if typeof(weapon_mags) != TYPE_DICTIONARY:
        weapon_mags = {}
    if typeof(weapon_condition) != TYPE_DICTIONARY:
        weapon_condition = {}
    if typeof(weapon_mods) != TYPE_DICTIONARY:
        weapon_mods = {}
    if typeof(weapon_instance_states) != TYPE_DICTIONARY:
        weapon_instance_states = {}

    for weapon_id in FIREARM_IDS:
        if not weapon_mods.has(weapon_id) or typeof(weapon_mods[weapon_id]) != TYPE_DICTIONARY:
            weapon_mods[weapon_id] = {"magazine":"","muzzle":""}
        var mods = weapon_mods[weapon_id]
        if mods.has("sight"):
            mods.erase("sight")
        if not mods.has("magazine"):
            mods["magazine"] = ""
        if not mods.has("muzzle"):
            mods["muzzle"] = ""

        var magazine_id = str(mods.get("magazine",""))
        if magazine_id != "" and (not item_defs.has(magazine_id) or str(item_defs[magazine_id].get("allowed_weapon","")) != weapon_id):
            mods["magazine"] = ""
        var muzzle_id = str(mods.get("muzzle",""))
        if muzzle_id != "" and (not item_defs.has(muzzle_id) or str(item_defs[muzzle_id].get("allowed_weapon","")) != weapon_id):
            mods["muzzle"] = ""
        weapon_mods[weapon_id] = mods
        weapon_mags[weapon_id] = clamp(int(weapon_mags.get(weapon_id,0)),0,_weapon_capacity_for_mods(weapon_id,mods))
        weapon_condition[weapon_id] = clamp(float(weapon_condition.get(weapon_id,100.0)),0.0,100.0)

    _sanitize_loaded_entries(inventory_entries)
    _ensure_equipment_slots()

    for key in container_states.keys():
        var state = container_states[key]
        if typeof(state) != TYPE_DICTIONARY:
            container_states.erase(key)
            continue
        var entries = state.get("items",[])
        _sanitize_loaded_entries(entries)
        state["items"] = entries
        container_states[key] = state

    if typeof(loot_refresh_sites) != TYPE_DICTIONARY:
        loot_refresh_sites = {}
    else:
        var clean_refresh = {}
        for raw_id in loot_refresh_sites.keys():
            var poi_id = str(raw_id)
            var poi = RegionCatalog.poi_by_id(poi_id)
            var raw_state = loot_refresh_sites[raw_id]
            if poi.is_empty() or _target_farm_profile(poi) == "" or typeof(raw_state) != TYPE_DICTIONARY:
                continue
            clean_refresh[poi_id] = {
                "cycle":max(0,int(raw_state.get("cycle",0))),
                "ready_day":max(0,int(raw_state.get("ready_day",0))),
                "cleared_day":max(0,int(raw_state.get("cleared_day",0))),
                "last_refresh_day":max(0,int(raw_state.get("last_refresh_day",0)))
            }
        loot_refresh_sites = clean_refresh

    for i in range(dropped_items.size() - 1,-1,-1):
        if not item_defs.has(str(dropped_items[i].get("id",""))):
            dropped_items.remove_at(i)

    _ensure_runtime_item_instance_ids()

    if equipped_melee_id != "" and (not melee_defs.has(equipped_melee_id) or not _inventory_has_item(equipped_melee_id)):
        equipped_melee_id = ""
    if not weapon_defs.has(current_weapon_id):
        current_weapon_id = "makarov"

    _ensure_weapon_runtime_state(migrate_legacy_weapon_state)

func _load_state():
    var load_path = SAVE_PATH
    if not FileAccess.file_exists(load_path) and not FileAccess.file_exists(load_path + ".bak"):
