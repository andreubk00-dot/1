    TradingMarket.restock(faction_state,trader_id,world_day,false)
    _refresh_trader_ui()

func _close_trader():
    trader_open = false
    active_trader_id = ""
    trader_selected_stock_item = ""
    trader_selected_inventory_index = -1
    if trader_panel != null:
        trader_panel.visible = false

func _refresh_trader_ui():
    if trader_panel == null:
        return
    trader_panel.visible = trader_open
    if not trader_open:
        return
    var data = TraderCatalog.trader(active_trader_id)
    if data.is_empty():
        _close_trader()
        return

    TradingMarket.ensure_state(faction_state,world_day)
    var faction_id = str(data.get("faction",""))
    var faction_data = FactionCatalog.faction(faction_id)
    var rep = FactionEconomy.reputation(faction_state,faction_id)
    var tier = FactionEconomy.reputation_tier(faction_state,faction_id)
    var condition = FactionEconomy.settlement_condition(faction_state,faction_id)
    var reserve = TradingMarket.reserve(faction_state,active_trader_id)
    trader_title.text = "%s  •  %s" % [str(data.get("name","ТОРГОВЕЦ")).to_upper(),str(data.get("role","рынок")).to_upper()]
    trader_subtitle.text = "%s  |  Репутация: %s (%d)  |  Талоны: %d  |  Резерв торговца: %d  |  Снабжение: %d%%  |  %s  |  %s" % [
        str(faction_data.get("name",faction_id)),str(tier.get("name","ЧУЖОЙ")),rep,
        int(faction_state.get("currency_tickets",0)),reserve,int(round(condition)),
        SettlementCrisis.summary(faction_state,faction_id,world_day),
        FactionEndgame.summary(faction_state,faction_id)
    ]

    trader_stock_list.clear()
    trader_stock_meta.clear()
    var trader_state = faction_state.get("traders",{}).get(active_trader_id,{})
    var stock = trader_state.get("stock",{})
    var ordered_ids = []
    for spec in data.get("stock",[]):
        var item_id = str(spec.get("id",""))
        if item_id != "" and item_id not in ordered_ids:
            ordered_ids.append(item_id)
    var extras = []
    for raw_id in stock.keys():
        var item_id = str(raw_id)
        if item_id not in ordered_ids and int(stock.get(item_id,0)) > 0:
            extras.append(item_id)
    extras.sort()
    ordered_ids.append_array(extras)

    for item_id in ordered_ids:
        var qty = max(0,int(stock.get(item_id,0)))
        var price = TradingMarket.buy_price(faction_state,active_trader_id,item_id)
        var unlocked = TradingMarket.item_unlocked(faction_state,active_trader_id,item_id)
        var spec = TraderCatalog.stock_spec(active_trader_id,item_id)
        var suffix = "НЕТ" if qty <= 0 else ("%d тал." % price)
        if not unlocked:
            suffix = "Нужен: %s" % _trade_tier_name_for_min(TraderCatalog.required_rep(active_trader_id,item_id))
        var line = "%s  ×%d  —  %s" % [_trade_item_name(item_id),qty,suffix]
        trader_stock_list.add_item(line)
        var list_index = trader_stock_list.item_count - 1
        trader_stock_list.set_item_metadata(list_index,item_id)
        trader_stock_list.set_item_disabled(list_index,qty <= 0 or not unlocked)
        trader_stock_meta.append(item_id)
        if item_id == trader_selected_stock_item and qty > 0 and unlocked:
            trader_stock_list.select(list_index)

    trader_inventory_list.clear()
    trader_inventory_meta.clear()
    for inv_index in range(inventory_entries.size()):
        var entry = inventory_entries[inv_index]
        var item_id = str(entry.get("id",""))
        if item_id == "":
            continue
        var qty = max(1,int(entry.get("qty",1)))
        var accepts = TraderCatalog.accepts_item(active_trader_id,item_id)
        var unit = TradingMarket.sell_price(faction_state,active_trader_id,item_id) if accepts else 0
        var line = "%s  ×%d  —  %s" % [
            _trade_item_name(item_id),qty,
            ("%d тал./шт." % unit) if accepts else "НЕ ПРИНИМАЕТ"
        ]
        trader_inventory_list.add_item(line)
        var list_index = trader_inventory_list.item_count - 1
        trader_inventory_list.set_item_metadata(list_index,inv_index)
        trader_inventory_list.set_item_disabled(list_index,not accepts)
        trader_inventory_meta.append(inv_index)
        if inv_index == trader_selected_inventory_index and accepts:
            trader_inventory_list.select(list_index)

    if trader_selected_stock_item == "" and trader_selected_inventory_index < 0:
        trader_status.text = "Выберите товар слева для покупки или предмет справа для продажи. Для бартера выберите оба."
    else:
        _refresh_trader_selection_status()

func _refresh_trader_selection_status():
    if trader_status == null or not trader_open:
        return
    var parts = []
    if trader_selected_stock_item != "":
        var price = TradingMarket.buy_price(faction_state,active_trader_id,trader_selected_stock_item)
        parts.append("Покупка: %s — %d тал." % [_trade_item_name(trader_selected_stock_item),price])
    if trader_selected_inventory_index >= 0 and trader_selected_inventory_index < inventory_entries.size():
        var entry = inventory_entries[trader_selected_inventory_index]
        var item_id = str(entry.get("id",""))
        var price = TradingMarket.sell_price(faction_state,active_trader_id,item_id)
        parts.append("Продажа: %s — %d тал./шт." % [_trade_item_name(item_id),price])
    trader_status.text = "  |  ".join(parts)

func _trader_stock_selected(index:int):
    if index < 0 or index >= trader_stock_list.item_count:
        return
    trader_selected_stock_item = str(trader_stock_list.get_item_metadata(index))
    _refresh_trader_selection_status()

func _trader_inventory_selected(index:int):
    if index < 0 or index >= trader_inventory_list.item_count:
        return
    trader_selected_inventory_index = int(trader_inventory_list.get_item_metadata(index))
    _refresh_trader_selection_status()

func _trade_simulated_remove(entries:Array,index:int,quantity:int) -> bool:
    if index < 0 or index >= entries.size() or quantity <= 0:
        return false
    var entry = entries[index]
    var qty = max(1,int(entry.get("qty",1)))
    if qty < quantity:
        return false
    if qty == quantity:
        entries.remove_at(index)
    else:
        entry["qty"] = qty - quantity
        entries[index] = entry
    return true

func _trade_remove_inventory_units(index:int,quantity:int) -> bool:
    if index < 0 or index >= inventory_entries.size() or quantity <= 0:
        return false
    var entry = inventory_entries[index]
    var item_id = str(entry.get("id",""))
    var qty = max(1,int(entry.get("qty",1)))
    if qty < quantity:
        return false
    var removing_whole = qty == quantity
    var instance_id = str(entry.get("instance_id",""))
    if removing_whole:
        inventory_entries.remove_at(index)
        if instance_id != "":
            water_container_states.erase(instance_id)
            weapon_instance_states.erase(instance_id)
            if current_weapon_instance_id == instance_id:
                current_weapon_instance_id = ""
    else:
        entry["qty"] = qty - quantity
        inventory_entries[index] = entry
    if equipped_melee_id == item_id and not _inventory_has_item(item_id):
        equipped_melee_id = ""
    _validate_equipment()
    _ensure_runtime_item_instance_ids()
    _ensure_water_container_runtime_state()
    _ensure_weapon_runtime_state(false)
    return true

func _trade_buy_selected():
    if not trader_open or trader_selected_stock_item == "":
        if trader_status != null:
            trader_status.text = "Сначала выберите товар торговца."
        return false
    var item_id = trader_selected_stock_item
    var quote = TradingMarket.buy_quote(faction_state,active_trader_id,item_id,1)
    if not bool(quote.get("ok",false)):
        trader_status.text = str(quote.get("reason","Покупка невозможна"))
        return false
    var test_entries = inventory_entries.duplicate(true)
    if _grid_add(test_entries,item_id,1,INV_W,INV_H) != 0:
        trader_status.text = "В рюкзаке нет места для покупки."
        return false
    var total = int(quote.get("total",0))
    if not TradingMarket.apply_purchase(faction_state,active_trader_id,item_id,1,total):
        trader_status.text = "Сделка изменилась. Попробуйте ещё раз."
        _refresh_trader_ui()
        return false
    inventory_entries = test_entries
    _ensure_runtime_item_instance_ids()
    _ensure_water_container_runtime_state()
    _ensure_weapon_runtime_state(false)
    _set_survival_feedback("Куплено: %s • %d тал." % [_trade_item_name(item_id),total],1.8)
    _refresh_trader_ui()
    return true

func _trade_sell_selected():
    if not trader_open or trader_selected_inventory_index < 0 or trader_selected_inventory_index >= inventory_entries.size():
        if trader_status != null:
            trader_status.text = "Сначала выберите предмет из своего рюкзака."
        return false
    var entry = inventory_entries[trader_selected_inventory_index]
    var item_id = str(entry.get("id",""))
    var quote = TradingMarket.sell_quote(faction_state,active_trader_id,item_id,1)
    if not bool(quote.get("ok",false)):
        trader_status.text = str(quote.get("reason","Продажа невозможна"))
        return false
    var total = int(quote.get("total",0))
    if not TradingMarket.apply_sale(faction_state,active_trader_id,item_id,1,total):
        trader_status.text = "Торговец больше не может оплатить эту сделку."
        _refresh_trader_ui()
        return false
    if not _trade_remove_inventory_units(trader_selected_inventory_index,1):
        trader_status.text = "Предмет уже недоступен."
        return false
    trader_selected_inventory_index = -1
    _set_survival_feedback("Продано: %s • +%d тал." % [_trade_item_name(item_id),total],1.8)
    _refresh_trader_ui()
    return true

func _trade_barter_selected():
    if not trader_open or trader_selected_stock_item == "":
        trader_status.text = "Для обмена выберите товар торговца слева."
        return false
    if trader_selected_inventory_index < 0 or trader_selected_inventory_index >= inventory_entries.size():
        trader_status.text = "Для обмена выберите свой товар справа."
        return false
    var offer_entry = inventory_entries[trader_selected_inventory_index]
    var sell_item = str(offer_entry.get("id",""))
    var buy_item = trader_selected_stock_item
    if sell_item == buy_item:
        trader_status.text = "Для бартера выберите разные товары."
        return false
    if not TraderCatalog.accepts_item(active_trader_id,sell_item):
        trader_status.text = "Этот торговец не принимает выбранный товар."
        return false
    var buy_value = TradingMarket.buy_price(faction_state,active_trader_id,buy_item)
    var sell_unit = max(1,TradingMarket.sell_price(faction_state,active_trader_id,sell_item))
    var entry_qty = max(1,int(offer_entry.get("qty",1)))
    var sell_qty = min(entry_qty,max(1,int(ceil(float(buy_value) / float(sell_unit)))))
    var quote = TradingMarket.barter_quote(faction_state,active_trader_id,buy_item,1,sell_item,sell_qty)
    if not bool(quote.get("ok",false)):
        trader_status.text = str(quote.get("reason","Бартер невозможен"))
        return false

    # Validate backpack space after offered goods leave, before committing economy state.
    var test_entries = inventory_entries.duplicate(true)
    if not _trade_simulated_remove(test_entries,trader_selected_inventory_index,sell_qty):
        trader_status.text = "Выбранный товар уже изменился."
        return false
    if _grid_add(test_entries,buy_item,1,INV_W,INV_H) != 0:
        trader_status.text = "После обмена в рюкзаке не хватит места."
        return false

    var delta = int(quote.get("ticket_delta",0))
    if not TradingMarket.apply_barter(faction_state,active_trader_id,buy_item,1,sell_item,sell_qty,delta):
        trader_status.text = "Условия обмена изменились."
        _refresh_trader_ui()
        return false
    if not _trade_remove_inventory_units(trader_selected_inventory_index,sell_qty):
        trader_status.text = "Не удалось списать предложенный товар."
        return false
    var remainder = _grid_add(inventory_entries,buy_item,1,INV_W,INV_H)
    if remainder != 0:
        trader_status.text = "Ошибка размещения товара после обмена."
        return false
    _ensure_runtime_item_instance_ids()
    _ensure_water_container_runtime_state()
    _ensure_weapon_runtime_state(false)
    trader_selected_inventory_index = -1
    var cash_text = "без доплаты"
    if delta > 0:
        cash_text = "доплата %d тал." % delta
    elif delta < 0:
        cash_text = "сдача %d тал." % (-delta)
    _set_survival_feedback("Обмен: %d× %s → %s • %s" % [sell_qty,_trade_item_name(sell_item),_trade_item_name(buy_item),cash_text],2.2)
    _refresh_trader_ui()
    return true


