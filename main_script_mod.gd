        ]
        return {"scale":0.78,"root_bias":roots[d],"grip_px":grips[d],"source_size":Vector2(16,16)}
    if weapon_id in ["shotgun","toz34","sks"]:
        var roots = [
            Vector2(-1.4,0.4), Vector2(-0.9,0.9), Vector2(0.0,1.2), Vector2(0.9,0.9),
            Vector2(1.4,0.4), Vector2(0.9,-0.2), Vector2(0.0,-0.8), Vector2(-0.9,-0.2)
        ]
        var grips = [
