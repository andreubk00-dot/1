func _is_water_container_item(item_id):
    return item_defs.has(item_id) and str(item_defs[item_id].get("use","")) == "water_container"

func _water_container_capacity_l(item_id):
    if not _is_water_container_item(item_id):
        return 0.0
    return max(0.0,float(item_defs[item_id].get("capacity_l",0.0)))

func _sanitize_water_container_state(instance_id,item_id,state):
    var clean = state if typeof(state) == TYPE_DICTIONARY else {}
    var capacity = _water_container_capacity_l(item_id)
    clean["item_id"] = str(item_id)
    clean["fill_l"] = clamp(float(clean.get("fill_l",item_defs[item_id].get("default_fill_l",0.0))),0.0,capacity)
    water_container_states[str(instance_id)] = clean
    return clean

func _collect_water_container_instances():
    var records = []
    for entry in inventory_entries:
        var id = str(entry.get("id",""))
        if _is_water_container_item(id):
            records.append({"item_id":id,"instance_id":str(entry.get("instance_id",""))})
    for key in container_states.keys():
        var state = container_states[key]
        for entry in state.get("items",[]):
            var id = str(entry.get("id",""))
            if _is_water_container_item(id):
                records.append({"item_id":id,"instance_id":str(entry.get("instance_id",""))})
    for record in dropped_items:
        var id = str(record.get("id",""))
        if _is_water_container_item(id):
            records.append({"item_id":id,"instance_id":str(record.get("instance_id",""))})
    return records

func _ensure_water_container_runtime_state():
    if typeof(water_container_states) != TYPE_DICTIONARY:
        water_container_states = {}
    var live = {}
    for record in _collect_water_container_instances():
        var item_id = str(record.get("item_id",""))
        var instance_id = str(record.get("instance_id",""))
        if instance_id == "":
            continue
        live[instance_id] = true
        _sanitize_water_container_state(instance_id,item_id,water_container_states.get(instance_id,{}))
    for instance_id in water_container_states.keys():
        if not live.has(str(instance_id)):
            water_container_states.erase(instance_id)

func _water_container_state(item_id,instance_id,create_if_missing = true):
    var iid = str(instance_id)
    if iid == "" or not _is_water_container_item(item_id):
        return {}
    if not water_container_states.has(iid):
        if not create_if_missing:
            return {}
        water_container_states[iid] = {"item_id":str(item_id),"fill_l":float(item_defs[item_id].get("default_fill_l",0.0))}
    return _sanitize_water_container_state(iid,item_id,water_container_states[iid])

func _water_container_fill_l(item_id,instance_id):
    var state = _water_container_state(item_id,instance_id,true)
    return float(state.get("fill_l",0.0)) if not state.is_empty() else 0.0

func _set_water_container_fill_l(item_id,instance_id,value):
    var state = _water_container_state(item_id,instance_id,true)
    if state.is_empty():
        return false
    state["fill_l"] = clamp(float(value),0.0,_water_container_capacity_l(item_id))
    water_container_states[str(instance_id)] = state
    return true

func _entry_total_weight(entry):
    var item_id = str(entry.get("id",""))
    if not item_defs.has(item_id):
        return 0.0
    var qty = int(entry.get("qty",1))
    var total = float(item_defs[item_id].get("weight",0.0)) * qty
    if _is_water_container_item(item_id):
        total += _water_container_fill_l(item_id,str(entry.get("instance_id","")))
    return total

func _total_clean_water_l():
    var liters = float(_inventory_count("water")) * WATER_PORTION_L
    for entry in inventory_entries:
        var item_id = str(entry.get("id",""))
        if _is_water_container_item(item_id):
            liters += _water_container_fill_l(item_id,str(entry.get("instance_id","")))
    return liters

func _water_container_source_method():
    if _inventory_count("water") > 0:
        return "clean"
    if _inventory_count("dirty_water") > 0:
        if _inventory_count("water_filter") > 0:
            return "filter"
        if _player_near_active_fire():
            return "fire"
    return ""

func _refill_selected_water_container():
    if selected_inventory_index < 0 or selected_inventory_index >= inventory_entries.size():
        return false
    _ensure_runtime_item_instance_ids()
    _ensure_water_container_runtime_state()
    var entry = inventory_entries[selected_inventory_index]
    var item_id = str(entry.get("id",""))
    if not _is_water_container_item(item_id):
        return false
    var instance_id = str(entry.get("instance_id",""))
    var capacity = _water_container_capacity_l(item_id)
    var fill = _water_container_fill_l(item_id,instance_id)
    var free = capacity - fill
    if free + 0.0001 < WATER_PORTION_L:
        if inv_details != null:
            inv_details.text = "Для переливания одной порции нужно не меньше %.1f л свободного объёма." % WATER_PORTION_L
        return false
    var method = _water_container_source_method()
    if method == "":
        if inv_details != null:
            inv_details.text = "Нет подходящей воды для наполнения этой ёмкости."
        return false
    if method == "clean":
        if not _consume_inventory_item("water",1):
            return false
    else:
        if not _consume_inventory_item("dirty_water",1):
            return false
    _set_water_container_fill_l(item_id,instance_id,fill + WATER_PORTION_L)
    var new_fill = _water_container_fill_l(item_id,instance_id)
    var prefix = "Перелито" if method == "clean" else ("Очищено фильтром" if method == "filter" else "Вскипячено и перелито")
    _set_survival_feedback("%s: %.1f / %.1f л" % [prefix,new_fill,capacity],2.0)
    call_deferred("_refresh_inventory_ui")
    return true

func _drink_selected_water_container():
    if selected_inventory_index < 0 or selected_inventory_index >= inventory_entries.size():
        return false
    _ensure_runtime_item_instance_ids()
    _ensure_water_container_runtime_state()
    var entry = inventory_entries[selected_inventory_index]
    var item_id = str(entry.get("id",""))
    if not _is_water_container_item(item_id):
        return false
    var instance_id = str(entry.get("instance_id",""))
    var fill = _water_container_fill_l(item_id,instance_id)
    if fill <= 0.0001:
        if inv_details != null:
            inv_details.text = "Ёмкость пуста. В открытом инвентаре R переливает в неё воду."
        return false
    if thirst >= 99.9:
        if inv_details != null:
            inv_details.text = "Пить сейчас не хочется."
        return false
    var need_l = max(0.0,(100.0 - thirst) / WATER_HYDRATION_PER_L)
    var amount = min(fill,min(WATER_SIP_MAX_L,need_l))
    if amount <= 0.0001:
        return false
    thirst = min(100.0,thirst + amount * WATER_HYDRATION_PER_L)
    stamina = min(_survival_stamina_cap(),stamina + amount * WATER_STAMINA_PER_L)
    _set_water_container_fill_l(item_id,instance_id,fill - amount)
    var left = _water_container_fill_l(item_id,instance_id)
    _set_survival_feedback("Выпито %.2f л • осталось %.2f л" % [amount,left],1.8)
    return true

# -------------------------------------------------------------------
# 1.17.2 INDIVIDUAL FIREARM STATE
# -------------------------------------------------------------------

func _weapon_default_instance_state(weapon_id):
    return {
        "weapon_id":str(weapon_id),
        "mag":0,
        "condition":100.0,
        "mods":{"magazine":"","muzzle":""}
    }

func _weapon_capacity_for_mods(weapon_id,mods):
    if not weapon_defs.has(weapon_id):
        return 0
    var bonus = 0
    if typeof(mods) == TYPE_DICTIONARY:
        var magazine_id = str(mods.get("magazine",""))
        if magazine_id != "" and item_defs.has(magazine_id):
            if str(item_defs[magazine_id].get("allowed_weapon","")) == weapon_id:
                bonus = int(item_defs[magazine_id].get("mag_bonus",0))
    return max(0,int(weapon_defs[weapon_id].get("mag",0)) + bonus)

func _sanitize_weapon_instance_state(instance_id,weapon_id,state):
    var clean = _weapon_default_instance_state(weapon_id)
    if typeof(state) == TYPE_DICTIONARY:
        clean["mag"] = int(state.get("mag",0))
        clean["condition"] = float(state.get("condition",100.0))
        var source_mods = state.get("mods",{})
        if typeof(source_mods) == TYPE_DICTIONARY:
            for slot in ["magazine","muzzle"]:
                var module_id = str(source_mods.get(slot,""))
                if module_id != "" and item_defs.has(module_id):
                    var item = item_defs[module_id]
                    if str(item.get("use","")) == "weapon_mod" and str(item.get("mod_slot","")) == slot and str(item.get("allowed_weapon","")) == weapon_id:
                        clean["mods"][slot] = module_id
    clean["mag"] = clamp(int(clean["mag"]),0,_weapon_capacity_for_mods(weapon_id,clean["mods"]))
    clean["condition"] = clamp(float(clean["condition"]),0.0,100.0)
    clean["weapon_id"] = str(weapon_id)
    weapon_instance_states[str(instance_id)] = clean
    return clean

func _collect_firearm_instance_records():
    var records = []
    for i in range(inventory_entries.size()):
        var entry = inventory_entries[i]
        var weapon_id = str(entry.get("id",""))
        if weapon_defs.has(weapon_id):
            records.append({"scope":"inventory","index":i,"weapon_id":weapon_id,"instance_id":str(entry.get("instance_id",""))})
    var keys = container_states.keys()
    keys.sort()
    for key in keys:
        var entries = container_states[key].get("items",[])
        for i in range(entries.size()):
            var entry = entries[i]
            var weapon_id = str(entry.get("id",""))
            if weapon_defs.has(weapon_id):
                records.append({"scope":"container","key":str(key),"index":i,"weapon_id":weapon_id,"instance_id":str(entry.get("instance_id",""))})
    for i in range(dropped_items.size()):
        var entry = dropped_items[i]
        var weapon_id = str(entry.get("id",""))
        if weapon_defs.has(weapon_id):
            records.append({"scope":"drop","index":i,"weapon_id":weapon_id,"instance_id":str(entry.get("instance_id",""))})
    return records

func _inventory_has_weapon_instance(instance_id,weapon_id = ""):
    var iid = str(instance_id)
    if iid == "":
        return false
    for entry in inventory_entries:
        if str(entry.get("instance_id","")) != iid:
            continue
        var id = str(entry.get("id",""))
        return weapon_defs.has(id) and (weapon_id == "" or id == weapon_id)
    return false

func _inventory_weapon_instance_ids(weapon_id = ""):
    var result = []
    for entry in inventory_entries:
        var id = str(entry.get("id",""))
        if not weapon_defs.has(id) or (weapon_id != "" and id != weapon_id):
            continue
        var iid = str(entry.get("instance_id",""))
        if iid != "" and not result.has(iid):
            result.append(iid)
    return result

func _weapon_type_for_instance(instance_id):
    var iid = str(instance_id)
    if iid == "":
        return ""
    if weapon_instance_states.has(iid) and typeof(weapon_instance_states[iid]) == TYPE_DICTIONARY:
        var from_state = str(weapon_instance_states[iid].get("weapon_id",""))
        if weapon_defs.has(from_state):
            return from_state
    for rec in _collect_firearm_instance_records():
        if str(rec.get("instance_id","")) == iid:
            return str(rec.get("weapon_id",""))
    return ""

func _resolve_weapon_instance(weapon_id,instance_id = ""):
    var iid = str(instance_id)
    if iid != "" and _weapon_type_for_instance(iid) == weapon_id:
        return iid
    if weapon_id == current_weapon_id and current_weapon_instance_id != "" and _weapon_type_for_instance(current_weapon_instance_id) == weapon_id:
        return current_weapon_instance_id
    for candidate in _inventory_weapon_instance_ids(weapon_id):
        return str(candidate)
    var keys = weapon_instance_states.keys()
    keys.sort()
    for candidate in keys:
        var state = weapon_instance_states[candidate]
        if typeof(state) == TYPE_DICTIONARY and str(state.get("weapon_id","")) == weapon_id:
            return str(candidate)
    return ""

func _find_inventory_weapon_instance(weapon_id,preferred_instance_id = ""):
    var preferred = str(preferred_instance_id)
    if preferred != "" and _inventory_has_weapon_instance(preferred,weapon_id):
        return preferred
    if weapon_id == current_weapon_id and _inventory_has_weapon_instance(current_weapon_instance_id,weapon_id):
        return current_weapon_instance_id
    var ids = _inventory_weapon_instance_ids(weapon_id)
    return str(ids[0]) if not ids.is_empty() else ""

func _weapon_instance_state(weapon_id,instance_id = "",create_if_missing = true):
    var iid = _resolve_weapon_instance(weapon_id,instance_id)
    if iid == "":
        return {}
    if not weapon_instance_states.has(iid) or typeof(weapon_instance_states[iid]) != TYPE_DICTIONARY:
        if not create_if_missing:
            return {}
        weapon_instance_states[iid] = _weapon_default_instance_state(weapon_id)
    return _sanitize_weapon_instance_state(iid,weapon_id,weapon_instance_states[iid])

func _weapon_mag_value(weapon_id,instance_id = ""):
    var state = _weapon_instance_state(weapon_id,instance_id,false)
    if state.is_empty():
        return clamp(int(weapon_mags.get(weapon_id,0)),0,_weapon_capacity_for_mods(weapon_id,weapon_mods.get(weapon_id,{})))
    return int(state.get("mag",0))

func _set_weapon_mag_value(weapon_id,value,instance_id = ""):
    var iid = _resolve_weapon_instance(weapon_id,instance_id)
    if iid == "":
        return false
    var state = _weapon_instance_state(weapon_id,iid,true)
    state["mag"] = clamp(int(value),0,_weapon_capacity_for_mods(weapon_id,state.get("mods",{})))
    weapon_instance_states[iid] = state
    _sync_legacy_weapon_projection_for_type(weapon_id)
    return true

func _weapon_mod_state(weapon_id,instance_id = ""):
    var state = _weapon_instance_state(weapon_id,instance_id,false)
    if state.is_empty():
        var legacy = weapon_mods.get(weapon_id,{})
        return legacy.duplicate(true) if typeof(legacy) == TYPE_DICTIONARY else {"magazine":"","muzzle":""}
    return state.get("mods",{}).duplicate(true)

func _set_weapon_mod_slot(weapon_id,slot,module_id,instance_id = ""):
    var iid = _resolve_weapon_instance(weapon_id,instance_id)
    if iid == "":
        return false
    var state = _weapon_instance_state(weapon_id,iid,true)
    var mods = state.get("mods",{}).duplicate(true)
    mods[slot] = str(module_id)
    state["mods"] = mods
    state["mag"] = min(int(state.get("mag",0)),_weapon_capacity_for_mods(weapon_id,mods))
    weapon_instance_states[iid] = state
    _sync_legacy_weapon_projection_for_type(weapon_id)
    return true

func _sync_legacy_weapon_projection_for_type(weapon_id):
    var iid = ""
    if weapon_id == current_weapon_id and _inventory_has_weapon_instance(current_weapon_instance_id,weapon_id):
        iid = current_weapon_instance_id
    if iid == "":
        iid = _find_inventory_weapon_instance(weapon_id)
    if iid == "":
        for candidate in weapon_instance_states.keys():
            var state = weapon_instance_states[candidate]
            if typeof(state) == TYPE_DICTIONARY and str(state.get("weapon_id","")) == weapon_id:
                iid = str(candidate)
                break
    if iid == "":
        if not weapon_mags.has(weapon_id): weapon_mags[weapon_id] = 0
        if not weapon_condition.has(weapon_id): weapon_condition[weapon_id] = 100.0
        if not weapon_mods.has(weapon_id): weapon_mods[weapon_id] = {"magazine":"","muzzle":""}
        return
    var state = _weapon_instance_state(weapon_id,iid,false)
    if state.is_empty():
        return
    weapon_mags[weapon_id] = int(state.get("mag",0))
    weapon_condition[weapon_id] = float(state.get("condition",100.0))
    weapon_mods[weapon_id] = state.get("mods",{}).duplicate(true)

func _sync_legacy_weapon_projections():
    for weapon_id in FIREARM_IDS:
        _sync_legacy_weapon_projection_for_type(weapon_id)

func _ensure_weapon_runtime_state(migrate_legacy = false):
    _ensure_runtime_item_instance_ids()
    if typeof(weapon_instance_states) != TYPE_DICTIONARY:
        weapon_instance_states = {}

    # Migration is deterministic and conservative: the old shared type state goes to
    # one concrete gun only, so loaded rounds and installed modules are never duplicated.
    var records = _collect_firearm_instance_records()
    var first_any = {}
    var first_inventory = {}
    var live_ids = {}
    for rec in records:
        var iid = str(rec.get("instance_id",""))
        var weapon_id = str(rec.get("weapon_id",""))
        if iid == "" or not weapon_defs.has(weapon_id):
            continue
        live_ids[iid] = weapon_id
        if not first_any.has(weapon_id):
            first_any[weapon_id] = iid
        if str(rec.get("scope","")) == "inventory" and not first_inventory.has(weapon_id):
            first_inventory[weapon_id] = iid

    var migration_target = {}
    if migrate_legacy:
        for weapon_id in FIREARM_IDS:
            if weapon_id == current_weapon_id and first_inventory.has(weapon_id):
                migration_target[weapon_id] = first_inventory[weapon_id]
            elif first_inventory.has(weapon_id):
                migration_target[weapon_id] = first_inventory[weapon_id]
            elif first_any.has(weapon_id):
                migration_target[weapon_id] = first_any[weapon_id]

    var stale = weapon_instance_states.keys()
    for iid in stale:
        if not live_ids.has(str(iid)):
            weapon_instance_states.erase(iid)

    for iid in live_ids.keys():
        var weapon_id = str(live_ids[iid])
        if weapon_instance_states.has(iid) and typeof(weapon_instance_states[iid]) == TYPE_DICTIONARY:
            _sanitize_weapon_instance_state(iid,weapon_id,weapon_instance_states[iid])
            continue
        if migrate_legacy and str(migration_target.get(weapon_id,"")) == str(iid):
            var legacy_mods = weapon_mods.get(weapon_id,{})
            _sanitize_weapon_instance_state(iid,weapon_id,{
                "weapon_id":weapon_id,
                "mag":int(weapon_mags.get(weapon_id,0)),
                "condition":float(weapon_condition.get(weapon_id,100.0)),
                "mods":legacy_mods.duplicate(true) if typeof(legacy_mods) == TYPE_DICTIONARY else {}
            })
        else:
            _sanitize_weapon_instance_state(iid,weapon_id,_weapon_default_instance_state(weapon_id))

    if not _inventory_has_weapon_instance(current_weapon_instance_id,current_weapon_id):
        current_weapon_instance_id = _find_inventory_weapon_instance(current_weapon_id)
    _sync_legacy_weapon_projections()

func _grid_add_existing_entry(entries,source_entry,gw,gh):
    var item_id = str(source_entry.get("id",""))
    var quantity = int(source_entry.get("qty",1))
    if not item_defs.has(item_id):
        return quantity

    if not _item_uses_instance_id(item_id):
        return _grid_add(entries,item_id,quantity,gw,gh)

    var pos = _find_grid_space(entries,item_id,gw,gh)
    if pos.x < 0:
        return quantity

    var copy = source_entry.duplicate(true)
    copy["id"] = item_id
    copy["qty"] = 1
    copy["x"] = pos.x
    copy["y"] = pos.y
    entries.append(copy)
    return max(0,quantity - 1)

func _grid_add(entries, item_id, quantity, gw, gh):
    if not item_defs.has(item_id):
        return quantity

    var item = item_defs[item_id]
    var max_stack = int(item.get("stack", 1))
    var remaining = int(quantity)

    if max_stack > 1:
        for i in range(entries.size()):
            if remaining <= 0:
                break
            if str(entries[i].get("id", "")) == item_id:
                var current = int(entries[i].get("qty", 1))
                if current < max_stack:
                    var add = min(max_stack - current, remaining)
                    entries[i]["qty"] = current + add
                    remaining -= add

    while remaining > 0:
        var pos = _find_grid_space(entries, item_id, gw, gh)
        if pos.x < 0:
            break

        var stack_qty = min(max_stack, remaining)
        var new_entry = {
            "id": item_id,
            "qty": stack_qty,
            "x": pos.x,
            "y": pos.y
        }
        if max_stack <= 1:
            new_entry["instance_id"] = ""
        entries.append(new_entry)
        remaining -= stack_qty

    return remaining

func _find_grid_space(entries, item_id, gw, gh):
    if not item_defs.has(item_id):
        return Vector2i(-1,-1)

    var item = item_defs[item_id]
    var iw = int(item.get("w", 1))
    var ih = int(item.get("h", 1))

    for y in range(gh - ih + 1):
        for x in range(gw - iw + 1):
            if _can_place(entries, x, y, iw, ih):
                return Vector2i(x,y)

    return Vector2i(-1,-1)

func _can_place(entries, x, y, iw, ih):
    for entry in entries:
        if not item_defs.has(str(entry.get("id", ""))):
            continue

        var other = item_defs[str(entry["id"])]
        var ox = int(entry.get("x", 0))
        var oy = int(entry.get("y", 0))
        var ow = int(other.get("w", 1))
        var oh = int(other.get("h", 1))

        if x < ox + ow and x + iw > ox and y < oy + oh and y + ih > oy:
            return false

    return true

func _can_add_all(entries, item_id, qty, gw, gh):
    var test = entries.duplicate(true)
    return _grid_add(test, item_id, qty, gw, gh) == 0

func _inventory_has_item(id):
    return _inventory_count(id) > 0

func _inventory_count(id):
    var count = 0
    for entry in inventory_entries:
        if str(entry.get("id", "")) == id:
            count += int(entry.get("qty", 1))
    return count

func _consume_inventory_item(id, amount):
    var remaining = int(amount)

    for i in range(inventory_entries.size() - 1, -1, -1):
        if remaining <= 0:
            break
        if str(inventory_entries[i].get("id", "")) != id:
            continue

        var qty = int(inventory_entries[i].get("qty", 1))
        var take = min(qty, remaining)
        qty -= take
        remaining -= take

        if qty <= 0:
            inventory_entries.remove_at(i)
        else:
            inventory_entries[i]["qty"] = qty

    return remaining == 0


func _inventory_weight():
    _ensure_runtime_item_instance_ids()
    _ensure_water_container_runtime_state()
    var total = 0.0

    for entry in inventory_entries:
        total += _entry_total_weight(entry)

    for slot in equipment.keys():
        var equipped_id = str(equipment.get(slot,""))
        if equipped_id != "" and item_defs.has(equipped_id):
            total += float(item_defs[equipped_id].get("weight",0.0))

    return total


func _weapon_condition_state(id,instance_id = ""):
    var value = _weapon_condition_value(id,instance_id)

    if value >= 85.0:
        return "ОТЛИЧНОЕ"
    if value >= 60.0:
        return "РАБОЧЕЕ"
    if value >= 35.0:
        return "ИЗНОШЕНО"
    return "КРИТИЧЕСКОЕ"

func _service_costs(service_type):
    if service_type == "overhaul":
        return {"repair_kit":2,"scrap":3,"tape":1}
    return {"repair_kit":1,"scrap":1,"cloth":1}


func _service_gain(service_type):
    var base_gain = 60.0 if service_type == "overhaul" else 30.0
    return base_gain

func _service_cap(service_type):
    return 100.0 if service_type == "overhaul" else 90.0

func _service_name(service_type):
    return "КАПИТАЛЬНЫЙ РЕМОНТ" if service_type == "overhaul" else "ОБСЛУЖИВАНИЕ"

func _can_service_weapon(weapon_id,service_type,instance_id = ""):
    if not weapon_defs.has(weapon_id):
        return false
    var iid = _find_inventory_weapon_instance(weapon_id,instance_id)
    if iid == "":
        return false

    var current = _weapon_condition_value(weapon_id,iid)
    var cap_value = _service_cap(service_type)
    if current >= cap_value - 0.01:
        return false

    for id in _service_costs(service_type).keys():
        if _inventory_count(str(id)) < int(_service_costs(service_type)[id]):
            return false

    return true

func _perform_weapon_service(weapon_id,service_type,instance_id = ""):
    var iid = _find_inventory_weapon_instance(weapon_id,instance_id)
    if iid == "" or not _can_service_weapon(weapon_id,service_type,iid):
        if service_status != null:
            service_status.text = "Нельзя выполнить: не хватает ресурсов или ремонт уже не нужен."
        return false

    var test_entries = inventory_entries.duplicate(true)
    var costs = _service_costs(service_type)

    for id in costs.keys():
        if not _consume_from_entries(test_entries,str(id),int(costs[id])):
            if service_status != null:
                service_status.text = "Ошибка транзакции ремонта."
            return false

    var current = _weapon_condition_value(weapon_id,iid)
    var new_value = min(_service_cap(service_type),current + _service_gain(service_type))
    var state = _weapon_instance_state(weapon_id,iid,true)

    inventory_entries = test_entries
    state["condition"] = new_value
    weapon_instance_states[iid] = state
    _sync_legacy_weapon_projection_for_type(weapon_id)
    _emit_ai_sound(
        player.global_position,
        108.0 if service_type == "overhaul" else 82.0,
        "workbench",
        1.15 if service_type == "overhaul" else 0.85
    )

    if service_status != null:
        service_status.text = "%s: %d%% → %d%%" % [
            _service_name(service_type),
            int(current),
            int(new_value)
        ]

    _refresh_weapon_service_ui()
    _rebuild_salvage_ui()
    return true

func _select_service_weapon(weapon_id):
    if not weapon_defs.has(weapon_id):
        return
    _ensure_weapon_runtime_state(false)
    var ids = _inventory_weapon_instance_ids(weapon_id)
    if ids.is_empty():
        return

    var next_index = 0
    if service_weapon_id == weapon_id and ids.has(service_weapon_instance_id):
        next_index = (ids.find(service_weapon_instance_id) + 1) % ids.size()
    service_weapon_id = weapon_id
    service_weapon_instance_id = str(ids[next_index])
    _refresh_weapon_service_ui()

func _set_workbench_mode(mode):
    if mode != "craft" and mode != "service" and mode != "salvage":
        return
    workbench_mode = mode
    _refresh_workbench_mode()


func _refresh_workbench_mode():
    if workbench_craft_content != null:
        workbench_craft_content.visible = workbench_mode == "craft"
    if workbench_service_content != null:
        workbench_service_content.visible = workbench_mode == "service"
    if workbench_salvage_content != null:
        workbench_salvage_content.visible = workbench_mode == "salvage"

    if workbench_craft_tab != null:
        workbench_craft_tab.disabled = workbench_mode == "craft"
    if workbench_service_tab != null:
        workbench_service_tab.disabled = workbench_mode == "service"
    if workbench_salvage_tab != null:
        workbench_salvage_tab.disabled = workbench_mode == "salvage"

    if workbench_mode == "craft":
        _refresh_crafting_details()
    elif workbench_mode == "service":
        _refresh_weapon_service_ui()
    else:
        _rebuild_salvage_ui()

func _service_cost_text(service_type):
    var lines = []
    var costs = _service_costs(service_type)

    for id in costs.keys():
        var need = int(costs[id])
        var have = _inventory_count(str(id))
        var item_name = str(id)

        if item_defs.has(str(id)):
            item_name = str(item_defs[str(id)].get("name",id))

        lines.append("%s: %d/%d" % [item_name,have,need])

    return "\n".join(lines)

func _refresh_weapon_service_ui():
    _ensure_weapon_runtime_state(false)
    if service_weapon_id == "" or not weapon_defs.has(service_weapon_id):
        service_weapon_id = current_weapon_id
        service_weapon_instance_id = current_weapon_instance_id

    var ids = _inventory_weapon_instance_ids(service_weapon_id)
    if ids.is_empty():
        for candidate in FIREARM_IDS:
            var candidate_ids = _inventory_weapon_instance_ids(candidate)
            if not candidate_ids.is_empty():
                service_weapon_id = candidate
                service_weapon_instance_id = str(candidate_ids[0])
                ids = candidate_ids
                break
    elif not ids.has(service_weapon_instance_id):
        service_weapon_instance_id = str(ids[0])

    if service_weapon_id == "" or service_weapon_instance_id == "":
        if service_title != null:
            service_title.text = "НЕТ ОРУЖИЯ В РЮКЗАКЕ"
        if service_condition_label != null:
            service_condition_label.text = ""
        if service_condition_bar != null:
            service_condition_bar.value = 0
        return

    if service_weapon_icon != null:
        service_weapon_icon.texture = _make_item_icon(service_weapon_id)

    var instance_pos = ids.find(service_weapon_instance_id) + 1
    if service_title != null:
        var suffix = " • ЭКЗ. %d/%d" % [instance_pos,ids.size()] if ids.size() > 1 else ""
        service_title.text = str(weapon_defs[service_weapon_id].get("name",service_weapon_id)) + suffix

    var condition_value = _weapon_condition_value(service_weapon_id,service_weapon_instance_id)
    if service_condition_label != null:
        service_condition_label.text = "Состояние: %d%%  [%s]" % [
            int(condition_value),
            _weapon_condition_state(service_weapon_id,service_weapon_instance_id)
        ]

    if service_condition_bar != null:
        service_condition_bar.value = condition_value

    for id in service_weapon_buttons.keys():
        var button = service_weapon_buttons[id]
        if button != null:
            var weapon_ids = _inventory_weapon_instance_ids(str(id))
            button.disabled = weapon_ids.is_empty()
            var base_name = str(weapon_defs.get(str(id),{}).get("short_name",item_defs.get(str(id),{}).get("short",id)))
            button.text = "%s x%d" % [base_name,weapon_ids.size()] if weapon_ids.size() > 1 else base_name

    if service_requirements != null:
        service_requirements.text = "ОБСЛУЖИВАНИЕ  +30%%, максимум 90%%\n%s\n\nКАПРЕМОНТ  +60%%, максимум 100%%\n%s" % [
            _service_cost_text("maintenance"),
            _service_cost_text("overhaul")
        ]

    if service_status != null and service_status.text == "":
        service_status.text = "Повторный выбор типа оружия переключает его экземпляры."

func _service_selected_maintenance():
    _perform_weapon_service(service_weapon_id,"maintenance",service_weapon_instance_id)

func _service_selected_overhaul():
    _perform_weapon_service(service_weapon_id,"overhaul",service_weapon_instance_id)

func _salvage_outputs(item_id):
    var table = {
        "repair_kit":{"scrap":1},
        "water_filter":{"scrap":1,"cloth":1},
        "combat_knife":{"scrap":1},
        "steel_pipe":{"scrap":2},
        "fire_axe":{"scrap":2,"cloth":1},
        "cap":{"cloth":1},
        "light_jacket":{"cloth":2},
        "police_vest":{"scrap":2,"cloth":2},
        "field_backpack":{"cloth":2,"tape":1},
        "wool_hat":{"cloth":1},
        "ballistic_helmet":{"scrap":2,"cloth":1},
        "rain_jacket":{"cloth":2,"tape":1},
        "insulated_parka":{"cloth":3,"tape":1},
        "storm_poncho":{"cloth":2,"tape":2},
        "military_vest":{"scrap":3,"cloth":2},
        "hiking_backpack":{"cloth":3,"tape":1},
        "expedition_pack":{"cloth":4,"tape":2},
        "flashlight":{"scrap":1},
        "makarov_extmag":{"scrap":1},
        "shotgun_exttube":{"scrap":1},
        "akm_extmag":{"scrap":2},
        "muzzle_brake":{"scrap":1},
        "suppressor":{"scrap":2,"cloth":1}
    }

    if not table.has(item_id):
        return {}
    return table[item_id].duplicate(true)

func _is_salvageable(item_id):
    return not _salvage_outputs(item_id).is_empty()

func _can_salvage(item_id):
    if not _is_salvageable(item_id):
        return false
    if _inventory_count(item_id) <= 0:
        return false
    if item_id == equipped_melee_id:
        return false
    var test_entries = inventory_entries.duplicate(true)
    if not _consume_one_item_from_entries(test_entries,item_id):
        return false

    var outputs = _salvage_outputs(item_id)
    var output_ids = outputs.keys()
    output_ids.sort()
    for out_id in output_ids:
        if _grid_add(test_entries,str(out_id),int(outputs[out_id]),INV_W,INV_H) != 0:
            return false
    return true

func _salvage_output_text(item_id):
    var outputs = _salvage_outputs(item_id)
    if outputs.is_empty():
        return "Нет пригодных материалов."

    var lines = []
    var ids = outputs.keys()
    ids.sort()
    for out_id in ids:
        var item_name = str(out_id)
        if item_defs.has(str(out_id)):
            item_name = str(item_defs[str(out_id)].get("name",out_id))
        lines.append("%s x%d" % [item_name,int(outputs[out_id])])
    return "\n".join(lines)

func _rebuild_salvage_ui():
    if salvage_list == null:
        return

    for child in salvage_list.get_children():
        salvage_list.remove_child(child)
        child.queue_free()

    var seen = {}
    var ids = []
    for entry in inventory_entries:
        var item_id = str(entry.get("id",""))
        if item_id == "" or seen.has(item_id):
            continue
        if not _is_salvageable(item_id):
            continue
        seen[item_id] = true
        ids.append(item_id)

    ids.sort()
    for item_id in ids:
        var count = _inventory_count(item_id)
        var item_name = str(item_defs.get(item_id,{}).get("name",item_id))
        var button = Button.new()
        button.text = "%s x%d" % [item_name,count]
        button.custom_minimum_size = Vector2(170,30)
        button.add_theme_font_size_override("font_size",7)
        _visual_button_style(button)
        button.pressed.connect(_select_salvage_item.bind(item_id))
        salvage_list.add_child(button)

    if selected_salvage_id != "" and _inventory_count(selected_salvage_id) <= 0:
        selected_salvage_id = ""

    _refresh_salvage_details()

func _select_salvage_item(item_id):
    selected_salvage_id = str(item_id)
    _refresh_salvage_details()

func _refresh_salvage_details():
    if salvage_details == null:
        return

    if selected_salvage_id == "":
        salvage_details.text = "Выбери предмет для разборки."
        if salvage_status != null:
            salvage_status.text = ""
        return

    if not _is_salvageable(selected_salvage_id):
        salvage_details.text = "Этот предмет нельзя разобрать."
        if salvage_status != null:
            salvage_status.text = ""
        return

    var item_name = str(item_defs.get(selected_salvage_id,{}).get("name",selected_salvage_id))
    var count = _inventory_count(selected_salvage_id)

    salvage_details.text = "%s\n\nВ наличии: %d\n\nВОЗВРАТ:\n%s" % [
        item_name,
        count,
        _salvage_output_text(selected_salvage_id)
    ]

    if salvage_status != null:
        if selected_salvage_id == equipped_melee_id:
            salvage_status.text = "Сначала убери активное melee-оружие."
        elif not _can_salvage(selected_salvage_id):
            salvage_status.text = "Нет места для материалов."
        else:
            salvage_status.text = "Готово к разборке."

func _salvage_selected_item():
    if selected_salvage_id == "":
        return false

    var item_id = selected_salvage_id
    if not _can_salvage(item_id):
        _refresh_salvage_details()
        return false

    var test_entries = inventory_entries.duplicate(true)
    if not _consume_one_item_from_entries(test_entries,item_id):
        return false

    var outputs = _salvage_outputs(item_id)
    var output_ids = outputs.keys()
    output_ids.sort()
    for out_id in output_ids:
        if _grid_add(test_entries,str(out_id),int(outputs[out_id]),INV_W,INV_H) != 0:
            return false

    inventory_entries = test_entries
    _emit_ai_sound(player.global_position,92.0,"workbench",1.0)

    if salvage_status != null:
        salvage_status.text = "Разобрано: %s" % str(item_defs.get(item_id,{}).get("name",item_id))

    if _inventory_count(item_id) <= 0:
        selected_salvage_id = ""

    _rebuild_salvage_ui()
    _refresh_crafting_details()
    _refresh_weapon_service_ui()
    return true


