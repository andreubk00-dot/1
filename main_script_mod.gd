func _damage_enemy(enemy, amount):
    if not is_instance_valid(enemy):
        return
    var hp = float(enemy.get_meta("hp", 70.0)) - amount
    enemy.set_meta("hp", hp)
    if hp > 0.0:
        _infected_interrupt_special(enemy)
        enemy.set_meta("last_known_position",player.global_position)
        enemy.set_meta("suspicion",100.0)
        enemy.set_meta("lost_sight_time",0.0)
        _enemy_set_state(enemy,"chase",4.5)

    if hp <= 0.0:
        if str(enemy.get_meta("special_role","")) == "carrier" and not bool(enemy.get_meta("carrier_cloud_spawned",false)):
            enemy.set_meta("carrier_cloud_spawned",true)
            _spawn_carrier_death_cloud(enemy.global_position,enemy)
        var c = enemy.get_meta("chunk_coord")
        var sid = int(enemy.get_meta("spawn_id"))
        var key = "%d:%d:%d" % [c.x, c.y, sid]
        defeated[key] = true
        enemy.queue_free()

func _ai_state_valid(state):
    return state in ["idle","suspicious","investigate","chase","search","return"]

func _enemy_set_state(enemy,state,duration = 0.0):
    if not is_instance_valid(enemy):
        return
    if not _ai_state_valid(state):
        state = "idle"

    enemy.set_meta("ai_state",state)
    enemy.set_meta("ai_state_time",max(0.0,float(duration)))

    if state == "chase":
        enemy.set_meta("alert",max(float(enemy.get_meta("alert",0.0)),5.5))
    elif state == "idle":
        enemy.set_meta("alert",0.0)

func _player_has_active_flashlight():
    return (
        flashlight_on
        and flashlight_battery > 0.0
        and str(equipment.get("utility","")) == "flashlight"
    )


func _player_near_active_fire():
    if player == null:
        return false

    for rec in base_objects:
        if str(rec.get("kind","")) != "campfire":
            continue
        if not bool(rec.get("on",false)) or float(rec.get("fuel",0.0)) <= 0.0:
            continue

        var pos = Vector2(float(rec.get("x",0.0)),float(rec.get("y",0.0)))
        if player.global_position.distance_to(pos) <= 105.0 and _melee_line_clear(pos):
            return true

    return false

func _player_visibility_multiplier():
    var hour = world_minutes / 60.0
    var visibility = 1.0

    # Light level.
    if hour >= 21.0 or hour < 5.0:
        visibility *= 0.42
    elif hour >= 18.0:
        visibility *= lerpf(1.0,0.42,(hour - 18.0) / 3.0)
    elif hour < 7.0:
        visibility *= lerpf(0.42,1.0,(hour - 5.0) / 2.0)

    # Weather obscures visual detection.
    if weather_state == "rain":
        visibility *= 0.74
    elif weather_state == "cloudy":
        visibility *= 0.90

    # Player movement affects how easy the silhouette is to notice.
    if move_direction.length() <= 0.05:
        visibility *= 0.82
    elif is_sprinting:
        visibility *= 1.18

    # Roofed interiors reduce silhouette contrast from outside.
    if is_sheltered:
        visibility *= 0.90

    # Flashlight destroys most night stealth.
    if _player_has_active_flashlight():
        if hour >= 20.0 or hour < 6.0:
            visibility = max(visibility,1.05)
        else:
            visibility *= 1.05

    if _player_near_active_base_lamp():
        if hour >= 20.0 or hour < 6.0:
            visibility = max(visibility,0.96)
        else:
            visibility *= 1.03

    # Fire is a strong survival tool, but it exposes the player at night.
    if _player_near_active_fire():
        if hour >= 20.0 or hour < 6.0:
            visibility = max(visibility,1.10)
        else:
            visibility *= 1.06

    return clamp(visibility,0.25,1.35)

func _enemy_vision_radius(enemy):
    var base_radius = float(enemy.get_meta("detection_radius",170.0))
    return base_radius * _player_visibility_multiplier()

func _sound_weather_multiplier(kind):
    if weather_state == "rain":
        if kind == "gunshot":
            return 0.86
        if kind == "door":
            return 0.72
        if kind == "workbench":
            return 0.68
        if kind == "fire":
            return 0.48
        if kind == "infected_call":
            return 0.76
        return 0.58

    if weather_state == "cloudy":
        return 0.92

    return 1.0

func _sound_hearing_cap_multiplier(kind):
    if kind == "gunshot":
        return 1.75
    if kind == "sprint":
        return 1.00
    if kind == "melee":
        return 0.78
    if kind == "door":
        return 0.72
    if kind == "drop":
        return 0.50
    if kind == "workbench":
        return 0.65
    if kind == "fire":
        return 0.58
    if kind == "infected_call":
        return 1.35
    if kind == "walk":
        return 0.45
    return 0.90

func _sound_suspicion_gain(kind):
    if kind == "gunshot":
        return 92.0
    if kind == "sprint":
        return 52.0
    if kind == "melee":
        return 44.0
    if kind == "door":
        return 38.0
    if kind == "drop":
        return 28.0
    if kind == "workbench":
        return 34.0
    if kind == "fire":
        return 20.0
    if kind == "infected_call":
        return 82.0
    if kind == "walk":
        return 18.0
    return 34.0

func _sound_occlusion_multiplier(origin,enemy,kind):
    if not is_instance_valid(enemy):
        return 0.0

    var query = PhysicsRayQueryParameters2D.create(origin,enemy.global_position)
    query.collision_mask = LAYER_WORLD
    var hit = get_world_2d().direct_space_state.intersect_ray(query)

    if hit.is_empty():
        return 1.0

    if kind == "gunshot":
        return 0.70
    if kind == "door":
        return 0.55
    if kind == "fire":
        return 0.48
    if kind == "infected_call":
        return 0.62
    return 0.40

func _emit_ai_sound(origin,radius,kind = "generic",strength = 1.0,source_enemy = null):
    var base_radius = max(0.0,float(radius))
    if base_radius <= 0.0:
        return

    var weather_mult = _sound_weather_multiplier(kind)
    var source_strength = max(0.05,float(strength))

    if source_enemy == null and player != null and player.global_position.distance_to(origin) <= 80.0:
        last_player_noise_radius = base_radius
        last_player_noise_kind = kind
        last_player_noise_time = 1.15

    for enemy in get_tree().get_nodes_in_group("infected"):
        if not is_instance_valid(enemy) or enemy == source_enemy:
            continue

        var hearing = float(enemy.get_meta("hearing_radius",260.0))
        var cap = hearing * _sound_hearing_cap_multiplier(kind)
        var effective = min(base_radius,cap) * weather_mult
        effective *= _sound_occlusion_multiplier(origin,enemy,kind)

        if effective <= 1.0:
            continue

        var dist = enemy.global_position.distance_to(origin)
        if dist > effective:
            continue

        var proximity = 1.0 - clamp(dist / effective,0.0,1.0)
        var gain = _sound_suspicion_gain(kind) * (0.35 + proximity * 0.65) * source_strength
        var suspicion = min(100.0,float(enemy.get_meta("suspicion",0.0)) + gain)

        enemy.set_meta("suspicion",suspicion)
        enemy.set_meta("heard_position",origin)
        enemy.set_meta("last_sound_kind",kind)

        var state = str(enemy.get_meta("ai_state","idle"))
        if state == "chase":
            continue

        if suspicion >= 34.0 or kind == "gunshot":
            _enemy_set_state(enemy,"investigate",5.0)
        else:
            _enemy_set_state(enemy,"suspicious",1.25)

func _infected_is_calling(enemy) -> bool:
    return is_instance_valid(enemy) and float(enemy.get_meta("call_timer",0.0)) > 0.0

func _infected_is_spitting(enemy) -> bool:
    return is_instance_valid(enemy) and float(enemy.get_meta("spit_timer",0.0)) > 0.0

func _infected_interrupt_special(enemy) -> bool:
    if not is_instance_valid(enemy):
        return false
    var role = str(enemy.get_meta("special_role",""))
    if role == "caller" and _infected_is_calling(enemy):
        enemy.set_meta("call_timer",0.0)
        enemy.set_meta("call_cd",max(float(enemy.get_meta("call_cd",0.0)),float(enemy.get_meta("call_interrupt_cooldown",5.5))))
        enemy.set_meta("call_interrupted",true)
        return true
    if role == "spitter" and _infected_is_spitting(enemy):
        enemy.set_meta("spit_timer",0.0)
        enemy.set_meta("spit_cd",max(float(enemy.get_meta("spit_cd",0.0)),float(enemy.get_meta("spit_interrupt_cooldown",3.5))))
        enemy.set_meta("spit_interrupted",true)
        return true
    return false

func _infected_finish_call(enemy) -> void:
    if not is_instance_valid(enemy):
        return
    enemy.set_meta("call_timer",0.0)
    enemy.set_meta("call_cd",max(0.1,float(enemy.get_meta("call_cooldown",13.0))))
    enemy.set_meta("call_count",int(enemy.get_meta("call_count",0)) + 1)
    enemy.set_meta("call_interrupted",false)
    var radius = max(0.0,float(enemy.get_meta("call_radius",440.0)))
    _emit_ai_sound(enemy.global_position,radius,"infected_call",1.0,enemy)
    if player != null and player.global_position.distance_to(enemy.global_position) <= radius:
        _set_survival_feedback("КРИК ЗАРАЖЁННОГО — ОКРУГА НАСТОРОЖЕНА",1.8)

func _spawn_infected_spit_trace(origin:Vector2,target:Vector2) -> void:
    var line = Line2D.new()
    line.width = 2.2
    line.default_color = Color(0.54,0.92,0.30,0.72)
    line.z_index = 119
    line.z_as_relative = false
    line.add_point(origin)
    line.add_point(target)
    add_child(line)
    var timer = get_tree().create_timer(0.16)
    timer.timeout.connect(line.queue_free)

func _infected_spit_path_clear(enemy,target:Vector2) -> bool:
    if not is_instance_valid(enemy):
        return false
    var query = PhysicsRayQueryParameters2D.create(enemy.global_position,target)
    query.collision_mask = LAYER_WORLD
    query.exclude = [enemy.get_rid()]
    return get_world_2d().direct_space_state.intersect_ray(query).is_empty()

func _apply_infected_spit_hit(enemy) -> bool:
    if qa_visual_mode or developer_invulnerable or not is_instance_valid(enemy) or player == null:
        return false
    var damage = max(0.0,float(enemy.get_meta("spit_damage",6.0)))
    # Torso protection helps somewhat, but the core threat is loss of mobility rather than raw damage.
    var final_damage = damage * (1.0 - _armor_value_for_zone("torso") * 0.35)
    health = max(0.0,health - final_damage)
    stamina = max(0.0,stamina - 7.0)
    infected_spit_slow_time = max(infected_spit_slow_time,float(enemy.get_meta("spit_slow_time",2.4)))
    infected_spit_slow_mult = min(infected_spit_slow_mult,float(enemy.get_meta("spit_slow_mult",0.78)))
    modern_survivor_hit_time = modern_survivor_hit_duration
    _set_survival_feedback("ПЛЕВОК ЗАРАЖЁННОГО — ДВИЖЕНИЕ ЗАМЕДЛЕНО",1.6)
    return true

func _infected_finish_spit(enemy) -> void:
    if not is_instance_valid(enemy):
        return
    enemy.set_meta("spit_timer",0.0)
    enemy.set_meta("spit_cd",max(0.1,float(enemy.get_meta("spit_cooldown",7.5))))
    enemy.set_meta("spit_count",int(enemy.get_meta("spit_count",0)) + 1)
    enemy.set_meta("spit_interrupted",false)
    var target = enemy.get_meta("spit_target",enemy.global_position)
    if typeof(target) != TYPE_VECTOR2:
        target = enemy.global_position
    _spawn_infected_spit_trace(enemy.global_position,target)
    var hit = false
    if player != null and _infected_spit_path_clear(enemy,target):
        var radius = max(4.0,float(enemy.get_meta("spit_impact_radius",25.0)))
        if player.global_position.distance_to(target) <= radius:
            hit = _apply_infected_spit_hit(enemy)
    enemy.set_meta("spit_last_hit",hit)

func _spawn_carrier_death_cloud(origin:Vector2,enemy = null):
    var radius = 62.0
    var delay = 0.35
    var duration = 3.4
    var damage_per_sec = 1.8
    var stamina_per_sec = 6.0
    var contamination_per_sec = 4.0
    if is_instance_valid(enemy):
        radius = max(12.0,float(enemy.get_meta("cloud_radius",radius)))
        delay = max(0.0,float(enemy.get_meta("cloud_delay",delay)))
        duration = max(0.2,float(enemy.get_meta("cloud_duration",duration)))
        damage_per_sec = max(0.0,float(enemy.get_meta("cloud_damage_per_sec",damage_per_sec)))
        stamina_per_sec = max(0.0,float(enemy.get_meta("cloud_stamina_per_sec",stamina_per_sec)))
        contamination_per_sec = max(0.0,float(enemy.get_meta("cloud_contamination_per_sec",contamination_per_sec)))

    var cloud = Node2D.new()
    cloud.name = "CarrierDeathCloud"
    cloud.z_index = 8
    cloud.z_as_relative = false
    add_child(cloud)
    cloud.global_position = origin
    cloud.add_to_group("infected_death_hazard")
    cloud.set_meta("cloud_radius",radius)
    cloud.set_meta("cloud_delay",delay)
    cloud.set_meta("cloud_initial_delay",delay)
    cloud.set_meta("cloud_time",duration)
    cloud.set_meta("cloud_initial_time",duration)
    cloud.set_meta("cloud_damage_per_sec",damage_per_sec)
    cloud.set_meta("cloud_stamina_per_sec",stamina_per_sec)
    cloud.set_meta("cloud_contamination_per_sec",contamination_per_sec)
    cloud.set_meta("feedback_cd",0.0)

    var haze = _ellipse(Vector2.ZERO,radius,radius * 0.72,Color(0.40,0.56,0.18,0.22),cloud)
    haze.z_index = 0
    cloud.set_meta("cloud_visual",haze)
    var rim = Line2D.new()
    rim.width = 1.5
    rim.default_color = Color(0.68,0.82,0.34,0.52)
    rim.closed = true
    for i in range(24):
        var a = TAU * float(i) / 24.0
        rim.add_point(Vector2(cos(a) * radius,sin(a) * radius * 0.72))
    cloud.add_child(rim)
    cloud.set_meta("cloud_rim",rim)
    return cloud

func _carrier_cloud_path_clear(origin:Vector2) -> bool:
    if player == null:
        return false
    var query = PhysicsRayQueryParameters2D.create(origin,player.global_position)
    query.collision_mask = LAYER_WORLD
    query.exclude = [player.get_rid()]
    return get_world_2d().direct_space_state.intersect_ray(query).is_empty()

func _update_infected_death_hazards(delta:float) -> void:
    var step = max(0.0,float(delta))
    for cloud in get_tree().get_nodes_in_group("infected_death_hazard"):
        if not is_instance_valid(cloud) or cloud.is_queued_for_deletion():
            continue
        var delay = max(0.0,float(cloud.get_meta("cloud_delay",0.0)))
        var active_time = max(0.0,float(cloud.get_meta("cloud_time",0.0)))
        var feedback_cd = max(0.0,float(cloud.get_meta("feedback_cd",0.0)) - step)
        cloud.set_meta("feedback_cd",feedback_cd)

        var visual = cloud.get_meta("cloud_visual",null)
        var rim = cloud.get_meta("cloud_rim",null)
        if delay > 0.0:
            delay = max(0.0,delay - step)
            cloud.set_meta("cloud_delay",delay)
            var initial_delay = max(0.01,float(cloud.get_meta("cloud_initial_delay",0.35)))
            var armed = 1.0 - clamp(delay / initial_delay,0.0,1.0)
            if is_instance_valid(visual):
                visual.scale = Vector2.ONE * lerp(0.42,1.0,armed)
                visual.modulate.a = lerp(0.35,0.82,armed)
            if is_instance_valid(rim):
                rim.modulate.a = lerp(0.35,1.0,armed)
            continue

        active_time = max(0.0,active_time - step)
        cloud.set_meta("cloud_time",active_time)
        if active_time <= 0.0:
            cloud.queue_free()
            continue

        var initial_time = max(0.01,float(cloud.get_meta("cloud_initial_time",3.4)))
        var life_ratio = clamp(active_time / initial_time,0.0,1.0)
        if is_instance_valid(visual):
            visual.scale = Vector2.ONE * (1.0 + sin(active_time * 7.0) * 0.025)
            visual.modulate.a = 0.30 + life_ratio * 0.55
        if is_instance_valid(rim):
            rim.modulate.a = 0.25 + life_ratio * 0.70

        if qa_visual_mode or developer_invulnerable or player == null:
            continue
        var radius = max(1.0,float(cloud.get_meta("cloud_radius",62.0)))
        if player.global_position.distance_to(cloud.global_position) > radius:
            continue
        if not _carrier_cloud_path_clear(cloud.global_position):
            continue

        health = max(0.0,health - max(0.0,float(cloud.get_meta("cloud_damage_per_sec",1.8))) * step)
        stamina = max(0.0,stamina - max(0.0,float(cloud.get_meta("cloud_stamina_per_sec",6.0))) * step)
        if bleeding:
            wound_contamination = clamp(
                wound_contamination + max(0.0,float(cloud.get_meta("cloud_contamination_per_sec",4.0))) * step,
                0.0,100.0
            )
        modern_survivor_hit_time = max(modern_survivor_hit_time,min(0.12,modern_survivor_hit_duration))
        if feedback_cd <= 0.0:
            _set_survival_feedback("ОБЛАКО НОСИТЕЛЯ — ОТОЙДИ ОТ ТЕЛА",1.0)
            cloud.set_meta("feedback_cd",0.8)

func _infected_update_special_action(enemy,state:String,sees_player:bool,dist:float,delta:float) -> bool:
    if not is_instance_valid(enemy):
        return false
    var role = str(enemy.get_meta("special_role",""))
    if role == "caller":
        var cd = max(0.0,float(enemy.get_meta("call_cd",0.0)) - delta)
        enemy.set_meta("call_cd",cd)
        var timer = max(0.0,float(enemy.get_meta("call_timer",0.0)))
        if timer > 0.0:
            timer = max(0.0,timer - delta)
            enemy.set_meta("call_timer",timer)
            if timer <= 0.0:
                _infected_finish_call(enemy)
                return false
            return true
        if state == "chase" and sees_player and dist <= max(1.0,float(enemy.get_meta("call_trigger_range",250.0))) and cd <= 0.0:
            enemy.set_meta("call_timer",max(0.20,float(enemy.get_meta("call_windup",0.78))))
            enemy.set_meta("call_interrupted",false)
            return true
        return false
    if role == "spitter":
        var spit_cd = max(0.0,float(enemy.get_meta("spit_cd",0.0)) - delta)
        enemy.set_meta("spit_cd",spit_cd)
        var spit_timer = max(0.0,float(enemy.get_meta("spit_timer",0.0)))
        if spit_timer > 0.0:
            spit_timer = max(0.0,spit_timer - delta)
            enemy.set_meta("spit_timer",spit_timer)
            if spit_timer <= 0.0:
                _infected_finish_spit(enemy)
                return false
            return true
        var min_range = max(1.0,float(enemy.get_meta("spit_min_range",92.0)))
        var max_range = max(min_range,float(enemy.get_meta("spit_max_range",300.0)))
        if state == "chase" and sees_player and dist >= min_range and dist <= max_range and spit_cd <= 0.0 and player != null:
            enemy.set_meta("spit_timer",max(0.20,float(enemy.get_meta("spit_windup",0.72))))
            enemy.set_meta("spit_target",player.global_position)
            enemy.set_meta("spit_interrupted",false)
            enemy.set_meta("spit_last_hit",false)
            return true
    return false

func _enemy_move_toward(enemy,target,speed_value,enemies):
    var desired = target - enemy.global_position
    if desired.length() > 4.0:
        desired = desired.normalized()
    else:
        desired = Vector2.ZERO
        enemy.set_meta("navigation_path",[])

    if desired.length() > 0.01:
        desired = _enemy_navigation_direction(enemy,target,desired)

    var separation = Vector2.ZERO
    for other in enemies:
        if other == enemy or not is_instance_valid(other):
            continue
        var apart = enemy.global_position.distance_to(other.global_position)
        if apart > 0.01 and apart < 30.0:
            separation += (
                (enemy.global_position - other.global_position).normalized()
                * ((30.0 - apart) / 30.0)
            )

    # A strong lateral crowd push can pin a valid route against a door jamb.
    var final_dir = desired + separation * 0.75
    if desired.length() > 0.01 and final_dir.length() > 0.01:
        if not _enemy_navigation_segment_clear(enemy,enemy.global_position,enemy.global_position + final_dir.normalized() * 12.0):
            final_dir = desired
    elif desired.length() <= 0.01:
        final_dir = Vector2.ZERO
    if final_dir.length() > 0.01:
        final_dir = final_dir.normalized()
        enemy.set_meta("ai_facing",final_dir)

    enemy.velocity = final_dir * speed_value
    enemy.move_and_slide()

func _enemy_navigation_segment_clear(enemy,from,to):
    var transform = enemy.global_transform
    transform.origin = from
    return not enemy.test_move(transform,to-from)

func _enemy_navigation_direction(enemy,target,desired):
    var state = str(enemy.get_meta("ai_state","idle"))
    var prior_target = enemy.get_meta("navigation_goal",target)
    var prior_state = str(enemy.get_meta("navigation_state",state))
    var path = enemy.get_meta("navigation_path",[])
    var retry = max(0.0,float(enemy.get_meta("navigation_retry",0.0)) - get_process_delta_time())
    if prior_state != state or prior_target.distance_to(target) > 24.0:
        path = []
        retry = 0.0
    if path.is_empty():
        enemy.set_meta("navigation_goal",target)
    enemy.set_meta("navigation_state",state)
    # Existing breach approach owns a nearby intact defensive point.
    if is_instance_valid(_enemy_active_breach_ahead(enemy,desired,36.0)):
        enemy.set_meta("navigation_path",[])
        return desired
    while not path.is_empty() and enemy.global_position.distance_to(path[0]) < 5.0:
        # Do not cut a corner by accepting a waypoint early: the body must already
        # have clearance to the next segment before advancing the route.
        if path.size() > 1 and not _enemy_navigation_segment_clear(enemy,enemy.global_position,path[1]):
            break
        path.pop_front()
    if not path.is_empty():
        if _enemy_navigation_segment_clear(enemy,enemy.global_position,path[0]):
            enemy.set_meta("navigation_path",path)
            enemy.set_meta("navigation_retry",retry)
            return (path[0]-enemy.global_position).normalized()
        path = [] # A newly closed door or rebuilt barrier invalidates this segment.
    if _enemy_navigation_segment_clear(enemy,enemy.global_position,enemy.global_position + desired * 30.0):
        enemy.set_meta("navigation_path",[])
        enemy.set_meta("navigation_retry",retry)
        return desired
    var frame = Engine.get_process_frames()
    if retry <= 0.0 and navigation_plan_frame != frame:
        navigation_plan_frame = frame # At most one bounded search for the whole crowd per frame.
        var result = LocalNavigation.plan(enemy.global_position,target,func(from,to): return _enemy_navigation_segment_clear(enemy,from,to))
        path = result["path"]
        enemy.set_meta("navigation_expanded",result["expanded"])
        retry = 0.65
    enemy.set_meta("navigation_path",path)
    enemy.set_meta("navigation_retry",retry)
    if not path.is_empty():
        return (path[0]-enemy.global_position).normalized()
    return _enemy_local_steer(enemy,desired)


func _enemy_ray_clearance(enemy,direction,distance_value):
    if not is_instance_valid(enemy):
        return 0.0
    var dir = direction.normalized() if direction.length() > 0.001 else Vector2.RIGHT
    var distance = max(0.0,float(distance_value))
    var start = enemy.global_position
    var query = PhysicsRayQueryParameters2D.create(start,start + dir * distance)
    query.collision_mask = LAYER_WORLD
    query.exclude = [enemy.get_rid()]
    var hit = get_world_2d().direct_space_state.intersect_ray(query)
    if hit.is_empty():
        return distance
    var breach_node = _collider_breach_node(hit.get("collider",null))
    if is_instance_valid(breach_node) and _breach_node_active(breach_node):
        # Do not make local avoidance fight the existing door/window/barricade AI.
        return distance
    var hit_position = hit.get("position",start)
    if typeof(hit_position) != TYPE_VECTOR2:
        return 0.0
    return clamp(start.distance_to(hit_position),0.0,distance)

func _enemy_active_breach_ahead(enemy,direction,distance_value = 30.0):
    if not is_instance_valid(enemy) or direction.length() <= 0.001:
        return null
    var dir = direction.normalized()
    var start = enemy.global_position
    var query = PhysicsRayQueryParameters2D.create(start,start + dir * max(0.0,float(distance_value)))
    query.collision_mask = LAYER_WORLD
    query.exclude = [enemy.get_rid()]
    var hit = get_world_2d().direct_space_state.intersect_ray(query)
    if hit.is_empty():
        return null
    var breach_node = _collider_breach_node(hit.get("collider",null))
    return breach_node if is_instance_valid(breach_node) and _breach_node_active(breach_node) else null

func _enemy_local_steer(enemy,desired_direction):
    if not is_instance_valid(enemy) or desired_direction.length() <= 0.001:
        return Vector2.ZERO
    var desired = desired_direction.normalized()
    if is_instance_valid(_enemy_active_breach_ahead(enemy,desired,30.0)):
        enemy.set_meta("avoid_side",0)
        return desired
    var forward_clear = _enemy_ray_clearance(enemy,desired,30.0)
    var body_blocked = enemy.test_move(enemy.global_transform,desired * 10.0)
    if forward_clear >= 24.0 and not body_blocked:
        enemy.set_meta("avoid_side",0)
        return desired

    # Local steering only: the existing chase/investigate/search state still owns
    # the destination. We merely choose which side of a nearby solid obstacle to
    # slide around, preventing infected from walking forever into a blank wall.
    var left = desired.rotated(-1.18)
    var right = desired.rotated(1.18)
    var left_clear = _enemy_ray_clearance(enemy,left,40.0)
    var right_clear = _enemy_ray_clearance(enemy,right,40.0)
    var sid = int(enemy.get_meta("spawn_id",0))
    var avoid_side = int(enemy.get_meta("avoid_side",0))
    if avoid_side == 0:
        if right_clear > left_clear + 1.0:
            avoid_side = 1
        elif left_clear > right_clear + 1.0:
            avoid_side = -1
        else:
            avoid_side = 1 if posmod(sid,2) == 1 else -1
    else:
        var chosen_clear = right_clear if avoid_side > 0 else left_clear
        var other_clear = left_clear if avoid_side > 0 else right_clear
        # Only change side when the retained lane is genuinely trapped. Small
        # frame-to-frame clearance changes must not make an infected oscillate.
        if chosen_clear < 7.0 and other_clear > chosen_clear + 12.0:
            avoid_side *= -1
    enemy.set_meta("avoid_side",avoid_side)
    var steer = right if avoid_side > 0 else left
    return (desired * 0.06 + steer * 0.94).normalized()

func _enemy_search_target(enemy):
    var anchor = enemy.get_meta("search_anchor",enemy.global_position)
    if typeof(anchor) != TYPE_VECTOR2:
        anchor = enemy.global_position

    var phase = int(enemy.get_meta("search_phase",0))
    var sid = int(enemy.get_meta("spawn_id",0))
    var angle = float(phase * 2 + sid % 5) * 1.37
    var radius = 18.0 + float((phase % 3) * 14)

    return anchor + Vector2(cos(angle),sin(angle)) * radius

