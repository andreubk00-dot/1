    var test_chunk = Node2D.new()
    test_chunk.position = Vector2(-10000,-10000)
    add_child(test_chunk)

    var test_building_guard = Node2D.new()
    test_building_guard.position = Vector2(120,120)
    test_building_guard.set_meta("world_building",true)
    test_building_guard.set_meta("building_size",Vector2(120,90))
    test_chunk.add_child(test_building_guard)
    _record_test(_tree_overlaps_building(test_chunk,Vector2(120,120)),"0.84 tree exclusion не видит footprint здания")
    _record_test(not _tree_overlaps_building(test_chunk,Vector2(320,120)),"0.84 tree exclusion блокирует слишком далёкую точку")

    var test_door = _create_door(test_chunk,Vector2i(9999,9999),Vector2.ZERO,"selftest")
    var body = test_door.get_meta("door_body",null)
    _record_test(test_door.get_meta("door_hinge_offset",Vector2.ZERO) == Vector2(-19,0),"0.84 pivot двери не привязан к петле")

    _apply_door_state(test_door,true,true)
    _record_test(
        is_instance_valid(body) and body.collision_layer == 0,
        "Открытая дверь всё ещё имеет world collision"
    )

    _apply_door_state(test_door,false,true)
