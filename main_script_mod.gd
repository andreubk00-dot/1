func _decorate_high_risk_ground_identity(chunk,poi_id:String,cell_offset:Vector2i) -> void:
    if not HighRiskFloorCatalog.has_poi(poi_id):
        return
    var key = "%d,%d" % [cell_offset.x,cell_offset.y]
    # Curbs + service pavement stop high-risk sites reading as empty grey squares.
    _rect(Vector2(384,744),Vector2(720,18),Color(0.31,0.31,0.28,0.58),chunk).z_index = -6
    _rect(Vector2(384,730),Vector2(720,5),Color(0.10,0.11,0.10,0.50),chunk).z_index = -5
    for x in range(76,708,84):
        _rect(Vector2(x,686),Vector2(42,3),Color(0.72,0.66,0.43,0.24),chunk).z_index = -4
    for x in range(98,690,118):
        _ellipse(Vector2(x,706),18,4,Color(0.055,0.06,0.05,0.22),chunk).z_index = -4

    # Every authored high-risk cell gets real circulation language: worn lanes,
    # parking/service bays, crosswalks and patched asphalt. This prevents the
    # large compounds from reading as featureless grey squares between buildings.
    var ground_seed = abs(int(hash(poi_id + ":" + key + ":ground"))) + 1
    var ground_rng = RandomNumberGenerator.new()
    ground_rng.seed = ground_seed
    var route_y = 438.0 + float((cell_offset.x * 17 + cell_offset.y * 11) % 3) * 18.0
    for x in range(80,720,92):
        var dash = _rect(Vector2(float(x),route_y),Vector2(44,3),Color(0.76,0.74,0.61,0.17),chunk)
        dash.z_index = -4
    for x in range(104,704,74):
        var bay = _rect(Vector2(float(x),614),Vector2(2,70),Color(0.78,0.78,0.70,0.13),chunk)
        bay.z_index = -4
    for i in range(12):
        var px = ground_rng.randf_range(72.0,696.0)
        var py = ground_rng.randf_range(350.0,704.0)
        var stain = _ellipse(Vector2(px,py),ground_rng.randf_range(8.0,24.0),ground_rng.randf_range(2.0,6.0),Color(0.045,0.05,0.045,ground_rng.randf_range(0.12,0.26)),chunk)
        stain.z_index = -3
    if (cell_offset.x + cell_offset.y) % 2 == 0:
        for stripe in range(7):
            var cross = _rect(Vector2(350.0 + float(stripe)*11.0,500),Vector2(7,54),Color(0.74,0.74,0.68,0.15),chunk)
            cross.z_index = -3

    # Small authored road-edge details make the compound approach feel occupied
    # without turning the playable lanes into collision clutter. They are purely
    # visual and deterministic, so layout/navigation contracts stay unchanged.
    var road_detail_sets = [
        ["puddle",Vector2(124,706),0.54],
        ["newspapers_wide",Vector2(642,699),0.46],
        ["trash_bin",Vector2(84,650),0.44],
        ["cardboard_boxes",Vector2(690,646),0.43]
    ]
    var detail_shift = Vector2(float((cell_offset.x*29 + cell_offset.y*17) % 31),float((cell_offset.x*13 + cell_offset.y*23) % 17))
    for rec in road_detail_sets:
        _world_prop_sprite(str(rec[0]),chunk,rec[1] + detail_shift,2,float(rec[2]))
    if key in ["0,0","2,0","0,2"]:
