func _weapon_condition_value(id,instance_id = ""):
    var state = _weapon_instance_state(id,instance_id,false)
    if state.is_empty():
        return clamp(float(weapon_condition.get(id,100.0)),0.0,100.0)
    return clamp(float(state.get("condition",100.0)),0.0,100.0)

func _damage_weapon_condition(id,weapon,instance_id = ""):
    var iid = _resolve_weapon_instance(id,instance_id)
    if iid == "":
        return
    var state = _weapon_instance_state(id,iid,true)
    var wear = float(weapon.get("wear",0.08))
    state["condition"] = max(0.0,float(state.get("condition",100.0)) - wear)
    weapon_instance_states[iid] = state
    _sync_legacy_weapon_projection_for_type(id)

func _repair_current_weapon():
    # Legacy helper retained so old calls/saves do not break.
    # Repairs are intentionally restricted to the workbench in 0.14+.
    return false


func _melee_point_in_arc(origin,facing,target,range_value,arc_value):
    var offset = target - origin
    if offset.length() > range_value or offset.length() <= 0.001:
        return false

    var direction = offset.normalized()
    return abs(facing.angle_to(direction)) <= arc_value * 0.5

func _melee_line_clear(target_position):
    var query = PhysicsRayQueryParameters2D.create(player.global_position,target_position)
    query.collision_mask = LAYER_WORLD
    query.exclude = [player.get_rid()]
    return get_world_2d().direct_space_state.intersect_ray(query).is_empty()

func _clamped_player_forward_point(direction,distance_value,clearance = 2.0):
    if not is_instance_valid(player):
        return Vector2.ZERO
    var dir = direction
    if typeof(dir) != TYPE_VECTOR2 or dir.length() <= 0.001:
        dir = Vector2.RIGHT
    else:
        dir = dir.normalized()
    var travel = max(0.0,float(distance_value))
    if travel <= 0.01:
        return player.global_position
    var start = player.global_position
    var target = start + dir * travel
    var query = PhysicsRayQueryParameters2D.create(start,target)
    query.collision_mask = LAYER_WORLD
    query.exclude = [player.get_rid()]
    var hit = get_world_2d().direct_space_state.intersect_ray(query)
    if hit.is_empty():
        return target
    var hit_position = hit.get("position",start)
    if typeof(hit_position) != TYPE_VECTOR2:
        return start
    var safe_distance = max(0.0,start.distance_to(hit_position) - max(0.0,float(clearance)))
    return start + dir * min(travel,safe_distance)

func _apply_enemy_impulse(enemy,direction,force_value,stagger_time):
    if not is_instance_valid(enemy):
        return

    var dir = direction
    if dir.length() <= 0.001:
        dir = aim_direction
    else:
        dir = dir.normalized()

    var knockback_mult = clamp(float(enemy.get_meta("knockback_mult",1.0)),0.35,1.25)
    var stagger_mult = clamp(float(enemy.get_meta("stagger_mult",1.0)),0.35,1.25)
    enemy.set_meta("knockback_velocity",dir * force_value * knockback_mult)
    enemy.set_meta("stagger",max(float(enemy.get_meta("stagger",0.0)),stagger_time * stagger_mult))
    if force_value > 0.0 or stagger_time > 0.0:
        _infected_interrupt_special(enemy)
    enemy.set_meta("alert",max(float(enemy.get_meta("alert",0.0)),5.5))
    enemy.set_meta("last_known_position",player.global_position)
    enemy.set_meta("suspicion",100.0)
    enemy.set_meta("lost_sight_time",0.0)
    _enemy_set_state(enemy,"chase",4.5)

func _perform_melee_attack():
    if inventory_open or reload_time > 0.0 or melee_cooldown > 0.0:
        return
    if equipped_melee_id == "" or not melee_defs.has(equipped_melee_id) or not _inventory_has_item(equipped_melee_id):
        return

    var melee = melee_defs[equipped_melee_id]
    var stamina_cost = float(melee.get("stamina",10.0))
    if stamina < stamina_cost:
        return

    stamina = max(0.0,stamina - stamina_cost)
    melee_swing_duration = float(melee.get("swing_anim",0.55))
    melee_cooldown = max(float(melee.get("interval",0.5)),melee_swing_duration)
    melee_swing_time = melee_swing_duration

    var range_value = float(melee.get("range",38.0))
    var arc_value = float(melee.get("arc",0.8))
    var max_targets = int(melee.get("max_targets",1))
    var damage = float(melee.get("damage",30.0))
    var knockback = float(melee.get("knockback",70.0))
    var stagger_time = float(melee.get("stagger",0.35))
    var hit_count = 0

    for enemy in get_tree().get_nodes_in_group("infected"):
        if hit_count >= max_targets:
            break
        if not is_instance_valid(enemy):
            continue
        if not _melee_point_in_arc(player.global_position,aim_direction,enemy.global_position,range_value,arc_value):
            continue
        if not _melee_line_clear(enemy.global_position):
            continue

        var push_dir = enemy.global_position - player.global_position
        _apply_enemy_impulse(enemy,push_dir,knockback,stagger_time)
        _damage_enemy(enemy,damage)
        hit_count += 1
    _emit_ai_sound(player.global_position,float(melee.get("noise",65.0)),"melee",1.0)

func _perform_shove():
    if inventory_open or shove_cooldown > 0.0:
        return

    var stamina_cost = 12.0
    if stamina < stamina_cost:
        return

    stamina = max(0.0,stamina - stamina_cost)
    shove_cooldown = 0.82

    var affected = 0
    for enemy in get_tree().get_nodes_in_group("infected"):
        if affected >= 3:
            break
        if not is_instance_valid(enemy):
            continue
        if not _melee_point_in_arc(player.global_position,aim_direction,enemy.global_position,34.0,1.20):
            continue
        if not _melee_line_clear(enemy.global_position):
            continue

        var push_dir = enemy.global_position - player.global_position
        _apply_enemy_impulse(enemy,push_dir,165.0,0.82)
        affected += 1

    _alert_enemies(player.global_position,55.0)


func _primary_attack():
    if equipped_melee_id != "":
        _perform_melee_attack()
        return

    if reload_time > 0.0:
        if reload_shellwise and _weapon_mag_value(reload_weapon_id,reload_weapon_instance_id) > 0:
            _cancel_reload()
        else:
            return

    _fire_weapon()

func _switch_melee(id):
    if not melee_defs.has(id):
        return
    if not _inventory_has_item(id):
        return

    _cancel_reload()
    _cancel_weapon_cycle()
    equipped_melee_id = id
    weapon_recoil_time = 0.0
    _update_weapon_visual()

func _fire_weapon():
    if inventory_open or reload_time > 0.0 or fire_cooldown > 0.0:
        return
    _ensure_weapon_runtime_state(false)
    var iid = _find_inventory_weapon_instance(current_weapon_id,current_weapon_instance_id)
    if not weapon_defs.has(current_weapon_id) or iid == "":
        return
    current_weapon_instance_id = iid
    var mag_now = _weapon_mag_value(current_weapon_id,iid)
    if mag_now <= 0:
        _play_dry_fire_audio()
        fire_cooldown = 0.18
        return

    var weapon = weapon_defs[current_weapon_id]
    _set_weapon_mag_value(current_weapon_id,mag_now - 1,iid)
    fire_cooldown = float(weapon.get("interval",0.25))
    weapon_recoil_duration = float(weapon.get("recoil",0.10))
    weapon_recoil_time = weapon_recoil_duration
    _damage_weapon_condition(current_weapon_id,weapon,iid)
    _schedule_weapon_cycle(current_weapon_id,weapon)

    var origin = _clamped_player_forward_point(aim_direction,26.0,1.5)
    var range_value = float(weapon.get("range", 500.0))
    var damage = float(weapon.get("damage", 30.0))
    var shot_dirs = _weapon_shot_directions(weapon, aim_direction)
    var first_end = origin + aim_direction * range_value
    var hit_enemy = false
    var impact_hits = {}

    for i in range(shot_dirs.size()):
        var shot_dir = shot_dirs[i]
        var end = origin + shot_dir * range_value
        var query = PhysicsRayQueryParameters2D.create(origin, end)
        query.collision_mask = LAYER_ENEMY | LAYER_WORLD
        query.exclude = [player.get_rid()]
        var hit = get_world_2d().direct_space_state.intersect_ray(query)
        if not hit.is_empty():
            end = hit.position
            var collider = hit.collider
            if collider != null and collider.has_meta("is_enemy"):
                hit_enemy = true
                var enemy_iid = collider.get_instance_id()
                if not impact_hits.has(enemy_iid):
                    impact_hits[enemy_iid] = {"enemy":collider,"hits":0,"dir":shot_dir}
                impact_hits[enemy_iid]["hits"] = int(impact_hits[enemy_iid].get("hits",0)) + 1
                impact_hits[enemy_iid]["dir"] = shot_dir
                _damage_enemy(collider, damage)
        if i == int(shot_dirs.size() / 2):
            first_end = end
        if shot_dirs.size() > 1:
            _spawn_temp_tracer(origin,end,0.075)

    for impact_rec in impact_hits.values():
        var impact_enemy = impact_rec.get("enemy",null)
        if is_instance_valid(impact_enemy):
            _firearm_hit_response(weapon,impact_enemy,impact_rec.get("dir",aim_direction),int(impact_rec.get("hits",1)))

    if shot_dirs.size() == 1:
        tracer.clear_points()
        tracer.add_point(origin)
        tracer.add_point(first_end)
        tracer.visible = true
        tracer_time = 0.065
    var noise_radius = float(weapon.get("noise", 500.0))
    noise_radius *= _weapon_mod_multiplier(current_weapon_id,"noise_mult",iid)
    _emit_ai_sound(origin,noise_radius,"gunshot",_weapon_sound_signature(weapon))
    _play_weapon_shot_audio(current_weapon_id,weapon,iid)
    _apply_weapon_fire_fx(weapon)
    muzzle_flash.visible = true
    muzzle_time = 0.055

func _create_weapon_audio_layer():
    if not weapon_audio_players.is_empty():
        return
    # Six voices preserve the tail of fast automatic fire instead of restarting one sample.
    for _i in range(6):
        var player_node = AudioStreamPlayer.new()
        player_node.volume_db = -8.0
        add_child(player_node)
        weapon_audio_players.append(player_node)
    reload_audio_player = AudioStreamPlayer.new()
    reload_audio_player.volume_db = -11.0
    add_child(reload_audio_player)
    cycle_audio_player = AudioStreamPlayer.new()
    cycle_audio_player.volume_db = -12.0
    add_child(cycle_audio_player)

func _weapon_shot_audio_path(weapon_id,instance_id = ""):
    if str(weapon_id) == "makarov":
        var mods = _weapon_mod_state("makarov",instance_id)
        if str(mods.get("muzzle","")) == "suppressor":
            return "res://audio/weapons/makarov_suppressed_shot.wav"
    return "res://audio/weapons/%s_shot.wav" % str(weapon_id)

func _weapon_reload_audio_path(weapon_id):
    if not weapon_defs.has(weapon_id):
        return ""
    var profile = str(weapon_defs[weapon_id].get("reload_audio","rifle"))
    if profile not in ["pistol","rifle","smg","shell","bolt"]:
        profile = "rifle"
    return "res://audio/weapons/%s_reload.wav" % profile

func _weapon_cycle_audio_path(profile):
    var cycle_profile = str(profile)
    if cycle_profile not in ["pump","bolt"]:
        return ""
    return "res://audio/weapons/%s_cycle.wav" % cycle_profile

func _cached_weapon_audio(path):
    var key = str(path)
    if key == "":
        return null
    if weapon_audio_cache.has(key):
        return weapon_audio_cache[key]
    if not ResourceLoader.exists(key):
        weapon_audio_cache[key] = null
        return null
    var stream = load(key)
    weapon_audio_cache[key] = stream
    return stream

func _play_weapon_shot_audio(weapon_id,weapon = {},instance_id = ""):
    if weapon_audio_players.is_empty():
        _create_weapon_audio_layer()
    if weapon_audio_players.is_empty():
        return
    var stream = _cached_weapon_audio(_weapon_shot_audio_path(weapon_id,instance_id))
    if stream == null:
        return
    var voice = weapon_audio_players[weapon_audio_cursor % weapon_audio_players.size()]
    weapon_audio_cursor = (weapon_audio_cursor + 1) % weapon_audio_players.size()
    voice.stream = stream
    var audible_db = float(weapon.get("shot_volume_db",-8.0))
    if str(weapon_id) == "makarov" and str(_weapon_mod_state("makarov",instance_id).get("muzzle","")) == "suppressor":
        audible_db -= 7.0
    voice.volume_db = audible_db
    voice.pitch_scale = randf_range(0.985,1.015)
    voice.play()

func _play_weapon_reload_audio(weapon_id):
    if reload_audio_player == null:
        _create_weapon_audio_layer()
    if reload_audio_player == null:
        return
    var stream = _cached_weapon_audio(_weapon_reload_audio_path(weapon_id))
    if stream == null:
        return
    reload_audio_player.stream = stream
    reload_audio_player.volume_db = -11.0
    reload_audio_player.pitch_scale = randf_range(0.985,1.015)
    reload_audio_player.play()

func _play_weapon_cycle_audio(profile):
    if cycle_audio_player == null:
        _create_weapon_audio_layer()
    if cycle_audio_player == null:
        return
    var stream = _cached_weapon_audio(_weapon_cycle_audio_path(profile))
    if stream == null:
        return
    cycle_audio_player.stream = stream
    cycle_audio_player.volume_db = -12.0 if str(profile) == "pump" else -11.0
    cycle_audio_player.pitch_scale = randf_range(0.985,1.015)
    cycle_audio_player.play()

func _play_dry_fire_audio():
    if reload_audio_player == null:
        _create_weapon_audio_layer()
    if reload_audio_player == null:
        return
    var stream = _cached_weapon_audio("res://audio/weapons/dry_fire.wav")
    if stream == null:
        return
    reload_audio_player.stream = stream
    reload_audio_player.volume_db = -14.0
    reload_audio_player.pitch_scale = randf_range(0.98,1.02)
    reload_audio_player.play()

func _weapon_sound_signature(weapon):
    # Gameplay sound signature used by AI hearing. Audible asset finalization lives in 1.29,
    # but every firearm already has its own authored profile/cost here.
    match str(weapon.get("sound_profile","generic")):
        "pistol_compact": return 0.88
        "pistol_sharp": return 0.96
        "smg_metal": return 0.92
        "shotgun_pump": return 1.08
        "shotgun_break": return 1.12
        "rifle_semi": return 1.04
        "carbine_sharp": return 1.02
        "rifle_bolt": return 1.16
        "rifle_heavy": return 1.12
    return 1.0

func _apply_weapon_fire_fx(weapon):
