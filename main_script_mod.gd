func _decorate_roof_art(roof,sign_text,size,building_id):
    if roof == null:
        return
    var s = str(sign_text).to_upper()
    var seed_value = abs(hash(str(building_id))) + 8011
    var rng = RandomNumberGenerator.new()
    rng.seed = seed_value
    var main_scale = clamp(min(size.x / 190.0,size.y / 130.0),0.58,0.92)
    _roof_prop_sprite(roof,0,Vector2(size.x*0.18,-size.y*0.06),main_scale,2)
    if s.find("ЦЕХ") >= 0 or s.find("СКЛАД") >= 0 or s.find("ГАРАЖ") >= 0 or s.find("СЕРВИС") >= 0:
        _roof_prop_sprite(roof,1,Vector2(-size.x*0.22,-size.y*0.03),main_scale*0.78,2)
        _roof_prop_sprite(roof,2,Vector2(size.x*0.36,size.y*0.02),main_scale*0.64,2)
    elif s.find("АПТЕК") >= 0 or s.find("БОЛЬ") >= 0:
        _roof_prop_sprite(roof,1,Vector2(-size.x*0.28,-size.y*0.08),main_scale*0.72,2)
    elif rng.randf() > 0.45:
        _roof_prop_sprite(roof,3,Vector2(-size.x*0.20,size.y*0.02),main_scale*0.66,2)

func _interior_tile_region(sign_text):
    var s = str(sign_text).to_upper()
    if s.find("АПТЕК") >= 0 or s.find("БОЛЬНИЦ") >= 0 or s.find("ЛЕЧЕБН") >= 0:
        return Rect2(128,0,128,128)
    if s.find("ПРОДУК") >= 0 or s.find("МАГАЗ") >= 0 or s.find("КАФЕ") >= 0:
        return Rect2(128,128,128,128)
    if s.find("ЖИЛ") >= 0 or s.find("ДОМ") >= 0 or s.find("ДАЧ") >= 0:
        return Rect2(0,128,128,128)
    return Rect2(0,0,128,128)

func _interior_floor_row(sign_text):
    # 0.92: floor material follows the same building class as the facade.
    # 0 clinic ceramic, 1 retail linoleum, 2 concrete (garage/industry/military), 3 parquet.
    match _exterior_style_index(sign_text):
        1:
            return 0
        2:
            return 1
        3, 4, 5:
            return 2
    return 3

