func _hover_wrapped_line_count(text,width):
    if hover_body == null:
        return max(1,str(text).split("\n").size())
    var font = hover_body.get_theme_font("font")
    var font_size = hover_body.get_theme_font_size("font_size")
    var available = max(1.0,float(width))
    var count = 0
    for raw_line in str(text).split("\n"):
        var line_text = str(raw_line)
        if line_text == "":
            count += 1
            continue
        var text_width = float(line_text.length()) * float(font_size) * 0.56
        if font != null:
            text_width = font.get_string_size(line_text,HORIZONTAL_ALIGNMENT_LEFT,-1,font_size).x
        # Word wrapping can use an extra line compared with the raw width ratio,
        # so round upward and keep a small safety margin for long localized labels.
        count += max(1,int(ceil(text_width / available)))
    return max(1,count)

func _layout_hover_inspector(body_text):
    if hover_panel == null or hover_body == null or hover_footer == null:
        return
    var wrapped_lines = _hover_wrapped_line_count(body_text,hover_body.size.x)
    var line_height = 11.0
    # Keep a generous base height: localized gear stat lines can
    # wrap at word boundaries more than a raw width estimate predicts.
    var body_height = max(154.0,float(wrapped_lines + 3) * line_height)
    var viewport_height = max(240.0,get_viewport_rect().size.y)
    var max_body_height = max(154.0,viewport_height - 95.0)
    var content_min_height = hover_body.get_combined_minimum_size().y
    body_height = max(body_height,content_min_height + 4.0)
    body_height = min(body_height,max_body_height)
    hover_body.size.y = body_height
    hover_footer.position.y = hover_body.position.y + max(body_height,hover_body.size.y) + 5.0
    hover_panel.size.y = hover_footer.position.y + hover_footer.size.y + 9.0

func _hover_show_item(id,qty=1,context="storage",instance_id=""):
    if hover_panel == null or not item_defs.has(id):
        return

    hover_item_id = id
    hover_qty = qty
    hover_context = context

    var item = item_defs[id]
    hover_icon.texture = _make_item_icon(id)
    hover_title.text = str(item.get("name",id))
    hover_title.modulate = _item_rarity_color(id)

    var lines = []
    lines.append("Доступность: %s" % _item_rarity_label(id))
    var category = str(item.get("category",""))
    var category_names = {
        "weapon":"ОРУЖИЕ",
        "melee":"БЛИЖНИЙ БОЙ",
        "ammo":"БОЕПРИПАСЫ",
        "medical":"МЕДИЦИНА",
        "food":"ЕДА / ВОДА",
        "gear":"ЭКИПИРОВКА",
        "material":"МАТЕРИАЛ",
        "tool":"ИНСТРУМЕНТ",
        "mod":"МОДИФИКАЦИЯ"
    }

    lines.append(str(category_names.get(category,category.to_upper())))
    var hover_weight = float(item.get("weight",0.0)) * qty
    if _is_water_container_item(id):
        hover_weight += _water_container_fill_l(id,instance_id)
    lines.append("Вес: %.2f кг" % hover_weight)

    if qty > 1:
        lines.append("Количество: %d / %d" % [qty,int(item.get("stack",1))])

    if _is_water_container_item(id):
        var vessel_capacity = _water_container_capacity_l(id)
        var vessel_fill = _water_container_fill_l(id,instance_id)
        lines.append("Вода: %.2f / %.2f л" % [vessel_fill,vessel_capacity])
        lines.append("ИСП.: пить • R в инвентаре: перелить 0.5 л")
    elif category == "weapon":
        var iid = _resolve_weapon_instance(id,instance_id)
        lines.append("Состояние: %d%% [%s]" % [int(_weapon_condition_value(id,iid)),_weapon_condition_state(id,iid)])
        if weapon_defs.has(id):
            var w = weapon_defs[id]
            lines.append("Урон: %d   Магазин: %d/%d" % [int(w.get("damage",0)),_weapon_mag_value(id,iid),_weapon_mag_capacity(id,iid)])
            lines.append("Остановка: %s" % _weapon_stopping_label(w))
            lines.append("Моды: %s" % _weapon_mod_summary(id,iid))
        lines.append("ПКМ: открыть управление этим экземпляром")
    elif category == "melee":
        if melee_defs.has(id):
            var melee = melee_defs[id]
            lines.append("Урон: %d   Дистанция: %d" % [int(melee.get("damage",0)),int(melee.get("range",0))])
            lines.append("Выносливость за удар: %d   Целей: %d" % [int(melee.get("stamina",0)),int(melee.get("max_targets",1))])
        lines.append("ИСП.: взять в руки | V: толчок")
    elif category == "gear":
        lines.append("Слой: %s" % _slot_name(str(item.get("slot",""))))
        var armor = int(float(item.get("armor",0.0)) * 100.0)
        if armor > 0:
            var slot = str(item.get("slot",""))
            if slot == "head":
                lines.append("Защита головы: %d%%" % int(float(item.get("armor_head",item.get("armor",0.0))) * 100.0))
            elif slot == "body":
                lines.append("Защита корпуса: %d%%" % int(float(item.get("armor_torso",item.get("armor",0.0))) * 100.0))
                var arm_armor = int(float(item.get("armor_arms",0.0)) * 100.0)
                if arm_armor > 0:
                    lines.append("Защита рук: %d%%" % arm_armor)
            else:
                lines.append("Защита: %d%%" % armor)
        var bleed = int(float(item.get("bleed_resist",0.0)) * 100.0)
        if bleed > 0:
            lines.append("Защита от кровотечения: %d%%" % bleed)
        var carry = float(item.get("carry_bonus",0.0))
        if carry > 0.0:
            lines.append("Грузоподъёмность: +%.0f кг" % carry)
        var warmth = float(item.get("warmth",0.0))
        if warmth > 0.0:
            lines.append("Тепло: +%.1f" % warmth)
        var rain = int(float(item.get("rain_protect",0.0)) * 100.0)
        if rain > 0:
            lines.append("Защита от дождя: %d%%" % rain)
        var move_mult = float(item.get("move_mult",1.0))
        if move_mult < 0.999:
            lines.append("Подвижность: -%d%%" % int(round((1.0 - move_mult) * 100.0)))
        var quick_pockets = int(item.get("quick_pockets",0))
        if quick_pockets > 0:
            lines.append("Быстрые карманы: %d • клавиши 7–8" % quick_pockets)
            lines.append("Доступ к боеприпасам: +%d%%" % int(round((1.0 - float(item.get("reload_mult",1.0))) * 100.0)))
        if id == "flashlight":
            lines.append("Заряд: %d%%" % int(flashlight_battery))
    elif category == "mod":
        lines.append("Слот: %s" % ("МАГАЗИН" if str(item.get("mod_slot","")) == "magazine" else "СТВОЛ"))
        var mag_bonus = int(item.get("mag_bonus",0))
        if mag_bonus > 0:
            lines.append("Ёмкость: +%d патр." % mag_bonus)
        var sm = float(item.get("spread_mult",1.0))
        if sm < 0.999:
            lines.append("Точность: +%d%%" % int((1.0 - sm) * 100.0))
        elif sm > 1.001:
            lines.append("Точность: -%d%%" % int((sm - 1.0) * 100.0))
        var nm = float(item.get("noise_mult",1.0))
        if nm < 0.999:
            lines.append("Шум выстрела: -%d%%" % int((1.0 - nm) * 100.0))
        elif nm > 1.001:
            lines.append("Шум выстрела: +%d%%" % int((nm - 1.0) * 100.0))
    elif id == "repair_kit":
        lines.append("Используется у верстака → ОРУЖЕЙНИК")

    if context == "equipment":
        hover_footer.text = "НАДЕТО НА ПЕРСОНАЖЕ"
    elif context == "container":
        hover_footer.text = "ЛЕЖИТ В КОНТЕЙНЕРЕ"
    else:
        hover_footer.text = "В РЮКЗАКЕ"

    var body_text = "\n".join(lines)
    hover_body.text = body_text
    _layout_hover_inspector(body_text)
    hover_panel.visible = true
    _update_hover_position()

func _hover_hide_item():
    hover_item_id = ""
    if hover_panel != null:
        hover_panel.visible = false

func _update_hover_position():
    if hover_panel == null or not hover_panel.visible:
        return

    var mouse = get_viewport().get_mouse_position()
    var viewport_size = get_viewport_rect().size
    var pos = mouse + Vector2(16,16)

    if pos.x + hover_panel.size.x > viewport_size.x - 6:
        pos.x = mouse.x - hover_panel.size.x - 16
    if pos.y + hover_panel.size.y > viewport_size.y - 6:
        pos.y = mouse.y - hover_panel.size.y - 16

    pos.x = clamp(pos.x,6.0,max(6.0,viewport_size.x - hover_panel.size.x - 6.0))
    pos.y = clamp(pos.y,6.0,max(6.0,viewport_size.y - hover_panel.size.y - 6.0))
    hover_panel.position = pos



