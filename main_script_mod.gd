func _apply_authored_building_metadata(building_node,profile,archetype_id,archetype_data,loot_table,poi_role,cell_offset):
    if not is_instance_valid(building_node):
        return
    building_node.set_meta("world_archetype",archetype_id)
    building_node.set_meta("layout_profile",str(archetype_data.get("layout","utility")))
    building_node.set_meta("facade_profile",str(archetype_data.get("facade","utility")))
    building_node.set_meta("yard_profile",str(archetype_data.get("yard","")))
    var gameplay_profile = BuildingCatalog.gameplay_profile(archetype_id)
    building_node.set_meta("location_tags",gameplay_profile.get("tags",[]))
    building_node.set_meta("utility_hooks",gameplay_profile.get("utility_hooks",[]))
    building_node.set_meta("shelter_score",int(gameplay_profile.get("shelter_score",1)))
    building_node.set_meta("district_id",str(profile.get("district_id","")))
    building_node.set_meta("poi_id",str(profile.get("poi_id","")))
    building_node.set_meta("poi_role",poi_role)
    building_node.set_meta("poi_cell_offset",cell_offset)
    building_node.set_meta("loot_profile",loot_table)

func _faction_npc_color(faction_id:String) -> Color:
    match faction_id:
        "perron": return Color("8b7651")
        "rubezh": return Color("59634f")
        "mechanics": return Color("76644b")
        "lazaret": return Color("667a70")
    return Color("6b6b63")

func _create_faction_npc(chunk,record:Dictionary):
    var npc_id = str(record.get("npc_id",""))
    if npc_id == "":
        return null
    var node = Node2D.new()
    node.name = "FactionNPC_%s" % npc_id
    node.position = record.get("pos",Vector2(384,384))
    # 1.22-dev4: settlement NPCs stand on streets in front of the facades; keep
    # them above set pieces and building shadows, just below the player.
    node.z_index = 19
    node.z_as_relative = false
    node.set_meta("npc_id",npc_id)
    node.set_meta("faction_id",str(record.get("faction_id","")))
    node.set_meta("display_name",str(record.get("name",npc_id)))
    node.set_meta("npc_role",str(record.get("role","житель поселения")))
    node.set_meta("interaction_radius",76.0)
    var trader_id = TraderCatalog.trader_for_npc(npc_id)
    var contract_board = ContractCatalog.board_for_npc(npc_id)
    if trader_id != "":
        node.set_meta("interaction_type","trader")
        node.set_meta("trader_id",trader_id)
    elif not contract_board.is_empty():
        node.set_meta("interaction_type","contract_board")
        node.set_meta("contract_board_label",str(contract_board.get("label","КОНТРАКТЫ")))
    else:
        node.set_meta("interaction_type","faction_npc")
    node.add_to_group("interactable")
    node.add_to_group("faction_npcs")
    chunk.add_child(node)

    var faction_color = _faction_npc_color(str(record.get("faction_id","")))
    _ellipse(Vector2(0,4),11.0,4.0,Color(0.01,0.012,0.012,0.34),node)
    _rect(Vector2(0,-11),Vector2(13,22),faction_color,node)
    _rect(Vector2(-5,-1),Vector2(5,13),faction_color.darkened(0.18),node)
    _rect(Vector2(5,-1),Vector2(5,13),faction_color.darkened(0.18),node)
    _ellipse(Vector2(0,-27),6.0,7.0,Color("b89a79"),node)
    _rect(Vector2(0,-20),Vector2(15,3),faction_color.lightened(0.12),node)

    var name_label = Label.new()
    name_label.position = Vector2(-48,-48)
    name_label.size = Vector2(96,13)
    name_label.text = str(record.get("name",npc_id)).to_upper()
    name_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
    name_label.add_theme_font_size_override("font_size",6)
    name_label.modulate = Color(0.86,0.85,0.76,0.92)
    name_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
    node.add_child(name_label)

    if trader_id != "" or not contract_board.is_empty():
        var role_label = Label.new()
        role_label.position = Vector2(-30,-37)
        role_label.size = Vector2(60,11)
        role_label.text = "ТОРГОВЕЦ" if trader_id != "" else "КОНТРАКТЫ"
        role_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
        role_label.add_theme_font_size_override("font_size",5)
        role_label.modulate = Color("c6aa62")
        role_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
        node.add_child(role_label)
    return node

func _spawn_faction_npcs(chunk,poi_id:String,cell_offset:Vector2i):
    if not FactionSettlementCatalog.has(poi_id):
        return
    for record in FactionSettlementCatalog.npcs(poi_id,cell_offset):
        _create_faction_npc(chunk,record)

func _talk_faction_npc(node):
    if not is_instance_valid(node):
        return
    if node.has_meta("supply_event_id"):
        var stage = str(node.get_meta("supply_event_stage","distress"))
        var line = "Нас зажали на дороге. Сначала убери заражённых, потом проверь груз."
        if stage == "overrun":
            line = "Еле держусь. Груз ещё в машине — если очистишь дорогу, его можно спасти."
        _set_survival_feedback("%s • %s
%s" % [str(node.get_meta("display_name","Охранник")),str(node.get_meta("npc_role","уцелевший")),line],3.8)
        return
    var npc_id = str(node.get_meta("npc_id",""))
    var name = str(node.get_meta("display_name",""))
    var role = str(node.get_meta("npc_role",""))
    var line = "Держись ближе к освещённым улицам. За стенами сейчас неспокойно."
    match npc_id:
        "perron_steward": line = "Если привезёшь припасы, это почувствует весь Перрон, не только рынок."
        "perron_radio": line = "По радио снова говорят о проблемах на дальних маршрутах."
        "rubezh_commander": line = "Дороги важнее трофеев. Без маршрутов поселения начинают голодать."
        "rubezh_dispatch": line = "Патрули отмечают опасные участки, но людей на всё не хватает."
        "mechanics_electrician": line = "Хорошая электроника сейчас ценнее блестящей безделушки."
        "mechanics_storekeeper": line = "Склад не резиновый. Завалишь нас одним товаром — цена просядет."
        "lazaret_doctor": line = "Тяжёлые случаи лечатся запасами, а запасы сами себя не пополняют."
        "lazaret_researcher": line = "Образцы и реагенты интересуют нас больше оружия."
    _set_survival_feedback("%s • %s\n%s" % [name,role,line],3.8)

func _build_major_poi_chunk(chunk,coord,profile) -> bool:
    var poi = profile.get("poi",{})
    if poi.is_empty():
        return false
    var poi_id = str(poi.get("id",""))
    if not PoiCatalog.has_compound(poi_id):
        return false
    var cell_offset = poi.get("cell_offset",Vector2i.ZERO)
    var cell_data = PoiCatalog.cell(poi_id,cell_offset)
    if cell_data.is_empty():
        return false

    var role = str(cell_data.get("role","сектор"))
    var safe_settlement = bool(cell_data.get("safe_settlement",false))
    chunk.set_meta("poi_authored",true)
    chunk.set_meta("poi_role",role)
    chunk.set_meta("poi_cell_offset",cell_offset)
    chunk.set_meta("poi_flow_stage",int(cell_data.get("flow_stage",-1)))
    chunk.set_meta("poi_access_points",cell_data.get("access_points",[]).duplicate(true))
    _decorate_major_poi_ground(chunk,str(cell_data.get("ground","")),coord)
    if not HighRiskSiteCatalog.has(poi_id):
        _decorate_high_risk_ground_identity(chunk,poi_id,cell_offset)

    var poi_name = str(poi.get("short_name",poi.get("name","ОБЪЕКТ")))
    # settlements: the sector name sits on the street corner, not behind a facade
    var label_origin = Vector2(344,462) if safe_settlement else Vector2(292,272)
    _create_world_label(chunk,label_origin,poi_name,8,Color("c4b77f"))
    _create_world_label(chunk,label_origin + Vector2(0,14),role.to_upper(),6,Color("8f9686"))
    for access in cell_data.get("access_points",[]):
        var access_kind = str(access.get("kind","access"))
        var access_color = Color("82b894") if access_kind == "entry" else Color("c9a96a")
        _create_world_label(chunk,access.get("pos",Vector2(384,384)),str(access.get("label","ПРОХОД")),6,access_color)

    var buildings = _high_risk_visual_specs(poi_id,cell_offset,cell_data.get("buildings",[]))
    for spec in buildings:
        var archetype_id = str(spec.get("archetype","utility_house"))
        var archetype_data = BuildingCatalog.by_id(archetype_id)
        var pos = spec.get("pos",Vector2(140,140))
        var size = spec.get("size",Vector2(160,110))
        var model_id = str(spec.get("model",""))
        if model_id != "" and SettlementBuildingModels.has(model_id):
            # authored settlement exterior: the model fixes footprint and entrance
            var model_data = SettlementBuildingModels.model(model_id)
            archetype_data = archetype_data.duplicate(true)
            archetype_data["settlement_model"] = model_id
            size = model_data.get("size",size)
            archetype_data["door_x"] = float(model_data.get("door_x",0.0)) / max(1.0,size.x)
        var sign_text = str(spec.get("sign",archetype_data.get("sign","ДОМ")))
        var wall_color = archetype_data.get("color",Color("4c4942"))
        var building_id = str(spec.get("id","poi_building"))
        # 1.23-dev2: every High Risk building, the clinical complex reception block
        # included, wears an authored exterior model fitted to its gameplay
        # footprint (tools/wa_hr_buildings.py, rendered in Blender).
        var hr_model_id = HighRiskBuildingModels.model_id(poi_id,cell_offset,building_id)
        if hr_model_id != "":
            var hr_model = HighRiskBuildingModels.model(hr_model_id)
            if hr_model.get("size",Vector2.ZERO) == size:
                archetype_data = archetype_data.duplicate(true)
                archetype_data["settlement_model"] = hr_model_id
                archetype_data["door_x"] = float(hr_model.get("door_x",0.0)) / max(1.0,size.x)
        var loot_table = str(spec.get("loot",archetype_data.get("loot",profile.get("loot_theme","residential"))))
        var building_node = _create_building(chunk,coord,building_id,pos,size,sign_text,wall_color,true,archetype_id,archetype_data)
        _apply_authored_building_metadata(building_node,profile,archetype_id,archetype_data,loot_table,role,cell_offset)

        var container_id = str(spec.get("container_id",""))
        if container_id != "" and not safe_settlement:
            var cpos = spec.get("container_pos",pos + archetype_data.get("container_offset",Vector2.ZERO))
            _create_container(chunk,coord,cpos,container_id,loot_table,"%s • %s" % [sign_text,poi_name])

    for loose in cell_data.get("loose_containers",[]) if not safe_settlement else []:
        _create_container(
            chunk,
            coord,
            loose.get("pos",Vector2(384,384)),
            str(loose.get("id","cache_3")),
            str(loose.get("loot",profile.get("loot_theme","residential"))),
            str(loose.get("name","Запасы"))
        )

    for fence_data in cell_data.get("fences",[]):
        if HighRiskSiteCatalog.has(poi_id):
            _hr_fence(chunk,fence_data,poi_id,cell_offset)
        else:
            _create_fence(chunk,fence_data.get("pos",Vector2(384,80)),float(fence_data.get("length",120.0)),float(fence_data.get("rotation",0.0)))
    for lamp_pos in cell_data.get("lamps",[]):
        _create_lamp(chunk,lamp_pos)
    for bench_pos in cell_data.get("workbenches",[]):
        _create_workbench(chunk,bench_pos)
    for prop in cell_data.get("props",[]):
        _world_prop_sprite(
            str(prop.get("kind","debris")),
            chunk,
            prop.get("pos",Vector2.ZERO),
            int(prop.get("z",3)),
            float(prop.get("scale",0.5))
        )
    if cell_data.has("settlement_style"):
        _dress_faction_settlement(chunk,coord,cell_data,str(poi.get("name",poi_name)))
    _spawn_faction_npcs(chunk,poi_id,cell_offset)
    var vertical_entry = HighRiskFloorCatalog.ground_entry(poi_id,cell_offset)
    if not vertical_entry.is_empty():
        _create_high_risk_floor_transition(
            chunk,
            vertical_entry.get("pos",Vector2(384,384)),
            poi_id,
            int(vertical_entry.get("target_floor",2)),
            1,
            str(vertical_entry.get("label","ЛЕСТНИЦА"))
        )
    if HighRiskSiteCatalog.has(poi_id):
        _dress_high_risk_site(chunk,coord,poi_id,cell_offset,cell_data)
    else:
        _dress_major_poi(chunk,coord,str(cell_data.get("ground","")))
    return true

const POI_PROP_KINDS = [
    "boxcar","tank_wagon","h_tank","silo","pipe_rack","watchtower",
    "guard_booth","boom_barrier","army_truck","forklift","pallets_tarp","pipe_stack",
    "cable_drum","transformer","hedgehogs","greenhouse","woodpile","rail_signal"
]

func _poi_set_piece(chunk,kind,pos,solid_size = Vector2.ZERO,z_value = 7,flip = false):
    # 0.91: heavy set pieces from the industrial reference sheet (2x density, shown at 0.5).
    var index = POI_PROP_KINDS.find(kind)
    if index < 0:
        return null
    var node = Node2D.new()
    node.position = Vector2(round(pos.x),round(pos.y))
    node.z_index = z_value
    node.z_as_relative = false
    node.add_to_group("poi_set_pieces")
    node.set_meta("poi_piece_kind",kind)
    chunk.add_child(node)
    var shadow_w = max(10.0,solid_size.x * 0.55) if solid_size != Vector2.ZERO else 14.0
    _ellipse(Vector2(6,1),shadow_w,4.0,Color(0.01,0.012,0.012,0.26),node)
    var piece_scale = _poi_piece_scale(kind)
    var sprite = _facade_atlas_sprite(node,"res://poi_props_v1.png",Rect2((index % 6) * 192,int(index / 6) * 128,192,128),Vector2(0,-64.0 * piece_scale),piece_scale)
    if sprite != null:
        sprite.flip_h = flip
    if solid_size != Vector2.ZERO:
        _add_static_rect(node,Vector2(0,-solid_size.y * 0.5 + 2.0),solid_size)
    return node

func _poi_piece_scale(kind):
    # big vehicles / tanks read at world scale, small yard pieces a bit smaller
    if kind in ["boxcar","tank_wagon","h_tank","army_truck","pipe_rack"]:
        return 0.75
    return 0.6

func _poi_spot_free(chunk,pos,radius,allow_road = false):
    if not allow_road and _point_on_road_or_sidewalk(pos):
        return false
    if pos.x < radius * 0.6 or pos.x > CHUNK_SIZE - radius * 0.6 or pos.y < 30.0 or pos.y > CHUNK_SIZE - 10.0:
        return false
    for off in [Vector2.ZERO,Vector2(-radius,0),Vector2(radius,0),Vector2(0,-40),Vector2(0,18)]:
        if _tree_overlaps_building(chunk,pos + off):
            return false
    if _tree_blocks_door_swing(chunk,pos):
        return false
    var gp = chunk.global_position + pos
    for n in get_tree().get_nodes_in_group("interactable"):
        if is_instance_valid(n) and n.global_position.distance_to(gp) < radius + 26.0:
            return false
    for n in get_tree().get_nodes_in_group("poi_set_pieces"):
        if is_instance_valid(n) and n.global_position.distance_to(gp) < radius + 22.0:
            return false
    return true

func _dress_major_poi(chunk,coord,ground_kind):
    # 0.91: each compound cell gets its own heavy silhouette: tanks and pipe racks
    # at the factory, wagons on the depot tracks, barrier/booth/tower at the
    # checkpoint, trucks in the motor pool, greenhouses and woodpiles at the dachas.
    var rng = RandomNumberGenerator.new()
    rng.seed = int(abs(coord.x*52361 + coord.y*93151 + 3141)) + 1
    var plots = [
        Vector2(74,82),Vector2(196,82),Vector2(74,212),Vector2(196,212),
        Vector2(572,82),Vector2(694,82),Vector2(572,212),Vector2(694,212),
        Vector2(74,592),Vector2(196,592),Vector2(74,722),Vector2(196,722),
        Vector2(572,592),Vector2(694,592),Vector2(572,722),Vector2(694,722)
    ]
    var pieces = []   # [kind, radius, solid size]
    var fixed = []    # [kind, pos, radius, solid, allow_road]
    var g = str(ground_kind)
    if g.begins_with("factory"):
        pieces = [["h_tank",58,Vector2(96,18)],["pipe_rack",70,Vector2.ZERO],["silo",20,Vector2(28,16)],
                  ["pallets_tarp",28,Vector2(52,14)],["forklift",18,Vector2(32,12)],["pipe_stack",32,Vector2(58,14)],
                  ["transformer",24,Vector2(40,16)],["cable_drum",14,Vector2(22,10)]]
    elif g.begins_with("rail"):
        fixed = [["boxcar",Vector2(190,392),64,Vector2(110,20),true],
                 ["tank_wagon",Vector2(566,392),64,Vector2(110,20),true],
                 ["rail_signal",Vector2(318,346),10,Vector2(8,6),true]]
        pieces = [["pallets_tarp",28,Vector2(52,14)],["cable_drum",14,Vector2(22,10)],["pipe_stack",32,Vector2(58,14)]]
    elif g == "mil_checkpoint":
        fixed = [["boom_barrier",Vector2(342,262),16,Vector2(8,6),true],
                 ["guard_booth",Vector2(252,238),22,Vector2(34,18),false],
                 ["hedgehogs",Vector2(250,330),30,Vector2.ZERO,false]]
        pieces = [["watchtower",18,Vector2(24,14)],["hedgehogs",30,Vector2.ZERO]]
    elif g.begins_with("mil"):
        pieces = [["army_truck",60,Vector2(104,26)],["army_truck",60,Vector2(104,26)],["watchtower",18,Vector2(24,14)],
                  ["hedgehogs",30,Vector2.ZERO],["pallets_tarp",28,Vector2(52,14)]]
    elif g == "garage_lanes" or g == "service_yard":
        pieces = [["pallets_tarp",28,Vector2(52,14)],["cable_drum",14,Vector2(22,10)],["pipe_stack",32,Vector2(58,14)],
                  ["transformer",24,Vector2(40,16)],["forklift",18,Vector2(32,12)]]
    elif g.begins_with("dacha"):
        pieces = [["greenhouse",30,Vector2(54,16)],["woodpile",18,Vector2(30,10)],["greenhouse",30,Vector2(54,16)],
                  ["woodpile",18,Vector2(30,10)]]
    elif g.begins_with("hospital"):
        pieces = [["guard_booth",22,Vector2(34,18)],["pallets_tarp",28,Vector2(52,14)],["cable_drum",14,Vector2(22,10)],
                  ["transformer",24,Vector2(40,16)]]
    elif g.begins_with("quarantine"):
        pieces = [["guard_booth",22,Vector2(34,18)],["pallets_tarp",28,Vector2(52,14)],["cable_drum",14,Vector2(22,10)],
                  ["transformer",24,Vector2(40,16)]]
    else:
        return
    var placed = 0
    for f in fixed:
        if _poi_spot_free(chunk,f[1],float(f[2]),bool(f[4])):
            _poi_set_piece(chunk,f[0],f[1],f[3],7,false)
            placed += 1
    var order = plots.duplicate()
    for i in range(order.size()):
        var j = rng.randi_range(0,order.size() - 1)
        var tmp = order[i]
        order[i] = order[j]
        order[j] = tmp
    for piece in pieces:
        for spot in order:
            if _poi_spot_free(chunk,spot,float(piece[1]),false):
                _poi_set_piece(chunk,piece[0],spot,piece[2],7,rng.randf() < 0.5)
                placed += 1
                order.erase(spot)
                break
    chunk.set_meta("poi_set_pieces",placed)

