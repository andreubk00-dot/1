    return {"scale":0.88,"root_bias":roots[d],"grip_px":grips[d],"source_size":Vector2(16,16)}

func _hide_legacy_player_art():
    # The imported survivor is the only runtime body. Legacy body/pose/IK nodes
    # remain allocated for compatibility and tests, but must never leak on-screen.
    for node in [
        pv_pose_back,pv_pose_front,pv_legs,
        pv_backpack,pv_body,pv_vest,pv_head,pv_helmet,pv_helmet_lip,
        pv_leg_l,pv_leg_r,pv_boot_l,pv_boot_r,
        pv_arm_back_root,pv_arm_front_root
    ]:
        if node != null:
            node.visible = false
    _set_melee_arm_visible(false)
    _set_ranged_arm_visible(false)
    for node in [pv_weapon_stock,pv_weapon_body,pv_weapon_mag,pv_weapon_barrel]:
        if node != null:
            node.visible = false
    if pv_melee_trail != null:
        pv_melee_trail.visible = false

func _set_modern_survivor_visible(visible):
    if pv_modern_survivor_sprite != null:
        pv_modern_survivor_sprite.visible = visible
    if visible:
        _hide_legacy_player_art()
        if pv_weapon_root != null:
            # 0.75: every weapon (firearm and melee) is baked into the survivor sheets.
            pv_weapon_root.visible = false
    else:
        if pv_pose_back != null:
            pv_pose_back.visible = true
        if pv_pose_front != null:
            pv_pose_front.visible = true

func _update_modern_survivor(weapon_id,local_aim,local_motion,pose_offset,body_roll):
    if pv_modern_survivor_sprite == null:
        return
    var moving = visual_move_speed > 2.0 and movement_anim_blend > 0.10
    var clip = _modern_survivor_clip(weapon_id,local_aim,local_motion,moving)
    var tex = _modern_survivor_sheet(clip)
    if tex == null:
        tex = _modern_survivor_sheet(_modern_survivor_idle_sheet(weapon_id))
        clip = _modern_survivor_idle_sheet(weapon_id)
    pv_modern_survivor_sprite.texture = tex
    pv_modern_survivor_sprite.region_enabled = true
    var dir8 = _direction8_hysteresis(local_aim,visual_aim_dir8)
    var row = _modern_survivor_row(dir8)
    var frame_total = max(1,int(tex.get_width() / SURVIVOR_CELL)) if tex != null else 8
    var frame = min(_modern_survivor_frame(clip,moving,frame_total),frame_total - 1)
    pv_modern_survivor_sprite.region_rect = Rect2(frame * SURVIVOR_CELL,row * SURVIVOR_CELL,SURVIVOR_CELL,SURVIVOR_CELL)
    pv_modern_survivor_sprite.position = pose_offset + Vector2(0,-4)
    pv_modern_survivor_sprite.rotation = body_roll * 0.55
    pv_modern_survivor_sprite.scale = Vector2(SURVIVOR_SPRITE_SCALE,SURVIVOR_SPRITE_SCALE)
    pv_modern_survivor_sprite.z_index = 2

