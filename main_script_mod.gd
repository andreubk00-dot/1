func _decorate_interior_trim(root,inner_w,inner_h):
    var trim = Node2D.new()
    trim.name = "InteriorTrim"
    trim.z_index = 1
    root.add_child(trim)
    var half_w = inner_w * 0.5
    var half_h = inner_h * 0.5
    var h_count = max(1,int(ceil(inner_w / 32.0)))
    for x in range(h_count):
        var px = -half_w + 16.0 + float(x) * 32.0
        _interior_trim_piece(trim,Rect2(0,0,32,16),Vector2(px,-half_h+4),Vector2.ONE,0)
    var v_count = max(1,int(ceil(inner_h / 32.0)))
    for y in range(v_count):
        var py = -half_h + 16.0 + float(y) * 32.0
        _interior_trim_piece(trim,Rect2(64,0,16,32),Vector2(-half_w+4,py),Vector2.ONE,0)
        _interior_trim_piece(trim,Rect2(80,0,16,32),Vector2(half_w-4,py),Vector2.ONE,0)
    # Front edge stops around the real 32px doorway. A dedicated threshold joins the room to outside.
    var doorway_half = 23.0
    for x in range(h_count):
        var px = -half_w + 16.0 + float(x) * 32.0
        if abs(px) > doorway_half + 10.0:
            _interior_trim_piece(trim,Rect2(32,0,32,16),Vector2(px,half_h-4),Vector2.ONE,0)
    _interior_trim_piece(trim,Rect2(96,0,32,16),Vector2(0,half_h-3),Vector2.ONE,1)
    return trim

func _interior_floor_sprite(parent,sign_text,size):
    var atlas = load("res://interior_floor_tiles_v5.png")
    if atlas == null:
        return null
    var root = Node2D.new()
    root.name = "InteriorFloorTiles"
    root.position = Vector2(0,7)
    root.z_index = -2
    parent.add_child(root)

    var tile_size = 32.0
    var inner_w = max(tile_size,size.x - 20.0)
    var inner_h = max(tile_size,size.y - 28.0)
    var cols = max(1,int(ceil(inner_w / tile_size)))
    var rows = max(1,int(ceil(inner_h / tile_size)))
    var row = _interior_floor_row(sign_text)
    for y in range(rows):
        for x in range(cols):
            var variant = abs((x * 5 + y * 7 + row * 11 + int(abs(hash(str(sign_text)))))) % 8
            var tex = AtlasTexture.new()
            tex.atlas = atlas
            tex.region = Rect2(variant*32,row*32,32,32)
            var sprite = Sprite2D.new()
            sprite.texture = tex
            sprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
            sprite.position = Vector2(
                -inner_w*0.5 + tile_size*0.5 + float(x)*tile_size,
                -inner_h*0.5 + tile_size*0.5 + float(y)*tile_size
            )
            if ((x+y) % 5) == 0:
                sprite.modulate = Color(0.96,0.95,0.91,1.0)
            root.add_child(sprite)
    _decorate_interior_trim(root,inner_w,inner_h)
    return root



func _add_detail_light(parent,pos,color,energy,texture_scale,exterior=false):
    if parent == null:
        return
    var light = PointLight2D.new()
    light.position = pos
    light.texture = _make_base_radial_texture()
    light.texture_scale = texture_scale
    light.energy = energy
    light.color = color
    light.z_index = 1
    light.set_meta("base_energy",float(energy))
    light.set_meta("flicker_phase",float(abs(hash(str(parent.get_instance_id()) + ":" + str(pos)))) * 0.001)
    light.add_to_group("detail_lights")
    if exterior:
        light.add_to_group("exterior_practical_lights")
    parent.add_child(light)

func _update_detail_lights(delta):
    # Slight practical-light instability keeps abandoned interiors from looking
    # like a uniformly lit editor scene. This is visual-only and deterministic.
    var t = Time.get_ticks_msec() * 0.001
    for light in get_tree().get_nodes_in_group("detail_lights"):
        if not is_instance_valid(light):
            continue
        var base_energy = float(light.get_meta("base_energy",light.energy))
        var phase = float(light.get_meta("flicker_phase",0.0))
        var slow = sin(t * 1.7 + phase) * 0.035
        var fast = sin(t * 6.1 + phase * 1.7) * 0.018
        var target = base_energy * (1.0 + slow + fast)
        if light.is_in_group("exterior_practical_lights"):
            target *= 0.12 + _time_night_factor() * 0.88
        light.energy = max(0.0,target)

func _add_ground_decals(chunk,coord):
    var rng = RandomNumberGenerator.new()
    rng.seed = int(abs(coord.x*198491 + coord.y*65497 + 32001)) + 1
    for i in range(10):
        var p = Vector2(rng.randi_range(35,765),rng.randi_range(35,765))
        var kind = "debris" if rng.randf() > 0.18 else "blood"
        var sprite = _world_prop_sprite(kind,chunk,p,1,rng.randf_range(0.42,0.70))
        if sprite != null:
            sprite.rotation = rng.randf_range(-PI,PI)


