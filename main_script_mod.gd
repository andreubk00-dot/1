func _update_interior_prop_depth():
    if player == null:
        return
    for sprite in get_tree().get_nodes_in_group("interior_depth_props"):
        if not is_instance_valid(sprite):
            continue
        var foot_offset = float(sprite.get_meta("depth_foot_offset",6.0))
        var foot_y = sprite.global_position.y + foot_offset
        var near_player = abs(sprite.global_position.x - player.global_position.x) < 125.0 and abs(foot_y - player.global_position.y) < 105.0
        if near_player and player.global_position.y < foot_y - 2.0:
            sprite.z_index = 22
        else:
            sprite.z_index = 19

func _decorate_building_art(building,sign_text,size,building_id):
    if building == null:
        return
    var plan = _interior_layout_plan(sign_text,size,building_id)
    for item in plan:
        var kind = str(item.get("kind","debris"))
        var pos = _interior_plan_position(size,item)
        var scale_value = float(item.get("scale",0.5))
        var prop_sprite = _world_prop_sprite(kind,building,pos,int(item.get("z",2)),scale_value)
        var role = str(item.get("role","fixture"))
        if is_instance_valid(prop_sprite) and role != "decal" and _interior_prop_uses_depth(kind):
            prop_sprite.z_as_relative = false
            prop_sprite.z_index = 19
            prop_sprite.add_to_group("interior_depth_props")
            var prop_region = _world_prop_region(kind)
            prop_sprite.set_meta("depth_foot_offset",max(4.0,prop_region.size.y * scale_value * 0.30))
        if role == "fixture":
            var collision_size = _interior_prop_collision_size(kind,scale_value)
            if collision_size != Vector2.ZERO:
                _add_static_rect(building,pos + Vector2(0,collision_size.y*0.10),collision_size)
    var s = str(sign_text).to_upper()
    if s.find("АПТЕК") >= 0:
        _add_detail_light(building,Vector2(size.x*0.22,-size.y*0.12),Color(1.0,0.68,0.36),0.72,1.10)
        _add_detail_light(building,Vector2(-size.x*0.18,-size.y*0.24),Color(0.96,0.78,0.50),0.42,0.82)
        _add_detail_light(building,Vector2(size.x*0.04,-size.y*0.12),Color(1.0,0.62,0.30),0.28,0.58)
    elif s.find("ГАРАЖ") >= 0 or s.find("ЦЕХ") >= 0 or s.find("СЕРВИС") >= 0 or s.find("СКЛАД") >= 0:
        _add_detail_light(building,Vector2(size.x*0.28,-size.y*0.18),Color(1.0,0.66,0.34),0.24,0.64)

func _roof_surface_texture(sign_text):
    var atlas = load("res://roof_surface_v2.png")
    if atlas == null:
        return null
    var s = str(sign_text).to_upper()
    var index = 0
    if s.find("ЖИЛ") >= 0 or s.find("ДОМ") >= 0 or s.find("АПТЕК") >= 0 or s.find("МАГАЗ") >= 0 or s.find("КАФЕ") >= 0:
        index = 1
    var tex = AtlasTexture.new()
    tex.atlas = atlas
    tex.region = Rect2(index * 128,0,128,128)
    return tex

func _roof_surface_sprite(parent,sign_text,size):
    # 0.87: typed seamless roof material (bitumen / slab / corrugated / tin / shifer)
    # repeated at native density, framed by parapet or eave strips.
    var style = _roof_style_index(sign_text)
    var tex = load("res://roof_tile_s%d_v3.png" % style)
    if tex == null:
        tex = load("res://roof_tile_v2.png")
    if tex == null:
        tex = _roof_surface_texture(sign_text)
    if tex == null:
        return null
    var area = Vector2(max(64.0,size.x*0.90),max(64.0,size.y*0.90))
    var center = Vector2(0,-size.y*0.02)
    var sprite = Sprite2D.new()
    sprite.texture = tex
    sprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
    sprite.texture_repeat = CanvasItem.TEXTURE_REPEAT_ENABLED
    sprite.region_enabled = true
    sprite.region_filter_clip_enabled = false
    sprite.region_rect = Rect2(0,0,area.x,area.y)
    sprite.position = center
    sprite.modulate = Color(0.94,0.94,0.92,1.0)
    sprite.z_index = 0
    sprite.set_meta("roof_style",style)
    parent.add_child(sprite)
    _roof_edge_strips(parent,style,center,area)
    return sprite

func _roof_edge_strips(parent,style,center,area):
    var h_tex = load("res://roof_edge_h_s%d_v1.png" % style)
    var v_tex = load("res://roof_edge_v_s%d_v1.png" % style)
    if h_tex == null or v_tex == null:
        return
    for edge in [0,1]:
        var strip = Sprite2D.new()
        strip.texture = h_tex
        strip.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
        strip.texture_repeat = CanvasItem.TEXTURE_REPEAT_ENABLED
        strip.region_enabled = true
        strip.region_rect = Rect2(0,0,area.x,8)
        strip.position = center + Vector2(0,(-area.y*0.5 + 4.0) if edge == 0 else (area.y*0.5 - 4.0))
        strip.flip_v = edge == 1
        strip.z_index = 1
        strip.add_to_group("roof_edge_strips")
        parent.add_child(strip)
    for edge in [0,1]:
        var strip = Sprite2D.new()
        strip.texture = v_tex
        strip.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
        strip.texture_repeat = CanvasItem.TEXTURE_REPEAT_ENABLED
        strip.region_enabled = true
        strip.region_rect = Rect2(0,0,8,area.y)
        strip.position = center + Vector2((-area.x*0.5 + 4.0) if edge == 0 else (area.x*0.5 - 4.0),0)
        strip.flip_h = edge == 1
        strip.z_index = 1
        strip.add_to_group("roof_edge_strips")
        parent.add_child(strip)

