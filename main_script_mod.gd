func _building_slots_for_chunk(coord,profile = {},preserve_legacy = false):
    if profile.is_empty():
        profile = _chunk_profile(coord)
    if preserve_legacy or bool(profile.get("legacy",false)):
        var legacy_slots = []
        for anchor in _legacy_building_anchors():
            legacy_slots.append({"pos":anchor,"scale":Vector2.ONE})
        return legacy_slots
    var poi = profile.get("poi",{})
    var poi_kind = str(poi.get("kind",""))
    var building_set = str(profile.get("building_set","mixed_residential"))
    return ChunkLayoutCatalog.slots_for(building_set,coord,poi_kind)

func _fit_procedural_building_size(size):
    # The authored plots are intentionally unequal, but no procedural building may
    # spill into the road/sidewalk cross or outside its chunk.
    return Vector2(
        clamp(round(size.x),84.0,246.0),
        clamp(round(size.y),68.0,184.0)
    )

func _fit_procedural_building_center(raw_center,size):
    var half = size * 0.5
    var center = raw_center
    var left_plot = raw_center.x < CHUNK_SIZE * 0.5
    var top_plot = raw_center.y < CHUNK_SIZE * 0.5

    if left_plot:
        center.x = clamp(center.x,PLOT_EDGE_MARGIN + half.x,BUILDING_ROAD_MIN - PLOT_EDGE_MARGIN - half.x)
    else:
        center.x = clamp(center.x,BUILDING_ROAD_MAX + PLOT_EDGE_MARGIN + half.x,CHUNK_SIZE - PLOT_EDGE_MARGIN - half.x)

    if top_plot:
        center.y = clamp(center.y,PLOT_EDGE_MARGIN + half.y,BUILDING_ROAD_MIN - PLOT_EDGE_MARGIN - half.y)
    else:
        center.y = clamp(center.y,BUILDING_ROAD_MAX + PLOT_EDGE_MARGIN + half.y,CHUNK_SIZE - PLOT_EDGE_MARGIN - half.y)

    return Vector2(round(center.x),round(center.y))

func _point_on_road_or_sidewalk(pos):
    return (pos.x >= TREE_ROAD_MIN and pos.x <= TREE_ROAD_MAX) or (pos.y >= TREE_ROAD_MIN and pos.y <= TREE_ROAD_MAX)

func _tree_overlaps_building(chunk,pos):
    if chunk == null:
        return false
    for child in chunk.get_children():
        if not is_instance_valid(child) or not child.has_meta("world_building"):
            continue
        var size = child.get_meta("building_size",Vector2.ZERO)
        if typeof(size) != TYPE_VECTOR2 or size == Vector2.ZERO:
            continue
        var clearance = Vector2(30,42)
        var rect = Rect2(child.position - size*0.5 - clearance,size + clearance*2.0)
        if rect.has_point(pos):
            return true
    return false

func _tree_position_forbidden(chunk,pos):
    if _point_on_road_or_sidewalk(pos):
        return true
    if _tree_overlaps_building(chunk,pos):
        return true
    if chunk != null:
        for child in chunk.get_children():
            if is_instance_valid(child) and bool(child.get_meta("world_event_root",false)):
                if _world_event_rect(child).grow(22.0).has_point(pos):
                    return true
    return _tree_blocks_door_swing(chunk,pos)

func _decorate_major_poi_ground(chunk,ground_kind,coord=Vector2i.ZERO):
    # 0.85: physical language for multi-chunk compounds.  These marks live below
    # gameplay actors/buildings and make adjacent POI cells read as one facility.
    # 1.13: authored compounds are private yards/facilities, not four ordinary
    # city plots. Mask the baked public road cross before drawing their internal
    # lanes; otherwise large authored buildings can look as if they stand in the
    # middle of an asphalt street even though their gameplay geometry is valid.
    var g = str(ground_kind)
    var surface = Color(0.19,0.19,0.17,1.0)
    if g.begins_with("dacha") or g.begins_with("hunting"):
        surface = Color(0.20,0.24,0.15,1.0)
    elif g.begins_with("hospital") or g.begins_with("quarantine"):
        surface = Color(0.20,0.22,0.20,1.0)
    elif g.begins_with("mil"):
        surface = Color(0.18,0.19,0.17,1.0)
    elif g.begins_with("vector"):
        surface = Color(0.135,0.145,0.14,1.0)
    elif g.begins_with("rail") or g.begins_with("factory") or g == "service_yard" or g == "garage_lanes":
        surface = Color(0.18,0.18,0.17,1.0)
    elif g == "settlement_civic":
        surface = Color(0.215,0.195,0.160,1.0)
    elif g == "settlement_military":
        surface = Color(0.190,0.192,0.165,1.0)
    elif g == "settlement_industrial":
        surface = Color(0.185,0.183,0.175,1.0)
    elif g == "settlement_medical":
        surface = Color(0.250,0.258,0.244,1.0)
    var mask = _rect(Vector2(384,384),Vector2(CHUNK_SIZE,CHUNK_SIZE),surface,chunk)
    mask.z_index = -8
    var yard_texture = Sprite2D.new()
    yard_texture.name = "CompoundSurface"
    yard_texture.texture = CompoundSurface.texture(surface,g.begins_with("dacha") or g.begins_with("hunting") or g == "settlement_civic")
    yard_texture.texture_repeat = CanvasItem.TEXTURE_REPEAT_ENABLED
    yard_texture.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
    yard_texture.region_enabled = true
    yard_texture.region_rect = Rect2(0,0,CHUNK_SIZE,CHUNK_SIZE)
    yard_texture.position = Vector2(CHUNK_SIZE,CHUNK_SIZE) * 0.5
    yard_texture.z_index = -8
    chunk.add_child(yard_texture)
    chunk.set_meta("poi_masks_public_road",true)
    chunk.set_meta("poi_surface_opaque",true)

    # Replace the public road completely, but keep the compound floor visually
    # textured so the fix does not become one flat painted rectangle. The seed is
    # sector-specific, preventing an obvious repeated dirt pattern across a multi-
    # chunk facility. These are visual-only stains below gameplay props.
    var surface_rng = RandomNumberGenerator.new()
    surface_rng.seed = int(abs(coord.x * 6700417 + coord.y * 15485863 + int(g.hash()))) + 113
    var dirt = Color(0.07,0.075,0.065,0.09)
    if g.begins_with("dacha") or g.begins_with("hunting"):
        dirt = Color(0.11,0.095,0.055,0.11)
