func _hud_compact_condition_text():
    var flags = []
    if bleeding:
        flags.append("КРОВЬ")
    if wound_infection >= 30.0:
        flags.append("ИНФЕКЦИЯ")
    elif wound_contamination >= 45.0:
        flags.append("РАНА")
    if body_temperature < 35.7:
        flags.append("ХОЛОД")
    elif body_temperature > 38.0:
        flags.append("ЖАР")
    if wetness >= 70.0:
        flags.append("МОКРО")
    if fatigue >= 75.0:
        flags.append("УСТАЛ")
    if flags.is_empty():
        return "СТАБИЛЬНО"
    if flags.size() > 2:
        flags.resize(2)
    return " • ".join(flags)

