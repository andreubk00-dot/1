func _home_unloadable_item(id:String) -> bool:
    if not item_defs.has(id):
        return false
    var category = str(item_defs[id].get("category",""))
    if category in ["material","mod"]:
        return true
    return id in ["grain","herbs","dirty_water"]

func _home_unloadable_count() -> int:
    var total = 0
    for entry in inventory_entries:
        var id = str(entry.get("id",""))
        if _home_unloadable_item(id):
            total += max(0,int(entry.get("qty",1)))
    return total

func _home_unload_resources():
    if not _at_home():
        home_supply_feedback = "Разгружать ресурсы можно только внутри своего дома."
        _refresh_home_journal_ui()
        return false
    var keys = _home_stashes(true)
    if keys.is_empty():
        home_supply_feedback = "Нет доступного домашнего ящика рядом."
        _refresh_home_journal_ui()
        return false
    var inventory_copy = inventory_entries.duplicate(true)
    var states_copy = {}
    for key in keys:
        states_copy[key] = container_states[key].duplicate(true)
    var moved = {}
    for i in range(inventory_copy.size()-1,-1,-1):
        var entry = inventory_copy[i].duplicate(true)
        var id = str(entry.get("id",""))
        if not _home_unloadable_item(id):
            continue
        var original_qty = max(0,int(entry.get("qty",1)))
        var remaining = original_qty
        for key in keys:
            if remaining <= 0:
                break
            var state = states_copy[key]
            var entries = state.get("items",[])
            var grid = _container_grid_size(state)
            var piece = entry.duplicate(true)
            piece["qty"] = remaining
            var after = _grid_add_existing_entry(entries,piece,grid.x,grid.y)
            var moved_here = remaining - after
            if moved_here > 0:
                moved[id] = int(moved.get(id,0)) + moved_here
            remaining = after
            state["items"] = entries
            states_copy[key] = state
        if remaining <= 0:
            inventory_copy.remove_at(i)
        elif remaining < original_qty:
            inventory_copy[i]["qty"] = remaining
    if moved.is_empty():
        home_supply_feedback = "Нечего разгружать или в домашних ящиках нет места."
        _refresh_home_journal_ui()
        return false
    inventory_entries = inventory_copy
    selected_inventory_index = -1
    for key in keys:
        container_states[key] = states_copy[key]
    _ensure_runtime_item_instance_ids()
    _save_state()
    var moved_total = 0
    for amount in moved.values():
        moved_total += int(amount)
    home_supply_feedback = "Разгружено: %d ед. Оружие, БК и лечение оставлены." % moved_total
    _refresh_inventory_ui()
    _refresh_home_journal_ui()
    return true

func _refresh_home_supply_ui():
    var home_data_known = _home_supply_bounds().has_area()
    var all_entries = _home_stock_entries()
    var near_entries = _home_stock_entries(true)
    var lines = ["ИНФРАСТРУКТУРА",_home_infrastructure_text(),"\nЗАПАС В ДОМАШНИХ ЯЩИКАХ"]
    var totals = {}
    for entry in all_entries:
        var id = str(entry.get("id",""))
        if item_defs.has(id):
            totals[id] = int(totals.get(id,0)) + int(entry.get("qty",1))
    var ids = totals.keys()
    ids.sort()
    for id in ids:
        lines.append("%s ×%d" % [str(item_defs[id].get("name",id)),int(totals[id])])
    if totals.is_empty():
        lines.append("Запасов в ящиках нет." if home_data_known else "Запасы пока неизвестны — посетите дом.")
    lines.append("\nУчтены построенные ящики внутри дома. Уличный лут и соседние здания не включены.")
    home_preparation_text.text = "\n".join(lines)
    var selected_preset = clamp(int(expedition_journal.get("supply_preset",0)),0,2)
    var plan = ["Выбранный комплект: %s" % SupplyPlan.PRESETS[selected_preset]]
    var missing = 0
    for group in _home_supply_groups():
        var have = SupplyPlan.count(inventory_entries,group["ids"]) + int(group["loaded"])
        var at_home = SupplyPlan.count(all_entries,group["ids"])
        var nearby = SupplyPlan.count(near_entries,group["ids"])
        var need = SupplyPlan.remaining(inventory_entries,group)
        missing += need
        plan.append("\n%s: %d / %d" % [str(group["name"]),have,int(group["target"])])
        if home_data_known:
            plan.append("Дома %d • рядом %d • добыть ещё %d" % [at_home,nearby,max(0,need-at_home)])
        else:
            plan.append("До комплекта: %d • запас дома неизвестен" % need)
    plan.append("\nБоезапас включает заряженные патроны выбранного оружия. Излишки не выгружаются.")
    plan.append("Сбор оставляет 10%% веса под добычу: %.1f / %.1f кг." % [_inventory_weight(),_carry_limit()*0.90])
    var unloadable = _home_unloadable_count()
    plan.append("Ресурсы к разгрузке: %d ед." % unloadable)
    if not _at_home():
        plan.append("Для сбора и разгрузки вернитесь внутрь дома.")
    elif _home_stashes(true).is_empty():
        plan.append("Подойдите к домашнему ящику; стены перекрывают доступ.")
    home_report_text.text = "\n".join(plan)
    var home_stash_ready = _at_home() and not _home_stashes(true).is_empty()
    home_pack_button.disabled = not home_stash_ready or missing == 0
    home_pack_button.text = "ГОТОВО" if missing == 0 else "ДОПОЛНИТЬ"
    home_unload_button.disabled = not home_stash_ready or unloadable == 0
    home_unload_button.text = "РАЗГРУЗИТЬ"
    home_supply_status.text = home_supply_feedback
    home_supply_preset.select(selected_preset)

func _pack_home_supplies():
    # Re-check access on the authoritative action path, not just the UI button.
    if not _at_home():
        home_supply_feedback = "Собирать припасы можно только внутри своего дома."
        _refresh_home_journal_ui()
        return false
    var keys = _home_stashes(true)
    if keys.is_empty():
        home_supply_feedback = "Нет доступного домашнего ящика рядом."
        _refresh_home_journal_ui()
        return false
    var inventory_copy = inventory_entries.duplicate(true)
    var states_copy = {}
    for key in keys:
        states_copy[key] = container_states[key].duplicate(true)
    var weight = _inventory_weight()
    var max_weight = _carry_limit() * 0.90
    var moved = {}
    for group in _home_supply_groups():
        var need = SupplyPlan.remaining(inventory_copy,group)
        for id in group["ids"]:
            if not item_defs.has(id):
                continue
            for key in keys:
                var source = states_copy[key].get("items",[])
                for i in range(source.size()-1,-1,-1):
                    if need <= 0:
                        break
                    if str(source[i].get("id","")) != id:
                        continue
                    while need > 0 and int(source[i].get("qty",0)) > 0:
                        var item_weight = float(item_defs[id].get("weight",0.0))
                        if weight + item_weight > max_weight + 0.000001:
                            break
                        var one = source[i].duplicate(true)
                        one["qty"] = 1
                        if _grid_add_existing_entry(inventory_copy,one,INV_W,INV_H) != 0:
                            break
                        source[i]["qty"] = int(source[i]["qty"]) - 1
                        need -= 1
                        weight += item_weight
                        moved[id] = int(moved.get(id,0)) + 1
                    if int(source[i].get("qty",0)) <= 0:
                        source.remove_at(i)
                states_copy[key]["items"] = source
    if moved.is_empty():
        home_supply_feedback = "Ничего не взято: комплект готов либо нет припасов, места или резерва веса."
        _refresh_home_journal_ui()
        return false
    # Commit both sides together. No item is removed unless it fit in the pack.
    inventory_entries = inventory_copy
    for key in keys:
        container_states[key] = states_copy[key]
    var summary = []
    for id in moved:
        summary.append("%s ×%d" % [str(item_defs[id].get("name",id)),int(moved[id])])
    home_supply_feedback = "Взято: " + "; ".join(summary)
    _set_survival_feedback(home_supply_feedback,3.0)
    _save_state()
    _refresh_inventory_ui()
    _refresh_home_journal_ui()
    return true

