func _integrated_sprite_scale(value):
    # Quantized scaling keeps pixel density consistent between unrelated source assets.
    return clamp(round(float(value) * 7.0) / 8.0,0.25,1.5)

func _world_prop_sprite(kind,parent,pos = Vector2.ZERO,z_value = 0,scale_value = 1.0):
    var atlas = load("res://world_props_v19.png")
    if atlas == null:
        return null
    var region = _world_prop_region(kind)
    if region.size == Vector2.ZERO:
        return null
    var tex = AtlasTexture.new()
    tex.atlas = atlas
    tex.region = region
    var sprite = Sprite2D.new()
    sprite.texture = tex
    sprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
    sprite.region_filter_clip_enabled = true
    var integrated_scale = _integrated_sprite_scale(scale_value)
    sprite.position = Vector2(round(pos.x),round(pos.y))
    sprite.scale = Vector2(integrated_scale,integrated_scale)
    sprite.z_index = z_value
    sprite.set_meta("world_prop_kind",kind)
    sprite.set_meta("world_prop_scale",integrated_scale)
    if _world_prop_uses_contact_shadow(kind):
        var shadow_width = clamp(region.size.x * integrated_scale * 0.28,5.0,24.0)
        var shadow_height = clamp(region.size.y * integrated_scale * 0.055,1.5,5.0)
        var shadow_y = sprite.position.y + region.size.y * integrated_scale * 0.30
        var contact = _ellipse(
            Vector2(sprite.position.x,round(shadow_y)),
            shadow_width,shadow_height,Color(0.01,0.012,0.012,0.28),parent
        )
        contact.z_index = z_value - 1
    parent.add_child(sprite)
    return sprite

func _set_world_prop_sprite_kind(sprite,kind):
    if not is_instance_valid(sprite):
        return false
    var atlas = load("res://world_props_v19.png")
    if atlas == null:
        return false
    var region = _world_prop_region(kind)
    if region.size == Vector2.ZERO:
        return false
    var tex = AtlasTexture.new()
    tex.atlas = atlas
    tex.region = region
    sprite.texture = tex
    sprite.set_meta("world_prop_kind",kind)
    return true

func _interior_wall_band_texture(index):
    var atlas = load("res://interior_wall_band_v4.png")
    if atlas == null:
        return null
    var safe_index = clamp(int(index),0,7)
    var tex = AtlasTexture.new()
    tex.atlas = atlas
    tex.region = Rect2(safe_index * 32,0,32,28)
    return tex

func _exterior_style_index(sign_text):
    # 0.87: one visual language per building class (facade + roof + canopy).
    # 0 panel/admin, 1 clinic, 2 shop, 3 garage/service, 4 industrial, 5 military, 6 rural.
    var s = str(sign_text).to_upper()
    for key in ["ДАЧ","САРАЙ","ХОЗБЛОК","СТОРОЖК","ЛЕСНИК","ТЕПЛИЦ","КОРДОН"]:
        if s.find(key) >= 0:
            return 6
    for key in ["КПП","КАЗАР","СВЯЗ","КАРАУЛ","В/Ч","ДЕЖУР","ПРОХОДН","СМОТРОВ","АРСЕНАЛ","БАСТИОН","КОМЕНДАТ","ОРУЖЕЙ"]:
        if s.find(key) >= 0:
            return 5
    for key in ["ПОЛИКЛИН","АПТЕК","БОЛЬН","КЛИНИЧ","ГОСПИТ","МЕДИЦ","ИЗОЛЯТ","ЛАБОРАТ","РЕАНИМ","ОПЕРАЦ","ПРИЁМ","ПАЛАТ","ДИАГНОСТ","ТРИАЖ","САНПРОПУСК"]:
        if s.find(key) >= 0:
            return 1
    for key in ["ГАРАЖ","СЕРВИС","РЕМ","БОКС","МАСТЕРСК","ТЕХПОСТ","ШИНОМОНТ","ЗАПЧАСТ"]:
        if s.find(key) >= 0:
            return 3
    for key in ["ЦЕХ","СКЛАД","КОМПРЕСС","ЩИТОВ","ЗИП","ДЕПО","ПЧ","ПУТЕВ","ЭНЕРГО"]:
        if s.find(key) >= 0:
            return 4
    for key in ["МАГАЗ","ПРОДУК","КАФЕ"]:
        if s.find(key) >= 0:
            return 2
    return 0

func _roof_style_index(sign_text):
    # roof_tile_s<N>_v3: 0 bitumen, 1 concrete slab, 2 rusty corrugated,
    # 3 blue-grey corrugated, 4 red standing-seam tin, 5 asbestos-cement (shifer).
    var s = str(sign_text).to_upper()
    match _exterior_style_index(sign_text):
        1:
            return 1
        3:
            return 2
        4:
            return 3
        5:
            return 1
        6:
            if s.find("САРАЙ") >= 0 or s.find("ХОЗБЛОК") >= 0 or s.find("ТЕПЛИЦ") >= 0:
                return 5
            return 4
    return 0

func _facade_style_tile_texture(style_index,variant):
    var atlas = load("res://facade_wall_tiles_v4.png")
    if atlas == null:
        return null
    var tex = AtlasTexture.new()
    tex.atlas = atlas
    tex.region = Rect2(clamp(int(variant),0,3) * 32,clamp(int(style_index),0,6) * 28,32,28)
    return tex

func _facade_storeys_for(style_index,size,building_id = ""):
    var storeys = 1
    if style_index == 0 or style_index == 1 or style_index == 4:
        storeys = 2
    if size.x < 120.0 or size.y < 110.0:
        storeys = 1
    # 0.90: silhouette variety — some panel blocks get a third floor,
    # some workshops stay single-storey. Deterministic per building id.
    if str(building_id) != "":
        var h = abs(hash(str(building_id) + ":storeys"))
        if style_index == 0 and storeys == 2 and size.x >= 180.0 and size.y >= 130.0 and h % 2 == 0:
            storeys = 3
        elif style_index == 4 and storeys == 2 and h % 3 == 0:
            storeys = 1
    return storeys

func _facade_height_for(sign_text,size,building_id = ""):
    # plinth 10 + 28 per storey + cornice 8
    return 18.0 + 28.0 * float(_facade_storeys_for(_exterior_style_index(sign_text),size,building_id))

func _facade_atlas_sprite(parent,path,region,pos,scale_value = 1.0):
    var atlas = load(path)
    if atlas == null:
        return null
    var tex = AtlasTexture.new()
    tex.atlas = atlas
    tex.region = region
    var sprite = Sprite2D.new()
    sprite.texture = tex
    sprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
    sprite.position = Vector2(round(pos.x),round(pos.y))
    sprite.scale = Vector2(scale_value,scale_value)
    parent.add_child(sprite)
    return sprite

func _facade_strip(parent,path,region,y_center,width):
    # Tiles a 32px-wide atlas strip across the facade, cropping the last tile so
    # nothing overhangs the building edge (no clipping node needed).
    var x = -width * 0.5
    while x < width * 0.5 - 0.5:
        var vis = min(region.size.x,width * 0.5 - x)
        _facade_atlas_sprite(parent,path,Rect2(region.position.x,region.position.y,vis,region.size.y),Vector2(x + vis * 0.5,y_center))
        x += region.size.x

func _tall_facade_window(parent,style,state,pos):
    var sprite = _facade_atlas_sprite(parent,"res://facade_windows_v1.png",Rect2(int(state) * 48,int(style) * 40,48,40),pos)
    if sprite != null:
        sprite.set_meta("window_state",int(state))
        sprite.add_to_group("architecture_windows")
    return sprite

func _window_x_selected(values,x):
    for value in values:
        if abs(float(value) - float(x)) < 0.25:
            return true
    return false

# 0.97: only genuine ground-floor facade windows become breach points. Shopfronts,
# garage shutters and industrial gates keep their purpose-specific facade features.
func _breachable_window_xs(sign_text,size,building_id,door_x):
    var style = _exterior_style_index(sign_text)
    if not style in [0,1,5,6]:
        return []
    var w = float(size.x)
    if w < 92.0:
        return []
    var step = 44.0
    var n = max(1,int(floor((w - 24.0) / step)))
    var start = -float(n - 1) * step * 0.5
    var candidates = []
    for k in range(n):
        var wx = start + float(k) * step
        if abs(wx - float(door_x)) < 36.0:
            continue
        candidates.append(wx)
    if candidates.is_empty():
        return []
    # Prefer windows around the central circulation line, but never the doorway.
    candidates.sort_custom(func(a,b): return abs(float(a)) < abs(float(b)))
    var wanted = 1
    if w >= 150.0 and style != 6:
        wanted = 2
    var result = []
    for i in range(min(wanted,candidates.size())):
        result.append(float(candidates[i]))
    result.sort()
    return result

func _build_tall_facade(facade,sign_text,size,building_id,door_x,fh,profile = ""):
    # 0.88: one storey = 28px wall band; windows, balconies, shutters and the
    # entrance group are composed from style atlases. All children stay at
    # z 0 so the whole facade depth-sorts as one layer against the player.
    var style = _exterior_style_index(sign_text)
    var w = size.x
    var storeys = int(round((fh - 18.0) / 28.0))
    var seed_value = abs(hash(str(building_id)))
    var facade_seed = abs(hash(str(building_id) + ":facade"))
    var breach_window_xs = _breachable_window_xs(sign_text,size,building_id,door_x)
    _rect(Vector2(0,-fh*0.5),Vector2(w + 2.0,fh + 2.0),Color("1b1f1e"),facade)
    var variant_pattern = [0,0,1,0,2,0,0,3]
    for row in range(storeys):
        var ty = -10.0 - 14.0 - float(row) * 28.0
        var x = -w * 0.5
        var i = 0
        while x < w * 0.5 - 0.5:
            var vis = min(32.0,w * 0.5 - x)
            var variant = int(variant_pattern[(i + row * 3 + facade_seed) % variant_pattern.size()])
            if style == 6:
                variant = int(facade_seed % 4)
            _facade_atlas_sprite(facade,"res://facade_wall_tiles_v4.png",Rect2(variant * 32,style * 28,vis,28),Vector2(x + vis * 0.5,ty))
            x += 32.0
            i += 1
    _facade_strip(facade,"res://facade_bands_v1.png",Rect2(0,style * 18 + 8,32,10),-5.0,w)
    _facade_strip(facade,"res://facade_bands_v1.png",Rect2(0,style * 18,32,8),-fh + 4.0,w)

    # openings per storey
    for row in range(storeys):
        var wy = -10.0 - 14.0 - float(row) * 28.0
        var step = 44.0
        if row == 0 and (style == 2 or style == 3):
            step = 46.0
        var n = max(1,int(floor((w - 24.0) / step)))
        var start = -float(n - 1) * step * 0.5
        var gate_done = false
        for k in range(n):
            var wx = start + float(k) * step
            if row == 0 and abs(wx - door_x) < 36.0:
                continue
            var h = abs(hash(str(building_id) + ":" + str(row) + ":" + str(k)))
            var state = 0
            var roll = h % 100
            if roll < 12:
                state = 1
            elif roll < 28:
                state = 2
            elif roll < 36:
                state = 3
            var is_breach_window = row == 0 and _window_x_selected(breach_window_xs,wx)
            if is_breach_window:
                # Persistent defense state owns this visual from now on.
                state = 0
            if row == 0 and style == 2:
                _facade_atlas_sprite(facade,"res://facade_features_v1.png",Rect2(64,0,64,48),Vector2(wx,wy - 1.0),0.6)
            elif row == 0 and style == 3:
                var roller = 2 if h % 3 != 0 else 3
                _facade_atlas_sprite(facade,"res://facade_features_v1.png",Rect2(roller * 64,0,64,48),Vector2(wx,wy - 1.0),0.6)
            elif row == 0 and style == 4 and not gate_done and abs(wx - door_x) > 60.0:
                _facade_atlas_sprite(facade,"res://facade_features_v1.png",Rect2(5 * 64,0,64,48),Vector2(wx,wy - 1.0),0.6)
                gate_done = true
            elif row >= 1 and style == 4:
                _facade_atlas_sprite(facade,"res://facade_features_v1.png",Rect2(4 * 64,0,64,48),Vector2(wx,wy + 1.0),0.7)
            elif row >= 1 and style == 0 and h % 3 == 0:
                _facade_atlas_sprite(facade,"res://facade_features_v1.png",Rect2(0,0,64,48),Vector2(wx,wy - 2.0),0.62)
            else:
                var window_sprite = _tall_facade_window(facade,style,state,Vector2(wx,wy))
                if is_breach_window and is_instance_valid(window_sprite):
                    window_sprite.set_meta("breach_window_x",float(wx))
                    window_sprite.set_meta("breach_window_style",style)
                    window_sprite.add_to_group("breachable_window_visuals")
                if state == 3 or (state == 0 and (seed_value + k + row) % 5 == 0):
                    _add_detail_light(facade,Vector2(wx,wy + 6.0),Color(1.0,0.70,0.40),0.30,0.40,true)
            if style == 6 and state == 0 and h % 2 == 0:
                _facade_atlas_sprite(facade,"res://facade_features_v1.png",Rect2(7 * 64,0,64,48),Vector2(wx,wy - 5.0),0.6)
    if profile == "checkpoint":
        _facade_atlas_sprite(facade,"res://facade_features_v1.png",Rect2(6 * 64,38,64,10),Vector2(0,-5.0),1.0)

    _dress_tall_facade(facade,style,w,fh,storeys,door_x,building_id)

    # entrance group (door frame, canopy, lamp, steps) sits on the ground line
    var has_steps = style == 0 or style == 1 or style == 6
    _facade_atlas_sprite(facade,"res://entrance_v2.png",Rect2(style * 64,0,64,80),Vector2(door_x,-40.0 + (6.0 if has_steps else 1.0)))
    # 0.90: the door leaf is a real facade element driven by the door node
    # (open/close, collision, AI sound). Hinge on the left edge of the doorway.
    var leaf_w = 20.0 if (style == 4 or style == 5) else 18.0
    var leaf = _facade_atlas_sprite(facade,"res://door_leaf_v1.png",Rect2(style * 24,0,24,32),Vector2(door_x - leaf_w * 0.5,0.0))
    if leaf != null:
        leaf.centered = false
        leaf.offset = Vector2(0,-32)
        leaf.add_to_group("front_door_leaves")
        leaf.set_meta("leaf_width",leaf_w)
        facade.set_meta("door_leaf",leaf)
    _add_detail_light(facade,Vector2(door_x,-22.0),Color(1.0,0.72,0.42),0.52,0.62,true)
    var entrance_pool = _facade_atlas_sprite(facade,"res://light_pool_v1.png",Rect2(0,0,128,96),Vector2(door_x,16.0),0.42)
    if entrance_pool != null:
        entrance_pool.modulate = Color(1,1,1,0.0)
        entrance_pool.add_to_group("entrance_light_pools")
    # fire escape on tall residential / industrial walls
    if storeys >= 2 and (style == 0 or style == 4) and abs(hash(str(building_id) + ":ladder")) % 2 == 0:
        var lx = w * 0.5 - 24.0
        if abs(lx - door_x) > 40.0:
            _facade_atlas_sprite(facade,"res://facade_extras_v1.png",Rect2(0,120.0 - (fh - 10.0),48,fh - 10.0),Vector2(lx,-(fh - 10.0) * 0.5 - 6.0))

    # light from the upper-left: lit left edge, shaded right edge, ground contact
    _rect(Vector2(-w*0.5 + 2.0,-fh*0.5),Vector2(4.0,fh),Color(1.0,0.96,0.88,0.07),facade)
    _rect(Vector2(w*0.5 - 5.0,-fh*0.5),Vector2(10.0,fh),Color(0.0,0.0,0.0,0.22),facade)
    _rect(Vector2(0,1.5),Vector2(w,3.0),Color(0.0,0.0,0.0,0.30),facade)

    # sign board on the cornice above the entrance
    var sign_w = min(w * 0.5,104.0)
    var sign_x = clamp(door_x,-w*0.5 + sign_w*0.5 + 4.0,w*0.5 - sign_w*0.5 - 4.0)
    var sign_bg = ColorRect.new()
    sign_bg.position = Vector2(sign_x - sign_w*0.5,-fh + 0.0)
    sign_bg.size = Vector2(sign_w,11)
    sign_bg.color = Color("171b1b")
    facade.add_child(sign_bg)
    var sign = Label.new()
    sign.position = sign_bg.position + Vector2(5,-2)
    sign.text = sign_text
    sign.add_theme_font_size_override("font_size",7)
    sign.modulate = Color("c9c3a8")
    facade.add_child(sign)

const FACADE_DETAIL_KINDS = ["drainpipe","ivy","grime","ac_unit","wires","graffiti_a","graffiti_b","wall_lamp"]
const VEGETATION_KINDS = ["bush_orange","bush_yellow","bush_olive","weeds","tall_grass","leaf_pile","fallen_branch","bush_bare"]
const ROOF_DETAIL_KINDS = ["water_tank","sat_dish","stair_housing","pipe_run","roof_puddle","roof_debris","vent_small","skylight_row"]

func _facade_detail_region(kind,visible_height = 80.0):
    var index = max(0,FACADE_DETAIL_KINDS.find(kind))
    var hgt = clamp(visible_height,8.0,80.0)
    return Rect2(index * 48,80.0 - hgt,48,hgt)

func _dress_tall_facade(facade,style,w,fh,storeys,door_x,building_id):
    # 0.89: the lived-in layer from the reference sheets — drainpipes, AC units,
    # wires, ivy, rain streaks, graffiti, shrubs at the wall base and entrance props.
    # Everything is a facade child at z 0, so it depth-sorts with the wall.
    var rng = RandomNumberGenerator.new()
    rng.seed = abs(hash(str(building_id) + ":dress")) + 1
    var path = "res://facade_details_v1.png"
    # rain / grime streaks under the cornice
    var gx = -w * 0.5 + 24.0
    while gx < w * 0.5 - 20.0:
        if rng.randf() < 0.65:
            var streak = _facade_atlas_sprite(facade,path,_facade_detail_region("grime",fh - 8.0),Vector2(gx,-(fh - 8.0) * 0.5))
            if streak != null:
                streak.modulate = Color(1,1,1,0.55)
        gx += 44.0
    # drainpipes at the corners
    if style != 6:
        for side in [-1.0,1.0]:
            if style >= 3 and side > 0.0 and rng.randf() < 0.5:
                continue
            _facade_atlas_sprite(facade,path,_facade_detail_region("drainpipe",fh),Vector2(side * (w * 0.5 - 9.0),-fh * 0.5))
    # AC units on residential / clinic / shop walls
    if style <= 2 and w > 110.0:
        for i in range(rng.randi_range(1,2)):
            var ax = rng.randf_range(-w * 0.36,w * 0.36)
            if abs(ax - door_x) < 30.0:
                ax += 50.0 * sign(ax - door_x + 0.01)
            var ay = -10.0 - 28.0 * float(storeys - 1) - 16.0
            _facade_atlas_sprite(facade,path,Rect2(3 * 48,20,48,40),Vector2(clamp(ax,-w*0.42,w*0.42),ay),0.6)
    # sagging wires under the cornice
    if (style == 0 or style == 2 or style == 3) and rng.randf() < 0.45:
        _facade_atlas_sprite(facade,path,Rect2(4 * 48,0,48,64),Vector2(rng.randf_range(-w*0.3,w*0.3),-fh + 30.0))
    # ivy on garages, industry, dachas and some panel blocks
    if style == 3 or style == 4 or style == 6 or (style == 0 and rng.randf() < 0.3):
        if rng.randf() < 0.6:
            var ix = (w * 0.5 - 20.0) * (1.0 if rng.randf() < 0.5 else -1.0)
            _facade_atlas_sprite(facade,path,_facade_detail_region("ivy",fh - 6.0),Vector2(ix,-(fh - 6.0) * 0.5))
    # graffiti low on the wall
    if style != 1 and style != 6 and rng.randf() < 0.45:
        var gxx = rng.randf_range(-w * 0.4,w * 0.4)
        if abs(gxx - door_x) > 28.0:
            _facade_atlas_sprite(facade,path,Rect2((5 + rng.randi_range(0,1)) * 48,44,48,24),Vector2(gxx,-16.0),0.8)
    # shrubs and weeds along the wall base
    var shrubs = rng.randi_range(1,3) + (1 if style == 6 else 0)
    for i in range(shrubs):
        var bx = rng.randf_range(-w * 0.5 + 14.0,w * 0.5 - 14.0)
        if abs(bx - door_x) < 34.0:
            continue
        var kind = rng.randi_range(0,4)
        if style == 4 or style == 3:
            kind = 3 + rng.randi_range(0,1)
        _facade_atlas_sprite(facade,"res://vegetation_v1.png",Rect2(kind * 64,0,64,64),Vector2(bx,-12.0),0.5)
    # entrance furniture: bench + urn at blocks, bin at shops, tyres at garages
    var ex = door_x + (34.0 if door_x < w * 0.25 else -34.0)
    if abs(ex) < w * 0.5 - 14.0:
        if style == 0 or style == 1:
            _facade_atlas_sprite(facade,"res://street_furniture_v1.png",Rect2(0,0,64,48),Vector2(ex,-6.0),0.42)
            _facade_atlas_sprite(facade,"res://world_props_v19.png",Rect2(512,0,40,48),Vector2(ex + (20.0 if ex > door_x else -20.0),-8.0),0.4)
        elif style == 2:
            _facade_atlas_sprite(facade,"res://world_props_v19.png",Rect2(512,0,40,48),Vector2(ex,-8.0),0.45)
        elif style == 3 and rng.randf() < 0.7:
            _facade_atlas_sprite(facade,"res://street_furniture_v1.png",Rect2(6 * 64,0,64,48),Vector2(ex,-6.0),0.42)
    facade.set_meta("facade_dressed",true)

func _roof_detail_sprite(roof,kind,pos,scale_value,z_value = 2):
    var index = ROOF_DETAIL_KINDS.find(kind)
    if index < 0:
        return null
    var sprite = _facade_atlas_sprite(roof,"res://roof_details_v1.png",Rect2(index * 64,0,64,64),pos,scale_value)
    if sprite != null:
        sprite.z_index = z_value
        sprite.set_meta("roof_detail_kind",kind)
    return sprite

func _decorate_roof_details(roof,sign_text,size,building_id):
    # 0.89: rooftop clutter per roof type + inner parapet shadow (light from upper-left).
    var style = _roof_style_index(sign_text)
    var area = Vector2(max(64.0,size.x*0.90),max(64.0,size.y*0.90))
    var c = Vector2(0,-size.y*0.02)
    var rng = RandomNumberGenerator.new()
    rng.seed = abs(hash(str(building_id) + ":roofdetail")) + 1
    if style == 0 or style == 1 or style == 5:
        _rect(c + Vector2(0,-area.y*0.5 + 11.0),Vector2(area.x - 16.0,6.0),Color(0,0,0,0.20),roof)
        _rect(c + Vector2(-area.x*0.5 + 11.0,0),Vector2(6.0,area.y - 16.0),Color(0,0,0,0.16),roof)
    var spots = [Vector2(-0.30,-0.28),Vector2(0.30,-0.30),Vector2(-0.32,0.22),Vector2(0.32,0.24),Vector2(0.02,0.30),Vector2(-0.04,-0.34),Vector2(0.12,0.05)]
    var kinds = []
    match style:
        0, 1:
            kinds = ["roof_puddle","vent_small","roof_debris"]
            if area.x > 150.0:
                kinds.append("stair_housing")
            if rng.randf() < 0.5:
                kinds.append("water_tank")
            if rng.randf() < 0.6:
                kinds.append("sat_dish")
            if rng.randf() < 0.5:
                kinds.append("pipe_run")
        2:
            kinds = ["vent_small","roof_debris"]
        3:
            kinds = ["skylight_row","vent_small","pipe_run"]
        _:
            kinds = ["roof_debris"]
    for i in range(min(kinds.size(),spots.size())):
        var j = (i + rng.randi_range(0,spots.size() - 1)) % spots.size()
        var spot = spots[j]
        spots.remove_at(j)
        var pos = c + Vector2(spot.x * area.x,spot.y * area.y)
        var kind = kinds[i]
        var z_value = 1 if kind == "roof_puddle" else 2
        var sc = 0.55 if kind in ["stair_housing","water_tank","skylight_row"] else 0.5
        _roof_detail_sprite(roof,kind,pos,sc,z_value)
        if spots.is_empty():
            break
    # 0.90 silhouette pieces
    if style == 4 or style == 5:
        var ch = _facade_atlas_sprite(roof,"res://facade_extras_v1.png",Rect2(48,0,64,64),c + Vector2(area.x * 0.22,-area.y * 0.18),0.7)
        if ch != null:
            ch.z_index = 3
    elif style == 3 and rng.randf() < 0.55:
        var stack = _facade_atlas_sprite(roof,"res://facade_extras_v1.png",Rect2(112,0,64,120),c + Vector2(-area.x * 0.30,-area.y * 0.10),0.8)
        if stack != null:
            stack.z_index = 3
    # autumn litter on pitched / corrugated roofs
    if style >= 2:
        for i in range(rng.randi_range(1,2)):
            var lp = c + Vector2(rng.randf_range(-0.35,0.35) * area.x,rng.randf_range(-0.3,0.3) * area.y)
            var leaf = _facade_atlas_sprite(roof,"res://vegetation_v1.png",Rect2((5 if i == 0 else 6) * 64,0,64,64),lp,0.45)
            if leaf != null:
                leaf.z_index = 2
    roof.set_meta("roof_details",true)

func _scatter_vegetation(chunk,coord,district_id):
    # 0.89: shrubs, weeds, leaf piles and fallen branches on free grass. Visual only;
    # uses the same forbidden-zone test as trees (roads, buildings, door swings).
    var rng = RandomNumberGenerator.new()
    rng.seed = int(abs(coord.x*61141 + coord.y*39119 + 7717)) + 1
    var count = 10
    var weights = [3,3,2,3,2,3,1,1]
    if district_id.find("woodland") >= 0 or district_id.find("rural") >= 0 or district_id.find("dacha") >= 0:
        count = 18
        weights = [4,3,4,3,3,3,2,2]
    elif district_id.find("industrial") >= 0 or district_id == "rail_corridor":
        count = 9
        weights = [1,1,2,4,4,2,1,2]
    var total = 0
    for wv in weights:
        total += wv
    var placed = 0
    for attempt in range(count * 3):
        if placed >= count:
            break
        var pos = Vector2(rng.randi_range(20,CHUNK_SIZE - 20),rng.randi_range(20,CHUNK_SIZE - 20))
        if _tree_position_forbidden(chunk,pos):
            continue
        var r = rng.randi_range(0,total - 1)
        var kind = 0
        while r >= weights[kind]:
            r -= weights[kind]
            kind += 1
        var sprite = _facade_atlas_sprite(chunk,"res://vegetation_v1.png",Rect2(kind * 64,0,64,64),pos,0.5)
        if sprite != null:
            sprite.z_as_relative = false
            sprite.z_index = -6 if kind >= 5 else 6
            sprite.flip_h = rng.randf() < 0.5
            sprite.add_to_group("world_vegetation")
            sprite.set_meta("vegetation_kind",VEGETATION_KINDS[kind])
        placed += 1
    chunk.set_meta("vegetation_count",placed)

