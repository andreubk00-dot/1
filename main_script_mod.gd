func _direction8_from_vector(direction,fallback=0):
    var safe_fallback = int(fallback) % 8
    if direction.length() < 0.08:
        return safe_fallback
    var angle = fposmod(direction.angle() + TAU,TAU)
    return int(round(angle / (PI * 0.25))) % 8

func _direction8_hysteresis(direction,current_index):
    var current = int(current_index) % 8
    if direction.length() < 0.08:
        return current
    var step_angle = PI * 0.25
    var current_angle = float(current) * step_angle
    var delta_angle = wrapf(direction.angle() - current_angle,-PI,PI)
    # Default sector boundary is 22.5 degrees. Hold the current sprite a few
    # degrees longer so tiny mouse motion cannot chatter the whole body.
    if abs(delta_angle) <= step_angle * 0.62:
        return current
    return _direction8_from_vector(direction,current)

func _visual_weapon_angle(direction):
    if direction.length() < 0.08:
        direction = Vector2.RIGHT
    # 0.60: weapon art is locked to the same 8 directions as the baked hands.
    # This removes the old half-step rotations where the gun visibly slipped
    # out of the palms even though the projectile still used the exact aim vector.
    var step = PI / 4.0
    return round(direction.angle() / step) * step

func _player_pose_class(weapon_id):
    if equipped_melee_id != "" or weapon_id in ["combat_knife","steel_pipe","fire_axe"]:
        return "melee"
    return str(weapon_defs.get(weapon_id,{}).get("pose_class","longgun"))

func _ensure_player_pose_class(weapon_id):
    if pv_pose_back == null or pv_pose_front == null:
        return
    var cls = _player_pose_class(weapon_id)
    if cls == pv_pose_class:
        return
    if not pv_pose_back_cache.has(cls):
        pv_pose_back_cache[cls] = load("res://player_cohesive_%s_back_v8.png" % cls)
        pv_pose_front_cache[cls] = load("res://player_cohesive_%s_front_v8.png" % cls)
    pv_pose_back.texture = pv_pose_back_cache.get(cls,null)
    pv_pose_front.texture = pv_pose_front_cache.get(cls,null)
    pv_pose_class = cls

func _directional_leg_row8(direction_index,running,moving):
    var d = int(direction_index) % 8
    if not moving:
        return 16 + d
    if running:
        return 8 + d
    return d

func _set_pose_frame(weapon_id,row):
    if pv_pose_back == null or pv_pose_front == null:
        return
    _ensure_player_pose_class(weapon_id)
    visual_aim_dir8 = _direction8_hysteresis(aim_direction,visual_aim_dir8)
    var safe_row = clamp(int(row),0,64)
    var rect = Rect2(visual_aim_dir8 * 160,safe_row * 120,160,120)
    pv_pose_back.region_rect = rect
    pv_pose_front.region_rect = rect

func _update_pose_weapon(weapon_id,row,pose_offset,pose_rotation):
    if pv_weapon_root == null:
        return

    var is_melee = equipped_melee_id != ""
    var config = _held_visual_config(weapon_id,is_melee)
    var aim_angle = pose_rotation
    var aim_vec = Vector2.RIGHT.rotated(aim_angle)
    var grip_local = _source_point_to_weapon_local(
        config.get("rear_px",Vector2.ZERO),
        config
    )

    # 0.60 cohesive anatomical rig: the rear grip uses the same chest/hand geometry as the
    # baked arm atlas. Arms and weapon therefore remain one silhouette instead of
    # looking like independently animated pieces.
    var chest = pose_offset + Vector2(0,-8.7) + Vector2(0,aim_vec.y * 0.45)
    var side = Vector2(-aim_vec.y,aim_vec.x)
    var cls = _player_pose_class(weapon_id)
    var rear_reach = 5.1
    var rear_side = 0.28
    if cls == "pistol":
        rear_reach = 7.5
        rear_side = 0.30
    elif cls == "melee":
        rear_reach = 6.0
        rear_side = 0.45
    if abs(aim_vec.y) > 0.70:
        rear_side *= 0.28
        if cls == "longgun":
            rear_reach = 6.2
        elif cls == "pistol":
            rear_reach = 7.9
    var hand_anchor = chest + aim_vec * rear_reach + side * rear_side
    var visual_angle = aim_angle

    if is_melee:
        var swing_t = _melee_swing_progress()
        if swing_t >= 0.0:
            var swing_state = _melee_clip_state(weapon_id,swing_t)
            var swing_angle = float(swing_state.get("angle",0.0))
            visual_angle += swing_angle - 0.82
            hand_anchor += swing_state.get("root",Vector2.ZERO) * 0.28
    else:
        var recoil = _firearm_recoil_amount()
        hand_anchor -= aim_vec * recoil * (3.0 if weapon_id != "makarov" else 2.0)
        visual_angle += recoil * (-0.055 if aim_vec.y >= 0.0 else 0.055)

        var reload_p = _reload_anim_progress()
        if recoil < 0.01 and reload_p < 0.0 and movement_anim_blend < 0.12:
            var idle_t = Time.get_ticks_msec() * 0.001
            var side_idle = Vector2(-aim_vec.y,aim_vec.x)
            hand_anchor += side_idle * sin(idle_t * 1.15) * 0.22
            hand_anchor += aim_vec * sin(idle_t * 2.05) * 0.10
            visual_angle += sin(idle_t * 1.35) * 0.006

        if reload_p >= 0.0:
            var reload_arc = sin(reload_p * PI)
            var reload_reach = 5.0 if cls == "pistol" else 5.3
            var reload_target = chest + aim_vec * reload_reach
            hand_anchor = hand_anchor.lerp(reload_target,0.92 * reload_arc)
            if weapon_id in ["shotgun","toz34"]:
                visual_angle += reload_arc * 0.22
            elif weapon_id in ["makarov","tt33"]:
                visual_angle += reload_arc * 0.62
            else:
                visual_angle += reload_arc * 0.44

    pv_weapon_root.scale = Vector2.ONE
    pv_weapon_root.rotation = visual_angle
    if not is_melee and pv_modern_survivor_sprite != null and pv_modern_survivor_sprite.visible:
        # Imported survivor firearms use authored 8-way gun sprites that must be anchored
        # directly to the runtime hand position. The old path subtracted the legacy 144x48
        # weapon grip and left the directional gun floating beside the body.
        var dir8 = _direction8_hysteresis(aim_direction,visual_aim_dir8)
        var hand_cfg = _hand_weapon_visual_config(weapon_id,dir8)
        pv_weapon_root.position = hand_anchor + hand_cfg.get("root_bias",Vector2.ZERO)
    else:
        pv_weapon_root.position = hand_anchor - grip_local.rotated(visual_angle)

    if is_melee:
        if pv_modern_survivor_sprite != null and pv_modern_survivor_sprite.visible:
            if pv_melee_trail != null:
                pv_melee_trail.visible = false
        else:
            _update_melee_trail(weapon_id,_melee_swing_progress())
    elif pv_melee_trail != null:
        pv_melee_trail.visible = false

func _modern_survivor_firearm_variant_prefix():
    if equipped_melee_id != "":
        # 0.75: melee weapons are baked into the survivor sheets as well.
        match equipped_melee_id:
            "combat_knife":
                return "knife_"
            "steel_pipe":
                return "pipe_"
            "fire_axe":
                return "axe_"
        return ""
    var prefix = str(weapon_defs.get(current_weapon_id,{}).get("anim_prefix",current_weapon_id))
    return (prefix + "_") if prefix != "" else ""

func _modern_survivor_sheet(name):
    var prefix = _modern_survivor_firearm_variant_prefix()
    var key = name
    if prefix != "":
        key = prefix + name
        if not pv_modern_survivor_cache.has(key):
            pv_modern_survivor_cache[key] = load("res://survivor_%s%s.png" % [prefix,name])
        var variant = pv_modern_survivor_cache.get(key,null)
        if variant != null:
            return variant
    if not pv_modern_survivor_cache.has(name):
        pv_modern_survivor_cache[name] = load("res://survivor_%s.png" % name)
    return pv_modern_survivor_cache.get(name,null)

func _modern_survivor_row(dir8):
    # The supplied 8-way sheets already use OSTATOK's clockwise direction order:
    # E, SE, S, SW, W, NW, N, NE. Do not remap rows.
    return int(dir8) % 8

func _modern_survivor_idle_sheet(weapon_id):
    # Every weapon has its own baked Idle sheet (survivor_<weapon>_Idle.png).
    return "Idle"

func _modern_survivor_attack_sheet(weapon_id,stationary_attack):
    # Attack1 = firearm shot (recoil + muzzle flash). Attack3/Attack4 = melee swing/stab.
    return "Attack1" if stationary_attack else "RunAttack"

func _modern_survivor_frame(sheet_name,moving,count = 8):
    if sheet_name.begins_with("Idle"):
        return int(floor(Time.get_ticks_msec() * 0.0032)) % 8
    if sheet_name == "Taunt":
        var reload_p = _reload_anim_progress()
        if reload_p < 0.0:
            return 0
        return clamp(int(floor(reload_p * 8.0)),0,7)
    if sheet_name == "TakeDamage":
        if modern_survivor_hit_time <= 0.0 or modern_survivor_hit_duration <= 0.001:
            return 0
        var hit_p = clamp(1.0 - modern_survivor_hit_time / modern_survivor_hit_duration,0.0,1.0)
        return clamp(int(floor(hit_p * 8.0)),0,7)
    if sheet_name == "Attack2":
        var cycle_p = _weapon_cycle_progress()
        if cycle_p < 0.0:
            return 0
        return clamp(int(floor(cycle_p * 8.0)),0,7)
    if sheet_name.find("Attack") != -1:
        if equipped_melee_id != "":
            if melee_swing_time <= 0.0 or melee_swing_duration <= 0.001:
                return 0
            var melee_p = clamp(1.0 - melee_swing_time / melee_swing_duration,0.0,1.0)
            return clamp(int(floor(melee_p * 8.0)),0,7)
        if weapon_recoil_time <= 0.0 or weapon_recoil_duration <= 0.001:
            return 0
        var attack_p = clamp(1.0 - weapon_recoil_time / weapon_recoil_duration,0.0,1.0)
        return clamp(int(floor(attack_p * 8.0)),0,7)
    if movement_anim_blend <= 0.05 and not moving:
        return 0
    # 0.76: locomotion sheets carry 12 frames per cycle (count comes from the sheet width).
    var normalized = fposmod(walk_phase,TAU) / TAU
    return int(floor(normalized * float(count))) % count

func _modern_survivor_clip(weapon_id,local_aim,local_motion,moving):
    if modern_survivor_hit_time > 0.0:
        return "TakeDamage"

    if equipped_melee_id != "":
        if melee_swing_time > 0.0:
            return "Attack4" if equipped_melee_id == "combat_knife" else "Attack3"
        var melee_aim = local_aim.normalized() if local_aim.length() > 0.01 else Vector2.RIGHT
        var melee_motion = local_motion.normalized() if local_motion.length() > 0.01 else Vector2.ZERO
        if not moving or melee_motion == Vector2.ZERO:
            return "Idle"
        var melee_side = Vector2(-melee_aim.y,melee_aim.x)
        var melee_forward = melee_motion.dot(melee_aim)
        var melee_lateral = melee_motion.dot(melee_side)
        if abs(melee_lateral) > abs(melee_forward) * 1.10 and abs(melee_lateral) > 0.22:
            return "StrafeLeft" if melee_lateral < 0.0 else "StrafeRight"
        if melee_forward < -0.22:
            return "RunBackwards"
        return "Run" if is_sprinting else "Walk"

    if reload_time > 0.0:
        return "Taunt"

    if _weapon_cycle_progress() >= 0.0:
        return "Attack2"

    var shooting = _firearm_recoil_amount() > 0.015
    var aim = local_aim.normalized() if local_aim.length() > 0.01 else Vector2.RIGHT
    var motion = local_motion.normalized() if local_motion.length() > 0.01 else Vector2.ZERO
    if not moving or motion == Vector2.ZERO:
        return _modern_survivor_attack_sheet(weapon_id,true) if shooting else _modern_survivor_idle_sheet(weapon_id)

    var side = Vector2(-aim.y,aim.x)
    var forward_amount = motion.dot(aim)
    var side_amount = motion.dot(side)

    if shooting:
        if abs(side_amount) > abs(forward_amount) * 1.10 and abs(side_amount) > 0.22:
            return "StrafeLeftAttack" if side_amount < 0.0 else "StrafeRightAttack"
        if forward_amount < -0.22:
            return "RunBackwardsAttack"
        return "RunAttack"

    if abs(side_amount) > abs(forward_amount) * 1.10 and abs(side_amount) > 0.22:
        if side_amount < 0.0:
            return "StrafeLeft"
        return "StrafeRight"

    if forward_amount < -0.22:
        return "RunBackwards"

    return "Run" if is_sprinting else "Walk"

func _modern_survivor_overlay_config(weapon_id):
    # Weapon-specific overlay keeps the selected gun readable over the baked survivor.
    # Front guns sit above the survivor; north-facing guns sit behind the body.
    if weapon_id in ["makarov","tt33"]:
        return {"scale":0.88,"root":Vector2(-0.2,-0.2),"z_front":3,"z_back":-1}
    if weapon_id in ["shotgun","toz34","sks"]:
        return {"scale":1.02,"root":Vector2(-1.2,-0.6),"z_front":3,"z_back":-1}
    return {"scale":1.00,"root":Vector2(-0.8,-0.7),"z_front":3,"z_back":-1}

func _hand_weapon_dir_suffix(dir8):
    match int(dir8) % 8:
        0:
            return "e"
        1:
            return "se"
        2:
            return "s"
        3:
            return "sw"
        4:
            return "w"
        5:
            return "nw"
        6:
            return "n"
        _:
            return "ne"

func _hand_weapon_prefix(weapon_id):
    if weapon_id in ["makarov","tt33"]:
        return "makarov"
    if weapon_id in ["shotgun","toz34","sks"]:
        return "shotgun"
    return "akm"

func _hand_weapon_texture(weapon_id,dir8):
    var path = "res://free_weapon_hands/%s_%s.png" % [_hand_weapon_prefix(weapon_id),_hand_weapon_dir_suffix(dir8)]
    if not hand_weapon_texture_cache.has(path):
        hand_weapon_texture_cache[path] = load(path)
    return hand_weapon_texture_cache.get(path,null)

